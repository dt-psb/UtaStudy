  "lyrics": [
    {
      "id": 1,
      "start": 9.65,
      "end": 13.49,
      "rubyText": "偽[いつわ]りのマナーでホッとしてるの？",
      "translation": "가짜 매너에 안심하고 있는 거야?",
      "romaji": "itsuwari no manaa de hotsu toshiteruno ？"
    },
    {
      "id": 2,
      "start": 13.49,
      "end": 15.96,
      "rubyText": "何[なに]やったって指[さ]さされるの？",
      "translation": "뭘 해도 손가락질받는 거야?",
      "romaji": "nani yattatte sasa sareruno ？"
    },
    {
      "id": 3,
      "start": 15.96,
      "end": 16.9,
      "rubyText": "また消[け]されてく",
      "translation": "또 지워져 가고 있어",
      "romaji": "mata kesa reteku"
    },
    {
      "id": 4,
      "start": 16.9,
      "end": 19.81,
      "rubyText": "言[い]いたいことにただ蓋[ふた]して",
      "translation": "하고 싶은 말에 그저 뚜껑을 덮어버리고",
      "romaji": "ii taikotonitada futashite"
    },
    {
      "id": 5,
      "start": 19.81,
      "end": 20.38,
      "rubyText": "嗚呼[ああ]",
      "translation": "아아",
      "romaji": "aa"
    },
    {
      "id": 6,
      "start": 20.38,
      "end": 22.38,
      "rubyText": "なんかなんか全部[ぜんぶ]全部[ぜんぶ]",
      "translation": "뭔가 뭔가 전부 전부",
      "romaji": "nankananka zenbu zenbu"
    },
    {
      "id": 7,
      "start": 22.38,
      "end": 23.57,
      "rubyText": "嘘[うそ]で隠[かく]して",
      "translation": "거짓으로 숨기고",
      "romaji": "uso de kakushi te"
    },
    {
      "id": 8,
      "start": 24.0,
      "end": 25.63,
      "rubyText": "愛[あい]や恋[こい]や好[す]きやLOVEをずっと",
      "translation": "사랑이나 연애나 좋아해나 LOVE를 계속",
      "romaji": "ai ya koi ya suki ya LOVE wozutto"
    },
    {
      "id": 9,
      "start": 25.63,
      "end": 27.48,
      "rubyText": "別[べつ]の言葉[ことば]連[つら]ね使[つか]い伝[つた]えて",
      "translation": "다른 말들로 늘어놓아 전하고",
      "romaji": "betsuno kotoba tsurane tsukai tsutae te"
    },
    {
      "id": 10,
      "start": 27.48,
      "end": 29.5,
      "rubyText": "なんか実[じつ]は卑猥[ひわい]だった歌詞[かし]が",
      "translation": "그런데 사실은 음란한 가사였던 게",
      "romaji": "nanka jitsuha hiwai datta kashi ga"
    },
    {
      "id": 11,
      "start": 30.0,
      "end": 31.12,
      "rubyText": "電波[でんぱ]に乗[の]る",
      "translation": "전파를 타고 흘러가",
      "romaji": "denpa ni noru"
    },
    {
      "id": 12,
      "start": 31.12,
      "end": 32.64,
      "rubyText": "ってちょっと待[ま]ってだって変[へん]",
      "translation": "잠깐만, 이건 좀 이상해",
      "romaji": "ttechotto matsu tedatte hen"
    },
    {
      "id": 13,
      "start": 32.64,
      "end": 34.54,
      "rubyText": "笑[わら]ってたって裏[うら]でずっと陰口[かげぐち]",
      "translation": "웃고 있어도 뒤에서는 계속 뒷담화",
      "romaji": "waratsu tetatte urade zutto kageguchi"
    },
    {
      "id": 14,
      "start": 34.54,
      "end": 36.54,
      "rubyText": "本音[ほんね]ずっとLieでHyde楽[たの]しいの？",
      "translation": "속마음은 항상 Lie와 Hyde, 재미있어?",
      "romaji": "honne zutto Lie de Hyde tanoshii no ？"
    },
    {
      "id": 15,
      "start": 37.02,
      "end": 37.75,
      "rubyText": "いつからか",
      "translation": "언제부터였지",
      "romaji": "itsukaraka"
    },
    {
      "id": 16,
      "start": 38.24,
      "end": 41.63,
      "rubyText": "求[もと]めていた未来[みらい]がほら",
      "translation": "우리가 원하던 미래가 봐",
      "romaji": "motome teita mirai gahora"
    },
    {
      "id": 17,
      "start": 41.63,
      "end": 45.1,
      "rubyText": "書き換[かきか]えられて踏[ふ]み潰[つぶ]されて",
      "translation": "다시 쓰여지고 짓밟혀서",
      "romaji": "kakikaera rete fumi tsubusa rete"
    },
    {
      "id": 18,
      "start": 45.1,
      "end": 50.3,
      "rubyText": "言[い]いたいことも言[い]えなくなっていく",
      "translation": "하고 싶은 말도 못 하게 되어 가",
      "romaji": "ii taikotomo ie nakunatteiku"
    },
    {
      "id": 19,
