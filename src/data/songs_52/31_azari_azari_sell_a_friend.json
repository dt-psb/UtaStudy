  "duration": 141,
  "lyrics": [
    {
      "id": 1,
      "start": 6.45,
      "end": 8.96,
      "rubyText": "I can't fake クラクラしたい",
      "translation": "I can't fake 어질어질해지고 싶어",
      "romaji": "I can't fake kurakura shitai"
    },
    {
      "id": 2,
      "start": 9.12,
      "end": 11.75,
      "rubyText": "待[ま]ったって ま、変[か]わらない",
      "translation": "기다려봤자 뭐, 달라질 건 없어",
      "romaji": "mattatte ma, kawaranai"
    },
    {
      "id": 3,
      "start": 11.75,
      "end": 14.25,
      "rubyText": "I can't trade 刻[きざ]みつけたい",
      "translation": "I can't trade 새겨두고 싶어",
      "romaji": "I can't trade kizamitsuketai"
    },
    {
      "id": 4,
      "start": 14.25,
      "end": 17.08,
      "rubyText": "あなたのエラー",
      "translation": "너의 에러를",
      "romaji": "anatano eraa"
    },
    {
      "id": 5,
      "start": 17.12,
      "end": 19.33,
      "rubyText": "I can't fake すぐに飛[と]びたい",
      "translation": "I can't fake 당장 날아가고 싶어",
      "romaji": "I can't fake sugunitobitai"
    },
    {
      "id": 6,
      "start": 19.92,
      "end": 22.04,
      "rubyText": "去[さ]ったって 裁[さば]かれない",
      "translation": "떠나버려도 심판받진 않아",
      "romaji": "sattatte sabakarenai"
    },
    {
      "id": 7,
      "start": 22.29,
      "end": 24.75,
      "rubyText": "I can't trade 取[と]り替[か]えれない",
      "translation": "떠나버려도 심판받진 않아 I can't trade 바꿔 끼울 수 없어",
      "romaji": "I can't trade torikaerenai"
    },
    {
      "id": 8,
      "start": 24.88,
      "end": 27.2,
      "rubyText": "壊[こわ]れたセンサー",
      "translation": "망가진 센서 Let's Go!",
      "romaji": "kowareta sensaa"
    },
    {
      "id": 9,
      "start": 27.5,
      "end": 30.08,
      "rubyText": "浴[あ]びたい Happy time まだ夜[よる]は深[ふか]い",
      "translation": "흠뻑 젖고 싶어 Happy time 아직 밤은 깊어",
      "romaji": "abitai Happy time madayoruhafukai"
    },
    {
      "id": 10,
      "start": 30.12,
      "end": 32.96,
      "rubyText": "早[はや]まった行動[こうどう] 止[や]められないわ Tonight",
      "translation": "성급한 행동을 멈출 수 없어 Tonight",
      "romaji": "hayamattakoudou yamerarenaiwa Tonight"
    },
    {
      "id": 11,
      "start": 32.96,
      "end": 35.67,
      "rubyText": "ただ蒔[ま]いたら咲[さ]いた花[はな]の Parasite",
      "translation": "그저 뿌렸더니 피어난 꽃의 Parasite",
      "romaji": "tadamaitarasaitahanano Parasite"
    },
    {
      "id": 12,
      "start": 35.75,
      "end": 38.08,
      "rubyText": "ならLuckyに ひとつまみしたい",
      "translation": "그렇다면 Lucky하게 조금만 집어보고 싶어",
      "romaji": "nara Lucky ni hitotsumamishitai"
    },
    {
      "id": 13,
      "start": 38.17,
      "end": 42.09,
      "rubyText": "No, rise and fallには Silent",
      "translation": "No, rise and fall에는 Silent",
      "romaji": "No, rise and fall niha Silent"
    },
    {
      "id": 14,
      "start": 42.09,
      "end": 44.62,
      "rubyText": "興味[きょうみ]は無[な]い",
      "translation": "No, rise and fall에는 Silent 관심 없어",
      "romaji": "kyoumihanai"
    },
    {
      "id": 15,
      "start": 44.71,
      "end": 45.71,
      "rubyText": "Tonight,",
      "translation": "Tonight,",
      "romaji": "Tonight,"
    },
    {
      "id": 16,
      "start": 46.12,
      "end": 47.25,
      "rubyText": "Tonight,",
      "translation": "Tonight, Tonight,",
      "romaji": "Tonight,"
    },
    {
      "id": 17,
      "start": 47.63,
      "end": 49.17,
      "rubyText": "Tonight,",
      "translation": "Tonight, Tonight, Tonight",
      "romaji": "Tonight,"
    },
    {
      "id": 18,
      "start": 51.58,
      "end": 53.58,
      "rubyText": "期待[きたい]したい Delight",
      "translation": "기대하고 싶어 Delight",
      "romaji": "kitaishitai Delight"
    },
    {
      "id": 19,
      "start": 53.58,
      "end": 55.58,
      "rubyText": "すぐに会[あ]いたい ただ",
      "translation": "당장 만나고 싶어, 그냥",
      "romaji": "suguniaitai tada"
    },
    {
      "id": 20,
      "start": 55.75,
      "end": 57.54,
      "rubyText": "なのにいつも 怖[こわ]い？",
      "translation": "그런데 왜 늘 무서워?",
      "romaji": "nanoniitsumo kowai？"
    },
    {
      "id": 21,
      "start": 57.62,
      "end": 59.0,
      "rubyText": "ホワイ？ You lie!",
      "translation": "Why? You lie!",
      "romaji": "howai？ You lie!"
    },
    {
      "id": 22,
      "start": 59.04,
      "end": 61.0,
      "rubyText": "暴[あば]き出[だ]したい だから",
      "translation": "전부 파헤치고 싶어 그러니까",
      "romaji": "abakidashitai dakara"
    },
    {
      "id": 23,
      "start": 61.04,
      "end": 62.17,
      "rubyText": "Sell a friend!",
      "translation": "Sell a friend!",
      "romaji": "Sell a friend!"
    },
    {
      "id": 24,
      "start": 62.46,
      "end": 64.25,
      "rubyText": "誓[ちか]いを買[か]いなさい",
      "translation": "맹세를 사버려",
      "romaji": "chikaiwokainasai"
    },
    {
      "id": 25,
      "start": 64.42,
      "end": 66.12,
      "rubyText": "見[み]ないでいたい？ まだ",
      "translation": "아직은 안 보고 싶어? 그래도",
      "romaji": "minaideitai？ mada"
    },
    {
      "id": 26,
      "start": 66.17,
      "end": 68.0,
      "rubyText": "だけど少[すこ]し 見[み]たい？",
      "translation": "조금은 보고 싶어?",
      "romaji": "dakedosukoshi mitai？"
    },
    {
      "id": 27,
      "start": 68.12,
      "end": 69.58,
      "rubyText": "見[み]たい？ I like!",
      "translation": "보고 싶어? I like!",
      "romaji": "mitai？ I like!"
    },
    {
      "id": 28,
      "start": 69.58,
      "end": 71.62,
      "rubyText": "繋[つな]いでいたい ならば",
      "translation": "계속 이어지고 싶다면",
      "romaji": "tsunaideitai naraba"
    },
    {
      "id": 29,
      "start": 71.67,
      "end": 75.42,
      "rubyText": "Sell a friend tonight!",
      "translation": "Sell a friend tonight!",
      "romaji": "Sell a friend tonight!"
    },
    {
      "id": 30,
      "start": 83.88,
      "end": 86.38,
      "rubyText": "愛[あい]なんて すぐに消[き]えない",
      "translation": "사랑 따위 쉽게 사라지지 않아",
      "romaji": "ainante sugunikienai"
    },
    {
      "id": 31,
      "start": 86.42,
      "end": 88.92,
      "rubyText": "いつだって 逆[さか]らえない",
      "translation": "언제나 거스를 수 없어",
      "romaji": "itsudatte sakaraenai"
    },
    {
      "id": 32,
      "start": 89.0,
      "end": 91.71,
      "rubyText": "愛[あい]なんて 無口[むくち]でいたい",
      "translation": "사랑 따위 말없이 있고 싶어",
      "romaji": "ainante mukuchideitai"
    },
    {
      "id": 33,
      "start": 91.71,
      "end": 93.88,
      "rubyText": "優[まさ]れた連鎖[れんさ]",
