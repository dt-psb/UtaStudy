  "lyrics": [
    {
      "id": 1,
      "start": 20.14,
      "end": 24.96,
      "rubyText": "風[かぜ]がおもてで呼[よ]んでいる 呼[よ]んでいる",
      "translation": "바람이 밖에서 부르고 있어 부르고 있어",
      "romaji": "kaze gaomotede yon deiru   yon deiru"
    },
    {
      "id": 2,
      "start": 24.96,
      "end": 28.1,
      "rubyText": "さぁ行[い]こう海[うみ]を脱[ぬ]いで",
      "translation": "자, 가자, 바다를 벗어 던지고",
      "romaji": "saa iko u umi wo nui de"
    },
    {
      "id": 3,
      "start": 28.1,
      "end": 32.37,
      "rubyText": "あなたと私[わたし] ちょうどいい昼間[ひるま]",
      "translation": "당신과 나, 딱 좋은 오후 시간이야",
      "romaji": "anatato watashi   choudoii hiruma"
    },
    {
      "id": 4,
      "start": 36.13,
      "end": 41.01,
      "rubyText": "風[かぜ]がおもてで呼[よ]んでいる 飛[と]んでいる",
      "translation": "바람이 밖에서 부르고 있어 날고 있어",
      "romaji": "kaze gaomotede yon deiru   ton deiru"
    },
    {
      "id": 5,
      "start": 41.01,
      "end": 44.11,
      "rubyText": "三時[さんじ]半[はん] 腕[うで]を振[ふ]って",
      "translation": "3시 반, 팔을 흔들고",
      "romaji": "sanji han   ude wo futsu te"
    },
    {
      "id": 6,
      "start": 44.11,
      "end": 50.43,
      "rubyText": "千鳥足[ちどりあし]の私[わたし] 不確[ふたし]かに 今日[きょう]も回り道[まわりみち]",
      "translation": "비틀거리는 나, 불확실하게 오늘도 둘러서 가",
      "romaji": "chidoriashi no watashi   futashika ni   kyou mo mawarimichi"
    },
    {
      "id": 7,
      "start": 52.0,
      "end": 57.79,
      "rubyText": "たぶん私[わたし]は生[い]きている",
      "translation": "아마 나는 살아 있어",
      "romaji": "tabun watashi ha iki teiru"
    },
    {
      "id": 8,
      "start": 58.38,
      "end": 62.24,
      "rubyText": "風[かぜ]が私[わたし]を呼[よ]んでいる",
      "translation": "바람이 나를 부르고 있어",
      "romaji": "kaze ga watashi wo yon deiru"
    },
    {
      "id": 9,
      "start": 62.24,
      "end": 66.4,
      "rubyText": "鳥[とり]が私[わたし]を呼[よ]んでいる",
      "translation": "새가 나를 부르고 있어",
      "romaji": "tori ga watashi wo yon deiru"
    },
    {
      "id": 10,
      "start": 66.4,
      "end": 69.51,
      "rubyText": "ふざけた晴[は]れの炎天[えんてん]",
      "translation": "거짓말처럼 맑은 뜨거운 하늘",
      "romaji": "fuzaketa hare no enten"
    },
    {
      "id": 11,
      "start": 69.51,
      "end": 74.16,
      "rubyText": "ただ私[わたし]は酔[よ]いに酔[よ]った振[ふ]り",
      "translation": "그저 나는 취하고 취한 척을 해",
      "romaji": "tada watashi ha yoi ni yotsu ta furi"
    },
    {
      "id": 12,
      "start": 74.16,
      "end": 78.13,
      "rubyText": "雲[くも]が私[わたし]を呼[よ]んでいる",
      "translation": "구름이 나를 부르고 있어",
      "romaji": "kumo ga watashi wo yon deiru"
    },
    {
      "id": 13,
      "start": 78.13,
      "end": 82.3,
      "rubyText": "木々[きぎ]が私[わたし]を呼[よ]んでいる",
      "translation": "나무들이 나를 부르고 있어",
      "romaji": "kigi ga watashi wo yon deiru"
    },
    {
      "id": 14,
      "start": 82.3,
      "end": 85.44,
      "rubyText": "風下[かざしも]からり炎天[えんてん]",
      "translation": "바람이 향하는 곳은 말끔히 갠 뜨거운 하늘",
      "romaji": "kazashimo karari enten"
    },
    {
      "id": 15,
      "start": 85.44,
      "end": 91.65,
      "rubyText": "目眩[めまい]晴[は]れ 薄[うす]い今日[きょう]の月[つき]",
      "translation": "어지러울 만큼 맑은, 희미한 오늘의 달",
      "romaji": "memai hare   usui kyou no tsuki"
    },
    {
      "id": 16,
      "start": 108.22,
      "end": 111.49,
      "rubyText": "すすきの中[なか]に立[た]っている",
      "translation": "참억새 가운데 서 있어",
      "romaji": "susukino nakani tatsu teiru"
    },
    {
      "id": 17,
      "start": 111.49,
      "end": 115.95,
      "rubyText": "ふいに吹[ふ]く青[あお]風[かぜ] 雲[くも]の稜線[りょうせん]",
      "translation": "문득 불어오는 푸른 바람, 구름의 능선",
      "romaji": "fuini fuku ao kaze   kumo no ryousen"
    },
    {
      "id": 18,
      "start": 115.95,
      "end": 120.93,
      "rubyText": "私[わたし]このまま死[し]んでしまいそうだな",
      "translation": "나 이대로 죽어버릴 것 같아",
      "romaji": "watashi konomama shin deshimaisoudana"
    },
    {
      "id": 19,
      "start": 123.9,
      "end": 129.07,
      "rubyText": "風[かぜ]がおもてで呼[よ]んでいる 泣[な]いている",
      "translation": "바람이 밖에서 부르고 있어 울고 있어",
