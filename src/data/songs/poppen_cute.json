{
  "id": "tokyomanaka-poppencute",
  "title": "ポッペンキュート (Poppen Cute)",
  "artist": "東京真中 feat. 重音テト",
  "youtubeId": "XYYq-uSeVwY",
  "thumbnail": "https://img.youtube.com/vi/XYYq-uSeVwY/hqdefault.jpg",
  "duration": 153,
  "lyrics": [
    {
      "id": 1,
      "start": 4.83,
      "end": 5.83,
      "rubyText": "1、2、3、ポン！",
      "translation": "하나, 둘, 셋, 퐁!",
      "romaji": "ichi, ni, san, pon!"
    },
    {
      "id": 2,
      "start": 16.23,
      "end": 18.76,
      "rubyText": "一[ひと]つや二[ふた]つの秘密[ひみつ]や嘘[うそ]くらい",
      "translation": "한두 가지 비밀이나 거짓말 정도는",
      "romaji": "hitotsu ya futatsu no himitsu ya uso kurai"
    },
    {
      "id": 3,
      "start": 18.8,
      "end": 21.53,
      "rubyText": "誰[だれ]にだってあって当[あ]たり前[まえ]じゃんか",
      "translation": "누구에게나 있는 게 당연하잖아",
      "romaji": "dare ni datte atte atarimae jan ka"
    },
    {
      "id": 4,
      "start": 21.53,
      "end": 23.9,
      "rubyText": "間抜[まぬ]けも恥[はじ]もちょっとのスパイス",
      "translation": "어설픔도 부끄러움도 약간의 스파이스",
      "romaji": "manuke mo haji mo chotto no supaisu"
    },
    {
      "id": 5,
      "start": 23.93,
      "end": 26.66,
      "rubyText": "全部[ぜんぶ]ぜんぶ飲[の]み込[こ]んでやんよ",
      "translation": "전부 다 삼켜버릴 거야",
      "romaji": "zenbu zenbu nomikonde yan yo"
    },
    {
      "id": 6,
      "start": 26.66,
      "end": 28.56,
      "rubyText": "こっそり泣[な]きべそかいて",
      "translation": "남몰래 울상을 짓고",
      "romaji": "kossori nakibeso kaite"
    },
    {
      "id": 7,
      "start": 28.59,
      "end": 31.29,
      "rubyText": "空回[からまわ]って笑[わら]って疲[つか]れたって",
      "translation": "헛돌고 웃다가 지쳤다 해도",
      "romaji": "karamawatte waratte tsukareta tte"
    },
    {
      "id": 8,
      "start": 31.53,
      "end": 33.99,
      "rubyText": "情[なさ]けないなんてことはないぜ",
      "translation": "한심하다는 생각은 마",
      "romaji": "nasakenai nante koto wa nai ze"
    },
    {
      "id": 9,
      "start": 33.99,
      "end": 36.76,
      "rubyText": "むしろ美[うつく]しいまであるな",
      "translation": "오히려 아름답기까지 하네",
      "romaji": "mushiro utsukushii made aru na"
    },
    {
      "id": 10,
      "start": 36.93,
      "end": 41.69,
      "rubyText": "心[こころ]が叫[さけ]んでる（トンチンカン！アンポンタン！）",
      "translation": "마음이 외치고 있어 (엉뚱이! 얼간이!)",
      "romaji": "kokoro ga sakenderu (tonchinkan! anpontan!)"
    },
    {
      "id": 11,
      "start": 41.69,
      "end": 43.89,
      "rubyText": "はったりかましてこうぜ",
      "translation": "허세 좀 부리면서 가보자고",
      "romaji": "hattari kamashite kou ze"
    },
    {
      "id": 12,
      "start": 43.89,
      "end": 48.69,
      "rubyText": "世界[せかい]の中心[ちゅうしん]はここだ（面白[おもしろ]くなってきた～！）",
      "translation": "세상의 중심은 여기야 (재미있어지는데~!)",
      "romaji": "sekai no chuushin wa koko da (omoshiroku natte kita~!)"
    },
    {
      "id": 13,
      "start": 48.69,
      "end": 51.79,
      "rubyText": "パピプ Pop & Cute な嘘[うそ]を重[かさ]ねて",
      "translation": "파피푸 Pop & Cute한 거짓말을 쌓아서",
      "romaji": "papipu Pop & Cute na uso o kasanete"
    },
    {
      "id": 14,
      "start": 51.79,
      "end": 54.09,
      "rubyText": "トンチンカンなエンターテイナー",
      "translation": "엉뚱하기 짝이 없는 엔터테이너",
      "romaji": "tonchinkan na entaateinā"
    },
    {
      "id": 15,
      "start": 54.09,
      "end": 56.82,
      "rubyText": "騙[だま]されたふりでいいからさ（ポン！）",
      "translation": "속아주는 척이라도 좋으니까 (퐁!)",
      "romaji": "damasareta furi de ii kara sa (pon!)"
    },
    {
      "id": 16,
      "start": 56.82,
      "end": 59.02,
      "rubyText": "とりあえず付[つ]いてこい（OK？）",
      "translation": "일단 나를 따라와 (OK?)",
      "romaji": "toriaezu tsuite koi (OK?)"
    },
    {
      "id": 17,
      "start": 59.02,
      "end": 61.89,
      "rubyText": "パピプ Pop & Cute なリズムに乗[の]せて",
      "translation": "파피푸 Pop & Cute한 리듬에 맞춰서",
      "romaji": "papipu Pop & Cute na rizumu ni nosete"
    },
    {
      "id": 18,
      "start": 61.89,
      "end": 64.19,
      "rubyText": "アンポンタンなヒットメイカー",
      "translation": "얼빠진 히트 메이커",
      "romaji": "anpontan na hitto meikā"
    },
    {
      "id": 19,
      "start": 64.19,
      "end": 68.95,
      "rubyText": "笑[わら]われるくらいなんてことないさ",
      "translation": "비웃음을 산대도 아무렇지도 않아",
      "romaji": "warawareru kurai nante koto nai sa"
    },
    {
      "id": 20,
      "start": 69.59,
      "end": 71.49,
      "rubyText": "誰[だれ]かのためじゃなくていい",
      "translation": "꼭 누군가를 위해서가 아니어도 돼",
      "romaji": "dareka no tame ja nakute ii"
    },
    {
      "id": 21,
      "start": 71.49,
      "end": 74.39,
      "rubyText": "自分勝手[じぶんかって]になって描[えが]いたって",
      "translation": "제멋대로 그려낸다 할지라도",
      "romaji": "jibun katte ni natte egaita tte"
    },
    {
      "id": 22,
      "start": 74.39,
      "end": 76.69,
      "rubyText": "優[やさ]しさがあれば届[とど]くもんよ",
      "translation": "다정함이 있다면 전해질 거야",
      "romaji": "yasashisa ga areba todoku mon yo"
    },
    {
      "id": 23,
      "start": 76.69,
      "end": 79.69,
      "rubyText": "おまけにちょっとのユーモア交[まじ]えて",
      "translation": "덤으로 약간의 유머까지 섞어서",
      "romaji": "omake ni chotto no yūmoa majiete"
    },
    {
      "id": 24,
      "start": 79.69,
      "end": 81.69,
      "rubyText": "楽[たの]しいことばっかじゃない",
      "translation": "즐거운 일만 있는 건 아냐",
      "romaji": "tanoshii koto bakka ja nai"
    },
    {
      "id": 25,
      "start": 81.69,
      "end": 84.02,
      "rubyText": "けど逆[ぎゃく]もまた然[しか]りね",
      "translation": "하지만 그 반대도 마찬가지지",
      "romaji": "kedo gyaku mo mata shikari ne"
    },
    {
      "id": 26,
      "start": 84.02,
      "end": 86.45,
      "rubyText": "とにかく問題[もんだい]ない関係[かんけい]ない",
      "translation": "아무튼 문제없어 상관없어",
      "romaji": "tonikaku mondai nai kankei nai"
    },
    {
      "id": 27,
      "start": 86.45,
      "end": 89.32,
      "rubyText": "だって人生[じんせい]は文化祭[ぶんかさい]",
      "translation": "왜냐하면 인생은 축제니까",
      "romaji": "datte jinsei wa bunkasai"
    },
    {
      "id": 28,
      "start": 89.32,
      "end": 92.08,
      "rubyText": "パピプ Pop & Cute な嘘[うそ]を重[かさ]ねて",
      "translation": "파피푸 Pop & Cute한 거짓말을 쌓아서",
      "romaji": "papipu Pop & Cute na uso o kasanete"
    },
    {
      "id": 29,
      "start": 92.08,
      "end": 94.48,
      "rubyText": "トンチンカンなエンターテイナー",
      "translation": "엉뚱하기 짝이 없는 엔터테이너",
      "romaji": "tonchinkan na entaateinā"
    },
    {
      "id": 30,
      "start": 94.48,
      "end": 97.18,
      "rubyText": "あいつが笑[わら]ったその夢[ゆめ]も（ポン！）",
      "translation": "그 녀석이 비웃었던 그 꿈도 (퐁!)",
      "romaji": "aitsu ga waratta sono yume mo (pon!)"
    },
    {
      "id": 31,
      "start": 97.18,
      "end": 99.31,
      "rubyText": "本当[ほんとう]になんだぜ？（OK？）",
      "translation": "정말로 이뤄질 거야! (OK?)",
      "romaji": "hontou ni nan daze? (OK?)"
    },
    {
