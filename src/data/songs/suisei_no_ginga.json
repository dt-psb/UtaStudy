{
  "id": "suisei_no_ginga",
  "title": "彗星ノ銀河",
  "artist": "マツシタレオ feat. 初音ミク",
  "youtubeId": "HDwPGObRmXE",
  "thumbnail": "https://i.ytimg.com/vi/HDwPGObRmXE/maxresdefault.jpg",
  "lyrics": [
    {
      "id": 1,
      "start": 1.948,
      "end": 6.527,
      "rubyText": "\"彗星[すいせい]ノ銀河[ぎんが]\"",
      "translation": "“혜성의 은하”",
      "romaji": "“suisei no ginga”"
    },
    {
      "id": 2,
      "start": 6.527,
      "end": 12.058,
      "rubyText": "歌唱[かしょう]: 初音[はつね]ミク 音楽[おんがく]/映像[えいぞう]: マツシタレオ",
      "translation": "가창: 하츠네 미쿠 음악/영상: 마츠시타 레오",
      "romaji": "kashou: hatsune miku ongaku/eizou: matsushita reo"
    },
    {
      "id": 3,
      "start": 12.058,
      "end": 17.718,
      "rubyText": "旅[たび]に出[で]て何度目[なんどめ]かの惑星[マチ]",
      "translation": "여행을 떠나 몇 번째인지 모를 행성",
      "romaji": "tabi ni dete nando me ka no machi"
    },
    {
      "id": 4,
      "start": 17.718,
      "end": 23.286,
      "rubyText": "明星[みょうじょう]が僕[ぼく]らの未知[みち]を照[て]らした",
      "translation": "샛별이 우리의 미지의 길을 비추었어",
      "romaji": "myoujou ga bokura no michi o terashita"
    },
    {
      "id": 5,
      "start": 23.286,
      "end": 28.679,
      "rubyText": "彗星[すいせい]銀河[ぎんが]が迎[むか]える終末[しゅうまつ]を",
      "translation": "혜성 은하가 맞이하는 종말을",
      "romaji": "suisei ginga ga mukaeru shuumatsu o"
    },
    {
      "id": 6,
      "start": 28.679,
      "end": 34.559,
      "rubyText": "止[と]めれる回答[コタエ]は見当[みあ]たらない",
      "translation": "막아낼 해답은 보이지 않아",
      "romaji": "tomereru kotae wa miataranai"
    },
    {
      "id": 7,
      "start": 34.559,
      "end": 38.453,
      "rubyText": "今日[きょう]はここで休[やす]もう",
      "translation": "오늘은 여기서 쉬자",
      "romaji": "kyou wa koko de yasumou"
    },
    {
      "id": 8,
      "start": 38.453,
      "end": 44.833,
      "rubyText": "傷[きず]だらけさ　この宇宙船[フネ]も",
      "translation": "상처투성이야, 이 우주선도",
      "romaji": "kizudarake sa kono fune mo"
    },
    {
      "id": 9,
      "start": 44.833,
      "end": 48.179,
      "rubyText": "今更[いまさら]何[なに]を残[のこ]せるだろうかなんて",
      "translation": "새삼스레 무엇을 남길 수 있을까 라며",
      "romaji": "imasara nani o nokoseru darou ka nante"
    },
    {
      "id": 10,
      "start": 48.179,
      "end": 50.544,
      "rubyText": "悩[なや]んで過[す]ぎた日々[ひび]を",
      "translation": "고민하며 보낸 날들을",
      "romaji": "nayande sugita hibi o"
    },
    {
      "id": 11,
      "start": 50.544,
      "end": 55.79,
      "rubyText": "忘[わす]れさせてくれよ",
      "translation": "잊게 해줘",
      "romaji": "wasuresasete kure yo"
    },
    {
      "id": 12,
      "start": 57.179,
      "end": 62.462,
      "rubyText": "渦巻[うずま]く半径[はんけい]30万[まん]光年[こうねん]を漂[ただよ]い",
      "translation": "소용돌이치는 반지름 30만 광년을 떠돌아",
      "romaji": "uzumaku hankei sanjuuman kounen o tadayoi"
    },
    {
      "id": 13,
      "start": 62.462,
      "end": 67.572,
      "rubyText": "ようやく君[きみ]と出会[であ]ったのに",
      "translation": "겨우 너와 만났는데",
      "romaji": "youyaku kimi to deatta noni"
    },
    {
      "id": 14,
      "start": 67.572,
      "end": 70.199,
      "rubyText": "愛[あい]を確[たし]かめ合[あ]う前[まえ]に",
      "translation": "사랑을 서로 확인하기도 전에",
      "romaji": "ai o tashikameau mae ni"
    },
    {
      "id": 15,
      "start": 70.199,
      "end": 73.485,
      "rubyText": "どうやら僕[ぼく]らはここで",
      "translation": "우리는 왠지 여기서",
      "romaji": "douyara bokura wa koko de"
    },
    {
      "id": 16,
      "start": 73.485,
      "end": 76.875,
      "rubyText": "終[お]わってしまう運命[うんめい]らしい",
      "translation": "끝나버릴 운명인가 봐",
      "romaji": "owatteshimau unmei rashii"
    },
    {
      "id": 17,
      "start": 76.875,
      "end": 83.894,
      "rubyText": "終末[しゅうまつ]、君[きみ]と銀河[ぎんが]の終[お]わりを待[ま]つ",
      "translation": "종말, 너와 함께 은하의 끝을 기다려",
      "romaji": "shuumatsu, kimi to ginga no owari o matsu"
    },
    {
      "id": 18,
      "start": 91.103,
      "end": 93.316,
      "rubyText": "君[きみ]の泪[なみだ]を拭[ふ]きたかった",
      "translation": "너의 눈물을 닦아주고 싶었어",
      "romaji": "kimi no namida o fukitakatta"
    },
    {
      "id": 19,
      "start": 93.316,
      "end": 96.429,
      "rubyText": "これがきっと最後[さいご]だと",
      "translation": "이것이 분명 마지막이라고",
      "romaji": "kore ga kitto saigo da to"
    },
    {
      "id": 20,
      "start": 96.429,
      "end": 98.844,
      "rubyText": "話[はな]す会話[かいわ]で約束[やくそく]をした",
      "translation": "나누는 대화 속에서 약속을 했어",
      "romaji": "hanasu kaiwa de yakusoku o shita"
    },
    {
      "id": 21,
      "start": 99.548,
      "end": 101.495,
      "rubyText": "\"それじゃ、またどこかで\"",
      "translation": "“그럼, 또 어디선가에서”",
      "romaji": "“sore ja, mata dokoka de”"
    },
    {
      "id": 22,
      "start": 102.356,
      "end": 104.557,
      "rubyText": "夏休[なつやす]み飛[と]ばしてみたロケット",
      "translation": "여름방학 때 날려보았던 로켓",
      "romaji": "natsuyasumi tobashite mita roketto"
    },
    {
      "id": 23,
      "start": 104.557,
      "end": 107.576,
      "rubyText": "四季[しき]が巡[めぐ]り変[か]わりゆく地球[コキョウ]を",
      "translation": "사계절이 돌며 변해가는 고향(지구)을",
      "romaji": "shiki ga meguri kawariyuku kokyou o"
    },
    {
      "id": 24,
      "start": 107.576,
      "end": 110.147,
      "rubyText": "僕[ぼく]は思[おも]い出[だ]して",
      "translation": "나는 떠올리며",
      "romaji": "boku wa omoidashite"
    },
    {
      "id": 25,
      "start": 110.147,
      "end": 116.57,
      "rubyText": "好[す]きな音楽[おんがく]をかけた",
      "translation": "좋아하는 음악을 틀었어",
      "romaji": "suki na ongaku o kaketa"
    },
    {
      "id": 26,
      "start": 141.754,
      "end": 147.181,
      "rubyText": "渦巻[うずま]く半径[はんけい]30万[まん]光年[こうねん]を漂[ただよ]い",
