      "end": 133.552,
      "rubyText": "世界[せかい]を"
    },
    {
      "id": 41,
      "startTime": 133.552,
      "endTime": 136.31,
      "text": "いつまでもこの祈[いの]りが",
      "translation": "언제까지나 이 기도가",
      "start": 133.552,
      "end": 136.31,
      "rubyText": "いつまでもこの祈[いの]りが"
    },
    {
      "id": 42,
      "startTime": 136.31,
      "endTime": 139.31,
      "text": "光[ひか]る軌跡[きせき]残[のこ]すのさ",
      "translation": "빛나는 궤적을 남기는 거야",
      "start": 136.31,
      "end": 139.31,
      "rubyText": "光[ひか]る軌跡[きせき]残[のこ]すのさ"
