  "lyrics": [
    {
      "id": 1,
      "startTime": 0.586,
      "endTime": 3.552,
      "text": "目覚[めざ]めれば窓[まど]に散[ち]らばる",
      "translation": "눈을 뜨면 창가에 흩어져 있는",
      "start": 0.586,
      "end": 3.552,
      "rubyText": "目覚[めざ]めれば窓[まど]に散[ち]らばる"
    },
    {
      "id": 2,
      "startTime": 3.552,
      "endTime": 5.828,
      "text": "書[か]きかけのストーリー",
      "translation": "쓰다 만 스토리",
      "start": 3.552,
      "end": 5.828,
      "rubyText": "書[か]きかけのストーリー"
    },
    {
      "id": 3,
      "startTime": 5.828,
      "endTime": 8.552,
      "text": "どれもまだ足[た]りない足[た]りないってさ",
      "translation": "무엇이든 아직 부족해 부족해라며",
      "start": 5.828,
      "end": 8.552,
      "rubyText": "どれもまだ足[た]りない足[た]りないってさ"
    },
    {
      "id": 4,
      "startTime": 8.552,
      "endTime": 10.966,
      "text": "掃[は]き捨[す]ててしまった想[おも]いだ",
      "translation": "쓸어 버린 마음이야",
      "start": 8.552,
      "end": 10.966,
      "rubyText": "掃[は]き捨[す]ててしまった想[おも]いだ"
    },
    {
      "id": 5,
      "startTime": 10.966,
      "endTime": 13.862,
      "text": "気[き]がつけば幾[いく]つの日々[ひび]を",
      "translation": "정신 차리고 보니 얼마나의 나날을",
      "start": 10.966,
      "end": 13.862,
      "rubyText": "気[き]がつけば幾[いく]つの日々[ひび]を"
    },
    {
      "id": 6,
      "startTime": 13.862,
      "endTime": 16.034,
      "text": "見過[みす]ごしてきたんだろう",
      "translation": "놓쳐 온 걸까",
      "start": 13.862,
      "end": 16.034,
      "rubyText": "見過[みす]ごしてきたんだろう"
    },
    {
      "id": 7,
      "startTime": 16.034,
      "endTime": 18.759,
      "text": "でもそれはお終[しま]いお終[しま]いだよ",
      "translation": "하지만 그건 끝 끝이야",
      "start": 16.034,
      "end": 18.759,
      "rubyText": "でもそれはお終[しま]いお終[しま]いだよ"
    },
    {
      "id": 8,
      "startTime": 18.759,
      "endTime": 21.897,
      "text": "そんな空[そら]へ響[ひび]くアリア",
      "translation": "그런 하늘에 울려 퍼지는 아리아",
      "start": 18.759,
      "end": 21.897,
      "rubyText": "そんな空[そら]へ響[ひび]くアリア"
    },
    {
      "id": 9,
      "startTime": 23.069,
      "endTime": 25.655,
      "text": "次元[じげん]さえも超[こ]えて",
      "translation": "차원조차도 넘어서",
      "start": 23.069,
      "end": 25.655,
      "rubyText": "次元[じげん]さえも超[こ]えて"
    },
    {
      "id": 10,
      "startTime": 25.655,
      "endTime": 28.069,
      "text": "今[いま] 手[て]を伸[の]ばそう",
      "translation": "지금 손을 뻗자",
      "start": 25.655,
      "end": 28.069,
      "rubyText": "今[いま] 手[て]を伸[の]ばそう"
    },
    {
      "id": 11,
      "startTime": 28.069,
      "endTime": 33.483,
      "text": "継[つ]ぎ接[は]ぎの言葉[ことば]で",
      "translation": "기워 붙인 말로",
      "start": 28.069,
      "end": 33.483,
      "rubyText": "継[つ]ぎ接[は]ぎの言葉[ことば]で"
    },
    {
      "id": 12,
      "startTime": 34.793,
      "endTime": 37.793,
      "text": "さあ迎[むか]えに行[い]こう未来[みらい]を",
      "translation": "자 데리러 가자 미래를",
      "start": 34.793,
      "end": 37.793,
      "rubyText": "さあ迎[むか]えに行[い]こう未来[みらい]を"
    },
    {
      "id": 13,
      "startTime": 37.793,
      "endTime": 39.241,
      "text": "未来[みらい]を",
      "translation": "미래를!",
      "start": 37.793,
      "end": 39.241,
      "rubyText": "未来[みらい]を"
    },
    {
      "id": 14,
      "startTime": 39.241,
      "endTime": 42.103,
      "text": "目[め]の前[まえ]の「あと一歩[いっぽ]」で",
      "translation": "눈앞의 ‘앞으로 한 걸음’으로",
      "start": 39.241,
      "end": 42.103,
      "rubyText": "目[め]の前[まえ]の「あと一歩[いっぽ]」で"
    },
    {
      "id": 15,
      "startTime": 42.103,
      "endTime": 45.103,
      "text": "続[つづ]く夢[ゆめ]が見[み]えるかい（La La La La）",
      "translation": "이어지는 꿈이 보이니",
      "start": 42.103,
      "end": 45.103,
      "rubyText": "続[つづ]く夢[ゆめ]が見[み]えるかい（La La La La）"
    },
    {
      "id": 16,
      "startTime": 45.103,
      "endTime": 48.103,
      "text": "かけがえのない出会[であ]いを",
      "translation": "무엇과도 바꿀 수 없는 만남을",
      "start": 45.103,
      "end": 48.103,
      "rubyText": "かけがえのない出会[であ]いを"
    },
    {
      "id": 17,
      "startTime": 48.103,
      "endTime": 49.621,
      "text": "出会[であ]いを",
      "translation": "만남을!",
      "start": 48.103,
      "end": 49.621,
      "rubyText": "出会[であ]いを"
    },
    {
      "id": 18,
      "startTime": 49.621,
      "endTime": 52.448,
      "text": "いつか巡[めぐ]り合[あ]う答[こた]えが",
      "translation": "언젠가 다시 만날 대답이",
      "start": 49.621,
      "end": 52.448,
      "rubyText": "いつか巡[めぐ]り合[あ]う答[こた]えが"
    },
    {
      "id": 19,
      "startTime": 52.448,
      "endTime": 55.379,
      "text": "その奇跡[きせき]を起[お]こすのさ",
      "translation": "그 기적을 일으키는 거야",
      "start": 52.448,
      "end": 55.379,
      "rubyText": "その奇跡[きせき]を起[お]こすのさ"
    },
    {
      "id": 20,
      "startTime": 55.379,
      "endTime": 65.241,
      "text": "君[きみ]に贈[おく]る未来[みらい]",
      "translation": "네게 선사하는 미래",
      "start": 55.379,
      "end": 65.241,
      "rubyText": "君[きみ]に贈[おく]る未来[みらい]"
    },
    {
      "id": 21,
      "startTime": 65.759,
      "endTime": 67.828,
      "text": "暗[くら]い夜[よる]が怖[こわ]くたって",
      "translation": "어두운 밤이 무서워서",
      "start": 65.759,
      "end": 67.828,
      "rubyText": "暗[くら]い夜[よる]が怖[こわ]くたって"
    },
    {
      "id": 22,
      "startTime": 67.828,
      "endTime": 70.483,
      "text": "グシャグシャの心[こころ]塞[ふさ]いだって",
      "translation": "엉망진창인 마음이 가로막혀도",
      "start": 67.828,
      "end": 70.483,
      "rubyText": "グシャグシャの心[こころ]塞[ふさ]いだって"
    },
    {
      "id": 23,
      "startTime": 70.483,
      "endTime": 72.897,
      "text": "私[わたし]たちはいつだって歌[うた]おう",
      "translation": "우리들은 언제나 노래하자",
      "start": 70.483,
      "end": 72.897,
      "rubyText": "私[わたし]たちはいつだって歌[うた]おう"
    },
    {
      "id": 24,
      "startTime": 72.897,
      "endTime": 76.034,
      "text": "君[きみ]が君[きみ]でいられるように叫[さけ]ぶんだ",
      "translation": "네가 너로 있을 수 있도록 외치는 거야",
      "start": 72.897,
      "end": 76.034,
      "rubyText": "君[きみ]が君[きみ]でいられるように叫[さけ]ぶんだ"
    },
    {
      "id": 25,
      "startTime": 76.034,
      "endTime": 79.034,
      "text": "そう何回[なんかい]もそう何回[なんかい]も",
      "translation": "그래 몇 번이나 그래 몇 번이나",
      "start": 76.034,
      "end": 79.034,
      "rubyText": "そう何回[なんかい]もそう何回[なんかい]も"
    },
    {
      "id": 26,
      "startTime": 79.034,
      "endTime": 81.655,
      "text": "何回[なんかい]でも奏[かな]でていくんだ",
      "translation": "몇 번이나 연주해 나가는 거야",
      "start": 79.034,
      "end": 81.655,
      "rubyText": "何回[なんかい]でも奏[かな]でていくんだ"
    },
    {
      "id": 27,
      "startTime": 81.655,
      "endTime": 82.759,
      "text": "いえないいらない",
      "translation": "말할 수 없는 필요 없는",
      "start": 81.655,
      "end": 82.759,
      "rubyText": "いえないいらない"
    },
    {
      "id": 28,
      "startTime": 82.759,
      "endTime": 84.034,
      "text": "しらないこと",
      "translation": "모르는 것",
      "start": 82.759,
      "end": 84.034,
      "rubyText": "しらないこと"
    },
    {
      "id": 29,
      "startTime": 84.034,
      "endTime": 90.862,
      "text": "衝動[しょうどう]を声[こえ]に乗[の]せて",
      "translation": "충동을 목소리에 실어서",
      "start": 84.034,
      "end": 90.862,
      "rubyText": "衝動[しょうどう]を声[こえ]に乗[の]せて"
    },
    {
      "id": 30,
      "startTime": 90.862,
      "endTime": 96.069,
      "text": "愛[あい]を",
      "translation": "사랑을",
      "start": 90.862,
      "end": 96.069,
      "rubyText": "愛[あい]を"
    },
    {
      "id": 31,
      "startTime": 96.069,
      "endTime": 101.862,
      "text": "愛[あい]を",
      "translation": "사랑을",
      "start": 96.069,
      "end": 101.862,
      "rubyText": "愛[あい]を"
    },
    {
      "id": 32,
      "startTime": 108.207,
      "endTime": 112.448,
      "text": "宿[やど]した願[ねが]い気[き]づいて気[き]づいて",
      "translation": "품은 소원 알아차려줘 알아차려줘",
      "start": 108.207,
      "end": 112.448,
      "rubyText": "宿[やど]した願[ねが]い気[き]づいて気[き]づいて"
    },
    {
      "id": 33,
      "startTime": 112.448,
      "endTime": 115.586,
      "text": "君[きみ]は君[きみ]が思[おも]うより",
      "translation": "너는 네가 생각한 만큼",
      "start": 112.448,
      "end": 115.586,
      "rubyText": "君[きみ]は君[きみ]が思[おも]うより"
    },
    {
      "id": 34,
      "startTime": 115.586,
      "endTime": 118.724,
      "text": "無力[むりょく]じゃないってこと",
      "translation": "무력하지 않다는 것",
      "start": 115.586,
      "end": 118.724,
      "rubyText": "無力[むりょく]じゃないってこと"
    },
    {
      "id": 35,
      "startTime": 118.724,
      "endTime": 121.724,
      "text": "さあ踏[ふ]み出[だ]そう未来[みらい]へ",
      "translation": "자 내딛자 미래로",
      "start": 118.724,
      "end": 121.724,
      "rubyText": "さあ踏[ふ]み出[だ]そう未来[みらい]へ"
    },
    {
      "id": 36,
      "startTime": 121.724,
      "endTime": 123.172,
      "text": "未来[みらい]へ",
      "translation": "미래로!",
      "start": 121.724,
      "end": 123.172,
      "rubyText": "未来[みらい]へ"
    },
    {
      "id": 37,
      "startTime": 123.172,
      "endTime": 126.0,
      "text": "繰[く]り返[かえ]したその一歩[いっぽ]で",
      "translation": "반복한 그 한 걸음으로",
      "start": 123.172,
      "end": 126.0,
      "rubyText": "繰[く]り返[かえ]したその一歩[いっぽ]で"
    },
    {
      "id": 38,
      "startTime": 126.0,
      "endTime": 129.034,
      "text": "綴[つづ]る夢[ゆめ]が見[み]たいのさ（La La La La）",
      "translation": "자아내는 꿈이 보고 싶은 거야",
      "start": 126.0,
      "end": 129.034,
      "rubyText": "綴[つづ]る夢[ゆめ]が見[み]たいのさ（La La La La）"
    },
    {
      "id": 39,
      "startTime": 129.034,
      "endTime": 132.034,
      "text": "終[お]わることない世界[せかい]を",
      "translation": "끝나는 일 없는 세계를",
      "start": 129.034,
      "end": 132.034,
      "rubyText": "終[お]わることない世界[せかい]を"
