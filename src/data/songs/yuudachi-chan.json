{
  "id": "yuudachi-chan",
  "title": "夕立ちゃん",
  "artist": "雨の介 feat. flower",
  "youtubeId": "uCR3no1sKpI",
  "thumbnail": "https://img.youtube.com/vi/uCR3no1sKpI/hqdefault.jpg",
  "duration": 174,
  "lyrics": [
    {
      "id": 1,
      "start": 15.2,
      "end": 18.07,
      "rubyText": "隣街[となりまち]に住[す]む夕[ゆう]ちゃんは",
      "translation": "이웃 마을에 사는 유우 쨩은",
      "romaji": "tonarimachi ni sumu Yū-chan wa"
    },
    {
      "id": 2,
      "start": 18.2,
      "end": 21.0,
      "rubyText": "クラスじゃちょっと変[か]わってた",
      "translation": "반에서 조금 별났어",
      "romaji": "kurasu ja chotto kawatteta"
    },
    {
      "id": 3,
      "start": 21.0,
      "end": 24.54,
      "rubyText": "無邪気[むじゃき]にノートを写[うつ]させて",
      "translation": "순진하게 노트를 베끼게 해 줘서",
      "romaji": "mujaki ni nōto o utsusasete"
    },
    {
      "id": 4,
      "start": 24.54,
      "end": 26.24,
      "rubyText": "人気者[にんきもの]でした",
      "translation": "인기인이었습니다",
      "romaji": "ninkimono deshita"
    },
    {
      "id": 5,
      "start": 27.41,
      "end": 30.41,
      "rubyText": "いじめられっ子[こ]のA子[こ]ちゃんを",
      "translation": "괴롭힘을 당하던 A 쨩을",
      "romaji": "ijimerarekko no Ē-ko-chan o"
    },
    {
      "id": 6,
      "start": 30.61,
      "end": 33.35,
      "rubyText": "お洒落[しゃれ]な傘[かさ]に誘[さそ]ったら",
      "translation": "멋진 우산으로 초대했다가",
      "romaji": "oshare na kasa ni sasottara"
    },
    {
      "id": 7,
      "start": 33.62,
      "end": 37.42,
      "rubyText": "大好[だいす]きなバッグが濡[ぬ]れて上[うわ]の空[そら]...",
      "translation": "정말 좋아하는 가방이 젖어서 어리둥절...",
      "romaji": "daisuki na baggu ga nurete uwanosora..."
    },
    {
      "id": 8,
      "start": 37.42,
      "end": 39.26,
      "rubyText": "トゥララ...",
      "translation": "투라라...",
      "romaji": "turara..."
    },
    {
      "id": 9,
      "start": 40.46,
      "end": 44.49,
      "rubyText": "想[おも]えばぽっとしちゃいそうな 君[きみ]がひゅるりらりら",
      "translation": "생각하면 얼굴이 붉어져 버릴 것 같은 네가 휴루리라리라",
      "romaji": "omoeba potto shichai sō na kimi ga hyururirarira"
    },
    {
      "id": 10,
      "start": 44.49,
      "end": 47.97,
      "rubyText": "風[かぜ]に消[き]えたようなこの頃[ごろ]よ",
      "translation": "바람에 사라진 것 같은 요즘이야",
      "romaji": "kaze ni kieta yō na konogoro yo"
    },
    {
      "id": 11,
      "start": 47.97,
      "end": 49.5,
      "rubyText": "夢[ゆめ]に見[み]るの",
      "translation": "꿈에서 보는 것을",
      "romaji": "yume ni miru no"
    },
    {
      "id": 12,
      "start": 49.5,
      "end": 51.23,
      "rubyText": "怯[おび]えていたの",
      "translation": "무서워하고 있었어",
      "romaji": "obiete ita no"
    },
    {
      "id": 13,
      "start": 52.04,
      "end": 55.14,
      "rubyText": "嗚呼[ああ]、阿呆[あほう]みたいなJokeで狂[くる]っちゃうな",
      "translation": "아아 바보 같은 Joke로 미쳐버릴 것 같은",
      "romaji": "ā, ahō mitai na Joke de kurucchau na"
    },
    {
      "id": 14,
      "start": 55.14,
      "end": 56.91,
      "rubyText": "雨[あめ]...ケセラセラセラ",
      "translation": "비... 케 세라 세라 세라",
      "romaji": "ame... keseraserasera"
    },
    {
      "id": 15,
      "start": 56.91,
      "end": 58.71,
      "rubyText": "たまにせつないわ",
      "translation": "가끔은 애달파",
      "romaji": "tama ni setsunai wa"
    },
    {
      "id": 16,
      "start": 58.71,
      "end": 61.38,
      "rubyText": "君[きみ]が好[す]きだよ夕立[ゆうだち]ちゃん",
      "translation": "너를 좋아해 소나기 쨩",
      "romaji": "kimi ga suki da yo yūdachi-chan"
    },
    {
      "id": 17,
      "start": 61.38,
      "end": 64.18,
      "rubyText": "夕立[ゆうだち]ちゃん...",
      "translation": "소나기 쨩...",
      "romaji": "yūdachi-chan..."
    },
    {
      "id": 18,
      "start": 77.06,
      "end": 79.96,
      "rubyText": "ある日[ひ]、越[こ]して行[い]った夕[ゆう]ちゃんの",
      "translation": "어느 날, 이사 간 유우 쨩의",
      "romaji": "aru hi, koshite itta Yū-chan no"
    },
    {
      "id": 19,
      "start": 80.06,
      "end": 82.9,
      "rubyText": "席[せき]が窓辺[まどべ]に変[か]わってた",
      "translation": "자리가 창가로 바뀌었어",
      "romaji": "seki ga madobe ni kawatteta"
    },
    {
      "id": 20,
      "start": 83.07,
      "end": 84.84,
      "rubyText": "今[いま]、登下校[とうげこう]のチャイムに",
      "translation": "지금, 등하교 벨 소리에",
      "romaji": "ima, tōgekō no chaimu ni"
    },
    {
      "id": 21,
      "start": 84.84,
      "end": 86.44,
      "rubyText": "愛[あい]が憑依[ひょうい]しそうな",
      "translation": "사랑이 빙의할 것 같은",
      "romaji": "ai ga hyōi shisō na"
    },
    {
      "id": 22,
      "start": 86.44,
      "end": 88.74,
      "rubyText": "慣[な]れた君[きみ]の声[こえ]だ",
      "translation": "익숙한 너의 목소리다",
      "romaji": "nareta kimi no koe da"
    },
    {
      "id": 23,
      "start": 89.97,
      "end": 94.04,
      "rubyText": "手[て]と手[て]がフワってなっちゃった 日[ひ]からひゅるりらりら",
      "translation": "손과 손이 가볍게 닿아버린 날부터 휴루리라리라",
      "romaji": "te to te ga fuwatte naccatta hi kara hyururirarira"
    },
    {
      "id": 24,
      "start": 94.04,
      "end": 97.58,
      "rubyText": "夜[よ]ふけの朝[あさ]まで惚[ほ]れ惚[ぼ]れよ",
      "translation": "늦은 밤의 아침까지 푹 빠져버렸어",
      "romaji": "yofuke no asa made horebore yo"
    },
    {
      "id": 25,
      "start": 97.58,
      "end": 99.12,
      "rubyText": "見[み]とれちゃうの",
      "translation": "넋을 잃고 바라보게 돼",
      "romaji": "mitorechau no"
    },
    {
      "id": 26,
      "start": 99.12,
      "end": 101.19,
      "rubyText": "忘[わす]れちゃ嫌[いや]だよ",
      "translation": "잊어버리는 건 싫어",
      "romaji": "wasurecha iya da yo"
    },
    {
      "id": 27,
      "start": 101.65,
      "end": 104.62,
      "rubyText": "また夢[ゆめ]からスンと戻[もど]っちゃうな",
      "translation": "또 꿈에서 쌩하고 돌아가버리는",
      "romaji": "mata yume kara sun to modocchau na"
    },
    {
      "id": 28,
      "start": 104.62,
      "end": 106.42,
      "rubyText": "雨[あめ]...ケセラセラセラ",
      "translation": "비... 케 세라 세라 세라",
      "romaji": "ame... keseraserasera"
    },
    {
      "id": 29,
      "start": 106.42,
      "end": 108.22,
      "rubyText": "面影[おもかげ]よぎるわ",
      "translation": "모습이 스쳐지나가",
      "romaji": "omokage yogiru wa"
    },
    {
      "id": 30,
      "start": 108.22,
      "end": 110.83,
      "rubyText": "誰[だれ]と遊[あそ]ぼか夕立[ゆうだち]ちゃん",
      "translation": "누구와 놀까 소나기 쨩",
      "romaji": "dare to asobo ka yūdachi-chan"
    },
    {
      "id": 31,
      "start": 110.96,
      "end": 112.06,
      "rubyText": "夕立[ゆうだち]ちゃん？",
      "translation": "소나기 쨩?",
      "romaji": "yūdachi-chan?"
    },
    {
      "id": 32,
      "start": 127.41,
      "end": 129.85,
      "rubyText": "何処[どこ]かにとんと飛[と]んでった",
      "translation": "어디론가 완전히 날아간",
      "romaji": "doko ka ni tonto tondetta"
    },
    {
      "id": 33,
      "start": 129.85,
      "end": 131.65,
      "rubyText": "命[いのち]カラガラガラ",
      "translation": "목숨에서 달랑달랑",
      "romaji": "inochi karagaragara"
    },
    {
      "id": 34,
      "start": 131.81,
      "end": 133.28,
      "rubyText": "花[はな]の散[ち]るまにまに",
      "translation": "꽃이 지는 대로",
      "romaji": "hana no chiru manimani"
    },
    {
      "id": 35,
      "start": 133.55,
      "end": 135.02,
      "rubyText": "呆気[あっけ]ないの",
      "translation": "싱거운 것은",
      "romaji": "akkenai no"
    },
    {
      "id": 36,
      "start": 135.02,
      "end": 136.55,
      "rubyText": "懲[こ]り懲[ご]りなの",
      "translation": "지긋지긋한 걸",
      "romaji": "korigori na no"
    },
    {
      "id": 37,
      "start": 136.55,
      "end": 139.06,
      "rubyText": "君[きみ]のせいだよ...",
      "translation": "너 때문이야...",
      "romaji": "kimi no sei da yo..."
    },
    {
      "id": 38,
      "start": 139.66,
      "end": 142.33,
      "rubyText": "午後[ごご]から豪雨[ごうう]なあの日[ひ]でした",
      "translation": "오후부터 호우가 내린 그날이었습니다",
      "romaji": "gogo kara gōu na ano hi deshita"
    },
    {
      "id": 39,
      "start": 142.33,
      "end": 145.93,
      "rubyText": "いやいや...わりとせつないわ",
      "translation": "싫어 싫어... 비교적 애달파",
      "romaji": "iyaiya... warito setsunai wa"
    },
    {
      "id": 40,
      "start": 145.93,
      "end": 148.4,
      "rubyText": "誰[だれ]が呼[よ]んだか夕立[ゆうだち]ちゃん",
      "translation": "누가 불렀을까 소나기 쨩",
      "romaji": "dare ga yonda ka yūdachi-chan"
    },
    {
      "id": 41,
      "start": 148.63,
      "end": 151.7,
      "rubyText": "今宵[こよい]、涙色[なみだいろ]の憂鬱[ゆううつ]さ",
      "translation": "오늘 밤, 눈물 빛의 우울함",
      "romaji": "koyoi, namidairo no yūutsu sa"
    },
    {
      "id": 42,
      "start": 151.7,
      "end": 153.04,
      "rubyText": "夕立[ゆうだち]ちゃん...",
      "translation": "소나기 쨩...",
      "romaji": "yūdachi-chan..."
    },
    {
      "id": 43,
      "start": 153.57,
      "end": 155.17,
      "rubyText": "逢[あ]いに行[い]かなくちゃ",
      "translation": "만나러 가야만 해",
      "romaji": "ai ni ikanakucha"
    }
  ],
