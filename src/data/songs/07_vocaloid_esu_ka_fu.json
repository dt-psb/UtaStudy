    {
      "id": 34,
      "start": 137.3,
      "end": 140.17,
      "rubyText": "隠[かく]しきれない咎[とが]でさえぜんぶ",
      "translation": "숨기지 못한 허물조차도 전부",
      "romaji": "kakushikirenai toga de sae zenbu"
    },
    {
      "id": 35,
      "start": 140.17,
      "end": 143.1,
      "rubyText": "今[いま]にも溢[あふ]れる想[おも]いもぜんぶ",
      "translation": "지금이라도 넘쳐흐를 마음도 전부",
