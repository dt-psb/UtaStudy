    {
      "id": 33,
      "start": 134.4,
      "end": 137.3,
      "rubyText": "砕[くだ]けて尖[とが]った心[こころ]もぜんぶ",
      "translation": "부서져 뾰족해진 마음도 전부",
      "romaji": "kudakete togatta kokoro mo zenbu"
