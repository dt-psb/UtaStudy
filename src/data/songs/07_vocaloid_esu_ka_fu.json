      "romaji": "sono yasashisa wo kienu koukai de"
    },
    {
      "id": 28,
      "start": 119.9,
      "end": 122.9,
      "rubyText": "染[そ]めあげてみたい",
      "translation": "물들여보고 싶어",
      "romaji": "someagete mitai"
    },
    {
      "id": 29,
