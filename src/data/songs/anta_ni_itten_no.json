{
  "id": "peenata-anta-ni-itten-no",
  "title": "アンタに言ってんの！！！ (Anta ni Itten no!!!)",
  "artist": "ぴーなた feat. 重音テト",
  "youtubeId": "V4elF7---KQ",
  "thumbnail": "https://img.youtube.com/vi/V4elF7---KQ/hqdefault.jpg",
  "duration": 138,
  "lyrics": [
    {
      "id": 1,
      "start": 1.26,
      "end": 2.97,
      "rubyText": "狂[くる]ってしまったんだ",
      "translation": "미쳐버린 거야",
      "romaji": "kurutte shimattan da"
    },
    {
      "id": 2,
      "start": 2.99,
      "end": 6.49,
      "rubyText": "脳[のう]みそ切[き]り離[はな]して考[かんが]えて？",
      "translation": "머리 좀 비우고 생각해봐?",
      "romaji": "noumiso kirihanashite kangaete?"
    },
    {
      "id": 3,
      "start": 6.5,
      "end": 8.29,
      "rubyText": "痛[いた]いのが冗談[じょうだん]で",
      "translation": "아픈 걸 농담처럼 말하고",
      "romaji": "itai no ga joudan de"
    },
    {
      "id": 4,
      "start": 8.29,
      "end": 11.85,
      "rubyText": "どんな顔[かお]してるかみてみたいね？",
      "translation": "지금 무슨 표정 짓고 있는지 보고 싶네?",
      "romaji": "donna kao shiteru ka mite mitai ne?"
    },
    {
      "id": 5,
      "start": 11.85,
      "end": 13.42,
      "rubyText": "少[すこ]しセンチ",
      "translation": "조금 센치해",
      "romaji": "sukoshi senchi"
    },
    {
      "id": 6,
      "start": 13.43,
      "end": 15.85,
      "rubyText": "キャパもゼロ",
      "translation": "여유도 제로",
      "romaji": "kyapa mo zero"
    },
    {
      "id": 7,
      "start": 15.85,
      "end": 17.42,
      "rubyText": "かき混[ま]ぜていっぱい！",
      "translation": "막 섞어버려 한가득!",
      "romaji": "kakimazete ippai!"
    },
    {
      "id": 8,
      "start": 17.43,
      "end": 21.57,
      "rubyText": "凡[ぼん]ミスなんて平常運転[へいじょううんてん]です",
      "translation": "이 정도 실수는 일상이잖아",
      "romaji": "bonmisu nante heijou unten desu"
    },
    {
      "id": 9,
      "start": 22.96,
      "end": 26.21,
      "rubyText": "アンタに",
      "translation": "너한테, 너한테, 너한테",
      "romaji": "anta ni"
    },
    {
      "id": 10,
      "start": 26.21,
      "end": 28.21,
      "rubyText": "アンタに言[い]ってんの！",
      "translation": "너한테 말하는 거야!",
      "romaji": "anta ni itten no!"
    },
    {
      "id": 11,
      "start": 28.21,
      "end": 29.59,
      "rubyText": "気[き]になっちゃうくらいに",
      "translation": "신경 쓰일 정도로",
      "romaji": "ki ni nacchau kurai ni"
    },
    {
      "id": 12,
      "start": 29.59,
      "end": 30.99,
      "rubyText": "恋愛[れんあい]シュミレーション",
      "translation": "연애 시뮬레이션이네",
      "romaji": "ren'ai shumireeshon"
    },
    {
      "id": 13,
      "start": 31.44,
      "end": 33.63,
      "rubyText": "そんな趣味[しゅみ]とかないけどね",
      "translation": "그런 취미는 없지만 말이야?",
      "romaji": "sonna shumi toka nai kedo ne"
    },
    {
      "id": 14,
      "start": 44.81,
      "end": 46.71,
      "rubyText": "前[まえ]見[み]たってその感[かん]じ(笑[わら])",
      "translation": "아까도 그 느낌이었잖아 (ㅋㅋ)",
      "romaji": "mae mitatte sono kanji (wara)"
    },
    {
      "id": 15,
      "start": 46.71,
      "end": 49.83,
      "rubyText": "わかるって共感[きょうかん]して欲[ほ]しいんでしょ",
      "translation": "알지, 공감해달라는 거잖아",
      "romaji": "wakarutte kyoukan shite hoshiin desho"
    },
    {
      "id": 16,
      "start": 50.05,
      "end": 52.06,
      "rubyText": "つまらない同[おな]じ感[かん]じ",
      "translation": "맨날 똑같고 재미도 없고",
      "romaji": "tsumaranai onaji kanji"
    },
    {
      "id": 17,
      "start": 52.06,
      "end": 54.74,
      "rubyText": "かけて欲[ほ]しい言葉[ことば]用意[ようい]して？",
      "translation": "듣고 싶은 말은 이미 정해놨지?",
      "romaji": "kakete hoshii kotoba youi shite?"
    },
    {
      "id": 18,
      "start": 54.74,
      "end": 57.4,
      "rubyText": "ハイハイそれも私[わたし]のせいですか？",
      "translation": "그래그래 그것도 내 탓이야?",
      "romaji": "haihai sore mo watashi no sei desu ka?"
    },
    {
      "id": 19,
      "start": 57.4,
      "end": 60.14,
      "rubyText": "期待[きたい]してない呆[あき]れちゃってみる",
      "translation": "기대도 안 해서 그냥 어이없네",
      "romaji": "kitai shitenai akirechatte miru"
    },
    {
      "id": 20,
      "start": 60.14,
      "end": 62.72,
      "rubyText": "なんで毎回毎回[まいかいまいかい]同[おな]じ失敗[しっぱい]を",
      "translation": "왜 매번 같은 실수를",
      "romaji": "nande maikai maikai onaji shippai o"
    },
    {
      "id": 21,
      "start": 62.72,
      "end": 66.0,
      "rubyText": "繰[く]り返[かえ]して学[まな]ばない凡人[ぼんじん]さん",
      "translation": "반복하면서도 못 배우는 일반인 씨",
      "romaji": "kurikaeshite manabanai bonjin-san"
    },
    {
      "id": 22,
      "start": 66.0,
      "end": 69.4,
      "rubyText": "アンタに",
      "translation": "너한테, 너한테, 너한테",
      "romaji": "anta ni"
    },
    {
      "id": 23,
      "start": 69.4,
      "end": 71.0,
      "rubyText": "アンタに言[い]ってんの！",
      "translation": "너한테 말하는 거야!",
      "romaji": "anta ni itten no!"
    },
    {
      "id": 24,
      "start": 71.0,
      "end": 74.55,
      "rubyText": "泣[な]いちゃいたいくらいに素敵[すてき]な月[つき]ですね(笑[わら])",
      "translation": "울고 싶어질 만큼 멋진 달이네~ (ㅋㅋ)",
      "romaji": "naichaitai kurai ni suteki na tsuki desu ne (wara)"
    },
    {
      "id": 25,
      "start": 74.55,
      "end": 77.2,
      "rubyText": "嘘[うそ]も方便[ほうべん]って言[い]うからね？",
      "translation": "거짓말도 필요하긴 하다며?",
      "romaji": "uso mo houben tte iu kara ne?"
    },
    {
      "id": 26,
      "start": 77.2,
      "end": 80.62,
      "rubyText": "なんだっけ？思[おも]い出[だ]せないのは",
      "translation": "뭐였더라, 기억이 안 나는 건",
      "romaji": "nandakke? omoidasenai no wa"
    },
    {
      "id": 27,
      "start": 80.62,
      "end": 83.28,
      "rubyText": "形[かたち]型[かた]どるばかり",
      "translation": "겉모습만 흉내 내고",
      "romaji": "katachikatadoru bakari"
    },
    {
      "id": 28,
      "start": 83.28,
      "end": 85.93,
      "rubyText": "アタシを映[うつ]す鏡[かがみ]",
      "translation": "나를 비추는 거울이면서",
      "romaji": "atashi o utsusu kagami"
    },
    {
      "id": 29,
      "start": 85.93,
      "end": 87.68,
      "rubyText": "なんでまだ泣[な]いてんの？",
      "translation": "왜 아직도 울고 있는 거야?",
      "romaji": "nande mada naiten no?"
    },
    {
      "id": 30,
      "start": 87.68,
      "end": 98.34,
      "rubyText": "(だいたい減退[げんたい])",
      "translation": "(대충 점점 식어가는 중)",
      "romaji": "(daitai gentai)"
    },
    {
      "id": 31,
      "start": 98.34,
      "end": 100.48,
      "rubyText": "ポイして　恋[こい]して",
      "translation": "버렸다가, 사랑했다가",
      "romaji": "poi shite koi shite"
    },
    {
      "id": 32,
      "start": 100.48,
      "end": 103.67,
      "rubyText": "それも愛[あい]して　無[な]いしね",
      "translation": "그것도 사실 사랑은 아니고",
      "romaji": "sore mo aishite nai shi ne"
    },
    {
      "id": 33,
      "start": 103.67,
      "end": 105.95,
      "rubyText": "対[たい]して　期待[きたい]して",
      "translation": "그다지 기대해봤자",
      "romaji": "taishite kitai shite"
    },
    {
      "id": 34,
      "start": 105.95,
      "end": 108.66,
      "rubyText": "仕方[しかた]ないしね　どうして？",
      "translation": "어쩔 수 없잖아, 왜지...?",
      "romaji": "shikatanai shi ne doushite?"
    },
    {
      "id": 35,
      "start": 108.66,
      "end": 109.86,
      "rubyText": "全部[ぜんぶ]アンタに",
      "translation": "전부 너한테",
      "romaji": "zembu anta ni"
    },
    {
      "id": 36,
      "start": 109.86,
      "end": 112.49,
      "rubyText": "アンタに",
      "translation": "너한테, 너한테, 너한테",
      "romaji": "anta ni"
    },
    {
      "id": 37,
      "start": 112.49,
      "end": 114.21,
      "rubyText": "アンタに言[い]ってんの！",
      "translation": "너한테 말하는 거야!",
      "romaji": "anta ni itten no!"
    },
    {
      "id": 38,
      "start": 114.21,
      "end": 117.59,
      "rubyText": "釣[つ]り合[あ]わないアンタと私[わたし]でシュミレーション",
      "translation": "어울리지도 않는 너랑 나로 연애 시뮬레이션이라니",
      "romaji": "tsuriawanai anta to watashi de shumireeshon"
    },
    {
      "id": 39,
      "start": 117.59,
      "end": 121.45,
      "rubyText": "そんな趣味[しゅみ]とかマジで一切[いっさい]お断[ことわ]りです！",
      "translation": "그런 취미는 진짜 사양이야!",
      "romaji": "sonna shumi toka maji de issai okotowari desu!"
    },
    {
      "id": 40,
      "start": 122.0,
      "end": 125.17,
      "rubyText": "なんだっけ？思[おも]い出[だ]せないのは",
      "translation": "뭐였더라, 또 기억 안 나네",
      "romaji": "nandakke? omoidasenai no wa"
    },
    {
      "id": 41,
      "start": 125.17,
      "end": 127.78,
      "rubyText": "まだチグハグな二人[ふたり]",
      "translation": "아직도 엇갈린 우리 둘",
      "romaji": "mada chiguhagu na futari"
    },
    {
      "id": 42,
      "start": 127.78,
      "end": 130.56,
      "rubyText": "言[い]えない言葉[ことば]ばかり",
      "translation": "못한 말들만 쌓여가는데",
      "romaji": "ienai kotoba bakari"
    },
    {
      "id": 43,
      "start": 130.56,
      "end": 132.33,
      "rubyText": "なんでまだ泣[な]いてんの",
      "translation": "왜 아직도 울고 있는 거야?",
      "romaji": "nande mada naiten no"
    },
    {
      "id": 44,
      "start": 132.33,
      "end": 132.83,
      "rubyText": "おしまい",
      "translation": "게임 오버",
      "romaji": "oshimai"
    }
  ],
