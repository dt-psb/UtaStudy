{
  "id": "38-rumaki-seebuandoroodo-hatsune-miku-save",
  "title": "セーブアンドロード feat.初音ミク / save and load ft. Hatsune Miku",
  "artist": "rumaki",
  "youtubeId": "Xeq3nRhIczs",
  "thumbnail": "https://img.youtube.com/vi/Xeq3nRhIczs/hqdefault.jpg",
  "duration": 174,
  "lyrics": [
    {
      "id": 1,
      "start": 12.0,
      "end": 15.69,
      "rubyText": "単純明快[たんじゅんめいかい]な 日常[にちじょう]のバカ話[はなし]",
      "translation": "단순명쾌한 일상의 바보 같은 잡담",
      "romaji": "tanjunmeikai na   nichijou no baka hanashi"
    },
    {
      "id": 2,
      "start": 16.26,
      "end": 17.02,
      "rubyText": "そんでもって",
      "translation": "그러고 나서",
      "romaji": "sondemotte"
    },
    {
      "id": 3,
      "start": 17.02,
      "end": 20.56,
      "rubyText": "散々[さんざん]乙[おつ]って 死[し]にゲーで完全[かんぜん]出[で]オチ",
      "translation": "처절하게 패배하고, 데스게임식 완전 시작부터 망했어",
      "romaji": "sanzan'otsutte shini gee dekanzende ochi"
    },
    {
      "id": 4,
      "start": 22.0,
      "end": 24.49,
      "rubyText": "間違[まちが]った返答[へんとう]応答[おうとう]に 抗[あらが]っていたいの１２３",
      "translation": "틀린 답변과 응답에 맞서 버티고 싶어 1 2 3",
      "romaji": "machigatsu ta hentou outou ni   aragatsu teitaino 1 2 3"
    },
    {
      "id": 5,
      "start": 24.49,
      "end": 25.74,
      "rubyText": "ミスった回答[かいとう]リプ欄[らん]に",
      "translation": "실수한 답변, 댓글창에서",
      "romaji": "misu tta kaitou ripu ran ni"
    },
    {
      "id": 6,
      "start": 25.74,
      "end": 26.98,
      "rubyText": "さまっているの私[わたし]だけ…？",
      "translation": "헤매는 건 나뿐인 걸까...?",
      "romaji": "samatteiruno watashi dake … ？"
    },
    {
      "id": 7,
      "start": 27.14,
      "end": 29.54,
      "rubyText": "脳内[のうない]は混沌[こんとん] 滑稽[こっけい]な平和主義[へいわしゅぎ]",
      "translation": "뇌 속은 혼돈, 우스꽝스러운 평화주의",
      "romaji": "nounai ha konton   kokkei na heiwashugi"
    },
    {
      "id": 8,
      "start": 29.54,
      "end": 31.46,
      "rubyText": "散々[さんざん]なエンドロール",
      "translation": "처참한 엔딩 롤",
      "romaji": "sanzan na endorooru"
    },
    {
      "id": 9,
      "start": 31.69,
      "end": 34.22,
      "rubyText": "迷走[めいそう]！まだ まだ 夢見[ゆめみ]させてよ",
      "translation": "폭주! 아직 아직 꿈꾸게 해줘",
      "romaji": "meisou ! mada   mada   yumemi saseteyo"
    },
    {
      "id": 10,
      "start": 34.22,
      "end": 36.42,
      "rubyText": "歪[ひず]んだ理想[りそう]とパラノイア",
      "translation": "비틀린 이상과 파라노이아",
      "romaji": "hizun da risou to paranoia"
    },
    {
      "id": 11,
      "start": 37.16,
      "end": 39.62,
      "rubyText": "選択[せんたく]の選択[せんたく]に惑[まど]わされて",
      "translation": "선택 위의 선택에 휘둘리며",
      "romaji": "sentaku no sentaku ni madowa sarete"
    },
    {
      "id": 12,
      "start": 39.62,
      "end": 41.73,
      "rubyText": "めげない！ しょげない！ そんな訳[わけ]ない！",
      "translation": "안 꺾여! 기 안 죽어! 그럴 리가 없잖아!",
      "romaji": "megenai !   shogenai !   sonna wake nai !"
    },
    {
      "id": 13,
      "start": 42.44,
      "end": 44.3,
      "rubyText": "実像[じつぞう]と虚像[きょぞう]の見分[みわ]けつかない",
      "translation": "실상과 허상을 구분할 수 없어",
      "romaji": "jitsuzou to kyozou no miwake tsukanai"
    },
    {
      "id": 14,
      "start": 44.3,
      "end": 46.62,
      "rubyText": "アナログ帯[たい] ローディングなう",
      "translation": "아날로그 감성, 로딩 중",
      "romaji": "anarogu tai roodingu nau"
    },
    {
      "id": 15,
      "start": 47.18,
      "end": 50.54,
      "rubyText": "ただ癒[い]えない傷[きず]が増[ふ]えていく",
      "translation": "그저 낫지 않는 상처만 늘어가",
      "romaji": "tada ie nai kizu ga fue teiku"
    },
    {
      "id": 16,
      "start": 50.64,
      "end": 52.13,
      "rubyText": "セーブ アンド ロード",
      "translation": "세이브 앤 로드",
      "romaji": "seebu   ando   roodo"
    },
    {
      "id": 17,
      "start": 62.17,
      "end": 63.82,
      "rubyText": "完全[かんぜん]攻略[こうりゃく]です",
      "translation": "완전 공략입니다",
      "romaji": "kanzen kouryaku desu"
    },
    {
      "id": 18,
      "start": 63.82,
      "end": 66.0,
      "rubyText": "フラグ立[た]てたハッピーエンド",
      "translation": "플래그 세운 해피엔딩",
      "romaji": "furagu tate ta happiiendo"
    },
    {
      "id": 19,
      "start": 66.0,
      "end": 67.31,
      "rubyText": "イベント発生[はっせい]！",
      "translation": "이벤트 발생!",
      "romaji": "ibento hassei !"
    },
    {
      "id": 20,
      "start": 67.31,
      "end": 72.0,
      "rubyText": "SSRの感情[かんじょう]に惑[まど]わされないように",
      "translation": "SSR 감정에 휘둘리지 않도록",
      "romaji": "SSR no kanjou ni madowa sarenaiyouni"
    },
    {
      "id": 21,
      "start": 72.25,
      "end": 76.38,
      "rubyText": "将来[しょうらい]正解[せいかい]なテンプレに便乗[びんじょう]してばっか",
      "translation": "장래에 정답일 템플릿에 편승하기만 하고",
      "romaji": "shourai seikai na tenpure ni binjou shitebakka"
    },
    {
      "id": 22,
      "start": 76.38,
      "end": 77.28,
      "rubyText": "BAD MORNING",
      "translation": "BAD MORNING",
      "romaji": "BAD MORNING"
    },
    {
      "id": 23,
      "start": 77.28,
      "end": 80.94,
      "rubyText": "散々[さんざん]乙[おつ]って 死[し]にゲーな完全[かんぜん]出[で]オチ",
      "translation": "처절하게 패배하고, 데스게임식 완전 시작부터 망했어",
      "romaji": "sanzan'otsutte shini gee nakanzende ochi"
    },
    {
      "id": 24,
      "start": 82.39,
      "end": 84.81,
      "rubyText": "冷笑[れいしょう]！？ やだ やだ 先[さき]が見[み]れない",
      "translation": "냉소!? 싫어 싫어 앞이 안 보여",
      "romaji": "reishou ! ？   yada   yada   sakiga mire nai"
    },
    {
      "id": 25,
      "start": 84.81,
      "end": 86.83,
      "rubyText": "膿[う]んだ思想[しそう]とディストピア",
      "translation": "곪아 터진 사상과 디스토피아",
      "romaji": "undashisouto disutopia"
    },
    {
      "id": 26,
      "start": 87.4,
      "end": 89.84,
      "rubyText": "前言[ぜんげん]の撤回[てっかい]に命[いのち]かけて",
      "translation": "앞서 한 말의 철회에 목숨 걸고",
      "romaji": "zengen no tekkai ni inochi kakete"
    },
    {
      "id": 27,
      "start": 89.84,
      "end": 92.08,
      "rubyText": "消[け]したい 変[か]えたい セーブアンドロード！",
      "translation": "지우고 싶어! 바꾸고 싶어! 세이브 앤 로드!",
      "romaji": "keshi tai   kae tai   seebuandoroodo !"
    },
    {
      "id": 28,
      "start": 92.73,
      "end": 94.57,
      "rubyText": "とか言[い]ってみただけでリアルは",
      "translation": "...라고 말해봤을 뿐 현실은",
      "romaji": "toka itte mitadakede riaru ha"
    },
    {
      "id": 29,
      "start": 94.57,
      "end": 96.9,
      "rubyText": "こうもどうにも変[か]わらない",
      "translation": "이렇게도 어찌할 수 없이 변하지 않아",
      "romaji": "koumodounimo kawa ranai"
    },
    {
      "id": 30,
      "start": 97.45,
      "end": 100.76,
      "rubyText": "ただ癒[い]えない傷[きず]をつけている",
      "translation": "그저 낫지 않는 상처만 내고 있어",
      "romaji": "tada ie nai kizu wotsuketeiru"
    },
    {
      "id": 31,
      "start": 112.53,
      "end": 117.49,
      "rubyText": "いろんなゲームのセーブポイント：）",
      "translation": "여러 게임의 세이브 포인트 :)",
      "romaji": "ironna geemu no seebupointo : )"
    },
    {
      "id": 32,
      "start": 117.49,
      "end": 121.28,
      "rubyText": "全部[ぜんぶ]わかったら天才[てんさい]！",
      "translation": "전부 알았다면 천재!",
      "romaji": "zenbu wakattara tensai !"
    },
    {
      "id": 33,
      "start": 122.54,
      "end": 126.89,
      "rubyText": "嫌[きら]い 嫌[きら]いなんてあの子[こ]が言[い]っていたから",
      "translation": "'싫어, 싫어'라고 그 애가 말했으니까",
      "romaji": "kirai   kirai nanteano ko ga itte itakara"
    },
    {
      "id": 34,
      "start": 132.32,
      "end": 137.04,
      "rubyText": "間違[まちが]った選択[せんたく]をしたみたいだ この世界[せかい]は",
      "translation": "잘못된 선택을 한 것 같아, 이 세계는",
      "romaji": "machigatsu ta sentaku woshitamitaida   kono sekai ha"
    },
    {
      "id": 35,
