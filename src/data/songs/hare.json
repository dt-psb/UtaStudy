{
  "id": "lumina-hare",
  "title": "ハレ (Hare / 맑음)",
  "artist": "Project Lumina feat. 知声",
  "youtubeId": "T9eFcn4vKTI",
  "thumbnail": "https://img.youtube.com/vi/T9eFcn4vKTI/hqdefault.jpg",
  "duration": 188,
  "lyrics": [
    {
      "id": 1,
      "start": 18.07,
      "end": 20.76,
      "rubyText": "死[し]んだ土竜[もぐら]を",
      "translation": "죽은 두더쥐를"
    },
    {
      "id": 2,
      "start": 20.76,
      "end": 22.67,
      "rubyText": "端[はし]へ転[ころ]がして",
      "translation": "끝으로 굴리고서"
    },
    {
      "id": 3,
      "start": 22.67,
      "end": 23.91,
      "rubyText": "刹那[せつな]",
      "translation": "그 순간"
    },
    {
      "id": 4,
      "start": 23.91,
      "end": 25.87,
      "rubyText": "影法師[かげぼうし]もさ",
      "translation": "그림자도"
    },
    {
      "id": 5,
      "start": 25.87,
      "end": 28.43,
      "rubyText": "｢虚[むな]しいね｣なんて。",
      "translation": "「허무하네」라더라."
    },
    {
      "id": 6,
      "start": 28.43,
      "end": 30.97,
      "rubyText": "何[なに]を手向[たむ]けに",
      "translation": "헤어지며 무언가 주려"
    },
    {
      "id": 7,
      "start": 30.97,
      "end": 32.98,
      "rubyText": "しても苦[くる]しくて",
      "translation": "해봐도 괴로워서"
    },
    {
      "id": 8,
      "start": 32.98,
      "end": 34.22,
      "rubyText": "刹那[せつな]",
      "translation": "눈 깜짝할 새"
    },
    {
      "id": 9,
      "start": 34.22,
      "end": 35.84,
      "rubyText": "夏[なつ]が",
      "translation": "여름이"
    },
    {
      "id": 10,
      "start": 35.84,
      "end": 37.75,
      "rubyText": "過[す]ぎ去[さ]った気[き]がした",
      "translation": "지나간 듯 했어"
    },
    {
      "id": 11,
      "start": 37.75,
      "end": 38.43,
      "rubyText": "なんて。",
      "translation": "어쩜."
    },
    {
      "id": 12,
      "start": 38.43,
      "end": 39.65,
      "rubyText": "今[いま]踊[おど]るまで",
      "translation": "지금 춤추기까지"
    },
    {
      "id": 13,
      "start": 39.65,
      "end": 41.34,
      "rubyText": "永遠[えいえん]に踊[おど]るまでは",
      "translation": "영원히 춤출 때까지는"
    },
    {
      "id": 14,
      "start": 41.34,
      "end": 43.47,
      "rubyText": "木漏[こも]れ日[び]で。",
      "translation": "비치는 햇살 속에서."
    },
    {
      "id": 15,
      "start": 43.47,
      "end": 46.01,
      "rubyText": "流[なが]れる汗[あせ]すらも",
      "translation": "흐르는 땀조차도"
    },
    {
      "id": 16,
      "start": 46.01,
      "end": 48.71,
      "rubyText": "気[き]にせぬままで。",
      "translation": "신경쓰지 않은 채."
    },
    {
      "id": 17,
      "start": 48.71,
      "end": 49.93,
      "rubyText": "今[いま]歌[うた]うまで",
      "translation": "지금 노래하기까지"
    },
    {
      "id": 18,
      "start": 49.93,
      "end": 51.65,
      "rubyText": "永遠[えいえん]に歌[うた]うまでは",
      "translation": "영원히 노래할 때까지는"
    },
    {
      "id": 19,
      "start": 51.65,
      "end": 53.81,
      "rubyText": "灰色[はいいろ]で。",
      "translation": "잿빛으로."
    },
    {
      "id": 20,
      "start": 53.81,
      "end": 56.22,
      "rubyText": "あなたの口癖[くちぐせ]は",
      "translation": "당신의 말버릇은"
    },
    {
      "id": 21,
      "start": 56.22,
      "end": 57.99,
      "rubyText": "どんなだっけ。",
      "translation": "어땠더라."
    },
    {
      "id": 22,
      "start": 57.99,
      "end": 62.92,
      "rubyText": "その刹那[せつな] その刹那[せつな]",
      "translation": "그 순간"
    },
    {
      "id": 23,
      "start": 62.92,
      "end": 65.5,
      "rubyText": "僕[ぼく]はなんで",
      "translation": "나는 어째서"
    },
    {
      "id": 24,
      "start": 65.5,
      "end": 68.36,
      "rubyText": "涙[なみだ]してるんだろう",
      "translation": "울고 있었던 거지?"
    },
    {
      "id": 25,
      "start": 68.36,
      "end": 70.97,
      "rubyText": "この空[そら]の",
      "translation": "이 하늘의"
    },
    {
      "id": 26,
      "start": 70.97,
      "end": 74.51,
      "rubyText": "この青[あお]さに笑[わら]って",
      "translation": "이 푸르름을 보며 웃으며"
    },
    {
      "id": 27,
      "start": 74.51,
      "end": 78.92,
      "rubyText": "｢いつの日[ひ]でもそばに｣",
      "translation": "「언제든 곁에 있을게」"
    },
    {
      "id": 28,
      "start": 78.92,
      "end": 80.98,
      "rubyText": "なんて。",
      "translation": "라고 말했어."
    },
    {
      "id": 29,
      "start": 101.32,
      "end": 104.2,
      "rubyText": "｢灰色[はいいろ]の空[そら]が流[なが]した涙[なみだ]に",
      "translation": "「잿빛 하늘이 흘린 눈물에"
    },
    {
      "id": 30,
      "start": 104.2,
      "end": 107.61,
      "rubyText": "ほんの少[すこ]しだけ救[すく]われたのかもしれない。",
      "translation": "아주 조금이지만 구원을 받은 걸지도 모른다."
    },
    {
      "id": 31,
      "start": 107.61,
      "end": 109.32,
      "rubyText": "僕[ぼく]らは想[おも]い出[で]になるんだろうか。",
      "translation": "우리는 추억이 될 수 있을까."
    },
    {
      "id": 32,
      "start": 109.32,
      "end": 111.67,
      "rubyText": "僕[ぼく]らは想[おも]い出[で]になるんだろうか。",
      "translation": "우리는 추억이 될 수 있을까."
    },
    {
      "id": 33,
      "start": 111.67,
      "end": 114.58,
      "rubyText": "夏[なつ]を嵐[あらし] 青[あお]を纏[まと]い",
      "translation": "여름을 몰아치고, 푸름을 휘감은 채"
    },
    {
      "id": 34,
      "start": 114.58,
      "end": 116.92,
      "rubyText": "美[うつく]しいままで生[い]きていられない僕[ぼく]らは",
      "translation": "아름다운 그대로 살아갈 수 없는 우리는"
    },
    {
      "id": 35,
      "start": 116.92,
      "end": 118.13,
      "rubyText": "美[うつく]しいままで生[い]きていられない僕[ぼく]らは",
      "translation": "아름다운 그대로 살아갈 수 없는 우리는"
    },
    {
      "id": 36,
      "start": 118.13,
      "end": 120.08,
      "rubyText": "想[おも]い出[で]になるんだろうか。｣",
      "translation": "추억이 될 수 있는 걸까.」"
    },
    {
      "id": 37,
      "start": 120.08,
      "end": 122.35,
      "rubyText": "この過去[かこ]も",
      "translation": "이 과거도"
    },
    {
      "id": 38,
      "start": 122.35,
      "end": 125.16,
      "rubyText": "この日々[ひび]も",
      "translation": "이런 날들도"
    },
    {
      "id": 39,
      "start": 125.16,
      "end": 127.35,
      "rubyText": "いらないよ",
      "translation": "필요 없어"
    },
    {
      "id": 40,
      "start": 127.35,
      "end": 130.31,
      "rubyText": "「涙[なみだ]、捨[す]てるんだ」と",
      "translation": "「눈물은, 버리는 거야」"
    },
    {
      "id": 41,
      "start": 130.31,
      "end": 132.79,
      "rubyText": "この青[あお]も",
      "translation": "이 푸름도"
    },
    {
      "id": 42,
      "start": 132.79,
      "end": 135.16,
      "rubyText": "あの晴[は]れ間[ま]で",
      "translation": "구름 사이로 하늘을 보고"
    },
    {
      "id": 43,
      "start": 135.16,
      "end": 136.44,
      "rubyText": "咲[わら]って",
      "translation": "웃으며"
    },
    {
      "id": 44,
      "start": 136.44,
      "end": 140.4,
      "rubyText": "時[とき]を舞[ま]え この歌[うた]よ",
      "translation": "시간을 날아라, 이 노래여"
    },
    {
      "id": 45,
      "start": 140.4,
      "end": 141.17,
      "rubyText": "その",
      "translation": "그"
    },
    {
      "id": 46,
      "start": 141.17,
      "end": 145.51,
      "rubyText": "刹那[せつな] その刹那[せつな]",
      "translation": "그 순간"
    },
    {
      "id": 47,
      "start": 145.51,
      "end": 148.07,
      "rubyText": "僕[ぼく]はなんで",
      "translation": "나는 어째서"
    },
    {
      "id": 48,
      "start": 148.07,
      "end": 150.92,
      "rubyText": "涙[なみだ]してるんだろう",
      "translation": "울고 있었던 거지?"
    },
    {
      "id": 49,
      "start": 150.92,
      "end": 153.55,
      "rubyText": "この空[そら]の",
      "translation": "이 하늘의"
    },
    {
      "id": 50,
      "start": 153.55,
      "end": 156.99,
      "rubyText": "この青[あお]さへ笑[わら]って",
      "translation": "이 푸르름을 향해 웃어"
    },
    {
      "id": 51,
      "start": 156.99,
      "end": 159.75,
      "rubyText": "いつの日[ひ]でもそばに。",
      "translation": "언제든 곁에 있을게."
    },
    {
      "id": 52,
      "start": 159.75,
      "end": 162.32,
      "rubyText": "いつの日[ひ]も想[おも]い出[だ]せ。",
      "translation": "언제든 떠올려."
    },
    {
      "id": 53,
      "start": 162.32,
      "end": 166.63,
      "rubyText": "いつの日[ひ]でもここに。",
      "translation": "언제든 여기 있을게."
    },
    {
      "id": 54,
      "start": 166.63,
      "end": 169.77,
      "rubyText": "なんて。",
      "translation": "라면서."
    }
  ],
