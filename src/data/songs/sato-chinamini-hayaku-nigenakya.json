      "start": 17.968,
      "end": 19.336,
      "rubyText": "猫[ねこ]なで声[ごえ]で見[み]てくれは×"
    },
    {
      "id": 7,
      "startTime": 19.336,
      "endTime": 20.771,
      "text": "アレ見[み]せられちゃ逃[に]げるのは当然[とうぜん]",
