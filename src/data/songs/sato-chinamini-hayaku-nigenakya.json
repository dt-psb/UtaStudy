      "start": 16.6,
      "end": 17.968,
      "rubyText": "ふと後[うし]ろを振[ふ]り返[かえ]りゃご対面[たいめん]"
    },
    {
      "id": 6,
      "startTime": 17.968,
      "endTime": 19.336,
      "text": "猫[ねこ]なで声[ごえ]で見[み]てくれは×",
