{
  "id": "kanzaki-25ji-no-jounetsu",
  "title": "25時の情熱 (25-ji no Jounetsu)",
  "artist": "カンザキイオリ feat. VOCALOIDS",
  "youtubeId": "RifILHUOV_w",
  "thumbnail": "https://img.youtube.com/vi/RifILHUOV_w/hqdefault.jpg",
  "duration": 252,
  "lyrics": [
    {
      "id": 1,
      "start": 2.13,
      "end": 7.6,
      "rubyText": "いつか消[き]えた駅[えき]のあのホームの記憶[きおく]も",
      "translation": "언젠가 사라진 역 속 그 플랫폼의 기억도",
      "romaji": "itsuka kieta eki no ano hoomu no kioku mo"
    },
    {
      "id": 2,
      "start": 7.6,
      "end": 13.2,
      "rubyText": "熱[あつ]い志[こころざし]で出会[であ]った仲間達[なかまたち]も",
      "translation": "뜨거운 마음가짐으로 만나게 된 동료들도",
      "romaji": "atsui kokorozashi de deatta nakamatachi mo"
    },
    {
      "id": 3,
      "start": 13.2,
      "end": 18.73,
      "rubyText": "いつか海[うみ]になって空[そら]になって人[ひと]になっていく",
      "translation": "어느샌가 바다가 되고 하늘이 되고 사람이 되어가",
      "romaji": "itsuka umi ni natte sora ni natte hito ni natte iku"
    },
    {
      "id": 4,
      "start": 18.73,
      "end": 24.46,
      "rubyText": "25時[にじゅうごじ]の情熱[じょうねつ]も恋[こい]しくなる日[ひ]が来[く]る",
      "translation": "25시의 정열도 그리워질 날이 와",
      "romaji": "nijuugoji no jounetsu mo koishiku naru hi ga kuru"
    },
    {
      "id": 5,
      "start": 35.46,
      "end": 41.13,
      "rubyText": "顔[かお]を押[お]し付[つ]けた傷[きず]だらけの机[つくえ]と",
      "translation": "얼굴을 파묻었던 상처투성이 책상과",
      "romaji": "kao o oshitsuketa kizudarake no tsukue to"
    },
    {
      "id": 6,
      "start": 41.13,
      "end": 46.56,
      "rubyText": "放課後[ほうかご]の香[かお]りとチャイムの冷[つめ]たさと",
      "translation": "방과 후의 향기와 종의 차가움과",
      "romaji": "houkago no kaori to chaimu no tsumetasa to"
    },
    {
      "id": 7,
      "start": 46.56,
      "end": 52.2,
      "rubyText": "愛[あい]の軽[かる]さと悲[かな]しみの重[おも]さと",
      "translation": "사랑의 가벼움과 슬픔의 무거움과",
      "romaji": "ai no karusa to kanashimi no omosa to"
    },
    {
      "id": 8,
      "start": 52.2,
      "end": 58.09,
      "rubyText": "この夜[よる]で僕達[ぼくたち]は出来[でき]ている",
      "translation": "이 밤으로 우리들은 이루어져 있어",
      "romaji": "kono yoru de bokutachi wa dekite iru"
    },
    {
      "id": 9,
      "start": 59.29,
      "end": 62.92,
      "rubyText": "大人[おとな]になったらきっとわかる",
      "translation": "어른이 되면 분명 알게 될 거야",
      "romaji": "otona ni nattara kitto wakaru"
    },
    {
      "id": 10,
      "start": 64.62,
      "end": 68.49,
      "rubyText": "許[ゆる]されていた若[わか]さ",
      "translation": "뭐든지 용서받던 젊음을",
      "romaji": "yurusareteita wakasa"
    },
    {
      "id": 11,
      "start": 70.39,
      "end": 74.01,
      "rubyText": "大人[おとな]になってもきっと縋[すが]る",
      "translation": "어른이 되어도 분명 의지할",
      "romaji": "otona ni nattemo kitto sugaru"
    },
    {
      "id": 12,
      "start": 74.95,
      "end": 79.63,
      "rubyText": "一夜[いちや]の思[おも]い出[で]",
      "translation": "하룻밤의 추억",
      "romaji": "ichiya no omoide"
    },
    {
      "id": 13,
      "start": 80.25,
      "end": 85.55,
      "rubyText": "恋[こい]してる愛[あい]してるこの夜[よる]の歌[うた]も",
      "translation": "사랑하고 사랑하는 이 밤의 노래도",
      "romaji": "koishiteru aishiteru kono yoru no uta mo"
    },
    {
      "id": 14,
      "start": 85.55,
      "end": 91.27,
      "rubyText": "いつか奥底[おくそこ]で燻[くすぶ]る日[ひ]が来[く]るのかな",
      "translation": "언젠가 마음 속에서 맴돌 날이 올까",
      "romaji": "itsuka okusoko de kusuburu hi ga kuru no ka na"
    },
    {
      "id": 15,
      "start": 91.27,
      "end": 96.95,
      "rubyText": "ちゃんと綺麗[きれい]に幸[しあわ]せを愛[あい]せるかな",
      "translation": "제대로 아름답게 행복을 사랑할 수 있을까",
      "romaji": "chanto kirei ni shiawase o aiseru ka na"
    },
    {
      "id": 16,
      "start": 96.95,
      "end": 102.6,
      "rubyText": "ちゃんと綺麗[きれい]に人[ひと]を救[すく]えるかな",
      "translation": "제대로 아름답게 사람을 구해줄 수 있을까",
      "romaji": "chanto kirei ni hito o sukueru ka na"
    },
    {
      "id": 17,
      "start": 124.65,
      "end": 130.15,
      "rubyText": "世界[せかい]が輝[かがや]いていること忘[わす]れないで",
      "translation": "세상이 빛난다는 걸 잊지 말아줘",
      "romaji": "sekai ga kagayaite iru koto wasurenaide"
    },
    {
      "id": 18,
      "start": 130.15,
      "end": 135.72,
      "rubyText": "世界[せかい]が蠢[うごめ]いていること忘[わす]れないで",
      "translation": "세상이 꿈틀댄다는 걸 잊지 말아줘",
      "romaji": "sekai ga ugomeite iru koto wasurenaide"
    },
    {
      "id": 19,
      "start": 135.72,
      "end": 141.45,
      "rubyText": "世界[せかい]に一人[ひとり]じゃないこと忘[わす]れないで",
      "translation": "세상에 혼자 있는 게 아니라는 걸 잊지 말아줘",
      "romaji": "sekai ni hitori ja nai koto wasurenaide"
    },
    {
      "id": 20,
      "start": 141.45,
      "end": 146.57,
      "rubyText": "情熱[じょうねつ]を忘[わす]れないで",
      "translation": "정열을 잊지 말아줘",
      "romaji": "jounetsu o wasurenaide"
    },
    {
      "id": 21,
      "start": 147.23,
      "end": 149.89,
      "rubyText": "いつか歩[ある]く道[みち]も",
      "translation": "언젠가 걸을 길도",
      "romaji": "itsuka aruku michi mo"
    },
    {
      "id": 22,
      "start": 149.89,
      "end": 152.64,
      "rubyText": "いつか歌[うた]う場所[ばしょ]も",
      "translation": "언젠가 노래할 곳도",
      "romaji": "itsuka utau basho mo"
    },
    {
      "id": 23,
      "start": 152.64,
      "end": 158.3,
      "rubyText": "心[こころ]の片隅[かたすみ]で嫌[きら]いになる日[ひ]が来[く]る",
      "translation": "마음 한 구석에서 싫어하게 될 날이 올 거야",
      "romaji": "kokoro no katasumi de kirai ni naru hi ga kuru"
    },
    {
      "id": 24,
      "start": 158.3,
      "end": 160.99,
      "rubyText": "不条理[ふじょうり]に揉[も]まれて",
      "translation": "부조리에 치이고",
      "romaji": "fujouri ni momarete"
    },
    {
      "id": 25,
      "start": 160.99,
      "end": 163.95,
      "rubyText": "苦[くる]しみに晒[さら]され",
      "translation": "괴로움에 바래도",
      "romaji": "kurushimi ni sarasare"
    },
    {
      "id": 26,
      "start": 163.95,
      "end": 169.35,
      "rubyText": "また何度[なんど]でもこの夜[よる]に帰[かえ]ってくる",
      "translation": "또 다시 몇 번이고 이 밤으로 돌아올 거야",
      "romaji": "mata nando demo kono yoru ni kaette kuru"
    },
    {
      "id": 27,
      "start": 169.35,
      "end": 174.87,
      "rubyText": "恋[こい]してる愛[あい]してるこの夜[よる]の歌[うた]が",
      "translation": "사랑하고 사랑하는 이 밤의 노래가",
      "romaji": "koishiteru aishiteru kono yoru no uta ga"
    },
    {
      "id": 28,
      "start": 174.87,
      "end": 180.42,
      "rubyText": "いつか愛[あい]する人[ひと]の心[こころ]に届[とど]くのかな",
      "translation": "언젠가 사랑하는 사람의 마음에 닿을까",
      "romaji": "itsuka aisuru hito no kokoro ni todoku no ka na"
    },
    {
      "id": 29,
      "start": 180.42,
      "end": 186.06,
      "rubyText": "ちゃんと綺麗[きれい]に人[ひと]を愛[あい]せるかな",
      "translation": "제대로 아름답게 사람을 사랑할 수 있을까",
      "romaji": "chanto kirei ni hito o aiseru ka na"
    },
    {
      "id": 30,
      "start": 186.06,
      "end": 191.93,
      "rubyText": "ちゃんと綺麗[きれい]に人[ひと]を救[すく]えるかな",
      "translation": "제대로 아름답게 사람을 구해줄 수 있을까",
      "romaji": "chanto kirei ni hito o sukueru ka na"
    },
    {
      "id": 31,
      "start": 191.93,
      "end": 197.55,
      "rubyText": "25時[にじゅうごじ]の情熱[じょうねつ]を忘[わす]れずにいれるかな",
      "translation": "25시의 정열을 잊지 않을 수 있을까",
      "romaji": "nijuugoji no jounetsu o wasurezuni ireru ka na"
    }
  ],
