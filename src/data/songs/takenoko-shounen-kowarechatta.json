  "releaseDate": "2026-02-23",
  "lyrics": [
    {
      "id": 1,
      "startTime": 1.531,
      "endTime": 2.684,
      "text": "こわれちゃった！！",
      "translation": "망가져버렸어!!",
      "start": 1.531,
      "end": 2.684,
      "rubyText": "こわれちゃった！！"
    },
    {
      "id": 2,
      "startTime": 10.769,
      "endTime": 12.808,
      "text": "息[いき]も忘[わす]れるぐらいに夢中[むちゅう]",
      "translation": "숨쉬기도 잊을 정도로 푹 빠져",
      "start": 10.769,
      "end": 12.808,
      "rubyText": "息[いき]も忘[わす]れるぐらいに夢中[むちゅう]"
    },
    {
      "id": 3,
      "startTime": 12.808,
      "endTime": 14.808,
      "text": "今夜[こんや]も時計[とけい]は29時[にじゅうくじ]",
      "translation": "오늘 밤도 시계는 29시",
      "start": 12.808,
      "end": 14.808,
      "rubyText": "今夜[こんや]も時計[とけい]は29時[にじゅうくじ]"
    },
    {
      "id": 4,
      "startTime": 14.808,
      "endTime": 16.808,
      "text": "やばいやばいと思[おも]っていても",
      "translation": "위험해 위험하다고 생각하면서도",
      "start": 14.808,
      "end": 16.808,
      "rubyText": "やばいやばいと思[おも]っていても"
    },
    {
      "id": 5,
      "startTime": 16.808,
      "endTime": 18.846,
      "text": "無限[むげん]スワイプする指[ゆび]が止[と]まらない！",
      "translation": "무한 스와이프하는 손가락이 멈추질 않아!",
      "start": 16.808,
      "end": 18.846,
      "rubyText": "無限[むげん]スワイプする指[ゆび]が止[と]まらない！"
    },
    {
      "id": 6,
      "startTime": 18.846,
      "endTime": 20.654,
      "text": "ｱｼﾀﾓﾊﾔｵｷﾅﾝﾃﾞｽﾆｮ〜！",
      "translation": "내일도 일찍 일어나야 해뇨~!",
      "start": 18.846,
      "end": 20.654,
      "rubyText": "ｱｼﾀﾓﾊﾔｵｷﾅﾝﾃﾞｽﾆｮ〜！"
    },
    {
      "id": 7,
      "startTime": 20.654,
      "endTime": 23.0,
      "text": "うるさい！言[い]われなくても分[わ]かってる！",
      "translation": "시끄러워! 안 말해도 알고 있다고!",
      "start": 20.654,
      "end": 23.0,
      "rubyText": "うるさい！言[い]われなくても分[わ]かってる！"
    },
    {
      "id": 8,
      "startTime": 23.0,
      "endTime": 24.731,
      "text": "ﾎﾝﾄﾆﾈﾅｲﾄﾀﾞﾒﾃﾞｽﾆｮ～！",
      "translation": "진짜로 안 자면 안 돼뇨~!",
      "start": 23.0,
      "end": 24.731,
      "rubyText": "ﾎﾝﾄﾆﾈﾅｲﾄﾀﾞﾒﾃﾞｽﾆｮ～！"
    },
    {
      "id": 9,
      "startTime": 24.731,
      "endTime": 25.846,
      "text": "うるさい！うるさい！",
      "translation": "시끄러워! 시끄러워!",
      "start": 24.731,
      "end": 25.846,
      "rubyText": "うるさい！うるさい！"
    },
    {
      "id": 10,
      "startTime": 25.846,
      "endTime": 26.885,
      "text": "うるさい、うるさい、、",
      "translation": "시끄러워, 시끄러워, 시끄러워, 시끄러워,,",
      "start": 25.846,
      "end": 26.885,
      "rubyText": "うるさい、うるさい、、"
    },
    {
      "id": 11,
      "startTime": 26.885,
      "endTime": 28.038,
      "text": "うるさーーーーーーーーーい！！！！！！！",
      "translation": "시끄러어어어어어어어어어워!!!!!!!",
      "start": 26.885,
      "end": 28.038,
      "rubyText": "うるさーーーーーーーーーい！！！！！！！"
    },
    {
      "id": 12,
      "startTime": 35.231,
      "endTime": 37.231,
      "text": "現代社会[げんだいしゃかい] 蔓延[はびこ]ってるTips",
      "translation": "현대사회에 판치는 팁들",
      "start": 35.231,
      "end": 37.231,
      "rubyText": "現代社会[げんだいしゃかい] 蔓延[はびこ]ってるTips"
    },
    {
      "id": 13,
      "startTime": 37.231,
      "endTime": 38.231,
      "text": "試[ため]しまくってみたりしてるのに",
      "translation": "이것저것 막 시도해보고 있는데",
      "start": 37.231,
      "end": 38.231,
      "rubyText": "試[ため]しまくってみたりしてるのに"
    },
    {
      "id": 14,
      "startTime": 38.231,
      "endTime": 39.192,
      "text": "なんで？？",
      "translation": "왜??",
      "start": 38.231,
      "end": 39.192,
      "rubyText": "なんで？？"
    },
    {
      "id": 15,
      "startTime": 39.192,
      "endTime": 40.154,
      "text": "気持[きも]ちがどんどん焦[あせ]って、",
      "translation": "마음은 점점 초조해지고,",
      "start": 39.192,
      "end": 40.154,
      "rubyText": "気持[きも]ちがどんどん焦[あせ]って、"
    },
    {
      "id": 16,
      "startTime": 40.154,
      "endTime": 41.423,
      "text": "バクバク心臓[しんぞう]おかしくて、",
      "translation": "쿵쾅쿵쾅 심장 이상해지고,",
      "start": 40.154,
      "end": 41.423,
      "rubyText": "バクバク心臓[しんぞう]おかしくて、"
    },
    {
      "id": 17,
      "startTime": 41.423,
      "endTime": 42.846,
      "text": "眠[ねむ]れないの！！！！！",
      "translation": "잠이 안 와!!!!!",
      "start": 41.423,
      "end": 42.846,
      "rubyText": "眠[ねむ]れないの！！！！！"
    },
    {
      "id": 18,
      "startTime": 45.038,
      "endTime": 46.731,
      "text": "あー疲[つか]れきって嫌[いや]になった",
      "translation": "아~ 너무 지쳐서 진절머리나",
      "start": 45.038,
      "end": 46.731,
      "rubyText": "あー疲[つか]れきって嫌[いや]になった"
    },
    {
      "id": 19,
      "startTime": 46.731,
      "endTime": 48.808,
      "text": "そりゃ自暴自棄[じぼうじき]にもなりますわ",
      "translation": "그야 자포자기하게도 되지요",
      "start": 46.731,
      "end": 48.808,
      "rubyText": "そりゃ自暴自棄[じぼうじき]にもなりますわ"
    },
    {
      "id": 20,
      "startTime": 48.808,
      "endTime": 50.577,
      "text": "猛毒[もうどく]のオアシスが",
      "translation": "맹독의 오아시스가",
      "start": 48.808,
      "end": 50.577,
      "rubyText": "猛毒[もうどく]のオアシスが"
    },
    {
      "id": 21,
      "startTime": 50.577,
      "endTime": 52.269,
      "text": "こちらこちらようこそって言[い]ってんの",
      "translation": "이쪽 이쪽 어서 오세요 하고 있잖아",
      "start": 50.577,
      "end": 52.269,
      "rubyText": "こちらこちらようこそって言[い]ってんの"
    },
    {
      "id": 22,
      "startTime": 52.269,
      "endTime": 53.808,
      "text": "策略[さくりゃく]にハマっちゃった",
      "translation": "계략에 빠져버렸어",
      "start": 52.269,
      "end": 53.808,
      "rubyText": "策略[さくりゃく]にハマっちゃった"
    },
    {
      "id": 23,
      "startTime": 53.808,
      "endTime": 56.538,
      "text": "ゆるやかに埋葬[まいそう]されちゃった…？",
      "translation": "서서히 매장되어버린 건가…?",
      "start": 53.808,
      "end": 56.538,
      "rubyText": "ゆるやかに埋葬[まいそう]されちゃった…？"
    },
    {
      "id": 24,
      "startTime": 56.538,
      "endTime": 57.846,
      "text": "ぐるぐる巻[ま]き解[ほど]けなきゃ",
      "translation": "칭칭 감긴 걸 풀지 못하면",
      "start": 56.538,
      "end": 57.846,
      "rubyText": "ぐるぐる巻[ま]き解[ほど]けなきゃ"
    },
    {
      "id": 25,
      "startTime": 57.846,
      "endTime": 59.346,
      "text": "どうなんの？",
      "translation": "어떻게 되는 건데?",
      "start": 57.846,
      "end": 59.346,
      "rubyText": "どうなんの？"
    },
    {
      "id": 26,
      "startTime": 59.346,
      "endTime": 60.385,
      "text": "ねえ？？？？",
      "translation": "저기????",
      "start": 59.346,
      "end": 60.385,
      "rubyText": "ねえ？？？？"
    },
    {
      "id": 27,
      "startTime": 62.385,
      "endTime": 64.269,
      "text": "とっくのとっくのとっくのとっくに",
      "translation": "진작에 진작에 진작에 진작부터",
      "start": 62.385,
      "end": 64.269,
      "rubyText": "とっくのとっくのとっくのとっくに"
    },
    {
      "id": 28,
      "startTime": 64.269,
      "endTime": 66.192,
      "text": "何[なに]から何[なに]までおかしくなってんの！",
      "translation": "처음부터 끝까지 이상해져 있잖아!",
      "start": 64.269,
      "end": 66.192,
      "rubyText": "何[なに]から何[なに]までおかしくなってんの！"
    },
    {
      "id": 29,
      "startTime": 66.192,
      "endTime": 68.077,
      "text": "遠[とお]くの遠[とお]くの遠[とお]くの遠[とお]くの",
      "translation": "저 멀리 저 멀리 저 멀리 저 멀리",
      "start": 66.192,
      "end": 68.077,
      "rubyText": "遠[とお]くの遠[とお]くの遠[とお]くの遠[とお]くの"
    },
    {
      "id": 30,
      "startTime": 68.077,
      "endTime": 69.808,
      "text": "記憶[きおく]も消[き]えてておつむが大渋滞[だいじゅうたい]…",
      "translation": "기억도 사라져서 머릿속이 대정체…",
      "start": 68.077,
      "end": 69.808,
      "rubyText": "記憶[きおく]も消[き]えてておつむが大渋滞[だいじゅうたい]…"
    },
    {
      "id": 31,
      "startTime": 69.808,
      "endTime": 71.5,
      "text": "溢[あふ]れてるどぱどぱドーパミン",
      "translation": "넘쳐흐르는 도파도파 도파민",
      "start": 69.808,
      "end": 71.5,
      "rubyText": "溢[あふ]れてるどぱどぱドーパミン"
    },
    {
      "id": 32,
      "startTime": 71.5,
      "endTime": 73.808,
      "text": "ガチな中毒[ちゅうどく] 脳[のう]もショートらしい",
      "translation": "진짜 중독 뇌도 쇼트난 듯해",
      "start": 71.5,
      "end": 73.808,
      "rubyText": "ガチな中毒[ちゅうどく] 脳[のう]もショートらしい"
    },
    {
      "id": 33,
      "startTime": 73.808,
      "endTime": 75.769,
      "text": "集中力[しゅうちゅうりょく]とかそういうもんとか",
      "translation": "집중력 같은 그런 것들도",
      "start": 73.808,
      "end": 75.769,
      "rubyText": "集中力[しゅうちゅうりょく]とかそういうもんとか"
    },
    {
      "id": 34,
      "startTime": 75.769,
      "endTime": 76.769,
      "text": "ずっとずっと衝動[しょうどう]続[つづ]けて",
      "translation": "계속 계속 충동 이어져서",
      "start": 75.769,
      "end": 76.769,
      "rubyText": "ずっとずっと衝動[しょうどう]続[つづ]けて"
    },
    {
      "id": 35,
      "startTime": 76.769,
      "endTime": 78.462,
      "text": "寝[ね]られなくなって",
      "translation": "잠들 수 없게 되어서",
      "start": 76.769,
      "end": 78.462,
      "rubyText": "寝[ね]られなくなって"
    },
    {
      "id": 36,
      "startTime": 78.462,
      "endTime": 79.577,
      "text": "こわれちゃった！！",
      "translation": "망가져버렸어!!",
      "start": 78.462,
      "end": 79.577,
      "rubyText": "こわれちゃった！！"
    },
    {
      "id": 37,
      "startTime": 81.154,
      "endTime": 83.423,
      "text": "いつかミイラになって祀[まつ]られちゃって",
      "translation": "언젠가 미라가 돼서 모셔지게 되고",
      "start": 81.154,
      "end": 83.423,
      "rubyText": "いつかミイラになって祀[まつ]られちゃって"
    },
    {
      "id": 38,
      "startTime": 85.0,
      "endTime": 87.269,
      "text": "めちゃくちゃデカすぎるピラミッドに隠[かく]されちゃって",
      "translation": "엄청 큰 피라미드에 숨겨져 버리고",
      "start": 85.0,
      "end": 87.269,
      "rubyText": "めちゃくちゃデカすぎるピラミッドに隠[かく]されちゃって"
    },
    {
      "id": 39,
      "startTime": 88.769,
      "endTime": 91.115,
      "text": "そして最終的[さいしゅうてき]にお宝[たから]になって",
      "translation": "그리고 최종적으로 보물이 되고",
      "start": 88.769,
      "end": 91.115,
      "rubyText": "そして最終的[さいしゅうてき]にお宝[たから]になって"
    },
    {
      "id": 40,
      "startTime": 92.615,
      "endTime": 93.808,
      "text": "それでもいいのかなって",
      "translation": "그래도 괜찮은 거 아닐까 하고",
      "start": 92.615,
      "end": 93.808,
      "rubyText": "それでもいいのかなって"
    },
    {
      "id": 41,
      "startTime": 93.808,
      "endTime": 95.692,
      "text": "思[おも]うだなんてもう",
      "translation": "생각하다니, 정말",
      "start": 93.808,
      "end": 95.692,
      "rubyText": "思[おも]うだなんてもう"
    },
    {
      "id": 42,
      "startTime": 95.692,
      "endTime": 100.615,
      "text": "こわれちゃった！！",
      "translation": "망가져버렸어!!",
      "start": 95.692,
      "end": 100.615,
      "rubyText": "こわれちゃった！！"
    },
    {
      "id": 43,
      "startTime": 106.385,
      "endTime": 107.346,
      "text": "やっぱ無理[むり]、助[たす]けて～😭",
      "translation": "역시 무리야, 살려줘~ 😭",
      "start": 106.385,
      "end": 107.346,
      "rubyText": "やっぱ無理[むり]、助[たす]けて～😭"
    }
  ],
