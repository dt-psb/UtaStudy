  "lyrics": [
    {
      "id": 1,
      "start": 26.3,
      "end": 39.966,
      "rubyText": "どこにもいかない",
      "translation": "어디에도 가지 않아"
    },
    {
      "id": 2,
      "start": 47.633,
      "end": 49.772,
      "rubyText": "予[よ]報[ほう]の嘘[うそ]つき",
      "translation": "일기예보는 거짓말쟁이"
    },
    {
      "id": 3,
      "start": 50.283,
      "end": 54.5,
      "rubyText": "遊[あそ]びに行[い]くはずだったのに",
      "translation": "놀러 가기로 했었는데"
    },
    {
      "id": 4,
      "start": 54.5,
      "end": 56.739,
      "rubyText": "どこにもいけない",
      "translation": "어디에도 못 가"
    },
    {
      "id": 5,
      "start": 57.233,
      "end": 61.525,
      "rubyText": "もう全[ぜん]部[ぶ]台[だい]無[な]しだくそが",
      "translation": "이제 전부 엉망이야, 망할"
    },
    {
      "id": 6,
      "start": 61.525,
      "end": 64.991,
      "rubyText": "子[こ]どもじゃいけないよ",
      "translation": "아이처럼 굴면 안 된다는 거"
    },
    {
      "id": 7,
      "start": 64.991,
      "end": 68.4,
      "rubyText": "分[わ]かってますけれど どうも",
      "translation": "알고는 있지만, 아무래도"
    },
    {
      "id": 8,
      "start": 68.4,
      "end": 71.866,
      "rubyText": "どこにもいけないよ",
      "translation": "어디에도 갈 수 없어"
    },
    {
      "id": 9,
      "start": 71.866,
      "end": 75.4,
      "rubyText": "終[お]わらない雨[あま]音[おと]",
      "translation": "끝나지 않는 빗소리가"
    },
    {
      "id": 10,
      "start": 75.4,
      "end": 78.933,
      "rubyText": "ぽつ ぼつ ひとつ ずつ",
      "translation": "토독, 투둑, 한줄기 씩"
    },
    {
      "id": 11,
      "start": 78.933,
      "end": 81.933,
      "rubyText": "違[ちが]う音[おと]の中[なか]で",
      "translation": "서로 다른 소리들 속에서"
    },
    {
      "id": 12,
      "start": 81.933,
      "end": 89.045,
      "rubyText": "変[か]わらないものを探[さが]してる",
      "translation": "변하지 않는 것을 찾고 있어"
    },
    {
      "id": 13,
      "start": 90.73,
      "end": 119.799,
      "rubyText": "どこにもいかない",
      "translation": "어디에도 가지 않아"
    },
    {
      "id": 14,
      "start": 120.199,
      "end": 141.037,
      "rubyText": "どこにもいかない",
      "translation": "어디에도 가지 않아"
    },
    {
      "id": 15,
      "start": 148.462,
      "end": 151.9,
      "rubyText": "変[か]わらないでいてよ",
      "translation": "변하지 말고 있어줘"
    },
    {
      "id": 16,
      "start": 151.9,
      "end": 155.4,
      "rubyText": "誰[だれ]も彼[かれ]も自[じ]分[ぶん]さえも",
      "translation": "이 사람도 , 저 사람도, 나 자신조차도"
    },
    {
      "id": 17,
      "start": 155.4,
      "end": 158.833,
      "rubyText": "どこか行[い]ってしまう",
      "translation": "어딘가로 가버려"
    },
    {
      "id": 18,
      "start": 158.833,
      "end": 161.933,
      "rubyText": "もうあたらしくならないで",
      "translation": "더 이상 새로워지지 말아줘"
    },
    {
      "id": 19,
      "start": 161.933,
      "end": 172.283,
      "rubyText": "やめて",
      "translation": "그러지 마"
    },
    {
      "id": 20,
      "start": 172.29,
      "end": 175.862,
      "rubyText": "やめてよ",
      "translation": "그러지 말아줘"
    },
    {
      "id": 21,
      "start": 175.862,
      "end": 177.435,
      "rubyText": "どこにもいかない",
      "translation": "어디에도 가지 않아"
    },
    {
      "id": 22,
      "start": 214.323,
      "end": 217.694,
      "rubyText": "どこにもいけない",
      "translation": "어디에도 갈 수 없어"
    },
    {
      "id": 23,
      "start": 217.694,
      "end": 221.4,
      "rubyText": "熱[ねつ]で動[うご]けないし苦[くる]しくて",
      "translation": "열 때문에 움직일 수 없고 괴로워서"
    },
    {
      "id": 24,
      "start": 221.4,
      "end": 230.995,
      "rubyText": "このまま死[し]んでしまうかもと思[おも]った",
      "translation": "이대로 죽을지도 모른다고 생각했어"
    },
    {
      "id": 25,
      "start": 230.995,
      "end": 234.366,
      "rubyText": "玄[げん]関[かん]のドアが開[あ]く音[おと]がした",
      "translation": "현관문이 열리는 소리가 났어"
    },
    {
      "id": 26,
      "start": 234.366,
      "end": 237.833,
      "rubyText": "怒[おこ]ってる？焦[あせ]ってる？",
      "translation": "화난 거야? 서두르고 있어?"
    },
    {
      "id": 27,
      "start": 237.833,
      "end": 241.297,
      "rubyText": "その足[あし]音[おと]だけで",
      "translation": "그 발소리만으로"
    },
    {
      "id": 28,
      "start": 241.297,
      "end": 246.451,
      "rubyText": "誰[だれ]だかわかった",
      "translation": "누군지 알았어"
    },
    {
