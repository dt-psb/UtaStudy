  "lyrics": [
    {
      "id": 1,
      "start": 0.0,
      "end": 1.808,
      "rubyText": "ありえない幻[げん]想[そう]",
      "translation": "있을 수 없는 환상"
    },
    {
      "id": 2,
      "start": 1.808,
      "end": 3.156,
      "rubyText": "あふれだす妄[もう]想[そう]",
      "translation": "넘쳐나는 망상"
    },
    {
      "id": 3,
      "start": 3.156,
      "end": 5.701,
      "rubyText": "君[きみ]以[い]外[がい]全[ぜん]部[ぶ]いらないわ",
      "translation": "너 말고 다 필요 없어"
    },
    {
      "id": 4,
      "start": 17.447,
      "end": 19.869,
      "rubyText": "息[いき]をするように嘘[うそ]ついて",
      "translation": "숨 쉬듯 거짓말을 하고"
    },
    {
      "id": 5,
      "start": 19.869,
      "end": 22.834,
      "rubyText": "もうあたしやっぱいらない子[こ]？",
      "translation": "이제 나 역시 필요 없는 아이?"
    },
    {
      "id": 6,
      "start": 22.834,
      "end": 25.908,
      "rubyText": "こぼれ出[だ]しちゃった承[しょう]認[にん]欲[よっ]求[きゅう]",
      "translation": "흘러 넘쳐 버린 승인 욕구"
    },
    {
      "id": 7,
      "start": 25.908,
      "end": 28.752,
      "rubyText": "もっとココロ満[み]たしてよ",
      "translation": "좀더 마음을 채워줘"
    },
    {
      "id": 8,
      "start": 28.752,
      "end": 31.519,
      "rubyText": "アスパルテーム　甘[あま]い夢[ゆめ]",
      "translation": "아스파르템 달콤한 꿈"
    },
    {
      "id": 9,
      "start": 31.519,
      "end": 33.941,
      "rubyText": "あたしだけに愛[あい]をください",
      "translation": "나에게만 사랑을 주세요"
    },
    {
      "id": 10,
      "start": 33.941,
      "end": 35.058,
      "rubyText": "あ゛〜もうムリ まじムリ",
      "translation": "아~ 이제 무리 진짜 무리야"
    },
    {
      "id": 11,
      "start": 35.058,
      "end": 36.905,
      "rubyText": "恋[こい]して 愛[あい]して 救[きゅう]済[さい]執[しっ]行[こう]BAN⭐︎",
      "translation": "사랑하고 사랑하고 구제 집행 BAN⭐︎"
    },
    {
      "id": 12,
      "start": 36.905,
      "end": 38.636,
      "rubyText": "ねー好[す]きって言[い]ってよ？",
      "translation": "있잖아 좋아한다고 말해줘?"
    },
    {
      "id": 13,
      "start": 39.946,
      "end": 41.294,
      "rubyText": "ありえない幻[げん]想[そう]",
      "translation": "있을 수 없는 환상"
    },
    {
      "id": 14,
      "start": 41.294,
      "end": 42.718,
      "rubyText": "あふれだす妄[もう]想[そう]",
      "translation": "넘쳐나는 망상"
    },
    {
      "id": 15,
      "start": 42.718,
      "end": 43.334,
      "rubyText": "とまんない つまんない",
      "translation": "멈출 수 없어 재미없어"
    },
    {
      "id": 16,
      "start": 43.334,
      "end": 45.473,
      "rubyText": "欲[よく]が散[ち]らばって",
      "translation": "욕구가 흩어져"
    },
    {
      "id": 17,
      "start": 45.473,
      "end": 46.916,
      "rubyText": "求[もと]めてる愛[あい]情[じょう]",
      "translation": "원하고 있어 애정"
    },
    {
      "id": 18,
      "start": 46.916,
      "end": 48.267,
      "rubyText": "隠[かく]してる劣[れつ]情[じょう]",
      "translation": "숨기고 있어 열정"
    },
    {
      "id": 19,
      "start": 48.267,
      "end": 51.241,
      "rubyText": "君[きみ]以[い]外[がい]全[ぜん]部[ぶ]いらないわ",
      "translation": "너 말고 다 필요 없어"
    },
    {
      "id": 20,
      "start": 62.52,
      "end": 63.945,
      "rubyText": "誰[だれ]のこと見[み]てんの？",
      "translation": "누구를 보고 있는 거야?"
    },
    {
      "id": 21,
      "start": 63.945,
      "end": 65.435,
      "rubyText": "こういうの好[す]きなの？",
      "translation": "이런 거 좋아해?"
    },
    {
      "id": 22,
      "start": 65.435,
      "end": 68.233,
      "rubyText": "ねーDDとかガチでやめてください",
      "translation": "있잖아 DD라던가 진심 그만해 주세요"
    },
    {
      "id": 23,
      "start": 68.233,
      "end": 69.63,
      "rubyText": "かわいくなりたい！",
      "translation": "귀여워지고 싶어!"
    },
    {
      "id": 24,
      "start": 69.63,
      "end": 71.111,
      "rubyText": "キラキラしてたい！",
      "translation": "반짝반짝 빛나고 싶어!"
    },
    {
      "id": 25,
      "start": 71.111,
      "end": 73.946,
      "rubyText": "もっともっとガチで褒[ほ]めてください",
      "translation": "더욱 더 진심으로 칭찬해 주세요"
    },
    {
      "id": 26,
      "start": 73.946,
      "end": 75.334,
      "rubyText": "泣[な]いちゃう散[さん]々[ざん]",
      "translation": "울어버려 실컷"
    },
    {
      "id": 27,
      "start": 75.334,
      "end": 76.861,
      "rubyText": "空[あ]けちゃうシャンパン",
      "translation": "비워버리는 샴페인"
    },
    {
      "id": 28,
      "start": 76.861,
      "end": 79.64,
      "rubyText": "今[こん]夜[や]も配[はい]信[しん]来[き]てくれるよね？ね？",
      "translation": "오늘밤도 방송 와줄 거지? 응?"
    },
    {
      "id": 29,
      "start": 79.64,
      "end": 80.954,
      "rubyText": "独[どく]占[せん]させてよ",
      "translation": "독점하게 해줘"
    },
    {
      "id": 30,
      "start": 80.954,
      "end": 82.388,
      "rubyText": "本[ほん]命[めい]なんでしょ",
      "translation": "내가 제일 우선이지?"
    },
    {
      "id": 31,
      "start": 82.388,
      "end": 85.241,
      "rubyText": "もっともっとガチで推[お]してください",
      "translation": "더욱 더 진심으로 좋아해 줘요"
    },
    {
      "id": 32,
      "start": 85.241,
      "end": 87.955,
      "rubyText": "飲[の]み過[す]ぎ注[ちゅう]意[い] オーバードーズ",
      "translation": "과음 주의 오버 도즈"
    },
    {
      "id": 33,
      "start": 87.955,
      "end": 90.651,
      "rubyText": "クラクラさせて いつだって",
      "translation": "어지럽게 만들어줘  언제라도"
