    },
    {
      "id": 6,
      "start": 11.096,
      "end": 13.447,
      "rubyText": "あたし一[いっ]等[とう]賞[しょう]がほしいのよ",
      "romaji": "아타시 잇토오쇼오가 호시이노요",
      "translation": "나는 일등상을 가지고 싶어"
    },
    {
      "id": 7,
      "start": 13.447,
      "end": 16.002,
      "rubyText": "二[に]番[ばん]なんて望[のぞ]んでない",
      "romaji": "니반난테 노존데 나이",
      "translation": "2등 따위는 원하지 않아"
    },
    {
      "id": 8,
      "start": 16.002,
      "end": 18.541,
      "rubyText": "みんなめんどくせって離[はな]れるの",
      "romaji": "민나 멘도쿠셋테 하나레루노",
      "translation": "다들 귀찮다면서 멀어져가"
    },
    {
      "id": 9,
      "start": 18.541,
      "end": 21.163,
      "rubyText": "重[おも]い子[こ]って不[ふ]人[にん]気[き]なん　なんなん",
      "romaji": "오모이 콧테 후닌키난 난난",
      "translation": "부담스러운 앤 인기 없다나 뭐라나"
    },
    {
      "id": 10,
      "start": 21.163,
      "end": 23.663,
      "rubyText": "あたし迷[まい]子[ご]　迷[まい]子[ご]で損[そん]な感[かん]じ",
      "romaji": "아타시 마이고 마이고데 손나 칸지",
      "translation": "나는 미아, 미아라서 손해 보는 느낌"
    },
    {
      "id": 11,
      "start": 23.663,
      "end": 26.385,
      "rubyText": "本[ほん]命[めい]になれないマン　死[し]んじまうわ！",
      "romaji": "혼메이니 나레나이 만 신지마우와!",
      "translation": "진심이 되지못해맨, 죽어버릴 거야!"
    },
    {
      "id": 12,
      "start": 26.385,
      "end": 28.491,
      "rubyText": "サイコ？　サイコはどっちどっち",
      "romaji": "사이코? 사이코와 돗치 돗치",
      "translation": "사이코? 사이코는 누구 누구"
    },
    {
      "id": 13,
      "start": 28.491,
      "end": 31.437,
      "rubyText": "おまえのことは顔[かお]しか　信[しん]じらんない！",
      "romaji": "오마에노 코토와 카오시카 신지란나이!",
      "translation": "너에게서 믿을 건 얼굴 뿐이야!"
    },
    {
      "id": 14,
      "start": 31.437,
      "end": 33.916,
      "rubyText": "やってないね　やってらんないね",
      "romaji": "얏테나이네 얏테란나이네",
      "translation": "못 하겠네, 못 해먹겠네"
    },
    {
      "id": 15,
      "start": 33.916,
      "end": 36.58,
      "rubyText": "一[いっ]生[しょう]ぼっち　好[こう]意[い]ありがとさん",
