    },
    {
      "id": 2,
      "ruby": "それは瞬[しゅん]のぬくもりで",
      "translation": "그건 깜박임 같은 잠깐의 온기",
      "romaji": "sore wa shun no nukumori de",
      "startTime": 9.17,
      "endTime": 12.02
    },
    {
      "id": 3,
      "ruby": "メロディ",
      "translation": "Melody",
      "romaji": "merodi",
      "startTime": 12.02,
      "endTime": 13.45
    },
    {
      "id": 4,
      "ruby": "食[た]べて吐[は]いて飲[の]み込[こ]んで",
      "translation": "먹고 내뱉고 삼켜",
      "romaji": "tabete haite nomikonde",
      "startTime": 14.9,
      "endTime": 18.02
    },
    {
      "id": 5,
      "ruby": "笑味[しょうみ]馬鹿[ばか]みたいに",
      "translation": "실컷 맛봐",
      "romaji": "shoumi baka mitai ni",
      "startTime": 18.47,
      "endTime": 20.7
    },
    {
      "id": 6,
      "ruby": "甘[あま]く酸[す]っぱいこのケーキ",
      "translation": "새콤달콤한 이 케이크",
      "romaji": "amaku suppai kono keeki",
      "startTime": 20.7,
      "endTime": 24.07
    },
    {
      "id": 7,
      "ruby": "今日[きょう]が夢[ゆめ]みたいに",
      "translation": "만약 오늘이 꿈 같은 거였다면",
      "romaji": "kyou ga yume mitai ni",
      "startTime": 24.07,
      "endTime": 26.43
    },
    {
      "id": 8,
      "ruby": "なればゾッコン　病[や]みつき　イライラ",
      "translation": "너에게 반해 푹 빠져서 초조해질 텐데",
      "romaji": "nareba zokkon yamitsuki iraira",
      "startTime": 26.43,
      "endTime": 29.68
    },
    {
      "id": 9,
      "ruby": "あら！　あらま　ドキドキで",
      "translation": "어머! 어머나 두근두근",
      "romaji": "ara! arama dokidoki de",
      "startTime": 32.77,
      "endTime": 35.77
    },
    {
      "id": 10,
      "ruby": "その心[こころ]は　ラブラブで",
      "translation": "그 속마음은 러브러브",
      "romaji": "sono kokoro wa raburabu de",
      "startTime": 35.77,
      "endTime": 38.17
    },
    {
      "id": 11,
      "ruby": "あら！　あらま　なぞなぞで",
      "translation": "어머! 어머나 수수께끼",
      "romaji": "ara! arama nazonazo de",
      "startTime": 38.47,
      "endTime": 41.53
    },
    {
      "id": 12,
      "ruby": "ロマンチックなんて勝手[かって]言[い]うんでしょ",
