{
  "id": "nejishiki-sensuika",
  "title": "潜水花",
  "artist": "ねじ式 feat. 初音ミク",
  "romaji": "Sensuika",
  "englishTitle": "Diving Flower",
  "youtubeId": "r-Hrngs7Skw",
  "category": "VOCALOID",
  "language": "ja",
  "releaseDate": "2024-07-01",
  "lyrics": [
    {
      "id": 1,
      "startTime": 26.372,
      "endTime": 29.899,
      "text": "忘[わす]れかけた景色[けしき] 思[おも]い出[だ]すような 君[きみ]の声[こえ]で",
      "translation": "잊혀질 뻔한 풍경을 너의 목소리로 떠올려",
      "start": 26.372,
      "end": 29.899,
      "rubyText": "忘[わす]れかけた景色[けしき] 思[おも]い出[だ]すような 君[きみ]の声[こえ]で"
    },
    {
      "id": 2,
      "startTime": 29.899,
      "endTime": 32.905,
      "text": "夏[なつ]が巡[めぐ]る",
      "translation": "여름이 돌아오네",
      "start": 29.899,
      "end": 32.905,
      "rubyText": "夏[なつ]が巡[めぐ]る"
    },
    {
      "id": 3,
      "startTime": 32.905,
      "endTime": 36.408,
      "text": "息[いき]を止[と]めて潜[もぐ]る水中[すいちゅう]みたいに",
      "translation": "숨을 멈추고 잠수하는 물속처럼",
      "start": 32.905,
      "end": 36.408,
      "rubyText": "息[いき]を止[と]めて潜[もぐ]る水中[すいちゅう]みたいに"
    },
    {
      "id": 4,
      "startTime": 36.408,
      "endTime": 39.264,
      "text": "胸[むね]が苦[くる]しいよ",
      "translation": "가슴이 답답해",
      "start": 36.408,
      "end": 39.264,
      "rubyText": "胸[むね]が苦[くる]しいよ"
    },
    {
      "id": 5,
      "startTime": 39.482,
      "endTime": 42.745,
      "text": "空[から]っぽのまんまの心[こころ]を",
      "translation": "텅 빈 마음을",
      "start": 39.482,
      "end": 42.745,
      "rubyText": "空[から]っぽのまんまの心[こころ]を"
    },
    {
      "id": 6,
      "startTime": 42.745,
      "endTime": 46.007,
      "text": "満[み]たす魔法[まほう]みたいな言葉[ことば]",
      "translation": "채워주는 마법 같은 말들",
      "start": 42.745,
      "end": 46.007,
      "rubyText": "満[み]たす魔法[まほう]みたいな言葉[ことば]"
    },
    {
      "id": 7,
      "startTime": 46.007,
      "endTime": 52.059,
      "text": "ただ欲[ほ]しがって困[こま]らせてたよね",
      "translation": "그저 원하기만 하고 괴롭혔지",
      "start": 46.007,
      "end": 52.059,
      "rubyText": "ただ欲[ほ]しがって困[こま]らせてたよね"
    },
    {
      "id": 8,
      "startTime": 52.071,
      "endTime": 55.828,
      "text": "星[ほし]繋[つな]いだ橋[はし] 渡[わた]れたなら",
      "translation": "별들이 이어진 다리를 건널 수 있다면",
      "start": 52.071,
      "end": 55.828,
      "rubyText": "星[ほし]繋[つな]いだ橋[はし] 渡[わた]れたなら"
    },
    {
      "id": 9,
      "startTime": 55.828,
      "endTime": 58.944,
      "text": "時計[とけい]の針[はり]を 戻[もど]せたなら",
      "translation": "시간을 되돌릴 수 있다면",
      "start": 55.828,
      "end": 58.944,
      "rubyText": "時計[とけい]の針[はり]を 戻[もど]せたなら"
    },
    {
      "id": 10,
      "startTime": 58.944,
      "endTime": 62.402,
      "text": "ただ逢[あ]いたくて 逢[あ]いたくて 焦[こ]がれた",
      "translation": "그저 만나고 싶어 만나고 싶어 그리워했어",
      "start": 58.944,
      "end": 62.402,
      "rubyText": "ただ逢[あ]いたくて 逢[あ]いたくて 焦[こ]がれた"
    },
    {
      "id": 11,
      "startTime": 62.402,
      "endTime": 65.257,
      "text": "永遠[えいえん]の刹那[せつな] 唄[うた]うよ",
      "translation": "영원의 순간을 노래해",
      "start": 62.402,
      "end": 65.257,
      "rubyText": "永遠[えいえん]の刹那[せつな] 唄[うた]うよ"
    },
    {
      "id": 12,
      "startTime": 65.257,
      "endTime": 68.605,
      "text": "昨日[きのう]と明日[あした]に挟[はさ]まれた日々[ひび]",
      "translation": "어제와 내일 사이에 끼인 나날들",
      "start": 65.257,
      "end": 68.605,
      "rubyText": "昨日[きのう]と明日[あした]に挟[はさ]まれた日々[ひび]"
    },
    {
      "id": 13,
      "startTime": 68.605,
      "endTime": 71.966,
      "text": "約束[やくそく]だけがこぼれ落[お]ちた",
      "translation": "약속만이 흘러내려",
      "start": 68.605,
      "end": 71.966,
      "rubyText": "約束[やくそく]だけがこぼれ落[お]ちた"
    },
    {
      "id": 14,
      "startTime": 71.966,
      "endTime": 75.205,
      "text": "行方[ゆくえ]不明[ふめい]の心[こころ]が",
      "translation": "어디로 갈지 모르는 마음이",
      "start": 71.966,
      "end": 75.205,
      "rubyText": "行方[ゆくえ]不明[ふめい]の心[こころ]が"
    },
    {
      "id": 15,
      "startTime": 75.205,
      "endTime": 77.498,
      "text": "まだ逢[あ]いたいと 逢[あ]いたいと",
      "translation": "아직도 만나고 싶어 만나고 싶어",
      "start": 75.205,
      "end": 77.498,
      "rubyText": "まだ逢[あ]いたいと 逢[あ]いたいと"
    },
    {
      "id": 16,
      "startTime": 77.498,
      "endTime": 80.302,
      "text": "叫[さけ]んでるから",
      "translation": "소리치고 있어",
      "start": 77.498,
      "end": 80.302,
      "rubyText": "叫[さけ]んでるから"
    },
    {
      "id": 17,
      "startTime": 91.198,
      "endTime": 93.159,
      "text": "ただこうやって じゃれあっちゃって",
      "translation": "그저 이렇게 장난치고",
      "start": 91.198,
      "end": 93.159,
      "rubyText": "ただこうやって じゃれあっちゃって"
    },
    {
      "id": 18,
      "startTime": 93.159,
      "endTime": 97.872,
      "text": "何[なん]でもない瞬間[しゅんかん]が宝物[たからもの]に変[か]わってくから",
      "translation": "아무것도 아닌 순간들이 보물이 되어가",
      "start": 93.159,
      "end": 97.872,
      "rubyText": "何[なん]でもない瞬間[しゅんかん]が宝物[たからもの]に変[か]わってくから"
    },
    {
      "id": 19,
      "startTime": 97.872,
      "endTime": 99.537,
      "text": "ねぇ消[き]えないで おいてかないで",
      "translation": "제발 사라지지 마 떠나지 마",
      "start": 97.872,
      "end": 99.537,
      "rubyText": "ねぇ消[き]えないで おいてかないで"
    },
    {
      "id": 20,
      "startTime": 99.537,
      "endTime": 104.655,
      "text": "いかないで 散[ち]らばった時[とき]の砂[すな]を集[あつ]めて",
      "translation": "가지 마 흩어진 시간의 모래를 모아",
      "start": 99.537,
      "end": 104.655,
      "rubyText": "いかないで 散[ち]らばった時[とき]の砂[すな]を集[あつ]めて"
    },
    {
      "id": 21,
      "startTime": 119.013,
      "endTime": 125.518,
      "text": "形[かたち]のない想[おも]いだけが 胸[むね]の奥[おく]で蒼[あお]く咲[さ]いた",
      "translation": "형태 없는 마음이 가슴 깊숙이 푸르게 피어나",
      "start": 119.013,
      "end": 125.518,
      "rubyText": "形[かたち]のない想[おも]いだけが 胸[むね]の奥[おく]で蒼[あお]く咲[さ]いた"
    },
    {
      "id": 22,
      "startTime": 125.518,
      "endTime": 130.75,
      "text": "夏[なつ]が来[く]るたび 心[こころ]染[そ]めてく",
      "translation": "여름이 올 때마다 마음을 물들여",
      "start": 125.518,
      "end": 130.75,
      "rubyText": "夏[なつ]が来[く]るたび 心[こころ]染[そ]めてく"
    },
    {
      "id": 23,
      "startTime": 131.217,
      "endTime": 134.996,
      "text": "欲[ほ]しがるもの全[すべ]て 手[て]に入[い]れて",
      "translation": "원하는 모든 것들을 손에 넣고",
      "start": 131.217,
      "end": 134.996,
      "rubyText": "欲[ほ]しがるもの全[すべ]て 手[て]に入[い]れて"
    },
    {
      "id": 24,
      "startTime": 134.996,
      "endTime": 138.409,
      "text": "孤独[こどく]な夜[よる]もくぐり抜[ぬ]けて",
      "translation": "외로운 밤도 지나왔어",
      "start": 134.996,
      "end": 138.409,
      "rubyText": "孤独[こどく]な夜[よる]もくぐり抜[ぬ]けて"
    },
    {
      "id": 25,
      "startTime": 138.409,
      "endTime": 141.852,
      "text": "でも逢[あ]いたいよ 逢[あ]いたいよ 今[いま]でも",
      "translation": "하지만 만나고 싶어 만나고 싶어 지금도",
      "start": 138.409,
      "end": 141.852,
      "rubyText": "でも逢[あ]いたいよ 逢[あ]いたいよ 今[いま]でも"
    },
    {
      "id": 26,
      "startTime": 141.852,
      "endTime": 144.612,
      "text": "永遠[えいえん]の君[きみ]を 願[ねが]ってた",
      "translation": "영원의 너를 바랐어",
      "start": 141.852,
      "end": 144.612,
      "rubyText": "永遠[えいえん]の君[きみ]を 願[ねが]ってた"
    },
    {
      "id": 27,
      "startTime": 144.612,
      "endTime": 148.181,
      "text": "昨日[きのう]と明日[あした]に閉[と]ざされた日々[ひび]",
      "translation": "어제와 내일에 갇힌 나날들",
      "start": 144.612,
      "end": 148.181,
      "rubyText": "昨日[きのう]と明日[あした]に閉[と]ざされた日々[ひび]"
    },
    {
      "id": 28,
      "startTime": 148.181,
      "endTime": 151.48,
      "text": "約束[やくそく]だけは守[まも]りたかった",
      "translation": "약속만은 지키고 싶었어",
      "start": 148.181,
      "end": 151.48,
      "rubyText": "約束[やくそく]だけは守[まも]りたかった"
    },
    {
      "id": 29,
      "startTime": 151.48,
      "endTime": 154.616,
      "text": "行方[ゆくえ]不明[ふめい]の未来[みらい]が",
      "translation": "어디로 갈지 모르는 미래가",
      "start": 151.48,
      "end": 154.616,
      "rubyText": "行方[ゆくえ]不明[ふめい]の未来[みらい]が"
    },
    {
      "id": 30,
      "startTime": 154.616,
      "endTime": 157.205,
      "text": "まだ足[た]りないと 足[た]りないと",
      "translation": "아직도 부족해 부족해",
      "start": 154.616,
      "end": 157.205,
      "rubyText": "まだ足[た]りないと 足[た]りないと"
    },
    {
      "id": 31,
      "startTime": 157.205,
      "endTime": 161.054,
      "text": "叫[さけ]んでるから",
      "translation": "소리치고 있어",
      "start": 157.205,
      "end": 161.054,
      "rubyText": "叫[さけ]んでるから"
    },
    {
      "id": 32,
      "startTime": 161.054,
      "endTime": 163.711,
      "text": "また逢[あ]いたいな 逢[あ]いたいな",
      "translation": "또 만나고 싶어 만나고 싶어",
      "start": 161.054,
      "end": 163.711,
      "rubyText": "また逢[あ]いたいな 逢[あ]いたいな"
    },
    {
      "id": 33,
      "startTime": 163.711,
      "endTime": 167.478,
      "text": "いつの日[ひ]か",
      "translation": "언젠가",
      "start": 163.711,
      "end": 167.478,
      "rubyText": "いつの日[ひ]か"
    }
  ],
