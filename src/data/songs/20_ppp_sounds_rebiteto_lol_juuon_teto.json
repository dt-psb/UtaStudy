  "duration": 137,
  "lyrics": [
    {
      "id": 1,
      "start": 3.73,
      "end": 6.51,
      "rubyText": "なんでもかんでも私[わたし]だけ",
      "translation": "무엇이든 나 혼자 뿐",
      "romaji": "nandemokandemowatashidake"
    },
    {
      "id": 2,
      "start": 6.66,
      "end": 8.72,
      "rubyText": "嫌[きら]いね世[よ]の中[なか]なんて",
      "translation": "이 세상 따윈 싫어",
      "romaji": "kiraine yono yononakanante"
    },
    {
      "id": 3,
      "start": 8.81,
      "end": 11.35,
      "rubyText": "いっつもかっつも私[わたし]だけ",
      "translation": "언제든지 나 혼자 뿐",
      "romaji": "ittsumokattsumowatashidake"
    },
    {
      "id": 4,
      "start": 11.85,
      "end": 14.0,
      "rubyText": "世界[せかい]で浮[う]いてる気[き]がするわ",
      "translation": "세상 혼자인 기분이야",
      "romaji": "sekaideuiterukigasuruwa"
    },
    {
      "id": 5,
      "start": 24.0,
      "end": 26.24,
      "rubyText": "嫌[いや]な顔[かお]しちゃ玉[たま]に瑕[きず]",
      "translation": "완벽하려면 찌푸리면 안돼",
      "romaji": "iyanakaoshichatamanikizu"
    },
    {
      "id": 6,
      "start": 26.44,
      "end": 28.99,
      "rubyText": "知[し]らんぷりして現実逃避[げんじつとうひ]を",
      "translation": "등 돌리며 현실도피를",
      "romaji": "shiranpurishitegenjitsutouhiwo"
    },
    {
      "id": 7,
      "start": 29.1,
      "end": 31.1,
      "rubyText": "繰[く]り返[かえ]してはまた縋[すが]る",
      "translation": "반복하고 반복해",
      "romaji": "kuri kurikaeshitehamatasugaru"
    },
    {
      "id": 8,
      "start": 31.2,
      "end": 33.71,
      "rubyText": "鏡[かがみ]の向[む]こうの理想[りそう]の自分[じぶん]",
      "translation": "거울 너머의 이상적인 나를 위해",
      "romaji": "kagaminomukounorisounojibun"
    },
    {
      "id": 9,
      "start": 34.0,
      "end": 36.31,
      "rubyText": "ただメンチ切[き]って毒[どく]吐[は]いて",
      "translation": "그냥 찡그리고 욕하고",
      "romaji": "tada menchi kittedokuhaite"
    },
    {
      "id": 10,
      "start": 36.51,
      "end": 39.12,
      "rubyText": "変[か]わらぬ夜[よる]に枕[まくら]を濡[ぬ]らすの",
      "translation": "변함없는 밤을 울며 지새우는거야",
      "romaji": "kawaranuyorunimakurawonurasuno"
    },
    {
      "id": 11,
      "start": 39.12,
      "end": 41.12,
      "rubyText": "ちょっとだけならいいと",
      "translation": "조금은 괜찮겠지 라며",
      "romaji": "chottodakenaraiito"
    },
    {
      "id": 12,
      "start": 41.36,
      "end": 43.74,
      "rubyText": "またまた、って誰[だれ]かに見[み]せるの",
      "translation": "[다시...또...] 라며 누군가에게 보여줘",
      "romaji": "matamata, ttedarekanimiseruno"
    },
    {
      "id": 13,
      "start": 43.96,
      "end": 46.6,
      "rubyText": "好[す]き 好[す]き 鏡[かがみ]越[こ]しでも",
      "translation": "좋아해 좋아해 내가 아닌 나 지만",
      "romaji": "suki suki kagamikoshidemo"
    },
    {
      "id": 14,
      "start": 46.73,
      "end": 49.09,
      "rubyText": "好[す]き 好[す]き 満[み]たされる",
      "translation": "좋아해 좋아해 채워지고 있어",
      "romaji": "suki suki mitasareru"
    },
    {
      "id": 15,
      "start": 49.26,
      "end": 53.06,
      "rubyText": "今[いま]誰[だれ]かに必要[ひつよう]とされてる私[わたし]",
      "translation": "지금 누군가가 원하는 나",
      "romaji": "imadarekanihitsuyoutosareteruwatashi"
    },
    {
      "id": 16,
      "start": 54.28,
      "end": 56.98,
      "rubyText": "愛[あい]して愛[あい]して私[わたし]だけ",
      "translation": "나만 사랑해 나만 사랑해",
      "romaji": "aishiteaishitewatashidake"
    },
    {
      "id": 17,
      "start": 57.31,
      "end": 59.31,
      "rubyText": "なんて言[い]わないから",
      "translation": "라고 안 할 테니까",
      "romaji": "nanteiwanaikara"
    },
    {
      "id": 18,
      "start": 59.42,
      "end": 62.05,
      "rubyText": "ぽっかり空[あ]いてた穴[あな]ぼこを",
      "translation": "내 텅 빈 구멍을",
      "romaji": "pokkariaitetaanabokowo"
    },
    {
      "id": 19,
      "start": 62.46,
      "end": 64.46,
      "rubyText": "何[なに]かで埋[う]めて欲[ほ]しいの",
      "translation": "어떻게든 채워줘",
      "romaji": "nanikadeumetehoshiino"
    },
    {
      "id": 20,
      "start": 64.5,
      "end": 65.78,
      "rubyText": "(lie lie lie lie)",
      "translation": "(lie lie lie lie)",
      "romaji": "(lie lie lie lie)"
    },
    {
      "id": 21,
      "start": 65.78,
      "end": 69.27,
      "rubyText": "ただの幻想[げんそう]と知[し]って未[いま]だにやって",
      "translation": "그저 환상이라는걸 알지만 여전히",
      "romaji": "tadanogensoutoshitteimadaniyatte"
    },
    {
      "id": 22,
      "start": 69.33,
      "end": 70.69,
      "rubyText": "(lie lie lie lie lie)",
      "translation": "(lie lie lie lie lie)",
      "romaji": "(lie lie lie lie lie)"
    },
    {
      "id": 23,
      "start": 70.69,
      "end": 71.69,
      "rubyText": "くだらないわ",
      "translation": "한심하지만",
      "romaji": "kudaranaiwa"
    },
    {
      "id": 24,
      "start": 71.91,
      "end": 73.91,
      "rubyText": "だけど生[い]きてると感[かん]じるの",
      "translation": "살아있음을 느껴",
      "romaji": "dakedoikiterutokanjiruno"
    },
    {
      "id": 25,
      "start": 84.7,
      "end": 86.7,
      "rubyText": "イヤ、イヤ、イヤイヤよ",
      "translation": "싫어 싫어 싫어 싫어",
      "romaji": "iya, iya, iyaiya yo"
    },
    {
      "id": 26,
      "start": 89.69,
      "end": 91.69,
      "rubyText": "ダメ、ダメ、ダメダメよ",
      "translation": "안 돼 안 돼 안 돼 안 돼 안 돼",
      "romaji": "dame, dame, damedame yo"
    },
    {
      "id": 27,
      "start": 94.69,
      "end": 97.85,
      "rubyText": "暗[くら]い暗[くら]い部屋[へや]の隅[すみ]で見[み]てた",
      "translation": "어둡고 어두운 방구석에서도",
      "romaji": "kuraikuraiheyanosumidemiteta"
    },
    {
      "id": 28,
      "start": 97.85,
      "end": 99.64,
      "rubyText": "ただ確[たし]かな数字[すうじ]が",
      "translation": "또렷하게 보이는 숫자가",
      "romaji": "tadatashikanasuujiga"
    },
    {
      "id": 29,
      "start": 99.64,
      "end": 103.29,
      "rubyText": "居[い]てもいいと言[い]うの",
      "translation": "곁에 있어달라고 말하는 걸",
      "romaji": "itemoiitoiuno"
    },
