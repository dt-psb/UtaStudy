    },
    {
      "id": 44,
      "start": 126.452,
      "end": 128.635,
      "rubyText": "やっときみも笑[わら]えるんだね",
      "translation": "드디어 너도 웃을 수 있게 되었네",
      "romaji": "yatto kimi mo waraeru n da ne"
