      "rubyText": "PARTY PARTY PARTY PARTY",
      "translation": "PARTY PARTY PARTY PARTY",
      "romaji": "PARTY PARTY PARTY PARTY"
    },
    {
      "id": 48,
      "start": 105.49,
      "end": 107.01,
      "rubyText": "無責任[むせきにん]なのは",
      "translation": "무책임한 건",
      "romaji": "musekinin na no wa"
    },
    {
      "id": 49,
      "start": 107.01,
      "end": 108.5,
      "rubyText": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN",
      "translation": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN",
      "romaji": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN"
    },
    {
      "id": 50,
      "start": 108.5,
      "end": 110.02,
      "rubyText": "ボクじゃないわ",
      "translation": "내가 아니야!",
      "romaji": "boku ja nai wa"
    },
    {
      "id": 51,
      "start": 110.02,
      "end": 111.5,
      "rubyText": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE",
      "translation": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE",
      "romaji": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE"
    },
    {
      "id": 52,
      "start": 111.5,
      "end": 113.0,
      "rubyText": "勘違[かんちが]いしないで",
      "translation": "착각하지 말아줘",
      "romaji": "kanchigai shinaide"
    },
    {
      "id": 53,
      "start": 113.0,
      "end": 118.64,
      "rubyText": "君[きみ]たちぃ？ ボクが奪[うば]ったげるわ",
      "translation": "너희들 내가 빼앗아 줄 거야",
      "romaji": "kimitachii? boku ga ubattageru wa"
    },
    {
      "id": 54,
      "start": 124.95,
      "end": 128.01,
      "rubyText": "捕[つか]まえらえるものなら",
      "translation": "어디 한번 잡을 수 있다면",
      "romaji": "tsukamaeraeru mono nara"
    },
    {
      "id": 55,
      "start": 128.01,
      "end": 130.99,
      "rubyText": "ららえるものなら ららえるものなら",
      "translation": "잡을 수 있다면",
      "romaji": "raraeru mono nara raraeru mono nara"
    },
    {
      "id": 56,
      "start": 130.99,
      "end": 134.38,
      "rubyText": "捕[つか]まえてみろよ！",
      "translation": "한번 잡아보라구!",
      "romaji": "tsukamaete miro yo!"
    }
