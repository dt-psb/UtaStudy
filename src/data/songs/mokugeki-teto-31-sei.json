{
  "id": "mokugeki-teto-31-sei",
  "title": "目撃！テト31世",
  "artist": "はろける feat. 雨衣・重音テト",
  "youtubeId": "uWMr16O_Aso",
  "lyrics": [
    {
      "id": 1,
      "start": 3.34,
      "end": 5.36,
      "rubyText": "目撃[もくげき]！テト31世[せい]",
      "translation": "목격! 테토 31세",
      "romaji": "mokugeki! teto sanjuu-issei"
    },
    {
      "id": 2,
      "start": 6.57,
      "end": 11.32,
      "rubyText": "君[きみ]の一番[いちばん] かわいいところな～んだ？",
      "translation": "너의 가장 귀여운 부분은 뭘까~?",
      "romaji": "kimi no ichiban kawaii tokoro na~nda?"
    },
    {
      "id": 3,
      "start": 11.32,
      "end": 12.69,
      "rubyText": "（かかと？）",
      "translation": "뒤꿈치?",
      "romaji": "(kakato?)"
    },
    {
      "id": 4,
      "start": 12.69,
      "end": 17.54,
      "rubyText": "撃[う]ち抜[ぬ]かれたり 飛[と]び出[で]ちゃうものな～んだ？",
      "translation": "맞출 수도 있고 튀어나오기도 하는 건 뭘까~?",
      "romaji": "uchinukaretari tobidechau mono na~nda?"
    },
    {
      "id": 5,
      "start": 17.54,
      "end": 18.54,
      "rubyText": "（ハート？）",
      "translation": "하트?",
      "romaji": "(haato?)"
    },
    {
      "id": 6,
      "start": 18.54,
      "end": 23.75,
      "rubyText": "大[おお]きくなると 固[かた]くなるものな～んだ？",
      "translation": "커지면 단단해지는 건 뭘까~?",
      "romaji": "ookiku naruto kataku naru mono na~nda?"
    },
    {
      "id": 7,
      "start": 23.75,
      "end": 24.76,
      "rubyText": "（あー...）",
      "translation": "어...",
      "romaji": "(aa...)"
    },
    {
      "id": 8,
      "start": 24.76,
      "end": 27.49,
      "rubyText": "君[きみ]が一番[いちばん] ドキドキするの",
      "translation": "너가 가장 두근두근해 하는 사람은",
      "romaji": "kimi ga ichiban dokidoki suru no"
    },
    {
      "id": 9,
      "start": 27.49,
      "end": 30.11,
      "rubyText": "だ～れ～だ！！！",
      "translation": "누~굴~까~?",
      "romaji": "da~re~da!!!"
    },
    {
      "id": 10,
      "start": 30.63,
      "end": 32.27,
      "rubyText": "ボクのことでしょ？",
      "translation": "당연히 나지?",
      "romaji": "boku no koto desho?"
    },
    {
      "id": 11,
      "start": 32.27,
      "end": 33.47,
      "rubyText": "（違[ちが]うがー？）",
      "translation": "아닌데~?",
      "romaji": "(chigau gaa?)"
    },
    {
      "id": 12,
      "start": 33.47,
      "end": 34.98,
      "rubyText": "PARTY PARTY PARTY PARTY",
      "translation": "PARTY PARTY PARTY PARTY",
      "romaji": "PARTY PARTY PARTY PARTY"
    },
    {
      "id": 13,
      "start": 34.98,
      "end": 36.59,
      "rubyText": "Today is the 31st",
      "translation": "Today is the 31st",
      "romaji": "Today is the 31st"
    },
    {
      "id": 14,
      "start": 36.59,
      "end": 37.99,
      "rubyText": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN",
      "translation": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN",
      "romaji": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN"
    },
    {
      "id": 15,
      "start": 37.99,
      "end": 39.57,
      "rubyText": "Teto is 31",
      "translation": "Teto is 31",
      "romaji": "Teto is 31"
    },
    {
      "id": 16,
      "start": 39.57,
      "end": 41.01,
      "rubyText": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE",
      "translation": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE",
      "romaji": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE"
    },
    {
      "id": 17,
      "start": 41.01,
      "end": 42.49,
      "rubyText": "Today is the 31st",
      "translation": "Today is the 31st",
      "romaji": "Today is the 31st"
    },
    {
      "id": 18,
      "start": 42.49,
      "end": 45.52,
      "rubyText": "英語[えいご]じゃ何[なに]言[い]ってっか わかんない!!",
      "translation": "영어로 뭐라고 말하는 건지 모르겠어!!",
      "romaji": "eigo ja nani ittekka wakannai!!"
    },
    {
      "id": 19,
      "start": 45.52,
      "end": 47.02,
      "rubyText": "PARTY PARTY PARTY PARTY",
      "translation": "PARTY PARTY PARTY PARTY",
      "romaji": "PARTY PARTY PARTY PARTY"
    },
    {
      "id": 20,
      "start": 47.02,
      "end": 48.5,
      "rubyText": "無責任[むせきにん]だけど！",
      "translation": "무책임하더라도",
      "romaji": "musekinin dakedo!"
    },
    {
      "id": 21,
      "start": 48.5,
      "end": 49.98,
      "rubyText": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN",
      "translation": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN",
      "romaji": "PUMPKIN PUMPKIN PUMPKIN PUMPKIN"
    },
    {
      "id": 22,
      "start": 49.98,
      "end": 51.51,
      "rubyText": "奪[うば]ったげるわ",
      "translation": "빼앗아 주겠어",
      "romaji": "ubattageru wa"
    },
    {
      "id": 23,
      "start": 51.51,
      "end": 53.0,
      "rubyText": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE",
      "translation": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE",
      "romaji": "ZOMBIE ZOMBIE ZOMBIE ZOMBIE"
    },
    {
      "id": 24,
      "start": 53.0,
      "end": 54.51,
      "rubyText": "痛[いた]くしないから",
      "translation": "아프지 않을 테니까",
      "romaji": "itaku shinai kara"
    },
    {
      "id": 25,
      "start": 54.51,
      "end": 58.62,
      "rubyText": "初[はじ]めて ボクが奪[うば]ったげるわ",
      "translation": "처음으로 내가 빼앗아 줄거야",
      "romaji": "hajimete boku ga ubattageru wa"
    },
    {
      "id": 26,
      "start": 59.45,
      "end": 60.84,
      "rubyText": "幼子[おさなご]のみんなへ",
      "translation": "착한 어린이들 모두에게",
      "romaji": "osanago no minna e"
    },
    {
      "id": 27,
      "start": 60.84,
      "end": 65.7,
      "rubyText": "今[いま]からボクは、お前[まえ]らの･････お宝[たから]をいただくに参上[さんじょう]します！",
      "translation": "지금부터 저는, 여러분의 보물을 받으러 가겠습니다!",
      "romaji": "ima kara boku wa, omaera no..... otakara o itadaku ni sanjou shimasu!"
    },
    {
      "id": 28,
      "start": 65.7,
      "end": 67.86,
      "rubyText": "from テト31世[せい]",
      "translation": "from 테토 31세",
      "romaji": "from teto sanjuu-issei"
    },
    {
      "id": 29,
      "start": 68.36,
      "end": 69.36,
      "rubyText": "p.s.",
      "translation": "p.s.",
      "romaji": "p.s."
    },
    {
      "id": 30,
      "start": 69.36,
      "end": 71.19,
      "rubyText": "ちなみにボクは、",
      "translation": "참고로 저는~ · · ·",
      "romaji": "chinamini boku wa,"
    },
    {
      "id": 31,
      "start": 71.19,
      "end": 75.42,
      "rubyText": "名画[めいが]も秘宝[ひほう]も、絶対[ぜったい]奪[うば]ったりなんてしないんだからね？",
      "translation": "명화도 보물도, 절~~대 빼앗거나 하지 않을 거라구요?",
      "romaji": "meiga mo hihou mo, zettai ubattari nante shinain dakara ne?"
    },
    {
      "id": 32,
      "start": 75.42,
      "end": 77.09,
      "rubyText": "ほ、本当[ほんとう]だよ？",
      "translation": "…저, 정말이라구",
      "romaji": "ho, hontou da yo?"
    },
    {
      "id": 33,
      "start": 77.09,
      "end": 78.04,
      "rubyText": "あー...",
      "translation": "아 그리고,",
      "romaji": "aa..."
    },
    {
      "id": 34,
      "start": 78.04,
      "end": 79.27,
      "rubyText": "最後[さいご]にひとこと...",
      "translation": "마지막으로 한마디...",
      "romaji": "saigo ni hitokoto..."
    },
    {
      "id": 35,
      "start": 79.27,
      "end": 82.98,
      "rubyText": "ういちゃんにどうしても伝[つた]えたいことがあるんだ",
      "translation": "우이한테 꼭 전하고 싶은 말이 있어",
      "romaji": "ui-chan ni doushitemo tsutaetai koto ga arun da"
    },
    {
      "id": 36,
      "start": 82.98,
      "end": 84.49,
      "rubyText": "おかしなこと言[い]ってもいい？",
      "translation": "이상한 소리 해도 돼?",
      "romaji": "okashina koto ittemo ii?"
    },
    {
      "id": 37,
      "start": 84.49,
      "end": 86.06,
      "rubyText": "ボクと結婚[けっこん]してくれ！",
      "translation": "나랑 결혼해 줘!",
      "romaji": "boku to kekkon shite kure!"
    },
    {
      "id": 38,
      "start": 86.06,
      "end": 88.99,
      "rubyText": "お前[まえ]と結婚[けっこん]するわけないだろがっ！？",
      "translation": "너랑 결혼할 리가 없잖아!?",
      "romaji": "omae to kekkon suru wake nai daro gaa!?"
    },
    {
      "id": 39,
      "start": 88.99,
      "end": 90.5,
      "rubyText": "（ぬあああああ！）",
      "translation": "크아아아아아아아아아악!",
      "romaji": "(nuaaaaaa!)"
    },
    {
      "id": 40,
      "start": 92.02,
      "end": 93.56,
      "rubyText": "PARTY PARTY PARTY PARTY",
      "translation": "PARTY PARTY PARTY PARTY",
      "romaji": "PARTY PARTY PARTY PARTY"
    },
