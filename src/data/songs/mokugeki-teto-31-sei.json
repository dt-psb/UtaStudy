    {
      "id": 46,
      "start": 101.0,
      "end": 103.99,
      "rubyText": "（CANDY CANDY COOKIE COOKIE） チョコレート！",
      "translation": "CANDY CANDY COOKIE COOKIE CHOCOLATE",
      "romaji": "(CANDY CANDY COOKIE COOKIE) chokoreeto!"
    },
    {
      "id": 47,
