    {
      "id": 12,
      "start": 48.39,
      "end": 52.43,
      "rubyText": "キミだけどリズムで行[い]こう",
      "translation": "너만의 리듬으로 가보자",
      "romaji": "kimi dakedo rizumu deikou"
    },
    {
      "id": 13,
      "start": 52.43,
      "end": 56.28,
      "rubyText": "1,2,3ちょっと回[まわ]ってここでストップ！",
