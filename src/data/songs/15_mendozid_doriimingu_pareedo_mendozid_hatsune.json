    {
      "id": 15,
      "start": 59.94,
      "end": 63.26,
      "rubyText": "溢[あふ]れる想[おも]いを伝[つた]えよう",
      "translation": "넘쳐나는 마음을 전해보자",
      "romaji": "afureruomoiwotsutaeyou"
    },
    {
      "id": 16,
      "start": 63.26,
      "end": 65.48,
      "rubyText": "ほら、夢[ゆめ]も希望[きぼう]も願[ねが]いも全[すべ]て",
