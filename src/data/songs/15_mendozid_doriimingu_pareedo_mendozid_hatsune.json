      "romaji": "yumemirutabinimieru sekai"
    },
    {
      "id": 10,
      "start": 40.66,
      "end": 44.63,
      "rubyText": "憧[あこが]れたあのミライ",
      "translation": "동경했던 그 미래",
      "romaji": "akogaretaano mirai"
    },
    {
      "id": 11,
      "start": 44.63,
      "end": 48.39,
      "rubyText": "カラフルなステップで夢[ゆめ]を彩[いろど]ろう",
