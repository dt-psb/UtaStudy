  "lyrics": [
    {
      "id": 1,
      "startTime": 1.69,
      "endTime": 4.42,
      "text": "僕[ぼく]の方[ほう]が好[す]きって 私[わたし]の方[ほう]が好[す]きって",
      "translation": "내가 더 좋아한다고 내가 더 좋하한다고",
      "start": 1.69,
      "end": 4.42,
      "rubyText": "僕[ぼく]の方[ほう]が好[す]きって 私[わたし]の方[ほう]が好[す]きって"
    },
    {
      "id": 2,
      "startTime": 4.42,
      "endTime": 7.31,
      "text": "張[は]り合[あ]えているうちが花盛[はなざか]り",
      "translation": "서로 겨룰 때가 꽃이고",
      "start": 4.42,
      "end": 7.31,
      "rubyText": "張[は]り合[あ]えているうちが花盛[はなざか]り"
    },
    {
      "id": 3,
      "startTime": 7.31,
      "endTime": 8.65,
      "text": "どうしたってボコボコにしちゃって",
      "translation": "아무래도 두들겨 맞을 수 밖에 없어",
      "start": 7.31,
      "end": 8.65,
      "rubyText": "どうしたってボコボコにしちゃって"
    },
    {
      "id": 4,
      "startTime": 8.65,
      "endTime": 10.19,
      "text": "サンドバッグで僕[ぼく]を殴[なぐ]ってね",
      "translation": "샌드백으로 나를 때려줘",
      "start": 8.65,
      "end": 10.19,
      "rubyText": "サンドバッグで僕[ぼく]を殴[なぐ]ってね"
    },
    {
      "id": 5,
      "startTime": 10.19,
      "endTime": 12.42,
      "text": "負[ま]け逃[に]げが無傷[むきず]なこんなゲームに",
      "translation": "지면서 도망치면 상처 안 받는 이런 게임에",
      "start": 10.19,
      "end": 12.42,
      "rubyText": "負[ま]け逃[に]げが無傷[むきず]なこんなゲームに"
    },
    {
      "id": 6,
      "startTime": 12.42,
      "endTime": 15.55,
      "text": "攻略法[こうりゃくほう]なんてありはしないぜ",
      "translation": "공략법 따위는 없을 거야",
      "start": 12.42,
      "end": 15.55,
      "rubyText": "攻略法[こうりゃくほう]なんてありはしないぜ"
    },
    {
      "id": 7,
      "startTime": 16.824,
      "endTime": 19.573,
      "text": "愛[あい]し合[あ]いたいって本能[ほんのう]がいらない",
      "translation": "서로 사랑하고 싶다는 본능이 필요 없다고",
      "start": 16.824,
      "end": 19.573,
      "rubyText": "愛[あい]し合[あ]いたいって本能[ほんのう]がいらない"
    },
    {
      "id": 8,
      "startTime": 19.573,
      "endTime": 22.45,
      "text": "って思[おも]ってもだいたい膨張[ぼうちょう]する心臓[しんぞう]僕[ぼく]ドクドクに",
      "translation": "생각하더라도 대부분 팽창된 내 심장이 두군거리고",
      "start": 19.573,
      "end": 22.45,
      "rubyText": "って思[おも]ってもだいたい膨張[ぼうちょう]する心臓[しんぞう]僕[ぼく]ドクドクに"
    },
    {
      "id": 9,
      "startTime": 22.45,
      "endTime": 23.47,
      "text": "キャンセル足払[あしばら]いで",
      "translation": "캔슬 다리 걸기로",
      "start": 22.45,
      "end": 23.47,
      "rubyText": "キャンセル足払[あしばら]いで"
    },
    {
      "id": 10,
      "startTime": 23.47,
      "endTime": 24.74,
      "text": "必殺[ひっさつ]コンボが地雷[じらい]",
      "translation": "필살 콤보가 지뢰",
      "start": 23.47,
      "end": 24.74,
      "rubyText": "必殺[ひっさつ]コンボが地雷[じらい]"
    },
    {
      "id": 11,
      "startTime": 24.74,
      "endTime": 26.363,
      "text": "言[い]わんこちゃない 揃[そろ]っちゃいない",
      "translation": "거 봐 내가 말했지 못 갖췄잖아",
      "start": 24.74,
      "end": 26.363,
      "rubyText": "言[い]わんこちゃない 揃[そろ]っちゃいない"
    },
    {
      "id": 12,
      "startTime": 26.363,
      "endTime": 27.73,
      "text": "ちっちゃい器[うつわ]にゃ毒毒[どくどく]",
      "translation": "작은 그릇으로 독 독",
      "start": 26.363,
      "end": 27.73,
      "rubyText": "ちっちゃい器[うつわ]にゃ毒毒[どくどく]"
    },
    {
      "id": 13,
      "startTime": 27.73,
      "endTime": 30.364,
      "text": "あり余[あま]ったHP 夜[よる]むなしくなる",
      "translation": "남아도는 HP 밤엔 허무해져",
      "start": 27.73,
      "end": 30.364,
      "rubyText": "あり余[あま]ったHP 夜[よる]むなしくなる"
    },
    {
      "id": 14,
      "startTime": 30.364,
      "endTime": 33.481,
      "text": "半分[はんぶん]こしたいけど 顔色[かおいろ]伺[うかが]って",
      "translation": "반반으로 하고 싶지만 눈치를 봐서",
      "start": 30.364,
      "end": 33.481,
      "rubyText": "半分[はんぶん]こしたいけど 顔色[かおいろ]伺[うかが]って"
    },
    {
      "id": 15,
      "startTime": 33.513,
      "endTime": 35.82,
      "text": "できないなんてそんなのなおさらじゃん",
      "translation": "할 수 없다면 그것은 더욱 필요하잖아",
      "start": 33.513,
      "end": 35.82,
      "rubyText": "できないなんてそんなのなおさらじゃん"
    },
    {
      "id": 16,
      "startTime": 35.82,
      "endTime": 38.73,
      "text": "手加減[てかげん]しない 攻略法[こうりゃくほう]あったら当[あ]てにしたい",
      "translation": "안 봐준다 공략법이 있다면 참고하고 싶어",
      "start": 35.82,
      "end": 38.73,
      "rubyText": "手加減[てかげん]しない 攻略法[こうりゃくほう]あったら当[あ]てにしたい"
    },
    {
      "id": 17,
      "startTime": 38.73,
      "endTime": 40.033,
      "text": "（はいはいはいはい）",
      "translation": "(하이 하이 하이 하이)",
      "start": 38.73,
      "end": 40.033,
      "rubyText": "（はいはいはいはい）"
    },
    {
      "id": 18,
      "startTime": 40.033,
      "endTime": 43.35,
      "text": "（君[きみ]の実力[じつりょく]はそんなものかな？）",
      "translation": "(너의 실력은 이 정도인가?)",
      "start": 40.033,
      "end": 43.35,
      "rubyText": "（君[きみ]の実力[じつりょく]はそんなものかな？）"
    },
    {
      "id": 19,
      "startTime": 49.61,
