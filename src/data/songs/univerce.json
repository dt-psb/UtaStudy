  "lyrics": [
    {
      "id": 1,
      "start": 14.73,
      "end": 25.27,
      "rubyText": "あぁ深[ふか]く青[あお]い夢[ゆめ]なら醒[さ]めたよ",
      "translation": "아아 깊고 푸른 꿈이라면 깨어났어",
      "romaji": "aa fukaku aoi yume nara sameta yo"
    },
    {
      "id": 2,
      "start": 25.28,
      "end": 29.48,
      "rubyText": "まだ水[みず]はかけないで",
      "translation": "아직 물은 뿌리지 말아줘",
      "romaji": "mada mizu wa kakenaide"
    },
    {
      "id": 3,
      "start": 30.91,
      "end": 38.32,
      "rubyText": "遠[とお]く放[はな]つせめて一光年[いっこうねん]",
      "translation": "저 멀리 빛나는 적어도 1광년 떨어진 곳",
      "romaji": "tooku hanatsu semete ikkounen"
    },
    {
      "id": 4,
      "start": 38.32,
      "end": 45.46,
      "rubyText": "浮[う]かぶ目立[めだ]つ 赤[あか]い色[いろ]飛行艇[ひこうてい]",
      "translation": "떠오르는 건 눈에 띄는 붉은색의 비행정",
      "romaji": "ukabu medatsu akai iro hikoutei"
    },
    {
      "id": 5,
      "start": 45.46,
      "end": 49.23,
      "rubyText": "これからどうしようね",
      "translation": "이제부터 어떻게 할까",
      "romaji": "kore kara dou shiyou ne"
    },
    {
      "id": 6,
      "start": 49.23,
      "end": 52.94,
      "rubyText": "そこまで走[はし]ろうぜ",
      "translation": "그곳까지 달려보자",
      "romaji": "soko made hashirou ze"
    },
    {
      "id": 7,
      "start": 52.94,
      "end": 56.31,
      "rubyText": "第二速度[だいにそくど]越[こ]えて",
      "translation": "제2속도를 뛰어넘어서",
      "romaji": "daini sokudo koete"
    },
    {
      "id": 8,
      "start": 56.31,
      "end": 59.08,
      "rubyText": "あの彼方[かなた]まで",
      "translation": "저편까지",
      "romaji": "ano kanata made"
    },
    {
      "id": 9,
      "start": 59.08,
      "end": 60.91,
      "rubyText": "今[いま]飛[と]び立[た]つ前夜[ぜんや]",
      "translation": "오늘은 날아오르기 전날 밤",
      "romaji": "ima tobitatsu zenya"
    },
    {
      "id": 10,
      "start": 60.91,
      "end": 62.65,
      "rubyText": "私[わたし] I DON'T CARE!!",
      "translation": "나는 I DON'T CARE!!",
      "romaji": "watashi I DON'T CARE!!"
    },
    {
      "id": 11,
      "start": 62.65,
      "end": 66.52,
      "rubyText": "あの銀河系[ぎんがけい]手[て]を伸[の]ばすと届[とど]きそうな",
      "translation": "저 은하계는 손을 뻗으면 닿을 것 같아",
      "romaji": "ano gingakei te wo nobasu to todokisou na"
    },
    {
      "id": 12,
      "start": 66.52,
      "end": 70.25,
      "rubyText": "飛[と]び越[こ]えられそうな可能性[かのうせい]さえも",
      "translation": "뛰어넘을 수 있을 것 같은 가능성조차도!!",
      "romaji": "tobikoerareru you na kanousei sae mo"
    },
    {
      "id": 13,
      "start": 70.25,
      "end": 74.02,
      "rubyText": "まだ未完成[みかんせい]でも一光年[いっこうねん]先[さき]へ!!",
      "translation": "아직 미완성이지만 1광년 너머를 향해!!",
      "romaji": "mada mikansei demo ikkounen saki e!!"
    },
    {
      "id": 14,
      "start": 86.84,
      "end": 89.14,
      "rubyText": "想像[そうぞう]を超[こ]えて!!",
      "translation": "상상을 뛰어넘어서!!",
      "romaji": "souzou wo koete!!"
    },
    {
      "id": 15,
      "start": 118.23,
      "end": 126.68,
      "rubyText": "あぁ固[かた]く錆[さび]ついたネジを解[ほど]いて",
      "translation": "아아 굳어버린 녹슨 나사를 풀고",
      "romaji": "aa kataku sabitsuita neji wo hodoite"
    },
    {
      "id": 16,
      "start": 126.68,
      "end": 132.05,
      "rubyText": "きっと僕[ぼく]らたどり着[つ]けるはずさ",
      "translation": "분명 우리는 다다를 수 있을 거야",
      "romaji": "kitto bokura tadoritsukeru hazu sa"
    },
    {
      "id": 17,
      "start": 132.05,
      "end": 135.95,
      "rubyText": "いつか取[と]り巻[ま]く衛星[えいせい]",
      "translation": "언젠가 둘러싸일 위성",
      "romaji": "itsuka torimaku eisei"
    },
    {
      "id": 18,
      "start": 135.95,
      "end": 141.62,
      "rubyText": "あの彗星[すいせい]流[なが]れる流星[りゅうせい]に",
      "translation": "저 혜성과 떨어지는 유성을",
      "romaji": "ano suisei nagareru ryuusei ni"
    },
    {
      "id": 19,
      "start": 141.62,
      "end": 147.93,
      "rubyText": "線[せん]をつなげて目印[めじるし]にして",
      "translation": "선으로 이어서 이정표로 삼아",
      "romaji": "sen wo tsunagete mejirushi ni shite"
    },
    {
      "id": 20,
      "start": 154.1,
      "end": 156.91,
      "rubyText": "それは全然[ぜんぜん]怖[こわ]くは無[な]いよ",
      "translation": "그런 건 전혀 무섭지 않아",
      "romaji": "sore wa zenzen kowaku wa nai yo"
    },
    {
      "id": 21,
      "start": 156.91,
      "end": 158.94,
      "rubyText": "当然[とうぜん]傷[きず]はつくよ",
      "translation": "당연히 상처는 나지",
      "romaji": "touzen kizu wa tsuku yo"
    },
    {
      "id": 22,
      "start": 158.94,
      "end": 160.68,
      "rubyText": "前線[ぜんせん]引[ひ]かずに行[い]くよ",
      "translation": "전선은 물리지 않고 갈게",
      "romaji": "zensen hikazu ni iku yo"
    },
    {
      "id": 23,
      "start": 160.68,
      "end": 162.61,
      "rubyText": "サイレン鳴[な]り止[や]まないよ",
