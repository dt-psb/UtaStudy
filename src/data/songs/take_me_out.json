  "thumbnail": "https://img.youtube.com/vi/L6e6fjlQiL8/hqdefault.jpg",
  "duration": 169,
  "lyrics": [
    {
      "id": 1,
      "start": 16.33,
      "end": 18.76,
      "rubyText": "好[す]きなものは何[なん]ですか？",
      "translation": "좋아하는 것은 무엇인가요?",
      "romaji": "sukina mono wa nan desu ka?"
    },
    {
      "id": 2,
      "start": 19.14,
      "end": 21.65,
      "rubyText": "パッと思[おも]い出[だ]せないや",
      "translation": "문득 떠오르지 않는걸",
      "romaji": "patto omoidasenai ya"
    },
    {
      "id": 3,
      "start": 21.65,
      "end": 24.59,
      "rubyText": "変[か]わり映[ば]えのない毎日[まいにち]だな",
      "translation": "색다를 것 없는 매일이네",
      "romaji": "kawaribae no nai mainichi da na"
    },
    {
      "id": 4,
      "start": 24.59,
      "end": 26.76,
      "rubyText": "グッとくるようなトキメキはどこ？",
      "translation": "가슴을 울리는 설렘은 어디에 있어?",
      "romaji": "gutto kuru youna tokimeki wa doko?"
    },
    {
      "id": 5,
      "start": 27.35,
      "end": 29.48,
      "rubyText": "Take me out! Take me out",
      "translation": "날 데리고 나가줘! 데리고 가줘",
      "romaji": "Take me out! Take me out"
    },
    {
      "id": 6,
      "start": 29.82,
      "end": 32.31,
      "rubyText": "どこでもいい なんでもいいさ",
      "translation": "어디라도 좋아 뭐든 상관없어",
      "romaji": "doko demo ii nandemo ii sa"
    },
    {
      "id": 7,
      "start": 32.31,
      "end": 34.59,
      "rubyText": "Take me out! Take me out!",
      "translation": "날 데리고 나가줘! 데리고 가줘!",
      "romaji": "Take me out! Take me out!"
    },
    {
      "id": 8,
      "start": 34.93,
      "end": 36.92,
      "rubyText": "君[きみ]と一緒[いっしょ]なら",
      "translation": "너와 함께라면",
      "romaji": "kimi to issho nara"
    },
    {
      "id": 9,
      "start": 37.4,
      "end": 42.51,
      "rubyText": "俯[うつむ]いた時[とき]に思[おも]い出[だ]した言葉[ことば]",
      "translation": "고개를 떨궜을 때 떠올렸던 말",
      "romaji": "utsumuita toki ni omoidashita kotoba"
    },
    {
      "id": 10,
      "start": 42.51,
      "end": 47.42,
      "rubyText": "最後[さいご]に笑[わら]えたらそれでいい",
      "translation": "마지막에 웃을 수 있다면 그걸로 됐어",
      "romaji": "saigo ni waraetara sore de ii"
    },
    {
      "id": 11,
      "start": 47.89,
      "end": 52.66,
      "rubyText": "踊[おど]れ 歌[うた]え 伝[つた]えたい思[おも]いの丈[たけ]",
      "translation": "춤춰라 노래해라 전하고 싶은 마음의 전부를",
      "romaji": "odore utae tsutaetai omoi no take"
    },
    {
      "id": 12,
      "start": 52.66,
      "end": 58.16,
      "rubyText": "ひとつあればもう怖[こわ]くはない",
      "translation": "하나라도 있다면 더는 두렵지 않아",
      "romaji": "hitotsu areba mou kowaku wa nai"
    },
    {
      "id": 13,
      "start": 58.16,
      "end": 63.48,
      "rubyText": "泳[およ]げ 走[はし]れ 涙[なみだ]を堪[こら]えながら",
      "translation": "헤엄쳐라 달려라 눈물을 삼키면서",
      "romaji": "oyoge hashire namida o koraenagara"
    },
    {
      "id": 14,
      "start": 63.48,
      "end": 69.61,
      "rubyText": "手[て]をとって二人[ふたり]で笑[わら]いたい",
      "translation": "손을 잡고 둘이서 웃고 싶어",
      "romaji": "te o totte futari de waraitai"
    },
    {
      "id": 15,
      "start": 80.54,
      "end": 82.7,
      "rubyText": "Take me out! Take me out!",
      "translation": "날 데리고 나가줘! 데리고 가줘!",
      "romaji": "Take me out! Take me out!"
    },
    {
      "id": 16,
      "start": 83.06,
      "end": 85.57,
      "rubyText": "世界[せかい]から 宇宙[うちゅう]の果[は]てまで",
      "translation": "세상에서 우주의 끝까지",
      "romaji": "sekai kara uchuu no hate made"
    },
    {
      "id": 17,
      "start": 85.93,
      "end": 88.13,
      "rubyText": "Take me out! Take me out!",
      "translation": "날 데리고 나가줘! 데리고 가줘!",
      "romaji": "Take me out! Take me out!"
    },
    {
      "id": 18,
      "start": 88.13,
      "end": 91.3,
      "rubyText": "どこまでだって音[おと]に乗[の]って行[い]こう",
      "translation": "어디까지든 음악에 몸을 싣고 가자",
      "romaji": "doko made datte oto ni notte ikou"
    },
    {
      "id": 19,
      "start": 103.59,
      "end": 108.95,
      "rubyText": "あの時[とき] ああすれば良[よ]かったなんて",
      "translation": "그때 그렇게 했으면 좋았을 텐데 하고",
      "romaji": "ano toki aa sureba yokatta nante"
    },
    {
      "id": 20,
      "start": 108.95,
      "end": 112.02,
      "rubyText": "思[おも]うこともあるけれど",
      "translation": "생각할 때도 있지만",
      "romaji": "omou koto mo aru keredo"
    },
    {
      "id": 21,
      "start": 112.02,
      "end": 115.23,
      "rubyText": "今[いま]があるから出会[であ]えたんだ",
      "translation": "지금이 있기에 만날 수 있었던 거야",
      "romaji": "ima ga aru kara deaetan da"
    },
    {
      "id": 22,
      "start": 115.23,
      "end": 117.99,
      "rubyText": "間違[まちが]いないって思[おも]えた",
      "translation": "틀림없다고 생각했어",
      "romaji": "machigainai tte omoeta"
    },
    {
      "id": 23,
      "start": 118.33,
      "end": 120.24,
      "rubyText": "これからさ",
      "translation": "이제부터야",
      "romaji": "kore kara sa"
    },
    {
