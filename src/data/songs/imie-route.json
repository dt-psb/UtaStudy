  "lyrics": [
    {
      "id": 1,
      "startTime": 9.36,
      "endTime": 13.16,
      "text": "何[なに]かを知[し]るだけならば 歩[ある]く事[こと]もないだろう",
      "translation": "무언가를 알뿐이라면 걸을 일도 없겠지",
      "start": 9.36,
      "end": 13.16,
      "rubyText": "何[なに]かを知[し]るだけならば 歩[ある]く事[こと]もないだろう"
    },
    {
      "id": 2,
      "startTime": 13.16,
      "endTime": 16.8,
      "text": "ここから動[うご]かずとも全[すべ]て手[て]に入[はい]る",
      "translation": "여기서 움직이지 않아도 모두 손에 들어올 거야",
      "start": 13.16,
      "end": 16.8,
      "rubyText": "ここから動[うご]かずとも全[すべ]て手[て]に入[はい]る"
    },
    {
      "id": 3,
      "startTime": 24.6,
      "endTime": 28.56,
      "text": "それに触[ふ]れたいならば 歩[ある]くには遠[とお]いだろう",
      "translation": "그걸 손대고 싶다면 걷기에는 멀지",
      "start": 24.6,
      "end": 28.56,
      "rubyText": "それに触[ふ]れたいならば 歩[ある]くには遠[とお]いだろう"
    },
    {
      "id": 4,
      "startTime": 28.56,
      "endTime": 32.18,
      "text": "ここから見[み]えない全[すべ]てが見[み]たいなら",
      "translation": "여기서 보이지 않는 모든 것들이 보고 싶다면",
      "start": 28.56,
      "end": 32.18,
      "rubyText": "ここから見[み]えない全[すべ]てが見[み]たいなら"
    },
    {
      "id": 5,
      "startTime": 34.36,
      "endTime": 38.34,
      "text": "乗[の]りたいものに乗[の]り",
      "translation": "타고 싶은 것에 타고",
      "start": 34.36,
      "end": 38.34,
      "rubyText": "乗[の]りたいものに乗[の]り"
    },
    {
      "id": 6,
      "startTime": 41.98,
      "endTime": 46.08,
      "text": "風[かぜ]を切[き]って進[すす]む",
      "translation": "바람을 가르며 나아가자",
      "start": 41.98,
      "end": 46.08,
      "rubyText": "風[かぜ]を切[き]って進[すす]む"
    },
    {
      "id": 7,
      "startTime": 51.14,
      "endTime": 55.1,
      "text": "どこまで行[い]けるだろうか",
      "translation": "어디까지 갈 수 있을까",
      "start": 51.14,
      "end": 55.1,
      "rubyText": "どこまで行[い]けるだろうか"
    },
    {
      "id": 8,
      "startTime": 58.9,
      "endTime": 62.84,
      "text": "道[みち]は長[なが]く続[つづ]く",
      "translation": "길은 길고 계속돼",
      "start": 58.9,
      "end": 62.84,
      "rubyText": "道[みち]は長[なが]く続[つづ]く"
    },
    {
      "id": 9,
      "startTime": 78.56,
      "endTime": 82.32,
      "text": "歌声[うたごえ]が聴[き]こえている 知[し]らない言葉[ことば]の",
      "translation": "노랫소리가 들리고 있어 모르는 말의",
      "start": 78.56,
      "end": 82.32,
      "rubyText": "歌声[うたごえ]が聴[き]こえている 知[し]らない言葉[ことば]の"
    },
    {
      "id": 10,
      "startTime": 82.32,
      "endTime": 86.1,
      "text": "リズムに乗[の]れていれば分[わ]かり合[あ]えるだろう",
      "translation": "리듬을 타고 있으면 이해할 수 있겠지",
      "start": 82.32,
      "end": 86.1,
      "rubyText": "リズムに乗[の]れていれば分[わ]かり合[あ]えるだろう"
    },
    {
      "id": 11,
      "startTime": 86.1,
      "endTime": 89.96,
      "text": "ラジオが伝[つた]えている 知[し]らない言葉[ことば]で",
      "translation": "라디오가 전하는 모르는 말이",
      "start": 86.1,
      "end": 89.96,
      "rubyText": "ラジオが伝[つた]えている 知[し]らない言葉[ことば]で"
    },
    {
      "id": 12,
      "startTime": 89.96,
      "endTime": 93.58,
      "text": "すれ違[ちが]い続[つづ]ければ解[わか]らないだろう",
      "translation": "계속 스쳐 지나간다면 모르겠지",
      "start": 89.96,
      "end": 93.58,
      "rubyText": "すれ違[ちが]い続[つづ]ければ解[わか]らないだろう"
    },
    {
      "id": 13,
      "startTime": 95.82,
      "endTime": 99.72,
      "text": "美[うつく]しく広大[こうだい]な",
      "translation": "아름답고 광활한",
      "start": 95.82,
      "end": 99.72,
      "rubyText": "美[うつく]しく広大[こうだい]な"
    },
    {
      "id": 14,
      "startTime": 103.36,
      "endTime": 107.84,
      "text": "世界[せかい]を見[み]に来[き]たのに",
      "translation": "세계를 보기 위해 왔는데",
      "start": 103.36,
      "end": 107.84,
      "rubyText": "世界[せかい]を見[み]に来[き]たのに"
    },
    {
      "id": 15,
      "startTime": 110.96,
      "endTime": 114.88,
