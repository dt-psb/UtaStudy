  "lyrics": [
    {
      "id": 1,
      "start": 0.0,
      "end": 1.51,
      "rubyText": "ぎゃあああ 知[し]らないことが",
      "translation": "좀 더",
      "romaji": "gyaaaa   shira naikotoga"
    },
    {
      "id": 2,
      "start": 1.53,
      "end": 4.54,
      "rubyText": "どんどん たのしいね",
      "translation": "점점 재밌어져",
      "romaji": "dondon   tanoshiine"
    },
    {
      "id": 3,
      "start": 4.57,
      "end": 6.24,
      "rubyText": "おべんきょうしよう",
      "translation": "공부를 하자",
      "romaji": "obenkyoushiyou"
    },
    {
      "id": 4,
      "start": 17.42,
      "end": 18.8,
      "rubyText": "どうして いきものみる  かわいい の",
      "translation": "어째서 생물을 보면 = 귀엽다 인걸까",
      "romaji": "doushite   ikimonomiru     kawaii   no"
    },
    {
      "id": 5,
      "start": 18.82,
      "end": 20.34,
      "rubyText": "どうして おうちいる  あんしん ？",
      "translation": "어째서 집에 있으면 = 안심 ?",
      "romaji": "doushite   ouchiiru     anshin   ？"
    },
    {
      "id": 6,
      "start": 20.37,
      "end": 21.77,
      "rubyText": "どうして おいわい  うれしい こと？",
      "translation": "어째서 축하 = 기쁜 일 ?",
      "romaji": "doushite   oiwai     ureshii   koto ？"
    },
    {
      "id": 7,
      "start": 21.8,
      "end": 23.26,
      "rubyText": "わからない だらけ",
      "translation": "모르는 것이 너무 많아",
      "romaji": "wakaranai   darake"
    },
    {
      "id": 8,
      "start": 23.28,
      "end": 24.68,
      "rubyText": "あってる？ うんどう  たのしい こと。",
      "translation": "맞아? 운동 = 즐거운 것.",
      "romaji": "atteru ？   undou     tanoshii   koto ."
    },
    {
      "id": 9,
      "start": 24.7,
      "end": 26.18,
      "rubyText": "どうして きみは  いやがる の？",
      "translation": "어째서 너는 = 싫어한다 야?",
      "romaji": "doushite   kimiha     iyagaru   no ？"
    },
    {
      "id": 10,
      "start": 26.21,
      "end": 27.61,
      "rubyText": "どうして どうして みつける",
      "translation": "어째서 어째서를 발견하는",
      "romaji": "doushite   doushite   mitsukeru"
    },
    {
      "id": 11,
      "start": 27.64,
      "end": 29.04,
      "rubyText": "おべんきょう",
      "translation": "공부",
      "romaji": "obenkyou"
    },
    {
      "id": 12,
      "start": 29.06,
      "end": 30.26,
      "rubyText": "校閲[こうえつ]教育[きょういく]構成[こうせい]",
      "translation": "교열 교육 구성",
      "romaji": "kouetsu kyouiku kousei"
    },
    {
      "id": 13,
      "start": 30.28,
      "end": 31.76,
      "rubyText": "また効率[こうりつ]調律[ちょうりつ]矯正[きょうせい]",
      "translation": "또는 효율 조율 교정",
      "romaji": "mata kouritsu chouritsu kyousei"
    },
    {
      "id": 14,
      "start": 31.78,
      "end": 33.24,
      "rubyText": "また欠陥[けっかん]打擲[ちょうちゃく]更生[こうせい]",
      "translation": "또는 결함 타척 갱생",
      "romaji": "mata kekkan chouchaku kousei"
    },
    {
      "id": 15,
      "start": 33.27,
      "end": 34.6,
      "rubyText": "あれ時間[じかん]がない",
      "translation": "어라 시간이 없어",
      "romaji": "are jikan ganai"
    },
    {
      "id": 16,
      "start": 34.9,
      "end": 36.2,
      "rubyText": "存在[そんざい]認識[にんしき]解析[かいせき]",
      "translation": "존재 인식 분석",
      "romaji": "sonzai ninshiki kaiseki"
    },
    {
      "id": 17,
      "start": 36.23,
      "end": 37.62,
      "rubyText": "また言語化[げんごか]出力[しゅつりょく]発声[はっせい]",
      "translation": "또는 언어화 출력 발성",
      "romaji": "mata gengoka shutsuryoku hassei"
    },
    {
      "id": 18,
      "start": 37.65,
      "end": 39.04,
      "rubyText": "ほらだんだんおとなになってく！",
      "translation": "자 점점 어른이 되어가 !",
      "romaji": "horadandan'otonaninatteku !"
    },
    {
      "id": 19,
      "start": 39.07,
      "end": 40.92,
      "rubyText": "ArrayIndexOutOfBoundsException ※読み方[よみかた]：情報[じょうほう]膨大[ぼうだい]NO（脳[のう]）問題[もんだい]ない！",
      "translation": "ArrayIndexOutOfBoundsException ※읽는 법：정보 방대 NO (뇌) 문제 없음",
      "romaji": "ArrayIndexOutOfBoundsException  ※ yomikata : jouhou boudai NO ( nou ) mondai nai !"
    },
    {
      "id": 20,
      "start": 40.95,
      "end": 41.95,
      "rubyText": "正解[せいかい]  へんだへんだへんだへんだ",
