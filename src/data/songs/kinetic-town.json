{
  "id": "kinetic-town",
  "title": "キネティックタウン",
  "artist": "晴いちばん feat. 初音ミク",
  "youtubeId": "AdT_lmdC39g",
  "lyrics": [
    {
      "id": 1,
      "ruby": "幼[おさな]い頃[ころ]覚[おぼ]えた　無機物[むきぶつ]の優[やさ]しさは",
      "translation": "어릴 적에 배웠던 무생물의 다정함은",
      "romaji": "osanai koro oboeta mukibutsu no yasashisa wa",
      "startTime": 15.2,
      "endTime": 22.67
    },
    {
      "id": 2,
      "ruby": "硝子[ガラス]ほど脆[もろ]くて",
      "translation": "유리처럼 너무나도 연약해서",
      "romaji": "garasu hodo morokute",
      "startTime": 22.67,
      "endTime": 26.44
    },
    {
      "id": 3,
      "ruby": "壊[こわ]してしまいそうになった",
      "translation": "부서뜨려 버릴 것만 같았어",
      "romaji": "kowashite shimai sou ni natta",
      "startTime": 26.44,
      "endTime": 30.25
    },
    {
      "id": 4,
      "ruby": "どうやら今日[きょう]は　煙日和[けむりびより]らしい",
      "translation": "오늘은 왠지 그을음이 흐르는 날이래",
      "romaji": "douyara kyou wa kemuribiyori rashii",
      "startTime": 30.25,
      "endTime": 35.09
    },
    {
      "id": 5,
      "ruby": "錆[さ]びついた香[かお]りがした",
      "translation": "녹슨 듯한 냄새가 났어",
      "romaji": "sabitsuita kaori ga shita",
      "startTime": 35.09,
      "endTime": 37.59
    },
    {
      "id": 6,
      "ruby": "スクラップから　生[う]まれた心[こころ]を",
      "translation": "스크랩에서 태어난 마음을",
      "romaji": "sukurappu kara umareta kokoro o",
      "startTime": 37.69,
      "endTime": 42.56
    },
    {
      "id": 7,
      "ruby": "取[と]り零[こぼ]さないように",
      "translation": "놓쳐버리지 않도록",
      "romaji": "torikobosanai you ni",
      "startTime": 42.56,
      "endTime": 45.2
    },
    {
      "id": 8,
      "ruby": "壊[こわ]れかけた時計塔[とけいとう]の",
      "translation": "무너져 가는 시계탑의",
      "romaji": "kowarekaketa tokeitou no",
      "startTime": 45.2,
      "endTime": 48.87
    },
    {
      "id": 9,
      "ruby": "針[はり]が重[かさ]なってく",
      "translation": "바늘이 포개어져 가네",
      "romaji": "hari ga kasanatteku",
      "startTime": 48.87,
      "endTime": 52.67
    },
    {
      "id": 10,
      "ruby": "キネティックな街[まち]で生[い]きてるんだ",
      "translation": "키네틱한 거리에 우리는 살아가",
      "romaji": "kinetikku na machi de ikiterun da",
      "startTime": 52.67,
      "endTime": 56.34
    },
    {
      "id": 11,
      "ruby": "嚙[か]み合[あ]わないから楽[たの]しいんだ",
      "translation": "맞물리지 않으니 즐거운 거야",
      "romaji": "kamiawanai kara tanoshiin da",
      "startTime": 56.34,
      "endTime": 60.18
    },
    {
      "id": 12,
      "ruby": "貯[た]め込[こ]んだ熱[ねつ]で語[かた]り明[あ]かそうぜ",
      "translation": "쌓여온 열기로 밤새 얘기하자",
      "romaji": "tamekonda netsu de katariakasou ze",
      "startTime": 60.18,
      "endTime": 63.88
    },
    {
      "id": 13,
      "ruby": "ここが居場所[いばしょ]なら悪[わる]くないな",
      "translation": "여기가 우리 자리라면 나쁘지 않네",
      "romaji": "koko ga ibasho nara warukunai na",
      "startTime": 63.88,
      "endTime": 67.72
    },
    {
      "id": 14,
      "ruby": "世界[せかい]に見[み]つからないように",
      "translation": "세상에 들키지 않도록",
      "romaji": "sekai ni mitsukaranai you ni",
      "startTime": 75.16,
      "endTime": 78.93
    },
    {
      "id": 15,
      "ruby": "心[こころ]は閉[と]じたままで",
      "translation": "마음은 닫아 둔 채로",
      "romaji": "kokoro wa tojita mama de",
      "startTime": 78.93,
      "endTime": 82.67
    },
    {
      "id": 16,
      "ruby": "許[ゆる]されないと知[し]っても",
      "translation": "용서 받지 못할 걸 알면서도",
      "romaji": "yurusarenai to shittemo",
      "startTime": 82.67,
      "endTime": 86.5
    },
    {
      "id": 17,
      "ruby": "君[きみ]となら怖[こわ]くはないよ",
      "translation": "너와 함께라면 두렵지 않아",
      "romaji": "kimi to nara kowaku wa nai yo",
      "startTime": 86.5,
      "endTime": 90.27
    },
    {
      "id": 18,
      "ruby": "また独[ひと]りになる夢[ゆめ]を見[み]たの",
      "translation": "다시 혼자가 되는 꿈을 꾸었어",
      "romaji": "mata hitori ni naru yume o mita no",
      "startTime": 94.01,
      "endTime": 97.68
    },
    {
      "id": 19,
      "ruby": "全部[ぜんぶ]忘[わす]れたくなるけど",
      "translation": "전부 잊고 싶어지지만",
      "romaji": "zenbu wasuretaku naru kedo",
      "startTime": 101.58,
      "endTime": 105.22
    },
    {
      "id": 20,
      "ruby": "壊[こわ]れかけた歯車[はぐるま]では",
      "translation": "부서져가는 톱니바퀴로는",
      "romaji": "kowarekaketa haguruma de wa",
      "startTime": 105.22,
      "endTime": 108.86
    },
    {
      "id": 21,
      "ruby": "君[きみ]を救[すく]えないから",
      "translation": "너를 구할 수 없을테니까",
      "romaji": "kimi o sukuenai kara",
      "startTime": 108.93,
      "endTime": 112.66
    },
    {
      "id": 22,
      "ruby": "キネティックな街[まち]は生[い]きてるんだ",
      "translation": "키네틱한 거리는 살아 움직여",
      "romaji": "kinetikku na machi wa ikiterun da",
      "startTime": 112.66,
      "endTime": 116.17
    },
    {
      "id": 23,
      "ruby": "動力源[どうりょくげん]は憎[にく]しみなんだ",
      "translation": "원동력은 바로 증오라네",
      "romaji": "douryokugen wa nikushiminan da",
      "startTime": 116.17,
      "endTime": 120.14
    },
    {
      "id": 24,
      "ruby": "背負[せお]い込[こ]んだ罪[つみ]が背中[せなか]を叩[たた]いた",
      "translation": "짊어진 죄가 등을 두드렸어",
      "romaji": "seoikonda tsumi ga senaka o tataita",
      "startTime": 120.14,
      "endTime": 123.87
    },
    {
      "id": 25,
      "ruby": "なるようになれるのなら",
      "translation": "될 대로 된다면야",
      "romaji": "naru you ni nareru no nara",
      "startTime": 123.87,
      "endTime": 127.18
    },
    {
      "id": 26,
      "ruby": "キネティックな街[まち]を出[で]て行[い]こうぜ",
      "translation": "키네틱한 거리를 벗어나자",
      "romaji": "kinetikku na machi o dete ikou ze",
      "startTime": 127.68,
      "endTime": 131.15
    },
    {
      "id": 27,
      "ruby": "どこまでだって逃避行[とうひこう]さ",
      "translation": "어디까지든 도피할거야",
      "romaji": "doko made datte touhikou sa",
      "startTime": 131.15,
      "endTime": 135.19
    },
    {
      "id": 28,
      "ruby": "躊躇[ためら]うこともない　煙[けむり]の向[む]こうで",
      "translation": "망설일 것도 없어, 연기 저 너머에서",
      "romaji": "tamerau koto mo nai kemuri no mukou de",
      "startTime": 135.19,
      "endTime": 138.92
    },
    {
      "id": 29,
      "ruby": "本当[ほんとう]の居場所[いばしょ]を見[み]つけに行[い]こう",
      "translation": "진짜 우리 자리를 찾으러 가자",
      "romaji": "hontou no ibasho o mitsuke ni ikou",
      "startTime": 138.92,
      "endTime": 142.5
    }
  ],
