{
  "id": "nihachi-oimearcy",
  "title": "オイメアルシー (oimearcy)",
  "artist": "88 / nihachi feat. 知声",
  "youtubeId": "9v_0TZ4XMuw",
  "thumbnail": "https://img.youtube.com/vi/9v_0TZ4XMuw/hqdefault.jpg",
  "duration": 163,
  "lyrics": [
    {
      "id": 1,
      "start": 16.25,
      "end": 19.58,
      "rubyText": "それはそれで　気[き]になっちゃうでしょ",
      "translation": "그건 그것대로 신경 쓰이잖아?",
      "romaji": "sore wa sore de kininacchau desho"
    },
    {
      "id": 2,
      "start": 19.58,
      "end": 22.91,
      "rubyText": "何事[なにごと]もなかったような　顔[かお]",
      "translation": "아무 일도 없었다는 듯한 얼굴",
      "romaji": "nanigoto mo nakatta you na kao"
    },
    {
      "id": 3,
      "start": 22.91,
      "end": 26.45,
      "rubyText": "寝[ね]ても覚[さ]めても　へばりつくの",
      "translation": "자나 깨나 자꾸 달라붙어",
      "romaji": "netemo sametemo hebaritsuku no"
    },
    {
      "id": 4,
      "start": 26.45,
      "end": 30.45,
      "rubyText": "気[き]にしてない　とか　言[い]うからさ",
      "translation": "신경 안 쓴다 같은 소릴 하니까",
      "romaji": "ki ni shitenai toka iu kara sa"
    },
    {
      "id": 5,
      "start": 30.45,
      "end": 33.79,
      "rubyText": "準備[じゅんび]してます　とびっきりの",
      "translation": "준비하고 있어, 제일로",
      "romaji": "junbi shitemasu tobikkiri no"
    },
    {
      "id": 6,
      "start": 33.79,
      "end": 38.04,
      "rubyText": "申[もう]し訳[わけ]なさそうな　顔[かお]",
      "translation": "미안해하는 듯한 얼굴",
      "romaji": "moushiwakenasasou na kao"
    },
    {
      "id": 7,
      "start": 38.04,
      "end": 40.7,
      "rubyText": "うそうそ！　嘘[うそ]じゃないよ？",
      "translation": "장난이야! 거짓말 아냐?",
      "romaji": "uso uso! uso ja nai yo?"
    },
    {
      "id": 8,
      "start": 40.7,
      "end": 44.7,
      "rubyText": "心[こころ]の底[そこ]から　思[おも]ってる",
      "translation": "진심으로 그렇게 생각하고 있어",
      "romaji": "kokoro no soko kara omotteru"
    },
    {
      "id": 9,
      "start": 46.45,
      "end": 50.04,
      "rubyText": "オイメアルシー　道草[みちくさ]はかどってさ",
      "translation": "oimearcy, 딴길로 새는 게 너무 순조로워서",
      "romaji": "oimearushii michikusa hakadotte sa"
    },
    {
      "id": 10,
      "start": 50.04,
      "end": 53.78,
      "rubyText": "オイメアルシー　そこまで来[き]てるけど",
      "translation": "oimearcy, 거기까지 다 왔는데, 근데...",
      "romaji": "oimearushii soko made kiteru kedo"
    },
    {
      "id": 11,
      "start": 53.78,
      "end": 57.03,
      "rubyText": "どっか引[ひ]っかかっちゃって　取[と]り出[だ]せないの",
      "translation": "어딘가 걸려버려서 꺼낼 수가 없어",
      "romaji": "dokka hikkakacchatte toridasenai no"
    },
    {
      "id": 12,
      "start": 57.03,
      "end": 58.95,
      "rubyText": "ごめんね　ごめんね",
      "translation": "미안해, 미안해.",
      "romaji": "gomen ne gomen ne"
    },
    {
      "id": 13,
      "start": 72.29,
      "end": 75.57,
      "rubyText": "背[せ]伸[の]びしすぎ　痛[いた]むつま先[さき]",
      "translation": "너무 무리해서 발돋움했나, 아파오는 발끝",
      "romaji": "senobi shisugi itamu tsumasaki"
    },
    {
      "id": 14,
      "start": 75.57,
      "end": 79.11,
      "rubyText": "親指[おやゆび]の爪[つめ]　割[わ]れてる",
      "translation": "엄지발톱은 깨져 있어",
      "romaji": "oyayubi no tsume wareteru"
    },
    {
      "id": 15,
      "start": 79.11,
      "end": 82.49,
      "rubyText": "みのたけ　と　おもいのたけ",
      "translation": "나의 진짜 키, 그리고 나의 진짜 마음",
      "romaji": "minotake to omoinotake"
    },
    {
      "id": 16,
      "start": 82.49,
      "end": 86.41,
      "rubyText": "なんて　生[い]きづらい　世[よ]の中[なか]だ",
      "translation": "참 살아가기 힘든 세상이야",
      "romaji": "nante ikizurai yo no naka da"
    },
    {
      "id": 17,
      "start": 86.41,
      "end": 89.74,
      "rubyText": "そんなことは　どうでもよくて",
      "translation": "그런 건 아무래도 좋고,",
      "romaji": "sonna koto wa dou demo yokute"
    },
    {
      "id": 18,
      "start": 89.74,
      "end": 94.07,
      "rubyText": "すぐにでも　会[あ]いたくて",
      "translation": "당장이라도 만나고 싶어서—",
      "romaji": "sugu ni demo aitakute"
    },
    {
      "id": 19,
      "start": 94.07,
      "end": 97.78,
      "rubyText": "うそうそ！　会[あ]いたくなくて",
      "translation": "장난이야! 만나고 싶지 않아,",
      "romaji": "uso uso! aitakunakute"
    },
    {
      "id": 20,
      "start": 97.78,
      "end": 99.32,
      "rubyText": "まだ　無理[むり]",
      "translation": "아직은, 도저히 안 돼.",
      "romaji": "mada muri"
    },
    {
      "id": 21,
      "start": 122.05,
      "end": 125.61,
      "rubyText": "オイメアルシー　不安[ふあん]の材料[ざいりょう]を",
      "translation": "oimearcy, 불안의 재료를",
      "romaji": "oimearushii fuan no zairyou o"
    },
    {
      "id": 22,
      "start": 125.61,
      "end": 129.4,
      "rubyText": "オイメアルシー　ことこと煮[に]込[こ]んでます",
      "translation": "oimearcy, 보글보글 푹 끓이고 있어",
      "romaji": "oimearushii kotokoto nikondemasu"
    },
    {
      "id": 23,
      "start": 129.4,
      "end": 133.44,
      "rubyText": "いっそもっときつく　しかりつけてよ",
      "translation": "차라리 더 따끔하게 혼내줘",
      "romaji": "isso motto kitsuku shikaritsukete yo"
    },
    {
      "id": 24,
      "start": 133.44,
      "end": 134.48,
      "rubyText": "ごめんね",
      "translation": "미안해",
      "romaji": "gomen ne"
    },
    {
      "id": 25,
      "start": 134.48,
      "end": 138.02,
      "rubyText": "オイメアルシー　道草[みちくさ]はかどってさ",
      "translation": "oimearcy, 딴길로 새는 게 너무 순조로워서",
      "romaji": "oimearushii michikusa hakadotte sa"
    },
    {
      "id": 26,
      "start": 138.02,
