{
  "id": "mimi-hanabira-aika",
  "title": "花びら哀歌",
  "artist": "MIMI feat. 重音テトSV",
  "youtubeId": "IxVFW1XIW7Q",
  "lyrics": [
    {
      "id": 1,
      "start": 25.275,
      "end": 30.948,
      "rubyText": "ふとした言葉[ことば]が胸[むね]を焦[こ]がす",
      "translation": "무심코 내뱉은 한마디가 애태워 와"
    },
    {
      "id": 2,
      "start": 30.948,
      "end": 36.487,
      "rubyText": "僕[ぼく]がさ 舞[ま]える理由[りゆう]はさ 無[な]くて",
      "translation": "나는 말이야, 흩날릴 이유는 없어서"
    },
    {
      "id": 3,
      "start": 36.587,
      "end": 41.925,
      "rubyText": "蕾[つぼみ]の刹那[せつな]に眩暈[めまい]がして",
      "translation": "꽃봉오리가 맺는 순간에 현기증이 나서"
    },
    {
      "id": 4,
      "start": 41.925,
      "end": 46.397,
      "rubyText": "じっとじっと閉[と]じこもる",
      "translation": "가만히, 가만히 움츠려있어"
    },
    {
      "id": 5,
      "start": 47.831,
      "end": 52.703,
      "rubyText": "お願[ねが]い 風[かぜ]が吹[ふ]いたら見[み]つけてね",
      "translation": "부탁해, 바람이 불면 보러와줘"
    },
    {
      "id": 6,
      "start": 52.703,
      "end": 56.04,
      "rubyText": "君[きみ]とひら ひら ひら ひら",
      "translation": "너와 나풀, 나풀 나풀 나풀"
    },
    {
      "id": 7,
      "start": 56.04,
      "end": 58.308,
      "rubyText": "まだ怖[こわ]いけど",
      "translation": "아직 두렵지만"
    },
    {
      "id": 8,
      "start": 58.308,
      "end": 64.148,
      "rubyText": "寂[さび]しくないくらい晴[は]れ渡[わた]る 芽吹[めぶ]きでした",
      "translation": "외롭지 않도록 맑게 개어가는 싹틔움이었어"
    },
    {
      "id": 9,
      "start": 64.148,
      "end": 67.418,
      "rubyText": "君[きみ]が歌[うた]う 歌[うた]う 歌[うた]うから",
      "translation": "너가 노래하고, 노래하고, 노래하니까"
    },
    {
      "id": 10,
      "start": 67.418,
      "end": 69.686,
      "rubyText": "つられて舞[ま]った",
      "translation": "이끌려 흩날렸어"
    },
    {
      "id": 11,
      "start": 69.686,
      "end": 76.126,
      "rubyText": "いつかまた出会[であ]えるまで 笑[わら]っていて",
      "translation": "언젠가 다시 만나는 날까지 웃고 있어 줘"
    },
    {
      "id": 12,
      "start": 98.682,
      "end": 104.288,
      "rubyText": "思[おも]えば季節[きせつ]が焦[あせ]らせてた",
      "translation": "생각해보면 계절이 날 초조하게 만들었어"
    },
    {
      "id": 13,
      "start": 104.288,
      "end": 109.726,
      "rubyText": "僕[ぼく]がさ舞[ま]えるはずなんて 無[な]くて",
      "translation": "내가 흩날릴 수 있을 리 없는데"
    },
    {
      "id": 14,
      "start": 109.993,
      "end": 114.998,
      "rubyText": "君[きみ]のさ 両手[りょうて]の 温[ぬく]もりだけが",
      "translation": "네 양손의 온기만이"
    },
    {
      "id": 15,
      "start": 114.998,
      "end": 120.571,
      "rubyText": "泣[な]いていない から から からっぽな心[こころ]だけ",
      "translation": "울고 있지 않아, 않아, 않아, 안이 텅 빈 마음뿐"
    },
    {
      "id": 16,
      "start": 120.571,
      "end": 126.11,
      "rubyText": "それも花開[はなひら]く朝露[あさつゆ]が 頬[ほお]を濡[ぬ]らす",
      "translation": "그마저도 꽃이 피어나는 아침 이슬이 빰을 적셔와"
    },
    {
      "id": 17,
      "start": 126.11,
      "end": 132.015,
      "rubyText": "君[きみ]が優[やさ]しく笑[わら]うから つられて舞[ま]った",
      "translation": "네가 다정하게 미소 지으니, 이끌려 흩날렸어"
    },
    {
      "id": 18,
      "start": 132.015,
      "end": 138.222,
      "rubyText": "流氷[りゅうひょう]の蕾[つぼみ]は溶[と]かされて 抱[だ]きしめられる",
      "translation": "유빙 속 꽃봉오리는 녹아내려 포근히 안겨 와"
    },
    {
      "id": 19,
      "start": 138.288,
      "end": 142.96,
      "rubyText": "明日[あした]も待[ま]ってるから",
      "translation": "내일도 기다리고 있을테니까"
    },
    {
      "id": 20,
      "start": 143.26,
      "end": 148.866,
      "rubyText": "だって僕[ぼく]らは遠[とお]くても一[ひと]つだから",
      "translation": "그야 우리는 떨어져 있어도 하나니까"
    },
    {
      "id": 21,
      "start": 148.866,
      "end": 151.969,
      "rubyText": "君[きみ]とひら ひら ひら ひら",
      "translation": "너와 나풀, 나풀 나풀 나풀"
    },
    {
      "id": 22,
      "start": 151.969,
      "end": 154.204,
      "rubyText": "まだ怖[こわ]いけど",
      "translation": "아직 두렵지만"
    },
    {
      "id": 23,
      "start": 154.204,
      "end": 159.877,
      "rubyText": "寂[さび]しくないくらい晴[は]れ渡[わた]る 芽吹[めぶ]きでした",
      "translation": "외롭지 않도록 맑게 개어가는 싹틔움이었어"
    },
    {
      "id": 24,
      "start": 160.01,
      "end": 163.28,
      "rubyText": "君[きみ]が歌[うた]う 歌[うた]う 歌[うた]うから",
      "translation": "너가 노래하고, 노래하고, 노래하니까"
    },
    {
      "id": 25,
      "start": 163.28,
      "end": 165.682,
      "rubyText": "つられて舞[ま]った",
      "translation": "이끌려 흩날렸어"
    },
    {
      "id": 26,
      "start": 165.782,
      "end": 171.288,
      "rubyText": "いつかまた出会[であ]えるまで 笑[わら]っていて",
      "translation": "언젠가 다시 만나는 날까지 웃고 있어 줘"
    },
    {
      "id": 27,
      "start": 171.288,
      "end": 177.895,
      "rubyText": "そしてまた出会[であ]えたなら笑[わら]いかけて",
      "translation": "그리고 다시 만난다면 미소 지어줘"
    }
  ],
