{
  "id": "dareka-nuite-kure",
  "title": "だれかぬいてくれ",
  "artist": "ぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬぬ feat. 音街ウナSV & タカハシアマト",
  "youtubeId": "VgLNfVougpI",
  "lyrics": [
    {
      "id": 1,
      "start": 0.96,
      "end": 3.01,
      "rubyText": "遂[つい]に始[はじ]まりました！！、",
      "translation": "드디어 시작되었습니다!",
      "romaji": "tsui ni hajimarimashita!!,"
    },
    {
      "id": 2,
      "start": 3.31,
      "end": 4.66,
      "rubyText": "ボカコレです！！。",
      "translation": "보카코레예요!",
      "romaji": "bokakore desu!!."
    },
    {
      "id": 3,
      "start": 10.79,
      "end": 12.14,
      "rubyText": "もひか゚つ！",
      "translation": "모힝가츠!",
      "romaji": "mohingatsu!"
    },
    {
      "id": 4,
      "start": 12.14,
      "end": 12.8,
      "rubyText": "ちゅばっぽ！",
      "translation": "츄바뽀!",
      "romaji": "chubappo!"
    },
    {
      "id": 5,
      "start": 13.64,
      "end": 17.14,
      "rubyText": "だれか ぬいてくれ！！",
      "translation": "누가 좀 빼내 줘!!",
      "romaji": "dareka nuite kure!!"
    },
    {
      "id": 6,
      "start": 17.14,
      "end": 18.29,
      "rubyText": "ぬぉ、待[ま]ちんしゃい⋯！",
      "translation": "누악, 잠깐 기다리셔…!",
      "romaji": "nwo, machinshai...!"
    },
    {
      "id": 7,
      "start": 18.29,
      "end": 19.64,
      "rubyText": "なんでも するから",
      "translation": "뭐든지 할 테니까",
      "romaji": "nandemo suru kara"
    },
    {
      "id": 8,
      "start": 19.64,
      "end": 20.79,
      "rubyText": "おたすけぬぉー！！。",
      "translation": "도와주세누오-!!",
      "romaji": "otasuke nwoo!!."
    },
    {
      "id": 9,
      "start": 32.81,
      "end": 34.96,
      "rubyText": "早[はや]う 助[たす]け舟[ぶね] 求[もと]めてえけど",
      "translation": "얼른 구원의 손길 구하고 싶은데",
      "romaji": "hayau tasukebune motometee kedo"
    },
    {
      "id": 10,
      "start": 34.96,
      "end": 37.65,
      "rubyText": "人影[ひとかげ]⋯　絶[た]ゆ",
      "translation": "인적이···· 끊겼어",
      "romaji": "hitokage... tayu"
    },
    {
      "id": 11,
      "start": 37.65,
      "end": 39.8,
      "rubyText": "それに この醜態[しゅうたい] 晒[さら]す",
      "translation": "게다가 이 추태를 드러낼",
      "romaji": "sore ni kono shuutai sarasu"
    },
    {
      "id": 12,
      "start": 39.8,
      "end": 41.96,
      "rubyText": "心[こころ]の準備[じゅんび]が⋯",
      "translation": "마음의 준비가...",
      "romaji": "kokoro no junbi ga..."
    },
    {
      "id": 13,
      "start": 41.96,
      "end": 42.46,
      "rubyText": "あっ⋯///",
      "translation": "아…///",
      "romaji": "a...///"
    },
    {
      "id": 14,
      "start": 43.31,
      "end": 45.48,
      "rubyText": "ガン見[み]されてらあ 恥[は]ずかしかあ",
      "translation": "빤히 쳐다보잖아 창피하다고",
      "romaji": "ganmisareteraa hazukashikaa"
    },
    {
      "id": 15,
      "start": 45.48,
      "end": 46.98,
      "rubyText": "穴[あな]があったら入[はい]りてえ⋯。",
      "translation": "쥐구멍에라도 들어갈래…",
      "romaji": "ana ga attara hairitee..."
    },
    {
      "id": 16,
      "start": 46.98,
      "end": 48.13,
      "rubyText": "※もう入[はい]ってます",
      "translation": "※이미 들어가 있습니다",
      "romaji": "※mou haittemasu"
    },
    {
      "id": 17,
      "start": 48.13,
      "end": 50.99,
      "rubyText": "じゃが 遂[つい]に 到来[とうらい]し 絶好[ぜっこう]の chance",
      "translation": "그치만 마침내 도래한 절호의 chance",
      "romaji": "jaga tsui ni touraishi zekkou no chance"
    },
    {
      "id": 18,
      "start": 50.99,
      "end": 53.67,
      "rubyText": "今[いま]こそ 伝[つた]えるべし SOS",
      "translation": "지금이야말로 전해야 해 SOS",
      "romaji": "ima koso tsutaerubeshi SOS"
    },
    {
      "id": 19,
      "start": 53.67,
      "end": 56.41,
      "rubyText": "じゃが コミュ症[しょう] ですから　おくちは chuck",
      "translation": "그치만 아싸니까 입은 chuck",
      "romaji": "jaga komyushou desukara okuchi wa chuck"
    },
    {
      "id": 20,
      "start": 56.45,
      "end": 59.15,
      "rubyText": "手旗信号[てばたしんごう] 振[ふ]り翳[かざ]んば…！。 ",
      "translation": "깃발 신호를 휘둘러 보인다면…！",
      "romaji": "tebata shingou furikazanba...!. "
    },
    {
      "id": 21,
      "start": 60.15,
      "end": 63.7,
      "rubyText": "Ѿ Ѿ た Ѿ Ѿ す Ѿ け Ѿ て",
      "translation": "도와줘요",
      "romaji": "ta su ke te"
    },
    {
      "id": 22,
      "start": 63.7,
