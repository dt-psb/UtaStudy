{
  "id": "deco27-hello-sekai",
  "title": "ハローセカイ (Hello Sekai)",
  "artist": "DECO*27 feat. 初音ミク",
  "youtubeId": "t5U0rrj0dio",
  "thumbnail": "https://img.youtube.com/vi/t5U0rrj0dio/hqdefault.jpg",
  "duration": 163,
  "lyrics": [
    {
      "id": 1,
      "start": 1.602,
      "end": 10.818,
      "rubyText": "きっと届[とど]くはず　きっと見[み]えるはず",
      "translation": "분명 닿을 거야, 분명 보일 거야",
      "romaji": "kitto todokuhazu kitto mieruhazu"
    },
    {
      "id": 2,
      "start": 10.818,
      "end": 16.568,
      "rubyText": "そんな会[あ]ってみたい未来[みらい]を　僕[ぼく]はひとりきりのセカイで",
      "translation": "그런 만나보고 싶은 미래를, 나는 혼자만의 세카이에서",
      "romaji": "sonna attemitai mirai o boku wa hitorikiri no sekai de"
    },
    {
      "id": 3,
      "start": 16.568,
      "end": 21.701,
      "rubyText": "ずっとそう歌[うた]うたっていた",
      "translation": "계속, 그래, 노래하고 있었어",
      "romaji": "zutto sou uta utatteita"
    },
    {
      "id": 4,
      "start": 29.213,
      "end": 35.218,
      "rubyText": "今[いま]聞[き]こえたよ　ほら少[すこ]しだけ",
      "translation": "지금 들렸어, 봐, 조금이지만",
      "romaji": "ima kikoetayo hora sukoshi dake"
    },
    {
      "id": 5,
      "start": 35.218,
      "end": 42.203,
      "rubyText": "君[きみ]を感[かん]じたよ　メロディーがリンクする",
      "translation": "너를 느꼈어, 멜로디가 링크돼",
      "romaji": "kimi o kanjitayo merodii ga rinkusuru"
    },
    {
      "id": 6,
      "start": 42.203,
      "end": 48.033,
      "rubyText": "今[いま]繋[つな]がるよ　今[いま]重[かさ]なるよ",
      "translation": "지금 이어져, 지금 겹쳐져",
      "romaji": "ima tsunagaruyo ima kasanaruyo"
    },
    {
      "id": 7,
      "start": 48.034,
      "end": 56.131,
      "rubyText": "伝[つた]えたかったこと　山[やま]ほどあるんだけどどうしよう",
      "translation": "전하고 싶었던 건 산더미처럼 있는데 어떻게 할까",
      "romaji": "tsutaetakatta koto yamahodo arundakedo doushiyou"
    },
    {
      "id": 8,
      "start": 58.956,
      "end": 64.173,
      "rubyText": "見[み]たこともない顔[かお]で　君[きみ]は君[きみ]をダメと言[い]うけど",
      "translation": "본 적도 없는 얼굴로 너는 네가 글러먹었다 말하지만",
      "romaji": "mita koto mo nai kao de kimi wa kimi o dame to iukedo"
    },
    {
      "id": 9,
      "start": 64.174,
      "end": 70.491,
      "rubyText": "未来[みらい]にいる理想[りそう]の君[きみ]を　今[いま]の君[きみ]に押[お]し付[つ]け過[す]ぎないで",
      "translation": "미래에 있는 이상적인 너를, 지금의 너에게 너무 강요하지 말아줘",
      "romaji": "mirai ni iru risou no kimi o ima no kimi ni oshitsukesuginaide"
    },
    {
      "id": 10,
      "start": 71.771,
      "end": 76.923,
      "rubyText": "見[み]たこともない景色[けしき]　見[み]せ合[あ]ういつかが来[く]るまで",
      "translation": "본 적 없는 풍경을 서로에게 보여주는 언젠가가 올 때까지",
      "romaji": "mita koto mo nai keshiki miseau itsuka ga kurumade"
    },
    {
      "id": 11,
      "start": 76.923,
      "end": 83.104,
      "rubyText": "つらいこと　泣[な]きたくなること　たまには預[あず]け合[あ]おう",
      "translation": "괴로운 일도, 울고 싶어지는 일도, 가끔은 서로에게 맡기자",
      "romaji": "tsurai koto nakitaku naru koto tamani wa azukeaou"
    },
    {
      "id": 12,
      "start": 83.104,
      "end": 89.609,
      "rubyText": "ハロー、セカイ　僕[ぼく]の声[こえ]はちゃんと届[とど]いてるかい",
      "translation": "헬로, 세카이, 내 목소리는 제대로 전해지고 있을까",
      "romaji": "harou, sekai boku no koe wa chanto todoiterukai"
    },
    {
      "id": 13,
      "start": 89.609,
      "end": 95.717,
      "rubyText": "思[おも]ったよりも大丈夫[だいじょうぶ]　君[きみ]はひとりなんかじゃない",
      "translation": "생각했던 것보다 괜찮아, 너는 혼자가 아니야",
      "romaji": "omotta yorimo daijoubu kimi wa hitori nankajanai"
    },
    {
      "id": 14,
      "start": 95.717,
      "end": 102.284,
      "rubyText": "ハロー、セカイ　君[きみ]の声[こえ]もちゃんと届[とど]いてるよ",
      "translation": "헬로, 세카이, 네 목소리는 제대로 전해지고 있어",
      "romaji": "harou, sekai kimi no koe mo chanto todoiteruyo"
    },
    {
      "id": 15,
      "start": 102.285,
      "end": 108.168,
      "rubyText": "思[おも]ったよりも最高[さいこう]だ　僕[ぼく]もひとりなんかじゃない",
      "translation": "생각했던 것보다 최고야, 나도 혼자가 아니야",
      "romaji": "omotta yorimo saikouda boku mo hitorinankajanai"
    },
    {
      "id": 16,
      "start": 108.168,
      "end": 111.397,
      "rubyText": "行[い]くよジャンプ　跳[は]ねるダンス",
      "translation": "갈게, 점프, 뛰어, 댄스",
      "romaji": "ikuyo janpu haneru dansu"
    },
    {
      "id": 17,
      "start": 111.398,
      "end": 114.875,
      "rubyText": "いらない不安[ふあん]なんて踏[ふ]んじゃってこう",
      "translation": "필요없는 불안 따윈 짓밟고서 가자",
      "romaji": "iranai fuan nante funjatte kou"
    },
    {
      "id": 18,
      "start": 114.875,
      "end": 118.072,
      "rubyText": "ああでもこうでもないも　そんなのどうでもいいよ",
      "translation": "이렇지도 저렇지도 않아도, 그런 건 아무래도 좋아",
      "romaji": "aa demo kou demo naimo sonnano doudemo iiyo"
    },
    {
      "id": 19,
      "start": 118.072,
      "end": 120.86,
      "rubyText": "やりたいようにやろう　ハローハロー",
      "translation": "하고 싶은 대로 하자, 헬로, 헬로",
      "romaji": "yaritai youni yarou harouharou"
    },
    {
      "id": 20,
      "start": 120.86,
      "end": 123.989,
      "rubyText": "もう一回[いっかい]ジャンプ　回[まわ]るダンス",
      "translation": "한 번 더 점프, 돌아가는 댄스",
      "romaji": "mou ikkai janpu mawaru dansu"
    },
    {
      "id": 21,
      "start": 123.989,
      "end": 127.595,
      "rubyText": "行[い]きたい未来[みらい]　きっともうすぐだよ",
      "translation": "가고 싶은 미래, 분명 이제 곧이야",
      "romaji": "ikitai mirai kitto mousugudayo"
    },
    {
      "id": 22,
      "start": 127.596,
      "end": 130.727,
      "rubyText": "ああでもこうでもないも　そんなのどうでもいいよ",
      "translation": "이렇지도 저렇지도 않아도, 그런 건 아무래도 좋아",
      "romaji": "aa demo kou demo naimo sonnano doudemo iiyo"
    },
    {
      "id": 23,
      "start": 130.727,
      "end": 133.912,
      "rubyText": "やりたいようにやろう",
      "translation": "하고 싶은 대로 하자",
      "romaji": "yaritai youni yarou"
    },
    {
      "id": 24,
      "start": 133.912,
      "end": 136.923,
      "rubyText": "飛[と]び込[こ]んでいこう　僕[ぼく]らのセカイが",
      "translation": "뛰어들어보자, 우리들의 세카이가",
      "romaji": "tobikondeikou bokura no sekaiga"
    },
    {
      "id": 25,
      "start": 137.404,
      "end": 140.569,
      "rubyText": "正解[せいかい]か不正解[ふせいかい]かわからなくても",
      "translation": "정답인지 오답인진 알 수 없더라도",
      "romaji": "seikaika fuseikaika wakaranakutemo"
    },
    {
      "id": 26,
      "start": 140.569,
      "end": 143.626,
      "rubyText": "僕[ぼく]にある想[おも]いも　君[きみ]にある願[ねが]いも",
      "translation": "나에게 있는 마음도, 너에게 있는 소원도",
      "romaji": "boku ni aru omoimo kimi ni aru negaimo"
    },
    {
      "id": 27,
      "start": 143.626,
      "end": 149.799,
      "rubyText": "きっと消[き]えないんだよ　ずっとセカイは終[お]わらないよ",
      "translation": "분명 사라지지 않아, 계속 세카이는 끝나지 않아",
      "romaji": "kitto kienaindayo zutto sekai wa owaranaiyo"
    },
    {
      "id": 28,
      "start": 149.799,
      "end": 155.617,
      "rubyText": "今[いま]繋[つな]がるよ　今[いま]重[かさ]なるよ",
      "translation": "지금 이어져, 지금 겹쳐져",
      "romaji": "ima tsunagaruyo ima kasanaruyo"
    },
    {
      "id": 29,
      "start": 155.617,
      "end": 161.428,
      "rubyText": "ほら聞[き]こえるよ　ほら伝[つた]わるよ僕[ぼく]ら",
      "translation": "봐, 들려와, 봐, 전해져, 우리는",
      "romaji": "hora kikoeruyo hora tsutawaruyo bokura"
    }
  ],
