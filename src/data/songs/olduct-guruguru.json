  "lyrics": [
    {
      "id": 1,
      "start": 0.8,
      "end": 2.4,
      "rubyText": "やあ、こんにちは",
      "translation": "안녕, 안녕하세요"
    },
    {
      "id": 2,
      "start": 7.167,
      "end": 8.767,
      "rubyText": "しなやかに",
      "translation": "유연하게"
    },
    {
      "id": 3,
      "start": 9.0,
      "end": 10.6,
      "rubyText": "軽[かろ]やかに",
      "translation": "가볍게"
    },
    {
      "id": 4,
      "start": 10.8,
      "end": 12.4,
      "rubyText": "強[したた]かに",
      "translation": "강인하게"
    },
    {
      "id": 5,
      "start": 12.534,
      "end": 14.134,
      "rubyText": "雅[みや]びやかに",
      "translation": "우아하게"
    },
    {
      "id": 6,
      "start": 14.367,
      "end": 15.967,
      "rubyText": "黙[もく]々[もく]と",
      "translation": "묵묵히"
    },
    {
      "id": 7,
      "start": 16.167,
      "end": 17.767,
      "rubyText": "端[たん]然[ぜん]と",
      "translation": "단정하게"
    },
    {
      "id": 8,
      "start": 17.967,
      "end": 19.567,
      "rubyText": "悠[ゆう]々[ゆう]と",
      "translation": "느긋하게"
    },
    {
      "id": 9,
      "start": 19.767,
      "end": 21.367,
      "rubyText": "飄[ひょう]々[ひょう]と",
      "translation": "표표히"
    },
    {
      "id": 10,
      "start": 21.5,
      "end": 24.934,
      "rubyText": "ねこがそうであるように",
      "translation": "고양이가 그러하듯"
    },
    {
      "id": 11,
      "start": 24.934,
      "end": 27.367,
      "rubyText": "人[にん]間[げん]もまたそうであるべき",
      "translation": "인간도 그래야 하지 않을까요?"
    },
    {
      "id": 12,
      "start": 28.467,
      "end": 33.3,
      "rubyText": "みんなもそう思[おも]いませんか？",
      "translation": "여러분도 그렇게 생각하지 않나요?"
    },
    {
      "id": 13,
      "start": 35.767,
      "end": 36.6,
      "rubyText": "にゃー にゃー",
      "translation": "야옹 야옹"
    },
    {
      "id": 14,
      "start": 36.6,
      "end": 37.567,
      "rubyText": "かわいいねこ",
      "translation": "귀여운 고양이"
    },
    {
      "id": 15,
      "start": 37.567,
      "end": 38.934,
      "rubyText": "マオ マオ ファ ファ タン タン",
      "translation": "마오 마오 파 파 탕 탕"
    },
    {
      "id": 16,
      "start": 38.934,
      "end": 39.434,
      "rubyText": "ねこ",
      "translation": "고양이"
    },
    {
      "id": 17,
      "start": 39.434,
      "end": 40.134,
      "rubyText": "にゃー にゃー",
      "translation": "야옹 야옹"
    },
    {
      "id": 18,
      "start": 40.134,
      "end": 41.1,
      "rubyText": "かわいいねこ",
      "translation": "귀여운 고양이"
    },
    {
      "id": 19,
      "start": 41.1,
      "end": 42.434,
      "rubyText": "もう、萌[も]えすぎてどうしよう…",
      "translation": "아… 너무 귀여워서 어쩌지…"
    },
    {
      "id": 20,
      "start": 42.434,
      "end": 43.234,
      "rubyText": "ねこをモフる",
      "translation": "고양이를 포근히 안아줘"
    },
    {
      "id": 21,
