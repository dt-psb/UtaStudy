    {
      "id": 24,
      "start": 46.067,
      "end": 46.567,
      "rubyText": "うん",
      "translation": "응"
    },
    {
      "id": 25,
      "start": 46.867,
      "end": 48.267,
      "rubyText": "…あれ、なんだっけ？",
