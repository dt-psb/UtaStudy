  "lyrics": [
    {
      "id": 1,
      "start": 4.17,
      "end": 7.83,
      "rubyText": "フワフワな雲[くも]の上[うえ]に Diving!",
      "translation": "폭신폭신한 구름 위로 Diving!"
    },
    {
      "id": 2,
      "start": 7.83,
      "end": 11.96,
      "rubyText": "明日[あした]は晴[は]れるかな？",
      "translation": "내일은 맑으려나?"
    },
    {
      "id": 3,
      "start": 11.96,
      "end": 14.75,
      "rubyText": "柔[やわ]らかに香[かお]る Flavor",
      "translation": "부드럽게 향기 나는 Flavor"
    },
    {
      "id": 4,
      "start": 14.75,
      "end": 17.33,
      "rubyText": "目[め]を閉[と]じれば",
      "translation": "눈을 감으면"
    },
    {
      "id": 5,
      "start": 17.33,
      "end": 18.21,
      "rubyText": "Feel My Heart",
      "translation": "Feel My Heart"
    },
    {
      "id": 6,
      "start": 18.21,
      "end": 19.71,
      "rubyText": "Feel My Dream",
      "translation": "Feel My Dream"
    },
    {
      "id": 7,
      "start": 19.71,
      "end": 21.54,
      "rubyText": "初[はじ]めて見[み]た景色[けしき]みたい",
      "translation": "처음으로 본 풍경 같아"
    },
    {
      "id": 8,
      "start": 21.54,
      "end": 23.46,
      "rubyText": "もっともっと夢[ゆめ]を見[み]ていたい",
      "translation": "좀 더 좀 더 꿈을 꾸고 싶어"
    },
    {
      "id": 9,
      "start": 23.46,
      "end": 24.17,
      "rubyText": "Oh-Na Na Na",
      "translation": "Oh-Na Na Na"
    },
    {
      "id": 10,
      "start": 24.17,
      "end": 24.88,
      "rubyText": "Oh-Ma Ma Ma",
      "translation": "Oh-Ma Ma Ma"
    },
    {
      "id": 11,
      "start": 24.88,
      "end": 27.21,
      "rubyText": "この手[て]を伸[の]ばすの",
      "translation": "이 손을 뻗는 거야"
    },
    {
      "id": 12,
      "start": 27.21,
      "end": 35.08,
      "rubyText": "触[ふ]れるだけで優[やさ]しく包[つつ]み込[こ]んで",
      "translation": "닿는 것만으로 부드럽게 감싸 안아줘"
    },
    {
      "id": 13,
      "start": 35.08,
      "end": 38.92,
      "rubyText": "Sometimes なんでかな",
      "translation": "Sometimes 왜일까"
    },
    {
      "id": 14,
      "start": 38.92,
      "end": 42.67,
      "rubyText": "Suddenly 不安[ふあん]になるの",
      "translation": "Suddenly 불안해져"
    },
    {
      "id": 15,
      "start": 42.67,
      "end": 50.17,
      "rubyText": "それでも進[すす]むも止[と]まるも私次第[わたししだい]",
      "translation": "그렇대도 나아가는 것도 멈추는 것도 나 하기 나름"
    },
    {
      "id": 16,
      "start": 50.17,
      "end": 52.5,
      "rubyText": "見[み]えるよ鮮[あざ]やかな",
      "translation": "보이고 있어, 선명한"
    },
    {
      "id": 17,
      "start": 52.5,
      "end": 55.04,
      "rubyText": "Beautiful Future Future",
      "translation": "Beautiful Future Future"
    },
    {
      "id": 18,
      "start": 55.04,
      "end": 57.62,
      "rubyText": "私[わたし]だけの Beautiful World",
      "translation": "나만의 Beautiful World"
    },
    {
      "id": 19,
      "start": 57.62,
      "end": 60.71,
      "rubyText": "雲[くも]に乗[の]って飛[と]んでいく先[さき]は",
      "translation": "구름을 타고 날아간 저 너머는"
    },
    {
      "id": 20,
      "start": 60.71,
      "end": 62.58,
      "rubyText": "Future Future",
      "translation": "Future Future"
    },
    {
      "id": 21,
      "start": 62.58,
      "end": 65.17,
      "rubyText": "ドキドキ止[と]まんない",
      "translation": "두근거림이 멈추지 않아"
    },
    {
      "id": 22,
      "start": 65.17,
      "end": 68.92,
      "rubyText": "La La La",
      "translation": "La La La"
    },
    {
      "id": 23,
      "start": 68.92,
      "end": 72.67,
      "rubyText": "ねえ見[み]えるでしょ？",
      "translation": "저기 보이지?"
    },
    {
      "id": 24,
      "start": 72.67,
      "end": 76.38,
      "rubyText": "La La La",
      "translation": "La La La"
    },
    {
      "id": 25,
      "start": 76.38,
      "end": 77.58,
      "rubyText": "あの光[ひかり]に",
      "translation": "저 빛에"
    },
    {
      "id": 26,
      "start": 77.58,
      "end": 81.75,
      "rubyText": "近[ちか]づいていこう",
      "translation": "가까워져 가는 거야"
    },
    {
      "id": 27,
      "start": 81.75,
      "end": 83.71,
      "rubyText": "I Say 強[つよ]くなろうって",
      "translation": "I Say 강해지자고"
    },
    {
      "id": 28,
      "start": 83.71,
      "end": 85.29,
      "rubyText": "I Swear 綺麗[きれい]になるって",
      "translation": "I Swear 아름다워지자고"
    },
    {
      "id": 29,
      "start": 85.29,
      "end": 87.42,
      "rubyText": "憧[あこが]れてた",
      "translation": "동경했던"
    },
    {
      "id": 30,
      "start": 87.42,
      "end": 89.08,
      "rubyText": "私[わたし]が見[み]つかるかも？",
      "translation": "날 찾을 수 있을 지도?"
    },
    {
      "id": 31,
      "start": 89.08,
      "end": 91.0,
      "rubyText": "大好[だいす]きな Pinky Cherry",
      "translation": "정말 좋아하는 Pinky Cherry"
    },
    {
      "id": 32,
      "start": 91.0,
      "end": 93.08,
      "rubyText": "甘酸[あます]っぱい Candy Jelly",
      "translation": "새콤달콤한 Candy Jelly"
    },
    {
      "id": 33,
      "start": 93.08,
      "end": 97.04,
      "rubyText": "全部[ぜんぶ] 宝物[たからもの]だから",
      "translation": "전부 보물이니까"
    },
    {
      "id": 34,
      "start": 97.04,
      "end": 100.83,
      "rubyText": "Sometime 叶[かな]うかな",
      "translation": "Sometime 이루어질까"
    },
    {
      "id": 35,
      "start": 100.83,
      "end": 104.5,
      "rubyText": "Maybe 言葉[ことば]にできないけど",
      "translation": "Maybe 말로 표현할 수는 없어도"
    },
    {
      "id": 36,
      "start": 104.5,
      "end": 112.04,
      "rubyText": "なぜだかうまくいくって信[しん]じる未来[みらい]",
      "translation": "왜인지 잘 될 거라고 믿는 미래"
    },
    {
      "id": 37,
      "start": 112.04,
      "end": 114.38,
      "rubyText": "見[み]えるよ煌[きら]めいた",
      "translation": "보이고 있어, 반짝이는"
