{
  "id": "kuriyama-lifereward",
  "title": "ライフリワード (Life Reward)",
  "artist": "栗山夕璃 feat. 重音テトSV",
  "youtubeId": "81jeVW4JLXs",
  "thumbnail": "https://img.youtube.com/vi/81jeVW4JLXs/hqdefault.jpg",
  "duration": 227,
  "lyrics": [
    {
      "id": 1,
      "start": 12.11,
      "end": 13.35,
      "rubyText": "ねぇなんだか、",
      "translation": "있잖아, 뭔가",
      "romaji": "nee nandaka,"
    },
    {
      "id": 2,
      "start": 13.45,
      "end": 17.62,
      "rubyText": "映画[えいが]のワンシーンになりそうな空[そら]",
      "translation": "영화의 한 장면에 나올 것만 같은 하늘",
      "romaji": "eiga no wansheen ni narisouna sora"
    },
    {
      "id": 3,
      "start": 17.68,
      "end": 24.29,
      "rubyText": "アラームが鳴[な]り響[ひび]いた部屋[へや]の奥[おく]でパッと目覚[めざ]めた",
      "translation": "알람음이 울리는 방 안에서 딱 눈을 떴어",
      "romaji": "araamu ga narihibiita heya no oku de patto mezameta"
    },
    {
      "id": 4,
      "start": 24.36,
      "end": 32.2,
      "rubyText": "今日[きょう]から何[なに]かが変[か]わってく気[き]がしていたんだ",
      "translation": "오늘부터 무언가 바뀔 것만 같은 기분이 들었어",
      "romaji": "kyou kara nanika ga kawatteku ki ga shiteitan da"
    },
    {
      "id": 5,
      "start": 33.67,
      "end": 40.54,
      "rubyText": "『これが最後[さいご]の希望[きぼう]です。』テレビは騒[さわ]いでいた",
      "translation": "'이것이 마지막 희망입니다' 떠들썩한 텔레비전의 소리",
      "romaji": "'kore ga saigo no kibou desu.' terebi wa sawaideita"
    },
    {
      "id": 6,
      "start": 40.64,
      "end": 48.72,
      "rubyText": "それでも要[い]らないって何[なに]をしたってならないと思[おも]った",
      "translation": "그래도 필요 없어 그게 뭐든 안 된다고 생각했어",
      "romaji": "soredemo iranai tte nani o shitatte naranai tte omotta"
    },
    {
      "id": 7,
      "start": 52.48,
      "end": 56.82,
      "rubyText": "僕[ぼく]らの未来[みらい]の期待[きたい]も不安[ふあん]も",
      "translation": "우리의 미래를 향한 기대도 불안도",
      "romaji": "bokura no mirai no kitai mo fuan mo"
    },
    {
      "id": 8,
      "start": 56.92,
      "end": 60.99,
      "rubyText": "明日[あした]になったら不確定[ふかくてい]らしい。",
      "translation": "내일이란 그저 불확실일 뿐",
      "romaji": "ashita ni nattara fukakutei rashii."
    },
    {
      "id": 9,
      "start": 61.09,
      "end": 64.23,
      "rubyText": "それならもっと会[あ]いに行[い]こうぜ！",
      "translation": "그렇다면 더 만나러 가야지!",
      "romaji": "sorenara motto ai ni ikou ze!"
    },
    {
      "id": 10,
      "start": 64.33,
      "end": 66.5,
      "rubyText": "さぁ行[い]こう！はぐれないで合図[あいず]を",
      "translation": "자, 가자! 떨어지지 마",
      "romaji": "saa ikou! hagurenaide aizu o"
    },
    {
      "id": 11,
      "start": 66.73,
      "end": 70.67,
      "rubyText": "今[いま]すぐに察知[さっち]して！",
      "translation": "내 신호를 지금 바로 알아차려 줘",
      "romaji": "ima sugu ni satchi shite!"
    },
    {
      "id": 12,
      "start": 70.74,
      "end": 75.94,
      "rubyText": "心[こころ]が枯[か]れたならば燃[も]やして",
      "translation": "마음이 메말랐다면 불태워 봐",
      "romaji": "kokoro ga kareta naraba moyashite"
    },
    {
      "id": 13,
      "start": 79.95,
      "end": 81.2,
      "rubyText": "ねぇなんだか、",
      "translation": "있잖아, 뭔가",
      "romaji": "nee nandaka,"
    },
    {
      "id": 14,
      "start": 81.2,
      "end": 85.79,
      "rubyText": "映画[えいが]のワンシーンに飛[と]び込[こ]んだような",
      "translation": "영화의 한 장면에 뛰어든 것 같아",
      "romaji": "eiga no wansheen ni tobikonda youna"
    },
    {
      "id": 15,
      "start": 85.85,
      "end": 92.23,
      "rubyText": "アラートが鳴[な]り響[ひび]いた街[まち]の中[なか]駆[か]けていった",
      "translation": "경고음이 울리는 마을 안을 달리고 있어",
      "romaji": "araato ga narihibiita machi no naka kakete itta"
    },
    {
      "id": 16,
      "start": 92.46,
      "end": 99.97,
      "rubyText": "今日[きょう]から何[なに]かが変[か]わって行[い]く気[き]がしていたんだ",
      "translation": "오늘부터 무언가 깨달을 것만 같은 기분이 들었어",
      "romaji": "kyou kara nanika ga kawatte iku ki ga shiteitan da"
    },
    {
      "id": 17,
      "start": 101.77,
      "end": 107.61,
      "rubyText": "『これで世界[せかい]は終末[おわり]です。』人々[ひとびと]は言[い]った",
      "translation": "'이렇게 세상은 종말입니다' 사람들은 말했어",
      "romaji": "'kore de sekai wa owari desu.' hitobito wa itta"
    },
    {
      "id": 18,
      "start": 107.71,
      "end": 114.21,
      "rubyText": "それでもいいやって諦[あきら]められないな",
      "translation": "그래도 괜찮아 포기할 순 없어",
      "romaji": "soredemo ii ya tte akiramerarenai na"
    },
    {
      "id": 19,
      "start": 118.02,
      "end": 122.39,
      "rubyText": "僕[ぼく]らの未来[みらい]の期待[きたい]も不安[ふあん]も",
      "translation": "우리의 미래를 향한 기대도 불안도",
      "romaji": "bokura no mirai no kitai mo fuan mo"
    },
    {
      "id": 20,
      "start": 122.46,
      "end": 126.53,
      "rubyText": "明日[あした]になったら未確定[みかくてい]らしい。",
      "translation": "내일이란 그저 미확정일 뿐",
      "romaji": "ashita ni nattara mikakutei rashii."
    },
    {
      "id": 21,
      "start": 126.59,
      "end": 129.56,
      "rubyText": "いっそ笑[わら]えるショーにしようぜ！",
      "translation": "차라리 웃을 수 있는 쇼로 만들자!",
      "romaji": "isso waraeru shoo ni shiyou ze!"
    },
    {
      "id": 22,
      "start": 129.66,
      "end": 135.67,
      "rubyText": "さぁ歌[うた]え！怯[おび]えないで合図[あいず]を今[いま]すぐに察知[さっち]して！",
      "translation": "자, 노래 불러! 겁먹지 마 내 신호를 지금 바로 알아차려 줘",
      "romaji": "saa utae! obienaide aizu o ima sugu ni satchi shite!"
    },
    {
      "id": 23,
      "start": 136.2,
      "end": 141.07,
      "rubyText": "声[こえ]すら枯[か]れたならば踊[おど]って",
      "translation": "목소리마저 메말랐다면 춤을 춰 봐",
      "romaji": "koe sura kareta naraba odotte"
    },
    {
      "id": 24,
      "start": 151.58,
      "end": 153.95,
      "rubyText": "『たいせつ』をいくつも失[な]くした",
      "translation": "'소중함'을 얼마나 잃었던지",
      "romaji": "'taisetsu' o ikutsumo nakushita"
    },
    {
      "id": 25,
      "start": 154.05,
      "end": 156.82,
      "rubyText": "競[きそ]って奪[うば]って壊[こわ]れてった",
      "translation": "겨루고 훔치고 부서졌었지",
      "romaji": "kisotte ubatte kowaretetta"
    },
    {
      "id": 26,
      "start": 156.92,
      "end": 159.49,
      "rubyText": "『たいせつ』をいくつも作[つく]った",
      "translation": "'소중함'은 많이 생겨났지",
      "romaji": "'taisetsu' o ikutsumo tsukutta"
    },
    {
      "id": 27,
      "start": 159.59,
      "end": 162.3,
      "rubyText": "選[えら]んで磨[みが]いて星[ほし]になった",
      "translation": "고르고 닦아 별이 되었지",
      "romaji": "erande migaite hoshi ni natta"
    },
    {
      "id": 28,
      "start": 162.4,
      "end": 167.67,
      "rubyText": "明日[あした]は晴[は]れかな？やっぱり雨[あめ]かな？",
      "translation": "내일은 맑을까? 아니면 비가 올까?",
      "romaji": "ashita wa hare kana? yappari ame kana?"
    },
    {
      "id": 29,
      "start": 167.77,
      "end": 174.17,
      "rubyText": "繰[く]り返[かえ]し育[そだ]てよう僕[ぼく]たちの生命[せいめい]を",
      "translation": "반복되는 나날 속 우리들의 생명을 키워 가자",
      "romaji": "kurikaeshi sodateyou bokutachi no seimei o"
    },
    {
      "id": 30,
      "start": 177.84,
      "end": 182.35,
      "rubyText": "僕[ぼく]らは想[おも]いも涙[なみだ]も失[な]くして",
      "translation": "우리는 추억도 눈물도 잃고서",
      "romaji": "bokura wa omoi mo namida mo nakushite"
    },
    {
      "id": 31,
      "start": 182.58,
      "end": 186.45,
      "rubyText": "笑[わら]ってるほど利口[りこう]じゃないらしい。",
      "translation": "웃을 정도로 능숙하진 않아",
      "romaji": "waratteru hodo rikou ja nai rashii."
    },
    {
      "id": 32,
      "start": 186.55,
      "end": 189.59,
      "rubyText": "欲張[よくば]って全部[ぜんぶ]持[も]っていこうぜ！",
      "translation": "욕심을 부려 전부 가지고 가자!",
      "romaji": "yokubatte zenbu motte ikou ze!"
    },
    {
      "id": 33,
      "start": 189.69,
      "end": 192.36,
      "rubyText": "さぁ行[い]こう！終末[おわり]だって遠[とお]くに",
      "translation": "자, 가자! 종말이 올지라도",
      "romaji": "saa ikou! owari datte tooku ni"
    },
    {
      "id": 34,
      "start": 192.43,
      "end": 196.06,
      "rubyText": "ぶっ飛[と]ばしてくれ！",
      "translation": "아주 멀리 날려 줘!",
      "romaji": "buttobashite kure!"
    },
    {
      "id": 35,
      "start": 196.16,
      "end": 202.27,
      "rubyText": "生命[せいめい]が枯[か]れたならば燃[も]やして",
      "translation": "목숨이 메말랐다면 불태워 봐",
      "romaji": "seimei ga kareta naraba moyashite"
    }
  ],
