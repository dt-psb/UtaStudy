{
  "id": "luna-ours",
  "title": "Ours",
  "artist": "*Luna feat. 初音ミク",
  "youtubeId": "QcpjV43ALCA",
  "thumbnail": "https://img.youtube.com/vi/QcpjV43ALCA/hqdefault.jpg",
  "duration": 231,
  "lyrics": [
    {
      "id": 1,
      "start": 1.15,
      "end": 5.42,
      "rubyText": "長[なが]い夢[ゆめ]を見[み]てたみたい",
      "translation": "긴 꿈을 꾼 것 같아?",
      "romaji": "nagai yume o miteta mitai"
    },
    {
      "id": 2,
      "start": 5.42,
      "end": 10.3,
      "rubyText": "何[なに]もない退屈[たいくつ]な日々[ひび]だった？",
      "translation": "아무 것도 아닌 지루한 하루였어?",
      "romaji": "nanimo nai taikutsu na hibi datta?"
    },
    {
      "id": 3,
      "start": 10.3,
      "end": 13.29,
      "rubyText": "動[うご]き出[だ]した時[とき]が、",
      "translation": "움직이기 시작한 때가,",
      "romaji": "ugokidashita toki ga,"
    },
    {
      "id": 4,
      "start": 13.29,
      "end": 17.41,
      "rubyText": "夏[なつ]が「忘[わす]れないで」と光[ひか]った",
      "translation": "여름이 「잊어버리지마」 라며 빛났어",
      "romaji": "natsu ga 'wasurenaide' to hikatta"
    },
    {
      "id": 5,
      "start": 17.41,
      "end": 21.16,
      "rubyText": "きっと変[か]わらず　ただそこにあるものだ",
      "translation": "분명 변치않고, 그저 거기에 있을거야",
      "romaji": "kitto kawarazu tada soko ni aru mono da"
    },
    {
      "id": 6,
      "start": 21.16,
      "end": 24.86,
      "rubyText": "変[か]わってしまったのは　僕[ぼく]たちだ",
      "translation": "변해버린 것은 우리니까",
      "romaji": "kawatte shimatta no wa bokutachi da"
    },
    {
      "id": 7,
      "start": 24.86,
      "end": 28.49,
      "rubyText": "だからこそ今[いま]　大切[たいせつ]なものが",
      "translation": "그렇기에 지금 소중한 것이",
      "romaji": "dakara koso ima taisetsu na mono ga"
    },
    {
      "id": 8,
      "start": 28.49,
      "end": 33.01,
      "rubyText": "もう一度[いちど]愛[いとお]しく　思[おも]えたのなら",
      "translation": "다시금 사랑스럽게 느껴졌다면",
      "romaji": "mou ichido itooshiku omoeta no nara"
    },
    {
      "id": 9,
      "start": 33.01,
      "end": 36.99,
      "rubyText": "ここから始[はじ]めたらいいさ　何度[なんど]でも",
      "translation": "지금부터 시작하면 돼, 몇번이라도",
      "romaji": "koko kara hajimetara ii sa nando demo"
    },
    {
      "id": 10,
      "start": 36.99,
      "end": 40.92,
      "rubyText": "だって僕[ぼく]ら人生[じんせい]一回目[いっかいめ]",
      "translation": "왜냐하면 우리들 인생은 처음인걸",
      "romaji": "datte bokura jinsei ikkaime"
    },
    {
      "id": 11,
      "start": 40.92,
      "end": 50.22,
      "rubyText": "見失[みうしな]って　間違[まちが]って　折[お]れたって また夏[なつ]は巡[めぐ]ってきたんだから",
      "translation": "잃어버리고 실수하고 부러져도 또 여름은 돌아왔으니까",
      "romaji": "miushinatte machigatte oretatte mata natsu wa megutte kitan dakara"
    },
    {
      "id": 12,
      "start": 63.14,
      "end": 67.71,
      "rubyText": "あの日[ひ]失[な]くした日常[にちじょう]は",
      "translation": "그 날 잃어버린 일상은,",
      "romaji": "ano hi nakushita nichijou wa"
    },
    {
      "id": 13,
      "start": 67.71,
      "end": 71.87,
      "rubyText": "埋[う]もれていた夢[ゆめ]は　どんなだった？",
      "translation": "묻혀있던 꿈은 무엇이었어?",
      "romaji": "umoreteita yume wa donna datta?"
    },
    {
      "id": 14,
      "start": 71.87,
      "end": 75.04,
      "rubyText": "動[うご]き出[だ]しそうなんだ",
      "translation": "움직일 것만 같아",
      "romaji": "ugokidashisou nan da"
    },
    {
      "id": 15,
      "start": 75.04,
      "end": 79.31,
      "rubyText": "その名[な]を呼[よ]ばれるのを待[ま]ってる",
      "translation": "그 이름을 불러주길 기다릴게",
      "romaji": "sono na o yobareru no o matteru"
    },
    {
      "id": 16,
      "start": 79.31,
      "end": 82.83,
      "rubyText": "きっと変[か]わらず　ただそこにあったはずだ",
      "translation": "분명 변치않고, 그저 거기에 있었을거야",
      "romaji": "kitto kawarazu tada soko ni atta hazu da"
    },
    {
      "id": 17,
      "start": 82.83,
      "end": 86.76,
      "rubyText": "変[か]わってしまったのは　僕[ぼく]たちだ",
      "translation": "변해버린 것은 우리니까",
      "romaji": "kawatte shimatta no wa bokutachi da"
    },
    {
      "id": 18,
      "start": 86.76,
      "end": 90.34,
      "rubyText": "だからこそ　何気[なにげ]ないこの今[いま]が",
      "translation": "그렇기에 평범한 이 순간이",
      "romaji": "dakara koso nanigenai kono ima ga"
    },
    {
      "id": 19,
      "start": 90.34,
      "end": 94.56,
      "rubyText": "僕[ぼく]を作[つく]ってるって　気[き]づいたから",
      "translation": "나를 만들고 있다는걸 알았으니까",
      "romaji": "boku o tsukutterutte kizuita kara"
    },
    {
      "id": 20,
      "start": 94.56,
      "end": 99.1,
      "rubyText": "今更[いまさら]始[はじ]めてもいいかな？　僕[ぼく]も",
      "translation": "이제와서 시작해도 될까? 나도?",
      "romaji": "imasara hajimetemo ii kana? boku mo"
    },
    {
      "id": 21,
      "start": 99.1,
      "end": 102.73,
      "rubyText": "だって僕[ぼく]ら人生[じんせい]一回[いっかい]で",
      "translation": "왜냐하면 우리들 인생은 처음인걸",
      "romaji": "datte bokura jinsei ikkai de"
    },
    {
      "id": 22,
      "start": 102.73,
      "end": 107.83,
      "rubyText": "やり残[のこ]さぬよう　思[おも]い残[のこ]さぬよう",
      "translation": "남김이 없도록, 여한이 없도록",
      "romaji": "yarinokosanu you omoinokosanu you"
    },
    {
      "id": 23,
      "start": 107.83,
      "end": 111.88,
      "rubyText": "全部[ぜんぶ]使[つか]い切[き]ってみたいから",
      "translation": "전부 써버리고 싶으니까",
      "romaji": "zenbu tsukaikitte mitai kara"
    },
    {
      "id": 24,
      "start": 125.7,
      "end": 133.4,
      "rubyText": "未来[みらい]なんて　どんなでもいいけど",
      "translation": "미래 같은 건 뭐든 좋지만",
      "romaji": "mirai nante donna demo ii kedo"
    },
    {
      "id": 25,
      "start": 133.4,
      "end": 140.0,
      "rubyText": "そこで僕[ぼく]は　胸[むね]を張[は]っていたい",
      "translation": "거기서 나는 가슴을 활짝 펴고싶어",
      "romaji": "soko de boku wa mune o hatteitai"
    },
    {
      "id": 26,
      "start": 140.0,
      "end": 143.96,
      "rubyText": "失敗[しっぱい]しても　散々[さんざん]でも　誰[だれ]も見向[みむ]きもしなくても",
      "translation": "실패해도, 산산조각나도, 아무도 봐주지 않아도",
      "romaji": "shippai shitemo sanzan demo dare mo mimuki mo shinakutemo"
    },
    {
      "id": 27,
      "start": 143.96,
      "end": 147.72,
      "rubyText": "昨日[きのう]までの自分[じぶん]が　大嫌[だいきら]いだとしても",
      "translation": "어제까지의 내가 밉다고해도",
      "romaji": "kinou made no jibun ga daikirai da to shitemo"
    },
    {
      "id": 28,
      "start": 147.72,
      "end": 151.47,
      "rubyText": "そんなのは　知[し]らん顔[かお]　夏[なつ]のせいにしてほら",
      "translation": "그런건 모른체하며 여름 탓으로 해두고, 자",
      "romaji": "sonna no wa shiran kao natsu no sei ni shite hora"
    },
    {
      "id": 29,
      "start": 151.47,
      "end": 158.37,
      "rubyText": "行[い]こう　行[い]こう",
      "translation": "가자, 가자",
      "romaji": "ikou ikou"
    },
    {
      "id": 30,
      "start": 158.37,
      "end": 162.84,
      "rubyText": "思[おも]い通[どお]りいかないことばっかりだ",
      "translation": "뜻대로 안되는 일 투성이야",
      "romaji": "omoidoori ikanai koto bakkari da"
    },
    {
      "id": 31,
      "start": 162.84,
      "end": 166.42,
      "rubyText": "だって僕[ぼく]ら人生[じんせい]一回目[いっかいめ]",
      "translation": "왜냐하면 우리들 인생은 처음인걸",
      "romaji": "datte bokura jinsei ikkaime"
    },
    {
      "id": 32,
      "start": 166.42,
      "end": 173.44,
      "rubyText": "失[な]くして困[こま]るものなんてなかったよな",
      "translation": "잃을 것 따윈 없었으려나",
      "romaji": "nakushite komaru mono nante nakatta yo na"
    },
    {
      "id": 33,
      "start": 173.44,
      "end": 177.66,
      "rubyText": "ここから始[はじ]めたらいいさ何度[なんど]でも",
      "translation": "지금부터 시작하면 돼, 몇번이라도",
      "romaji": "koko kara hajimetara ii sa nando demo"
    },
    {
      "id": 34,
      "start": 177.66,
      "end": 181.53,
      "rubyText": "だって僕[ぼく]ら人生[じんせい]一回[いっかい]で",
      "translation": "왜냐하면 우리들 인생은 한번인걸",
      "romaji": "datte bokura jinsei ikkai de"
    },
    {
      "id": 35,
      "start": 181.53,
      "end": 186.57,
      "rubyText": "やり残[のこ]さぬよう　思[おも]い残[のこ]さぬよう",
      "translation": "남김이 없도록, 여한이 없도록",
      "romaji": "yarinokosanu you omoinokosanu you"
    },
    {
      "id": 36,
      "start": 186.57,
      "end": 191.27,
      "rubyText": "全部[ぜんぶ]使[つか]い切[き]ってみたいから",
      "translation": "전부 써버리고 싶으니까",
      "romaji": "zenbu tsukaikitte mitai kara"
    },
    {
      "id": 37,
      "start": 191.27,
      "end": 195.6,
      "rubyText": "僕[ぼく]らの時間[じかん]だから",
      "translation": "우리의 시간이니까",
      "romaji": "bokura no jikan dakara"
    },
    {
      "id": 38,
      "start": 203.31,
      "end": 205.78,
      "rubyText": "だってこれは",
      "translation": "왜냐하면 이건",
      "romaji": "datte kore wa"
    },
    {
      "id": 39,
      "start": 205.78,
      "end": 212.33,
      "rubyText": "そう　僕[ぼく]らの夏[なつ]だから",
      "translation": "그래, 우리의 여름이니까",
      "romaji": "sou bokura no natsu dakara"
    }
  ],
