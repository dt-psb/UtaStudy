{
  "id": "shaito-milestone",
  "title": "マイルストーン (Milestone)",
  "artist": "しゃいと feat. 音街ウナ",
  "youtubeId": "s5Jj3aE9GAk",
  "thumbnail": "https://img.youtube.com/vi/s5Jj3aE9GAk/hqdefault.jpg",
  "duration": 213,
  "lyrics": [
    {
      "id": 1,
      "start": 0.85,
      "end": 7.24,
      "rubyText": "始[はじ]まりはどんな空[そら]だったろうか",
      "translation": "시작은 어떤 하늘이었을까",
      "romaji": "hajimari wa donna sora dattarou ka"
    },
    {
      "id": 2,
      "start": 8.1,
      "end": 14.0,
      "rubyText": "随分[ずいぶん]と遠[とお]くまで走[はし]ったものだ",
      "translation": "꽤나 멀리까지 달려왔네",
      "romaji": "zuibun to tooku made hashitta mono da"
    },
    {
      "id": 3,
      "start": 15.34,
      "end": 21.7,
      "rubyText": "君[きみ]のいた世界[せかい]がどうも眩[まぶ]しくてさ",
      "translation": "너가 있던 세계가 어쩐지 눈부셔서 말이야",
      "romaji": "kimi no ita sekai ga doumo mabushikute sa"
    },
    {
      "id": 4,
      "start": 22.86,
      "end": 29.03,
      "rubyText": "僕[ぼく]もそれになりたいと思[おも]ったの",
      "translation": "나도 그게 되고 싶다고 생각했어",
      "romaji": "boku mo sore ni naritai to omotta no"
    },
    {
      "id": 5,
      "start": 30.79,
      "end": 34.51,
      "rubyText": "まだきっときっと",
      "translation": "아직 분명 분명",
      "romaji": "mada kitto kitto"
    },
    {
      "id": 6,
      "start": 34.51,
      "end": 37.21,
      "rubyText": "ここは通過点[つうかてん]だけど",
      "translation": "여기는 통과점이지만",
      "romaji": "koko wa tsuukaten dakedo"
    },
    {
      "id": 7,
      "start": 37.21,
      "end": 41.75,
      "rubyText": "こうして君[きみ]と二人[ふたり]手[て]を繋[つな]いで",
      "translation": "이렇게 너와 둘이서 손을 잡고",
      "romaji": "koushite kimi to futari te o tsunaide"
    },
    {
      "id": 8,
      "start": 41.75,
      "end": 45.42,
      "rubyText": "何処[どこ]までも",
      "translation": "어디까지라도",
      "romaji": "doko made mo"
    },
    {
      "id": 9,
      "start": 47.19,
      "end": 49.66,
      "rubyText": "一歩[いっぽ]踏[ふ]み出[だ]す方[ほう]へ",
      "translation": "한 걸음 내딛는 방향으로",
      "romaji": "ippo fumidasu hou e"
    },
    {
      "id": 10,
      "start": 49.66,
      "end": 51.49,
      "rubyText": "鳴[な]るファンファーレ",
      "translation": "울리는 팡파레",
      "romaji": "naru fanfaare"
    },
    {
      "id": 11,
      "start": 51.49,
      "end": 53.76,
      "rubyText": "描[えが]いて一直線[いっちょくせん]",
      "translation": "그리며 일직선",
      "romaji": "egaite icchokusen"
    },
    {
      "id": 12,
      "start": 53.76,
      "end": 54.42,
      "rubyText": "今日[きょう]も",
      "translation": "오늘도",
      "romaji": "kyou mo"
    },
    {
      "id": 13,
      "start": 54.66,
      "end": 56.05,
      "rubyText": "欲張[よくば]った僕[ぼく]らは",
      "translation": "욕심냈던 우리들은",
      "romaji": "yokubatta bokura wa"
    },
    {
      "id": 14,
      "start": 56.05,
      "end": 57.58,
      "rubyText": "運命[うんめい]に抗[あらが]って",
      "translation": "운명에 거슬러서",
      "romaji": "unmei ni aragatte"
    },
    {
      "id": 15,
      "start": 57.58,
      "end": 61.53,
      "rubyText": "ただ掴[つか]みたいゴールへ向[む]かいながら",
      "translation": "그저 잡고 싶은 골을 향해 가면서",
      "romaji": "tada tsukamitai gooru e mukainagara"
    },
    {
      "id": 16,
      "start": 61.75,
      "end": 64.26,
      "rubyText": "きっと引[ひ]き返[かえ]せないね",
      "translation": "분명 되돌아갈 수 없겠네",
      "romaji": "kitto hikikaesenai ne"
    },
    {
      "id": 17,
      "start": 64.26,
      "end": 66.06,
      "rubyText": "先[さき]は長[なが]いぜ",
      "translation": "갈 길이 멀어",
      "romaji": "saki wa nagai ze"
    },
    {
      "id": 18,
      "start": 66.06,
      "end": 68.3,
      "rubyText": "怖[こわ]くても 前[まえ]へ",
      "translation": "무서워도 앞으로",
      "romaji": "kowakutemo mae e"
    },
    {
      "id": 19,
      "start": 68.3,
      "end": 68.97,
      "rubyText": "前[まえ]へ",
      "translation": "앞으로",
      "romaji": "mae e"
    },
    {
      "id": 20,
      "start": 69.2,
      "end": 70.79,
      "rubyText": "飲[の]み込[こ]んだ後悔[こうかい]も",
      "translation": "삼켜버린 후회도",
      "romaji": "nomikonda koukai mo"
    },
    {
      "id": 21,
      "start": 70.79,
      "end": 72.63,
      "rubyText": "ズキリと響[ひび]いた",
      "translation": "욱씬하며 울렸던",
      "romaji": "zukiri to hibiita"
    },
    {
      "id": 22,
      "start": 72.63,
      "end": 74.46,
      "rubyText": "痛[いた]みさえも",
      "translation": "아픔조차도",
      "romaji": "itami sae mo"
    },
    {
      "id": 23,
      "start": 74.46,
      "end": 76.31,
      "rubyText": "君[きみ]と刻[きざ]んだマイルストーン",
      "translation": "너와 새겼던 마일스톤",
      "romaji": "kimi to kizanda mairusutoon"
    },
    {
      "id": 24,
      "start": 82.61,
      "end": 89.04,
      "rubyText": "この先[さき]はどんな空[そら]なんだろうか",
      "translation": "이 앞은 어떤 하늘일까",
      "romaji": "kono saki wa donna sora nan darou ka"
    },
    {
      "id": 25,
      "start": 89.88,
      "end": 94.13,
      "rubyText": "君[きみ]に追[お]いつかれないように",
      "translation": "너에게 따라잡히지 않도록",
      "romaji": "kimi ni oitsukarenai you ni"
    },
    {
      "id": 26,
      "start": 94.35,
      "end": 97.85,
      "rubyText": "僕[ぼく]は今日[きょう]も歌[うた]を紡[つむ]いでいる",
      "translation": "나는 오늘도 노래를 만들어내",
      "romaji": "boku wa kyou mo uta o tsumuide iru"
    },
    {
      "id": 27,
      "start": 111.94,
      "end": 112.64,
      "rubyText": "未[いま]だ",
      "translation": "아직도",
      "romaji": "imada"
    },
    {
      "id": 28,
      "start": 112.64,
      "end": 114.44,
      "rubyText": "僕[ぼく]ら一向[いっこう]に未完成[みかんせい]で",
      "translation": "우리들은 도무지 미완성이라",
      "romaji": "bokura ikkou ni mikansei de"
    },
    {
      "id": 29,
      "start": 114.44,
      "end": 116.21,
      "rubyText": "聖人[せいじん]なんてなれやしなくて",
      "translation": "성인따위 될 수도 없어서",
      "romaji": "seijin nante nare ya shinakute"
    },
    {
      "id": 30,
      "start": 116.21,
      "end": 117.91,
      "rubyText": "それでもほら",
      "translation": "그렇지만 봐봐",
      "romaji": "soredemo hora"
    },
    {
      "id": 31,
      "start": 117.91,
      "end": 119.91,
      "rubyText": "ここまで来[き]たんだ",
      "translation": "여기까지 왔어",
      "romaji": "koko made kitan da"
    },
    {
      "id": 32,
      "start": 119.91,
      "end": 121.68,
      "rubyText": "躓[つまず]いて転[ころ]んで遠[とお]回[まわ]りをして",
      "translation": "넘어지고 자빠지고 멀리 돌아가도",
      "romaji": "tsumazuite koronde toomawari o shite"
    },
    {
      "id": 33,
      "start": 121.68,
      "end": 123.55,
      "rubyText": "息[いき]も次第[しだい]に絶[た]え絶[だ]えになって",
      "translation": "숨도 점점 끊어질 듯해도",
      "romaji": "iki mo shidai ni taedaeni natte"
    },
    {
      "id": 34,
      "start": 123.55,
      "end": 124.82,
      "rubyText": "それでも",
      "translation": "그래도",
      "romaji": "soredemo"
    },
    {
      "id": 35,
      "start": 124.82,
      "end": 132.1,
      "rubyText": "ここがいいって叫[さけ]んでる",
      "translation": "여기가 좋다고 외치고 있어",
      "romaji": "koko ga ii tte sakenderu"
    },
    {
      "id": 36,
      "start": 132.67,
      "end": 135.08,
      "rubyText": "一歩[いっぽ]先[さき]の世界[せかい]へ",
      "translation": "한 걸음 앞의 세상으로",
      "romaji": "ippo saki no sekai e"
    },
    {
      "id": 37,
      "start": 135.14,
      "end": 137.15,
      "rubyText": "次[つぎ]のミライへ",
      "translation": "다음 미래로",
      "romaji": "tsugi no mirai e"
    },
    {
