  "lyrics": [
    {
      "id": 1,
      "start": 13.43,
      "end": 17.3,
      "rubyText": "1.2.3ステップ踏[ふ]んでもう抜[ぬ]け出[だ]せないわ",
      "translation": "Step 1, 2, 3 시작하면 이제 빠져나올 수 없어",
      "romaji": "ichi ni san suteppu funde mou nukedasenai wa"
    },
    {
      "id": 2,
      "start": 17.3,
      "end": 20.66,
      "rubyText": "3.4.5ブレブレな感情[かんじょう]ド正論[せいろん]は",
      "translation": "3, 4, 5 흔들리는 감정, 너의 “완벽한 논리”는",
      "romaji": "san yon go burebure na kanjou do-seiron wa"
    },
    {
      "id": 3,
      "start": 20.8,
      "end": 22.4,
      "rubyText": "Brain Brain Brain out",
      "translation": "Brain, brain, brain out",
      "romaji": "Brain Brain Brain out"
    },
    {
      "id": 4,
      "start": 22.53,
      "end": 23.5,
      "rubyText": "認[みと]めない Doubt！",
      "translation": "인정 못 해, doubt!",
      "romaji": "mitomenai Doubt!"
    },
    {
      "id": 5,
      "start": 24.3,
      "end": 25.76,
      "rubyText": "Brain Brain Brain out！",
      "translation": "Brain, brain, brain out!",
      "romaji": "Brain Brain Brain out!"
    },
    {
      "id": 6,
      "start": 25.84,
      "end": 27.41,
      "rubyText": "酸素[さんそ]飲[の]み込[こ]んで",
      "translation": "공기를 삼켜",
      "romaji": "sanso nomikonde"
    },
    {
      "id": 7,
      "start": 27.48,
      "end": 30.84,
      "rubyText": "Tick Tack ハマって沼[ぬま]らせて吐[は]いて",
      "translation": "Tick-tock 빠져들게 하고 깊이 빠졌다가 뱉어",
      "romaji": "Tick Tack hamatte numarasete haite"
    },
    {
      "id": 8,
      "start": 30.84,
      "end": 34.28,
      "rubyText": "音[おと]の数[かず]だけ踊[おど]ればいいじゃん",
      "translation": "들리는 소리마다 춤추면 되잖아",
      "romaji": "oto no kazu dake odoreba ii jan"
    },
    {
      "id": 9,
      "start": 34.28,
      "end": 37.39,
      "rubyText": "Tick Tack 早[はや]くして！スクロールして",
      "translation": "Tick-tock 빨리 해, 계속 스크롤해",
      "romaji": "Tick Tack hayaku shite! sukurooru shite"
    },
    {
      "id": 10,
      "start": 37.39,
      "end": 39.48,
      "rubyText": "見[み]たくないのは",
      "translation": "보기 싫은 건",
      "romaji": "mitakunai no wa"
    },
    {
      "id": 11,
      "start": 39.48,
      "end": 40.85,
      "rubyText": "ブロックして",
      "translation": "그냥 차단해",
      "romaji": "burokku shite"
    },
    {
      "id": 12,
      "start": 41.3,
      "end": 42.76,
      "rubyText": "ディスコティックナイト",
      "translation": "Discotic Night",
      "romaji": "disukotikku naito"
    },
    {
      "id": 13,
      "start": 42.76,
      "end": 44.37,
      "rubyText": "キミがもういないと",
      "translation": "네가 없으면",
      "romaji": "kimi ga mou inai to"
    },
    {
      "id": 14,
      "start": 44.6,
      "end": 47.65,
      "rubyText": "Dance Dance 踊[おど]れないの",
      "translation": "Dance, dance 춤출 수 없어",
      "romaji": "Dance Dance odorenai no"
    },
    {
      "id": 15,
      "start": 47.88,
      "end": 49.36,
      "rubyText": "ディスコティックナイト",
      "translation": "Discotic Night",
      "romaji": "disukotikku naito"
    },
    {
      "id": 16,
      "start": 49.45,
      "end": 51.13,
      "rubyText": "脳内[のうない]は\"愛[あい]\"と",
      "translation": "머릿속에선 이걸 “사랑”이라고",
      "romaji": "nounai wa \"ai\" to"
    },
    {
      "id": 17,
      "start": 51.2,
      "end": 54.3,
      "rubyText": "勘違[かんちが]いはもうやめて",
      "translation": "착각하는 건 이제 그만",
      "romaji": "kanchigai wa mou yamete"
    },
    {
      "id": 18,
      "start": 61.82,
      "end": 62.92,
      "rubyText": "大好[だいす]きの裏返[うらがえ]し 無関心[むかんしん]",
      "translation": "“좋아해”의 반대는 무관심",
      "romaji": "daisuki no uragaeshi mukanshin"
    },
    {
      "id": 19,
      "start": 62.92,
      "end": 64.59,
      "rubyText": "網膜[もうまく]に焼[や]きつくほど監視[かんし]",
      "translation": "망막에 새겨질 만큼 바라봐",
      "romaji": "moumaku ni yakitsuku hodo kanshi"
    },
    {
      "id": 20,
      "start": 64.59,
      "end": 66.37,
      "rubyText": "盲目[もうもく]に追[お]い続[つづ]けるDancing",
      "translation": "눈이 멀 듯 계속 쫓아가며 dancing",
      "romaji": "moumoku ni oitsuzukeru Dancing"
    },
    {
      "id": 21,
      "start": 66.42,
      "end": 67.64,
      "rubyText": "踊[おど]りましょう",
      "translation": "춤추자",
      "romaji": "odorimashou"
    },
    {
      "id": 22,
