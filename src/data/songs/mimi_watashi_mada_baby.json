{
  "id": "mimi-watashi-mada-baby",
  "title": "わたしまだBABY (Watashi Mada BABY)",
  "artist": "MIMI feat. 狐子",
  "youtubeId": "q8Ap-1MUTew",
  "thumbnail": "https://img.youtube.com/vi/q8Ap-1MUTew/hqdefault.jpg",
  "duration": 155,
  "lyrics": [
    {
      "id": 1,
      "start": 0.41,
      "end": 5.18,
      "rubyText": "未熟[みじゅく] 舞[ま]う私[わたし]は未熟[みじゅく]",
      "translation": "미숙해, 춤추는 나는 아직 미숙해",
      "romaji": "mijuku mau watashi wa mijuku"
    },
    {
      "id": 2,
      "start": 5.18,
      "end": 7.95,
      "rubyText": "白[しら]む方[ほう]へ征[ゆ]く",
      "translation": "날이 밝아오는 쪽으로 향해 가",
      "romaji": "shiramu hou e yuku"
    },
    {
      "id": 3,
      "start": 7.95,
      "end": 10.86,
      "rubyText": "何[なに]も言[い]えぬまま",
      "translation": "아무런 말도 하지 못한 채",
      "romaji": "nani mo ienu mama"
    },
    {
      "id": 4,
      "start": 10.86,
      "end": 13.53,
      "rubyText": "夏[なつ]の思[おも]い出[で]が",
      "translation": "여름의 추억이",
      "romaji": "natsu no omoide ga"
    },
    {
      "id": 5,
      "start": 13.53,
      "end": 16.43,
      "rubyText": "少[すこ]し苦[くる]しくて",
      "translation": "조금은 괴로워서",
      "romaji": "sukoshi kurushikute"
    },
    {
      "id": 6,
      "start": 16.43,
      "end": 19.3,
      "rubyText": "プライベートでしょ",
      "translation": "사적인 부분이잖아",
      "romaji": "puraibeeto desho"
    },
    {
      "id": 7,
      "start": 19.3,
      "end": 22.1,
      "rubyText": "踏[ふ]み込[こ]まないでよ",
      "translation": "더는 발을 들이지 마",
      "romaji": "fumikomanaide yo"
    },
    {
      "id": 8,
      "start": 22.1,
      "end": 24.9,
      "rubyText": "笑[わら]えないままに",
      "translation": "웃지 못한 채로",
      "romaji": "waraenai mama ni"
    },
    {
      "id": 9,
      "start": 24.9,
      "end": 27.67,
      "rubyText": "大人[おとな]になるのね",
      "translation": "어른이 되어가는 거구나",
      "romaji": "otona ni naru no ne"
    },
    {
      "id": 10,
      "start": 27.67,
      "end": 30.54,
      "rubyText": "知[し]っているからさ",
      "translation": "이미 알고 있으니까",
      "romaji": "shitte iru kara sa"
    },
    {
      "id": 11,
      "start": 30.54,
      "end": 33.18,
      "rubyText": "あの声[こえ]に乾杯[かんぱい]",
      "translation": "그 목소리에 건배를",
      "romaji": "ano koe ni kanpai"
    },
    {
      "id": 12,
      "start": 33.18,
      "end": 36.18,
      "rubyText": "嗚呼[ああ]！ 未熟[みじゅく]な想[おも]いだけ",
      "translation": "아아! 미숙한 마음만이",
      "romaji": "aa! mijuku na omoi dake"
    },
    {
      "id": 13,
      "start": 36.18,
      "end": 37.45,
      "rubyText": "夢[ゆめ]はここに",
      "translation": "꿈은 여기에 있어",
      "romaji": "yume wa koko ni"
    },
    {
      "id": 14,
      "start": 37.45,
      "end": 40.29,
      "rubyText": "挨拶[あいさつ]さえも億劫[おっくう]な 夜[よる]に",
      "translation": "인사조차 귀찮아지는 밤에",
      "romaji": "aisatsu sae mo okkuu na yoru ni"
    },
    {
      "id": 15,
      "start": 40.29,
      "end": 42.55,
      "rubyText": "最終便[さいしゅうびん]が待[ま]っている",
      "translation": "막차가 기다리고 있어",
      "romaji": "saishuubin ga matte iru"
    },
    {
      "id": 16,
      "start": 42.55,
      "end": 45.86,
      "rubyText": "笑[わら]えないままに 大人[おとな]になるBABY",
      "translation": "웃지 못한 채 어른이 되어가는 BABY",
      "romaji": "waraenai mama ni otona ni naru BABY"
    },
    {
      "id": 17,
      "start": 45.86,
      "end": 48.16,
      "rubyText": "愛[あい]されたいってココロと",
      "translation": "사랑받고 싶다는 마음과",
      "romaji": "aisaretai tte kokoro to"
    },
    {
      "id": 18,
      "start": 48.16,
      "end": 51.03,
      "rubyText": "鏡合[かがみあ]わせの私[わたし]は未熟[みじゅく]",
      "translation": "거울처럼 마주 본 나는 아직 미숙해",
      "romaji": "kagamiawase no watashi wa mijuku"
    },
    {
      "id": 19,
      "start": 51.03,
      "end": 53.9,
      "rubyText": "何[なに]も知[し]らないままでいようね",
      "translation": "아무것도 모르는 채로 있자",
      "romaji": "nani mo shiranai mama de iyou ne"
    },
    {
      "id": 20,
      "start": 53.9,
      "end": 57.3,
      "rubyText": "夜[よる]が 夜[よる]が 夜[よる]が 夜[よる]が染[そ]め上[あ]げる",
      "translation": "밤이, 밤이, 밤이, 밤이 물들여 가",
      "romaji": "yoru ga yoru ga yoru ga yoru ga someageru"
    },
    {
      "id": 21,
      "start": 79.39,
      "end": 84.06,
      "rubyText": "未熟[みじゅく] 舞[ま]う私[わたし]は未熟[みじゅく]",
      "translation": "미숙해, 춤추는 나는 아직 미숙해",
      "romaji": "mijuku mau watashi wa mijuku"
    },
    {
      "id": 22,
      "start": 84.06,
      "end": 86.97,
      "rubyText": "白[しら]む方[ほう]へ征[ゆ]く",
      "translation": "날이 밝아오는 쪽으로 향해 가",
      "romaji": "shiramu hou e yuku"
    },
    {
      "id": 23,
      "start": 86.97,
      "end": 89.73,
      "rubyText": "何[なに]も言[い]えぬまま",
      "translation": "아무런 말도 하지 못한 채",
      "romaji": "nani mo ienu mama"
    },
    {
      "id": 24,
      "start": 89.73,
      "end": 92.47,
      "rubyText": "空[そら]に靡[なび]いてる",
      "translation": "하늘에 나부끼고 있어",
      "romaji": "sora ni nabiite iru"
    },
    {
      "id": 25,
      "start": 92.47,
      "end": 95.47,
      "rubyText": "言葉[ことば]に火[ひ]を灯[とも]す",
      "translation": "말들에 불을 밝혀",
      "romaji": "kotoba ni hi o tomosu"
    },
    {
      "id": 26,
      "start": 95.47,
      "end": 98.24,
      "rubyText": "私[わたし]は今日[きょう]だけ",
      "translation": "나는 오늘 하루만",
      "romaji": "watashi wa kyou dake"
    },
    {
      "id": 27,
      "start": 98.24,
      "end": 101.81,
      "rubyText": "ここで踊[おど]るだけ",
      "translation": "여기서 춤출 뿐이야",
      "romaji": "koko de odoru dake"
    },
    {
      "id": 28,
      "start": 101.81,
      "end": 106.79,
      "rubyText": "未熟[みじゅく]に あどけなく舞[ま]うDANCE",
      "translation": "미숙하게, 천진난만하게 춤추는 DANCE",
      "romaji": "mijuku ni adokenaku mau DANCE"
    },
    {
      "id": 29,
      "start": 106.79,
      "end": 109.55,
      "rubyText": "私[わたし]まだBABY",
      "translation": "난 아직 BABY",
      "romaji": "watashi mada BABY"
    },
    {
      "id": 30,
      "start": 109.55,
      "end": 112.32,
      "rubyText": "白紙[はくし]のまま踊[おど]る",
      "translation": "백지인 채로 춤춰",
      "romaji": "hakushi no mama odoru"
    },
    {
      "id": 31,
      "start": 112.32,
      "end": 115.09,
      "rubyText": "流[なが]されるままに",
      "translation": "흘러가는 그대로",
      "romaji": "nagasareru mama ni"
    },
    {
      "id": 32,
      "start": 115.09,
      "end": 118.0,
      "rubyText": "吹[ふ]かれてるままに",
      "translation": "바람에 날리는 그대로",
      "romaji": "fukareteru mama ni"
    },
    {
      "id": 33,
      "start": 118.0,
      "end": 120.9,
      "rubyText": "あどけなく舞[ま]うDANCE",
      "translation": "천진난만하게 춤추는 DANCE",
      "romaji": "adokenaku mau DANCE"
    },
    {
      "id": 34,
