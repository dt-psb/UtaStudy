      "rubyText": "扇風機[せんぷうき]、首[くび]を振[ふ]ってる"
    },
    {
      "id": 24,
      "startTime": 112.26,
      "endTime": 115.47,
      "text": "風鈴[ふうりん] 窓際[まどぎわ]で囁[ささや]いてる",
