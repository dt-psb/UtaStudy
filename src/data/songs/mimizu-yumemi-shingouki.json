  "lyrics": [
    {
      "id": 1,
      "startTime": 20.37,
      "endTime": 24.01,
      "text": "君[きみ]はずっと 夏[なつ]を待[ま]ってる",
      "translation": "너는 줄곧 여름을 기다리고 있어",
      "start": 20.37,
      "end": 24.01,
      "rubyText": "君[きみ]はずっと 夏[なつ]を待[ま]ってる"
    },
    {
      "id": 2,
      "startTime": 24.24,
      "endTime": 27.51,
      "text": "青空[あおぞら]が遠[とお]く広[ひろ]がっている",
      "translation": "푸른 하늘이 멀리 펼쳐져 있어",
      "start": 24.24,
      "end": 27.51,
      "rubyText": "青空[あおぞら]が遠[とお]く広[ひろ]がっている"
    },
    {
      "id": 3,
      "startTime": 28.25,
      "endTime": 32.02,
      "text": "麦[むぎ]わら帽子[ぼうし] 飛[と]ばさないよに",
      "translation": "밀짚모자가 날아가지 않게",
      "start": 28.25,
      "end": 32.02,
      "rubyText": "麦[むぎ]わら帽子[ぼうし] 飛[と]ばさないよに"
    },
    {
      "id": 4,
      "startTime": 32.25,
      "endTime": 35.49,
      "text": "この夏[なつ]を忘[わす]れてしまわぬよに",
      "translation": "이 여름을 잊지 않도록",
      "start": 32.25,
      "end": 35.49,
      "rubyText": "この夏[なつ]を忘[わす]れてしまわぬよに"
    },
    {
      "id": 5,
      "startTime": 36.39,
      "endTime": 39.99,
      "text": "君[きみ]はずっと 口[くち]ずさんでる",
      "translation": "너는 줄곧 노래를 흥얼거리고 있어",
      "start": 36.39,
      "end": 39.99,
      "rubyText": "君[きみ]はずっと 口[くち]ずさんでる"
    },
    {
      "id": 6,
      "startTime": 40.26,
      "endTime": 43.49,
      "text": "信号[しんごう]はまだ青[あお]を指[さ]している",
      "translation": "신호등은 아직 파란불을 비추고 있어",
      "start": 40.26,
      "end": 43.49,
      "rubyText": "信号[しんごう]はまだ青[あお]を指[さ]している"
    },
    {
      "id": 7,
      "startTime": 44.4,
      "endTime": 48.0,
      "text": "「くだらない」と君[きみ]は言[い]うけど",
      "translation": "\"시시하다\"고 너는 말하지만",
      "start": 44.4,
      "end": 48.0,
      "rubyText": "「くだらない」と君[きみ]は言[い]うけど"
    },
    {
      "id": 8,
      "startTime": 48.23,
      "endTime": 52.0,
      "text": "メロディを私[わたし]は覚[おぼ]えている まだ",
      "translation": "나는 그 선율을 기억하고 있어 여전히",
      "start": 48.23,
      "end": 52.0,
      "rubyText": "メロディを私[わたし]は覚[おぼ]えている まだ"
    },
    {
      "id": 9,
      "startTime": 52.0,
      "endTime": 53.98,
      "text": "ララララララ",
      "translation": "라라라라라라",
      "start": 52.0,
      "end": 53.98,
      "rubyText": "ララララララ"
    },
    {
      "id": 10,
      "startTime": 53.98,
      "endTime": 55.97,
      "text": "旋律[せんりつ]をなぞってく",
      "translation": "선율을 따라가며",
      "start": 53.98,
      "end": 55.97,
      "rubyText": "旋律[せんりつ]をなぞってく"
    },
    {
      "id": 11,
      "startTime": 55.97,
      "endTime": 57.49,
      "text": "ララララララ",
      "translation": "라라라라라라",
      "start": 55.97,
      "end": 57.49,
      "rubyText": "ララララララ"
    },
    {
      "id": 12,
      "startTime": 57.49,
      "endTime": 59.98,
      "text": "ふわり雲[くも]が触[ふ]れる",
      "translation": "살며시 구름이 스쳐가",
      "start": 57.49,
      "end": 59.98,
      "rubyText": "ふわり雲[くも]が触[ふ]れる"
    },
    {
      "id": 13,
      "startTime": 59.98,
      "endTime": 63.98,
      "text": "さあ 歌[うた]わせてその旋律[うた]を",
      "translation": "자 노래하게 해줘 그 선율(노래)을",
      "start": 59.98,
      "end": 63.98,
      "rubyText": "さあ 歌[うた]わせてその旋律[うた]を"
    },
    {
      "id": 14,
      "startTime": 63.98,
      "endTime": 67.98,
      "text": "詞[ことば]が紡[つむ]ぐ 君[きみ]だけが創[つく]る世界[せかい]！",
      "translation": "글(말)이 엮어내는, 오직 너만이 만들어가는 세상!",
      "start": 63.98,
      "end": 67.98,
      "rubyText": "詞[ことば]が紡[つむ]ぐ 君[きみ]だけが創[つく]る世界[せかい]！"
    },
    {
      "id": 15,
      "startTime": 67.98,
      "endTime": 71.99,
      "text": "ああ 響[ひび]かせてこの夏[なつ]を",
      "translation": "아아 울려 퍼지게 해줘 이 여름을",
      "start": 67.98,
      "end": 71.99,
      "rubyText": "ああ 響[ひび]かせてこの夏[なつ]を"
    },
    {
      "id": 16,
      "startTime": 71.99,
      "endTime": 75.76,
      "text": "波[なみ]が寄[よ]せるまで 夕陽[ゆうひ]が沈[しず]むまで",
      "translation": "파도가 밀려올 때까지 해가 지기까지",
      "start": 71.99,
      "end": 75.76,
      "rubyText": "波[なみ]が寄[よ]せるまで 夕陽[ゆうひ]が沈[しず]むまで"
    },
    {
      "id": 17,
      "startTime": 75.76,
