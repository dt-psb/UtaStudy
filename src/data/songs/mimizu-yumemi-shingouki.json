      "translation": "라라라라라라라",
      "start": 75.76,
      "end": 77.39,
      "rubyText": "ラララララララ"
    },
    {
      "id": 18,
      "startTime": 77.39,
      "endTime": 79.5,
      "text": "旋律[せんりつ]をなぞってく",
      "translation": "선율을 따라가며",
      "start": 77.39,
      "end": 79.5,
      "rubyText": "旋律[せんりつ]をなぞってく"
    },
    {
      "id": 19,
