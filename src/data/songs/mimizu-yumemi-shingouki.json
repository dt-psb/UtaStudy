      "start": 81.36,
      "end": 85.5,
      "rubyText": "君[きみ]の世界[うた]が私[わたし]は好[す]きだったんだ！"
    },
    {
      "id": 21,
      "startTime": 100.38,
      "endTime": 103.99,
      "text": "君[きみ]はずっと 指[ゆび]を噛[か]んでる",
      "translation": "너는 줄곧 손가락을 깨물고 있어",
      "start": 100.38,
      "end": 103.99,
      "rubyText": "君[きみ]はずっと 指[ゆび]を噛[か]んでる"
    },
    {
      "id": 22,
      "startTime": 104.25,
      "endTime": 107.49,
      "text": "モニターは波形[はけい]を描[えが]いている",
      "translation": "모니터는 파형을 그리고 있어",
      "start": 104.25,
      "end": 107.49,
      "rubyText": "モニターは波形[はけい]を描[えが]いている"
