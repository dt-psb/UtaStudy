      "start": 124.37,
      "end": 127.94,
      "rubyText": "音[おと]はずっと 夢[ゆめ]を編[あ]んでる"
    },
    {
      "id": 28,
      "startTime": 128.11,
      "endTime": 133.0,
      "text": "だから君[きみ]は世界[せかい]を創[つく]っている でしょ？",
