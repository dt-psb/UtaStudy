  "lyrics": [
    {
      "id": 1,
      "startTime": 0.437,
      "endTime": 3.216,
      "text": "起[お]きて！起[お]きて！",
      "translation": "일어나, 일어나!",
      "start": 0.437,
      "end": 3.216,
      "rubyText": "起[お]きて！起[お]きて！"
    },
    {
      "id": 2,
      "startTime": 4.728,
      "endTime": 7.226,
      "text": "良[よ]かった、やっと起[お]きた",
      "translation": "다행이다, 드디어 깨어났네",
      "start": 4.728,
      "end": 7.226,
      "rubyText": "良[よ]かった、やっと起[お]きた"
    },
    {
      "id": 3,
      "startTime": 7.251,
      "endTime": 11.183,
      "text": "もー、帰[かえ]ってこないかと思[おも]ってヒヤヒヤしたよ",
      "translation": "정말, 돌아오지 않을까봐 조마조마했다구",
      "start": 7.251,
      "end": 11.183,
      "rubyText": "もー、帰[かえ]ってこないかと思[おも]ってヒヤヒヤしたよ"
    },
    {
      "id": 4,
      "startTime": 22.1,
      "endTime": 26.851,
      "text": "人生[じんせい]にゴールが無[な]くて寂[さび]しいなら",
      "translation": "인생에 목표(골)가 없어서 외롭다면",
      "start": 22.1,
      "end": 26.851,
      "rubyText": "人生[じんせい]にゴールが無[な]くて寂[さび]しいなら"
    },
    {
      "id": 5,
      "startTime": 26.851,
      "endTime": 31.433,
      "text": "明確[めいかく]な意味[いみ]など無[な]くただくだらないなら",
      "translation": "명확한 의미 같은 건 없고 그저 시시하다면",
      "start": 26.851,
      "end": 31.433,
      "rubyText": "明確[めいかく]な意味[いみ]など無[な]くただくだらないなら"
    },
    {
      "id": 6,
      "startTime": 31.876,
      "endTime": 36.434,
      "text": "どこから来[き]てどこへ向[む]かうか考[かんが]えないでさ",
      "translation": "어디서 와서 어디로 향하는지 생각하지 마",
      "start": 31.876,
      "end": 36.434,
      "rubyText": "どこから来[き]てどこへ向[む]かうか考[かんが]えないでさ"
    },
    {
      "id": 7,
      "startTime": 36.434,
      "endTime": 41.243,
      "text": "君[きみ]をそっと見[み]つけ出[だ]してあげる",
      "translation": "내가 너를 살며시 찾아내 줄 테니까",
      "start": 36.434,
      "end": 41.243,
      "rubyText": "君[きみ]をそっと見[み]つけ出[だ]してあげる"
    },
    {
      "id": 8,
      "startTime": 41.243,
      "endTime": 43.8,
      "text": "ナイナイさー　ナイナイさー",
      "translation": "없어 없어- 없어 없어-",
      "start": 41.243,
      "end": 43.8,
      "rubyText": "ナイナイさー　ナイナイさー"
    },
    {
      "id": 9,
      "startTime": 43.8,
      "endTime": 46.24,
      "text": "ナイナイあたし愛[あい]されたことなど",
      "translation": "없단 말야, 나 사랑받아 본 적 따위",
      "start": 43.8,
      "end": 46.24,
      "rubyText": "ナイナイあたし愛[あい]されたことなど"
    },
    {
      "id": 10,
      "startTime": 46.264,
      "endTime": 48.665,
      "text": "ナイのにさー　感[かん]じたいの",
      "translation": "없는데도 말야- 느끼고 싶어",
      "start": 46.264,
      "end": 48.665,
      "rubyText": "ナイのにさー　感[かん]じたいの"
    },
    {
      "id": 11,
      "startTime": 48.677,
      "endTime": 51.07,
      "text": "恋[こい]の欠[か]片[けら]でも",
      "translation": "사랑의 조각이라도",
      "start": 48.677,
      "end": 51.07,
      "rubyText": "恋[こい]の欠[か]片[けら]でも"
    },
    {
      "id": 12,
      "startTime": 51.2,
      "endTime": 53.4,
      "text": "In this land.   In this land.",
      "translation": "이 땅에서, 이 땅에서",
      "start": 51.2,
      "end": 53.4,
      "rubyText": "In this land.   In this land."
    },
    {
      "id": 13,
      "startTime": 53.4,
      "endTime": 55.653,
      "text": "In this slightly dreamcore land.",
      "translation": "조금은 드림코어 같은 이 땅에서",
      "start": 53.4,
      "end": 55.653,
      "rubyText": "In this slightly dreamcore land."
    },
    {
      "id": 14,
      "startTime": 55.653,
      "endTime": 60.325,
      "text": "あなたが住[す]んでた世界[せかい]じゃみんなが苦[くる]しみ合[あ]ってる",
      "translation": "네가 살던 세계에선 모두가 서로 괴로워하고 있잖아",
      "start": 55.653,
      "end": 60.325,
      "rubyText": "あなたが住[す]んでた世界[せかい]じゃみんなが苦[くる]しみ合[あ]ってる"
    },
    {
      "id": 15,
      "startTime": 60.469,
      "endTime": 64.707,
      "text": "Sleeping sleeping, my daring   苦[にが]く甘[あま]いデジャヴ",
      "translation": "Sleeping sleeping, my daring   달콤 쌉싸름한 데자뷔",
      "start": 60.469,
      "end": 64.707,
      "rubyText": "Sleeping sleeping, my daring   苦[にが]く甘[あま]いデジャヴ"
    },
    {
      "id": 16,
      "startTime": 65.33,
      "endTime": 69.531,
      "text": "何回[なんかい]見[み]ても飽[あ]き足[た]らないあつあつな夢[ゆめ]を",
      "translation": "몇 번을 봐도 질리지 않는 뜨거운 꿈을",
      "start": 65.33,
      "end": 69.531,
      "rubyText": "何回[なんかい]見[み]ても飽[あ]き足[た]らないあつあつな夢[ゆめ]を"
    },
    {
      "id": 17,
      "startTime": 70.2,
      "endTime": 74.892,
      "text": "辺[あた]り一面[いちめん]に広[ひろ]がる景色[けしき]は壮観[そうかん]で",
      "translation": "사방으로 펼쳐진 풍경은 장관이고",
      "start": 70.2,
      "end": 74.892,
      "rubyText": "辺[あた]り一面[いちめん]に広[ひろ]がる景色[けしき]は壮観[そうかん]で"
    },
    {
      "id": 18,
      "startTime": 74.897,
      "endTime": 79.434,
      "text": "あなたの祖国[そこく]じゃ見[み]れない奇跡[きせき]の空間[くうかん]で",
      "translation": "당신의 조국에선 볼 수 없는 기적의 공간에서",
      "start": 74.897,
      "end": 79.434,
      "rubyText": "あなたの祖国[そこく]じゃ見[み]れない奇跡[きせき]の空間[くうかん]で"
    },
    {
      "id": 19,
      "startTime": 79.458,
      "endTime": 81.0,
      "text": "私[わたし]を愛[いと]しんでよ！　私[わたし]を愛[いと]しんでよ！",
      "translation": "나를 사랑해 줘! 나를 사랑해 줘!",
      "start": 79.458,
      "end": 81.0,
      "rubyText": "私[わたし]を愛[いと]しんでよ！　私[わたし]を愛[いと]しんでよ！"
    },
    {
      "id": 20,
      "startTime": 81.01,
      "endTime": 85.292,
      "text": "私[わたし]を！　私[わたし]を！　私[わたし]を！　私[わたし]を！",
      "translation": "나를! 나를! 나를! 나를!",
      "start": 81.01,
      "end": 85.292,
      "rubyText": "私[わたし]を！　私[わたし]を！　私[わたし]を！　私[わたし]を！"
    },
    {
      "id": 21,
      "startTime": 85.292,
      "endTime": 91.372,
      "text": "私[わたし]を！　私[わたし]を！　私[わたし]だけ見[み]ていてよ！",
      "translation": "나를! 나를! 나만 바라봐 줘~",
      "start": 85.292,
      "end": 91.372,
      "rubyText": "私[わたし]を！　私[わたし]を！　私[わたし]だけ見[み]ていてよ！"
    },
    {
      "id": 22,
      "startTime": 91.84,
      "endTime": 96.0,
      "text": "Sleeping sleeping, my daring   苦[にが]く甘[あま]いデジャヴ",
      "translation": "Sleeping sleeping, my daring   달콤 쌉싸름한 데자뷔",
      "start": 91.84,
      "end": 96.0,
      "rubyText": "Sleeping sleeping, my daring   苦[にが]く甘[あま]いデジャヴ"
    },
    {
      "id": 23,
      "startTime": 96.568,
      "endTime": 100.672,
      "text": "何回[なんかい]見[み]ても飽[あ]き足[た]らない██な夢[ゆめ]を",
      "translation": "몇 번을 봐도 질리지 않는     한 꿈을",
      "start": 96.568,
      "end": 100.672,
      "rubyText": "何回[なんかい]見[み]ても飽[あ]き足[た]らない██な夢[ゆめ]を"
    },
    {
      "id": 24,
      "startTime": 101.38,
      "endTime": 105.884,
      "text": "私[わたし]と君[きみ]だけに広[ひろ]がる景色[けしき]は壮観[そうかん]で",
      "translation": "나와 너에게만 펼쳐지는 풍경은 장관이고",
      "start": 101.38,
      "end": 105.884,
      "rubyText": "私[わたし]と君[きみ]だけに広[ひろ]がる景色[けしき]は壮観[そうかん]で"
    },
    {
      "id": 25,
      "startTime": 105.908,
      "endTime": 110.575,
      "text": "あっちの世界[せかい]を第二[だいに]の故郷[ふるさと]ってことにしてさ",
      "translation": "저쪽 세계를 '제2의 고향'으로 삼기로 하고 말야",
      "start": 105.908,
      "end": 110.575,
      "rubyText": "あっちの世界[せかい]を第二[だいに]の故郷[ふるさと]ってことにしてさ"
    },
    {
      "id": 26,
      "startTime": 110.603,
      "endTime": 112.5,
      "text": "Marry me.",
      "translation": "나랑 결혼해 줘",
      "start": 110.603,
      "end": 112.5,
      "rubyText": "Marry me."
    },
    {
      "id": 27,
      "startTime": 113.338,
      "endTime": 116.901,
      "text": "何気[なにげ]ない日々[ひび]を過[す]ごしましょう　過[す]ごしましょう",
      "translation": "아무렇지 않은 날들을 보내요! 보내요!",
      "start": 113.338,
      "end": 116.901,
      "rubyText": "何気[なにげ]ない日々[ひび]を過[す]ごしましょう　過[す]ごしましょう"
    },
    {
      "id": 28,
      "startTime": 116.901,
      "endTime": 119.369,
      "text": "困難[こんなん]を分[わ]かち合[あ]いましょう",
      "translation": "어려움은 함께 나눠요",
      "start": 116.901,
      "end": 119.369,
      "rubyText": "困難[こんなん]を分[わ]かち合[あ]いましょう"
    },
    {
      "id": 29,
      "startTime": 119.369,
      "endTime": 121.634,
      "text": "一緒[いっしょ]に乗[の]り越[こ]えていきましょう",
      "translation": "함께 극복해 나가요",
      "start": 119.369,
      "end": 121.634,
      "rubyText": "一緒[いっしょ]に乗[の]り越[こ]えていきましょう"
    },
    {
      "id": 30,
      "startTime": 121.634,
      "endTime": 124.332,
      "text": "毎日[まいにち]ちゃんと起[お]こしてあげるからね",
      "translation": "매일매일 꼭 깨워줄 테니까 말야!",
      "start": 121.634,
      "end": 124.332,
      "rubyText": "毎日[まいにち]ちゃんと起[お]こしてあげるからね"
    },
    {
      "id": 31,
      "startTime": 124.332,
      "endTime": 126.192,
      "text": "だって　だって　だって　だって",
      "translation": "왜냐면, 왜냐면, 왜냐면, 왜냐면",
      "start": 124.332,
