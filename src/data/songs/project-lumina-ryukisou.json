  "lyrics": [
    {
      "id": 1,
      "start": 21.819,
      "end": 26.235,
      "rubyText": "「あなたと共[とも]に」と決[き]めたことも",
      "translation": "「당신과 함께」 하겠다고 정한 것도"
    },
    {
      "id": 2,
      "start": 26.235,
      "end": 30.602,
      "rubyText": "なんにもならなくなっちゃって",
      "translation": "아무것도 이루어지지 않게 돼서"
    },
    {
      "id": 3,
      "start": 30.602,
      "end": 34.935,
      "rubyText": "「言葉[ことば]だけじゃなんとでも」",
      "translation": "「말만으로는 무슨 소리든 할 수 있다」"
    },
    {
      "id": 4,
      "start": 34.935,
      "end": 39.236,
      "rubyText": "なんて言葉[ことば]が似合[にあ]うくらい",
      "translation": "그런 말이 딱 맞을 정도야"
    },
    {
      "id": 5,
      "start": 39.236,
      "end": 43.636,
      "rubyText": "波紋[はもん]に紫陽花[あじさい]が咲[さ]く",
      "translation": "물결에 수국화가 피어나는"
    },
    {
      "id": 6,
      "start": 43.636,
      "end": 46.885,
      "rubyText": "そんな人生[じんせい]だとしても",
      "translation": "그런 인생이라고 하더라도"
    },
    {
      "id": 7,
      "start": 48.031,
      "end": 50.287,
      "rubyText": "過去[かこ]の僕[ぼく]に電話[でんわ]したい",
      "translation": "과거의 나에게 전화하고 싶어"
    },
    {
      "id": 8,
      "start": 50.287,
      "end": 52.352,
      "rubyText": "「飽[あ]きるくらいたくさんの",
      "translation": "「질릴 만큼 겪었던 수많은"
    },
    {
      "id": 9,
      "start": 52.352,
      "end": 54.486,
      "rubyText": "不安[ふあん]なんて後悔[こうかい]なんて",
      "translation": "불안은, 후회는"
    },
    {
      "id": 10,
      "start": 54.486,
      "end": 56.686,
      "rubyText": "鏡[かがみ]の壁[かべ]なんで。",
      "translation": "거울 속 벽이니까."
    },
    {
      "id": 11,
      "start": 56.686,
      "end": 58.786,
      "rubyText": "叩[たた]き割[わ]れば世界[せかい]は",
      "translation": "깨부순다면 세상은"
    },
    {
      "id": 12,
      "start": 58.786,
      "end": 61.302,
      "rubyText": "必[かなら]ず違[ちが]って見[み]える。",
      "translation": "반드시 다르게 보일 거야."
    },
    {
      "id": 13,
      "start": 61.302,
      "end": 63.202,
      "rubyText": "迎[むか]えに行[い]かなきゃ見[み]えないものなんて",
      "translation": "맞이하러 가야만 보이는 것도"
    },
    {
      "id": 14,
      "start": 63.202,
      "end": 64.702,
      "rubyText": "沢山[たくさん]ある。」",
      "translation": "잔뜩 있어.」"
    },
    {
      "id": 15,
      "start": 64.702,
      "end": 65.435,
      "rubyText": "走[はし]り出[だ]せ！",
      "translation": "달려나가!"
    },
    {
      "id": 16,
      "start": 73.323,
      "end": 74.168,
      "rubyText": "走[はし]り出[だ]せ！",
      "translation": "달려나가!"
    },
    {
      "id": 17,
      "start": 82.109,
      "end": 82.885,
      "rubyText": "走[はし]り出[だ]せ！",
      "translation": "달려나가!"
    },
    {
      "id": 18,
      "start": 82.885,
      "end": 87.318,
      "rubyText": "あなたが「共[とも]に」と決[き]めたことも",
      "translation": "당신이 「함께」 하자고 정했던 것도"
    },
    {
      "id": 19,
      "start": 87.318,
      "end": 91.685,
      "rubyText": "なんともならなくなっちゃって",
      "translation": "아무렇지 않게 되어버려서"
    },
    {
      "id": 20,
      "start": 91.685,
      "end": 96.035,
      "rubyText": "「言葉[ことば]だけを見[み]ているの？」",
      "translation": "「말만 보고 있는 거야?」"
    },
    {
      "id": 21,
      "start": 96.035,
      "end": 100.302,
      "rubyText": "なんて言葉[ことば]に気[き]づかずに",
      "translation": "그런 말을 알아채지 못한 채"
    },
    {
      "id": 22,
      "start": 100.302,
      "end": 104.736,
      "rubyText": "波紋[はもん]に紫陽花[あじさい]が咲[さ]く",
      "translation": "물결에 수국화가 피어나는"
    },
    {
      "id": 23,
      "start": 104.736,
      "end": 107.936,
      "rubyText": "そんな人生[じんせい]を望[のぞ]むよ",
      "translation": "그런 인생이 되길 바라"
    },
    {
      "id": 24,
      "start": 109.096,
      "end": 111.352,
      "rubyText": "過去[かこ]の僕[ぼく]に電話[でんわ]したい",
      "translation": "과거의 나에게 전화하고 싶어"
    },
    {
      "id": 25,
      "start": 111.352,
      "end": 113.452,
      "rubyText": "「飽[あ]きるくらいたくさんの",
      "translation": "「질릴 만큼 겪었던 수많은"
    },
    {
      "id": 26,
      "start": 113.452,
      "end": 115.551,
      "rubyText": "馬鹿[ばか]になんて嘲笑[ちょうしょう]なんて",
      "translation": "바보 취급은, 비웃음은"
    },
    {
      "id": 27,
      "start": 115.551,
      "end": 117.352,
      "rubyText": "春北風[はるきたかぜ]なんで。",
      "translation": "추위가 서린 봄바람이니까."
    },
    {
      "id": 28,
      "start": 117.352,
      "end": 119.252,
      "rubyText": "心[こころ]持[も]てば世界[せかい]は、",
      "translation": "마음을 가지면 세상은,"
    },
    {
      "id": 29,
      "start": 119.252,
