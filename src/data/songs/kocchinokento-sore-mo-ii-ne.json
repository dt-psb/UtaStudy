  "lyrics": [
    {
      "id": 1,
      "start": 18.2,
      "end": 21.928,
      "rubyText": "僕[ぼく]らが覚[おぼ]えている",
      "translation": "우리가 기억하는"
    },
    {
      "id": 2,
      "start": 21.928,
      "end": 25.525,
      "rubyText": "優[やさ]しさとか自[じ]分[ぶん]らしさ",
      "translation": "상냥함이나 나다움"
    },
    {
      "id": 3,
      "start": 25.525,
      "end": 29.429,
      "rubyText": "世[せ]界[かい]のわたしたちは",
      "translation": "세상 속 우리는"
    },
    {
      "id": 4,
      "start": 29.429,
      "end": 33.07,
      "rubyText": "どう思[おも]うかな？",
      "translation": "어떻게 생각할까?"
    },
    {
      "id": 5,
      "start": 33.07,
      "end": 40.303,
      "rubyText": "たとえば「よろこび」を運[はこ]ぶ車[くるま]があったとしたら",
      "translation": "예를 들어 '기쁨'을 운반하는 차가 있다면"
    },
    {
      "id": 6,
      "start": 40.303,
      "end": 48.174,
      "rubyText": "その車[くるま]には誰[だれ]もが願[ねが]うだけで一[いっ]緒[しょ]に乗[の]れるのかな？",
      "translation": "그 차에는 누구나 원하면 같이 탈 수 있을까?"
    },
    {
      "id": 7,
      "start": 48.174,
      "end": 52.239,
      "rubyText": "どんどんのめり込[こ]んでくこの世[せ]界[かい]は",
      "translation": "점점 빠져드는 이 세상은"
    },
    {
      "id": 8,
      "start": 52.239,
      "end": 55.77,
      "rubyText": "誰[だれ]もが人[ひと]それぞれ",
      "translation": "누구나 저마다 달라"
    },
    {
      "id": 9,
      "start": 55.77,
      "end": 59.904,
      "rubyText": "どんどんのめり込[こ]んでくこの世[せ]界[かい]は",
      "translation": "점점 빠져드는 이 세상은"
    },
    {
      "id": 10,
      "start": 59.904,
      "end": 63.442,
      "rubyText": "摩[ま]訶[か]不[ふ]思[し]議[ぎ]ばかりだから",
      "translation": "특이한것투성이니까"
    },
    {
      "id": 11,
      "start": 63.442,
      "end": 65.213,
      "rubyText": "違[ちが]っていても…",
      "translation": "다르지만…"
    },
    {
      "id": 12,
      "start": 65.213,
      "end": 69.185,
      "rubyText": "『それもいいね！』",
      "translation": "\"그것도 좋아!\""
    },
    {
      "id": 13,
      "start": 69.185,
      "end": 72.702,
      "rubyText": "僕[ぼく]らが覚[おぼ]えている",
      "translation": "우리가 기억하는"
    },
    {
      "id": 14,
      "start": 72.702,
