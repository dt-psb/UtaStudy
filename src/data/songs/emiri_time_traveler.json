    {
      "id": 37,
      "start": 153.29,
      "end": 157.47,
      "rubyText": "願[ねが]い事[ごと]はほとんど叶[かな]わないけれど",
      "translation": "소원은 거의 이루어지지 않지만",
      "romaji": "negaigoto wa hotondo kawanai keredo"
    },
    {
      "id": 38,
      "start": 157.47,
      "end": 160.61,
      "rubyText": "とりあえず願[ねが]うよ",
      "translation": "우선은 빌어볼게",
