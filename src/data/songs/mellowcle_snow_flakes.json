  "lyrics": [
    {
      "id": 1,
      "start": 7.55,
      "end": 10.27,
      "rubyText": "Action は衝動的[しょうどうてき]に",
      "translation": "행동은 충동적으로"
    },
    {
      "id": 2,
      "start": 10.27,
      "end": 11.25,
      "rubyText": "Alright alright",
      "translation": "Alright alright"
    },
    {
      "id": 3,
      "start": 11.25,
      "end": 13.9,
      "rubyText": "Fashion は情熱的[じょうねつてき]に",
      "translation": "패션은 정열적으로"
    },
    {
      "id": 4,
      "start": 13.9,
      "end": 15.76,
      "rubyText": "Gonna be gonna be gonna be",
      "translation": "Gonna be gonna be gonna be"
    },
    {
      "id": 5,
      "start": 15.76,
      "end": 17.55,
      "rubyText": "Lunch 好[す]きな物[もの]",
      "translation": "점심은 좋아하는 것"
    },
    {
      "id": 6,
      "start": 17.55,
      "end": 19.27,
      "rubyText": "Dinner 好[す]きなだけ",
      "translation": "저녁은 원하는 만큼"
    },
    {
      "id": 7,
      "start": 19.27,
      "end": 23.01,
      "rubyText": "カラフルフルーツにパフェ Happy happy",
      "translation": "다채로운 과일에 파르페 Happy happy"
    },
    {
      "id": 8,
      "start": 23.01,
      "end": 24.83,
      "rubyText": "見[み]たことない場所[ばしょ]行[い]って",
      "translation": "본 적 없는 곳에 가서"
    },
    {
      "id": 9,
      "start": 24.83,
      "end": 26.67,
      "rubyText": "思[おも]い出[で]のページ増[ふ]やして",
      "translation": "추억의 페이지를 늘려가며"
    },
    {
      "id": 10,
      "start": 26.67,
      "end": 29.73,
      "rubyText": "振[ふ]り回[まわ]されるのも悪[わる]くないね",
      "translation": "휘둘리는 것도 나쁘지 않네"
    },
    {
      "id": 11,
      "start": 29.73,
      "end": 33.6,
      "rubyText": "ちょっと！そんな風[ふう]に思[おも]ってたの？",
      "translation": "잠깐! 그런 식으로 생각했던 거야?"
    },
    {
      "id": 12,
      "start": 33.6,
      "end": 37.72,
      "rubyText": "いや僕[ぼく]だって So good 楽[たの]しんでる OK OK!!",
      "translation": "아니 나도 So good 즐기고 있어 OK OK!!"
    },
    {
      "id": 13,
      "start": 37.72,
      "end": 44.89,
      "rubyText": "月明[つきあ]かりの下[した]で始[はじ]まる物語[ものがたり]",
      "translation": "달빛 아래에서 시작되는 이야기"
    },
    {
      "id": 14,
      "start": 44.89,
      "end": 52.05,
      "rubyText": "並[なら]んで見上[みあ]げた夜空[よぞら]に",
      "translation": "나란히 올려다본 밤하늘에"
    },
    {
      "id": 15,
      "start": 52.05,
      "end": 55.74,
      "rubyText": "降[ふ]り出[だ]す Snow Flakes 魔法[まほう]みたいに",
      "translation": "내리기 시작하는 Snow Flakes 마법처럼"
    },
    {
      "id": 16,
      "start": 55.74,
      "end": 59.0,
      "rubyText": "煌[きら]めく Party 甘[あま]く溶[と]けていく",
      "translation": "반짝이는 Party 달콤하게 녹아내려 가"
    },
    {
      "id": 17,
      "start": 59.0,
      "end": 62.38,
      "rubyText": "願[ねが]い事[ごと] My wish この時間[じかん]が Fresh",
      "translation": "소원 My wish 이 시간이 Fresh"
    },
    {
      "id": 18,
      "start": 62.38,
      "end": 66.78,
      "rubyText": "いつまでもずっとずっと続[つづ]きますように",
      "translation": "언제까지나 계속 영원히 이어지기를"
    },
    {
      "id": 19,
      "start": 66.78,
      "end": 70.54,
      "rubyText": "舞[ま]い散[ち]る Snow Flakes 映画[えいが]みたいな",
      "translation": "흩날리는 Snow Flakes 영화 같은"
    },
    {
      "id": 20,
      "start": 70.54,
      "end": 73.48,
      "rubyText": "素敵[すてき]な Party 特別[とくべつ]な瞬間[しゅんかん]",
      "translation": "멋진 Party 특별한 순간"
    },
    {
      "id": 21,
      "start": 73.48,
      "end": 77.5,
      "rubyText": "これからもこんな景色[けしき]を",
      "translation": "앞으로도 이런 풍경을"
    },
    {
      "id": 22,
      "start": 77.5,
      "end": 82.28,
      "rubyText": "君[きみ]と君[きみ]と見続[みつづ]けて行[い]きたい",
      "translation": "너와 너와 계속 바라보며 가고 싶어"
    },
    {
      "id": 23,
      "start": 82.28,
      "end": 84.02,
      "rubyText": "非日常[ひにちじょう]に浸[ひた]って",
      "translation": "비일상에 젖어들어"
    },
    {
      "id": 24,
      "start": 84.02,
      "end": 85.77,
      "rubyText": "こんな贅沢[ぜいたく]したって",
      "translation": "이런 사치를 부려도"
    },
    {
      "id": 25,
      "start": 85.77,
      "end": 87.38,
      "rubyText": "バチは OMG!!",
      "translation": "벌받는 건 OMG!!"
    },
    {
      "id": 26,
      "start": 87.38,
      "end": 89.49,
      "rubyText": "Forgive me give me give me!!",
      "translation": "Forgive me give me give me!!"
    },
    {
      "id": 27,
      "start": 89.49,
      "end": 91.3,
      "rubyText": "美味[おい]しいものばかりで",
      "translation": "맛있는 것들투성이라"
    },
    {
      "id": 28,
      "start": 91.3,
      "end": 93.11,
      "rubyText": "あれもこれも欲張[よくば]って",
      "translation": "이것도 저것도 욕심부려"
    },
    {
      "id": 29,
      "start": 93.11,
      "end": 96.77,
      "rubyText": "スイーツだけは別腹[べつばら]なんだっけ？",
      "translation": "디저트 배는 따로였던가?"
    },
    {
      "id": 30,
      "start": 96.77,
      "end": 103.93,
      "rubyText": "ねえ楽[たの]しい時間[じかん]ってなんで短[みじか]く感[かん]じるの？",
      "translation": "있잖아, 즐거운 시간은 왜 짧게 느껴지는 걸까?"
    },
    {
      "id": 31,
      "start": 103.93,
      "end": 109.31,
      "rubyText": "1分[いっぷん]1秒[いちびょう]を大切[たいせつ]にしよう",
      "translation": "1분 1초를 소중히 여기자"
    },
    {
      "id": 32,
      "start": 109.31,
      "end": 113.0,
      "rubyText": "降[ふ]り出[だ]す Snow Flakes 魔法[まほう]をかけて",
      "translation": "내리기 시작하는 Snow Flakes 마법을 걸고"
    },
    {
      "id": 33,
      "start": 113.0,
      "end": 116.19,
      "rubyText": "煌[きら]めく Party 星達[ほしたち]と Winter show",
      "translation": "반짝이는 Party 별들과 함께하는 Winter show"
    },
    {
      "id": 34,
      "start": 116.19,
      "end": 119.67,
      "rubyText": "願[ねが]い事[ごと] My wish 瞬[またた]いてる Flash",
      "translation": "소원 My wish 반짝이는 Flash"
    },
    {
      "id": 35,
      "start": 119.67,
      "end": 124.27,
      "rubyText": "繋[つな]いだ星座[せいざ]ほら見[み]て美味[おい]しそうだね",
      "translation": "이어진 별자리 봐봐, 맛있어 보여"
    },
    {
      "id": 36,
      "start": 124.27,
      "end": 127.97,
      "rubyText": "またいつか君[きみ]と一緒[いっしょ]に",
      "translation": "또 언젠가 너와 함께"
    },
    {
      "id": 37,
      "start": 127.97,
      "end": 131.74,
      "rubyText": "同[おな]じ景色[けしき]見[み]に来[き]たいね",
      "translation": "같은 풍경을 보러 오고 싶네"
    },
    {
      "id": 38,
      "start": 131.74,
      "end": 135.38,
      "rubyText": "思[おも]い出[で]はきっと色褪[いろあ]せない",
      "translation": "추억은 분명 바래지 않아"
    },
    {
      "id": 39,
      "start": 135.38,
      "end": 138.78,
      "rubyText": "この目[め]に焼[や]き付[つ]けて",
      "translation": "이 눈에 새겨두고"
    },
    {
      "id": 40,
