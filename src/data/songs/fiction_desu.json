{
  "id": "chenomio-fiction-desu",
  "title": "フィクションです。 (Fiction Desu)",
  "artist": "Chenomio feat. 重音テト",
  "youtubeId": "LxVv4QneUuU",
  "thumbnail": "https://img.youtube.com/vi/LxVv4QneUuU/hqdefault.jpg",
  "duration": 150,
  "lyrics": [
    {
      "id": 1,
      "start": 2.89,
      "end": 6.15,
      "rubyText": "はいはい、そうこれってフィクションです。",
      "translation": "그래 그래, 이거 다 픽션이야",
      "romaji": "haihai, sou kore tte fikushon desu."
    },
    {
      "id": 2,
      "start": 6.15,
      "end": 8.62,
      "rubyText": "設定[せってい] 開[ひら]いて 選[えら]ぶストーリー",
      "translation": "설정 열어서 스토리 고르는 거지",
      "romaji": "settei hiraite erabu sutoorii"
    },
    {
      "id": 3,
      "start": 9.04,
      "end": 11.88,
      "rubyText": "だいたい そう 世界[せかい]はフィクションです。",
      "translation": "대충 말하면 이 세계도 픽션이고",
      "romaji": "daitai sou sekai wa fikushon desu."
    },
    {
      "id": 4,
      "start": 11.88,
      "end": 13.62,
      "rubyText": "電源[でんげん]オンしてGO!!",
      "translation": "전원 켜고 GO!!",
      "romaji": "dengen on shite GO!!"
    },
    {
      "id": 5,
      "start": 14.93,
      "end": 16.93,
      "rubyText": "余裕[よゆう]ぶって ダラダラ",
      "translation": "여유 부리면서 늘어지다",
      "romaji": "yoyuu butte daradara"
    },
    {
      "id": 6,
      "start": 17.32,
      "end": 20.0,
      "rubyText": "ライフ減[へ]ってく「それがどーした？」",
      "translation": "보니 라이프 깎이고 “그래서 뭐 어쩌라고?”",
      "romaji": "raifu hetteku \"sore ga dooshita?\""
    },
    {
      "id": 7,
      "start": 20.32,
      "end": 22.62,
      "rubyText": "で、トラブって いまさら",
      "translation": "그러다 사고 터지고",
      "romaji": "de, torabutte imasara"
    },
    {
      "id": 8,
      "start": 23.24,
      "end": 25.26,
      "rubyText": "冷[ひ]や汗[あせ]の エブリデイ",
      "translation": "이제 와서 식은땀 흘리는 매일",
      "romaji": "hiyaase no eburidei"
    },
    {
      "id": 9,
      "start": 26.36,
      "end": 29.24,
      "rubyText": "まぁ、そもそも人生[じんせい] 運[うん]ゲー 意味[いみ]さえ知[し]らない",
      "translation": "애초에 인생은 운빨겜 의미 같은 건 몰라도 돼",
      "romaji": "maa, somosomo jinsei ungee imi sae shiranai"
    },
    {
      "id": 10,
      "start": 29.24,
      "end": 32.54,
      "rubyText": "フィロソフィーなら DLC ほら 後[あと]づけでいいん",
      "translation": "철학 같은 건 DLC처럼 나중에 붙이면",
      "romaji": "firosofii nara DLC hora atozuke de ii n"
    },
    {
      "id": 11,
      "start": 32.54,
      "end": 33.12,
      "rubyText": "です。",
      "translation": "되잖아",
      "romaji": "desu."
    },
    {
      "id": 12,
      "start": 33.12,
      "end": 34.14,
      "rubyText": "さぁ お次[つぎ]は",
      "translation": "자, 다음은",
      "romaji": "saa otsugi wa"
    },
    {
      "id": 13,
      "start": 34.63,
      "end": 36.25,
      "rubyText": "君[きみ]の番[ばん]だ",
      "translation": "네 차례야",
      "romaji": "kimi no ban da"
    },
    {
      "id": 14,
      "start": 36.25,
      "end": 37.24,
      "rubyText": "Next stage➡",
      "translation": "Next stage➡",
      "romaji": "Next stage"
    },
    {
      "id": 15,
      "start": 38.58,
      "end": 39.99,
      "rubyText": "エンジョイ勢[ぜい] Pay to play",
      "translation": "즐겜러 Pay to play",
      "romaji": "enjoi-zei Pay to play"
    },
    {
      "id": 16,
      "start": 40.27,
      "end": 41.4,
      "rubyText": "ガチ勢[ぜい]さんMy own way",
      "translation": "하드코어는 My own way",
      "romaji": "gachi-zei-san My own way"
    },
    {
      "id": 17,
      "start": 41.4,
      "end": 42.71,
      "rubyText": "全人類[ぜんじんるい] 参戦[さんせん] 大乱闘[だいらんとう]",
      "translation": "전 인류 참전, 대난투",
      "romaji": "zenjinrui sansen dairantou"
    },
    {
      "id": 18,
      "start": 42.71,
      "end": 43.21,
      "rubyText": "Ready Go!",
      "translation": "Ready Go!",
      "romaji": "Ready Go!"
    },
    {
      "id": 19,
      "start": 43.52,
      "end": 44.35,
      "rubyText": "このまま",
      "translation": "이대로",
      "romaji": "kono mama"
    },
    {
      "id": 20,
      "start": 44.53,
      "end": 47.32,
      "rubyText": "何回[なんかい]も何回[なんかい]も 繰[く]り返[かえ]しずっと",
      "translation": "몇 번이고 몇 번이고 계속 반복하면서",
      "romaji": "nankai mo nankai mo kurikaeshi zutto"
    },
    {
      "id": 21,
      "start": 47.32,
      "end": 50.76,
      "rubyText": "セーブして ロードして レベル上[あ]げろ 人生[じんせい]",
      "translation": "세이브하고 로드하고 레벨 올려, 인생",
      "romaji": "seebu shite roodo shite reberu agero jinsei"
    },
    {
      "id": 22,
      "start": 50.86,
      "end": 53.34,
      "rubyText": "サヴァイヴしてこう この展開[てんかい]を",
      "translation": "이 전개, 끝까지 살아남아 보자",
      "romaji": "savaivu shite kou kono tenkai o"
    },
    {
      "id": 23,
      "start": 53.34,
      "end": 54.8,
      "rubyText": "ハイスコアメイクして",
      "translation": "하이스코어 찍고",
      "romaji": "hai sukoa meiku shite"
    },
    {
      "id": 24,
      "start": 54.9,
      "end": 56.21,
      "rubyText": "神回避[かみかいひ] “Way to go!”",
      "translation": "신들린 컨트롤 “Way to go!”",
      "romaji": "kamikaihi \"Way to go!\""
    },
    {
      "id": 25,
      "start": 56.21,
      "end": 58.82,
      "rubyText": "正解[せいかい]も不正解[ふせいかい]も 君[きみ]次第[しだい] I don’t know",
      "translation": "정답이든 오답이든 네 선택이야 I don’t know",
      "romaji": "seikai mo fuseikai mo kimi shidai I don't know"
    },
    {
      "id": 26,
      "start": 58.82,
      "end": 62.58,
      "rubyText": "最後[さいご]にはGGって フィクション 楽[たの]しもうよ",
      "translation": "마지막엔 GG 치고, 이 픽션 즐겨보자고",
      "romaji": "saigo ni wa GG tte fikushon tanoshimou yo"
    },
    {
      "id": 27,
      "start": 62.79,
      "end": 65.31,
      "rubyText": "理由[りゆう]なんてもう 必要[ひつよう]ない",
      "translation": "이유 같은 건 이제 필요 없어",
      "romaji": "riyuu nante mou hitsuyou nai"
    },
    {
      "id": 28,
      "start": 65.31,
      "end": 66.87,
      "rubyText": "コンティニュー もう一周[いっしゅう]？",
      "translation": "컨티뉴, 한 판 더?",
      "romaji": "kontinyuu mou isshuu?"
    },
    {
      "id": 29,
      "start": 66.87,
      "end": 68.34,
      "rubyText": "HPないや…",
      "translation": "HP 없는데…",
      "romaji": "HP nai ya..."
    },
    {
      "id": 30,
      "start": 68.34,
      "end": 71.03,
      "rubyText": "はいはい、そうこれってフィクションです。",
      "translation": "그래 그래, 이거 다 픽션이야",
