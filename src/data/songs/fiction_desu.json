    {
      "id": 34,
      "start": 83.27,
      "end": 84.56,
      "rubyText": "チュートリアル なんてない世界[せかい]",
      "translation": "튜토리얼 따위 없는 세계",
      "romaji": "chuutoriaru nante nai sekai"
    },
    {
      "id": 35,
      "start": 84.56,
      "end": 86.0,
      "rubyText": "放[ほう]り出[だ]され さぁ スタートライン",
      "translation": "던져지듯 뉴비가 되고",
      "romaji": "houridasare saa sutaato rain"
    },
    {
      "id": 36,
      "start": 86.0,
      "end": 87.29,
      "rubyText": "ちょっと待[ま]って ゴール遠[とお]くない？",
      "translation": "잠깐만, 목표까지 너무 먼 거 아니야?",
      "romaji": "chotto matte gooru tookunai?"
    },
    {
      "id": 37,
      "start": 87.29,
      "end": 88.92,
      "rubyText": "サブクエばっかで フラグ立[た]ってない",
      "translation": "서브퀘만 하고 플래그는 안 서 있고",
      "romaji": "sabukue bakka de furagu tattenai"
    },
    {
      "id": 38,
      "start": 88.92,
      "end": 90.47,
      "rubyText": "ダンジョン 最下層[さいかそう] 今日[きょう]も迷子[まいご]",
      "translation": "던전 최하층, 오늘도 길 잃고",
      "romaji": "danjon saikasou kyou mo maigo"
    },
    {
      "id": 39,
      "start": 90.47,
      "end": 91.74,
      "rubyText": "これって もう詰[つ]んでない？",
      "translation": "이거 그냥 망한 거 아니야?",
      "romaji": "kore tte mou tsundenai?"
    },
    {
      "id": 40,
      "start": 91.95,
      "end": 93.31,
      "rubyText": "滅[ほろ]びの呪文[じゅもん]の MP足[た]りない！",
      "translation": "멸망 주문 쓰기엔 MP가 부족해!",
      "romaji": "horobi no jumon no MP tarinai!"
    },
    {
      "id": 41,
      "start": 106.27,
      "end": 109.31,
      "rubyText": "このまま 何回[なんかい]も何回[なんかい]も 繰[く]り返[かえ]しずっと",
      "translation": "이대로 몇 번이고 몇 번이고 계속 반복하면서",
      "romaji": "kono mama nankai mo nankai mo kurikaeshi zutto"
    },
    {
      "id": 42,
      "start": 112.0,
      "end": 112.74,
      "rubyText": "ほらまた",
      "translation": "또 이러네",
      "romaji": "hora mata"
    },
    {
      "id": 43,
      "start": 112.74,
      "end": 115.38,
      "rubyText": "チートして無双[むそう]したって つまんないよ きっと",
      "translation": "치트 써서 무쌍 찍어도 재미없잖아 분명",
