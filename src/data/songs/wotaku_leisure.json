  "duration": 165,
  "lyrics": [
    {
      "id": 1,
      "start": 0.62,
      "end": 3.99,
      "rubyText": "行間[ぎょうかん]ばっかのウォーアイニー",
      "romaji": "gyoukan bakka no uo ai nii",
      "translation": "행간밖에 없는 워 아이 니"
    },
    {
      "id": 2,
      "start": 3.99,
      "end": 7.89,
      "rubyText": "まだ言[い]えない何[なに]も",
      "romaji": "mada ienai nanimo",
      "translation": "아직 말할 수 없어, 아무것도"
    },
    {
      "id": 3,
      "start": 7.89,
      "end": 11.2,
      "rubyText": "肯定感[こうていかん]　雑多[ざった]　ローファイビート",
      "romaji": "kouteikan zatta roofai biito",
      "translation": "긍정감 잡다 로파이 비트"
    },
    {
      "id": 4,
      "start": 11.2,
      "end": 15.0,
      "rubyText": "なら明日[あした]ってどう？",
      "romaji": "nara ashita tte dou?",
      "translation": "그럼 내일은 어때?"
    },
    {
      "id": 5,
      "start": 28.45,
      "end": 29.95,
      "rubyText": "着[つ]いたよ　どっち？",
      "romaji": "tsuita yo docchi?",
      "translation": "도착했어, 어디야?"
    },
    {
      "id": 6,
      "start": 29.95,
      "end": 32.98,
      "rubyText": "近[ちか]くにカバのコーナーあり？",
      "romaji": "chikaku ni kaba no koonaa ari?",
      "translation": "가까이에 하마 코너 있어?"
    },
    {
      "id": 7,
      "start": 32.98,
      "end": 34.72,
      "rubyText": "もうちょっと　バイソン寄[よ]り",
      "romaji": "mou chotto baison yori",
      "translation": "조금 더, 들소 근처"
    },
    {
      "id": 8,
      "start": 34.72,
      "end": 36.59,
      "rubyText": "ってもうカステラ食[く]ってる",
      "romaji": "tte mou kasutera kutteru",
      "translation": "근데 이미 카스테라 먹고 있어"
    },
    {
      "id": 9,
      "start": 37.86,
      "end": 40.42,
      "rubyText": "来[き]てから　ずっと　寝[ね]てるね",
      "romaji": "kite kara zutto neteru ne",
      "translation": "오고 나서 계속 자고 있네"
    },
    {
      "id": 10,
      "start": 40.42,
      "end": 42.66,
      "rubyText": "ホワイトタイガー",
      "romaji": "howaito taigaa",
      "translation": "화이트 타이거"
    },
    {
      "id": 11,
      "start": 42.66,
      "end": 43.79,
      "rubyText": "アレ買[か]って",
      "romaji": "are katte",
      "translation": "저거 사 줘"
    },
    {
      "id": 12,
      "start": 43.79,
      "end": 46.3,
      "rubyText": "ペンギンのデカいぬいぐるみ",
      "romaji": "pengin no dekai nuigurumi",
      "translation": "커다란 펭귄 인형"
    },
    {
      "id": 13,
      "start": 47.43,
      "end": 50.7,
      "rubyText": "近[ちか]い　近[ちか]すぎるよ",
      "romaji": "chikai chikasugiru yo",
      "translation": "가까워, 너무 가깝다고"
    },
    {
      "id": 14,
      "start": 50.7,
      "end": 52.04,
      "rubyText": "ライオンだのに",
      "romaji": "raion danoni",
      "translation": "사자가 있는데"
    },
    {
      "id": 15,
      "start": 52.04,
      "end": 55.17,
      "rubyText": "可愛[かわい]い　触[さわ]りたい",
      "romaji": "kawaii sawaritai",
      "translation": "귀여워, 만지고 싶어"
    },
    {
      "id": 16,
      "start": 55.17,
      "end": 55.74,
      "rubyText": "カワウソ",
      "romaji": "kawauso",
      "translation": "수달을"
    },
    {
      "id": 17,
      "start": 57.11,
      "end": 59.41,
      "rubyText": "行間[ぎょうかん]ばっかのウォーアイニー",
      "romaji": "gyoukan bakka no uo ai nii",
      "translation": "행간밖에 없는 워 아이 니"
    },
    {
      "id": 18,
      "start": 59.41,
      "end": 61.51,
      "rubyText": "まだ言[い]えない何[なに]も",
      "romaji": "mada ienai nanimo",
      "translation": "아직 말할 수 없어, 아무것도"
    },
    {
      "id": 19,
      "start": 61.51,
      "end": 64.35,
      "rubyText": "肯定感[こうていかん]　雑多[ざった]　ローファイビート",
      "romaji": "kouteikan zatta roofai biito",
      "translation": "긍정감 잡다 로파이 비트"
    },
    {
      "id": 20,
      "start": 64.35,
      "end": 66.58,
      "rubyText": "なら明日[あした]ってどう？",
      "romaji": "nara ashita tte dou?",
      "translation": "그럼 내일은 어때?"
    },
    {
      "id": 21,
      "start": 66.58,
      "end": 68.92,
      "rubyText": "冗談[じょうだん]ばっかでポーカーフェイス",
      "romaji": "joudan bakka de pookaa feisu",
      "translation": "농담밖에 없는 포커 페이스"
    },
    {
      "id": 22,
      "start": 68.92,
      "end": 71.06,
      "rubyText": "早[はや]く喋[しゃべ]っちまえ",
      "romaji": "hayaku shabecchimae",
      "translation": "빨리 말해버려"
    },
    {
      "id": 23,
      "start": 71.06,
      "end": 73.79,
      "rubyText": "想定外[そうていがい]からノーヒント",
      "romaji": "souteigai kara noo hinto",
      "translation": "예상 밖에서 노 힌트"
    },
    {
      "id": 24,
      "start": 73.79,
      "end": 76.13,
      "rubyText": "また間違[まちが]っていこう",
      "romaji": "mata machigatte ikou",
      "translation": "또 틀려보자"
    },
    {
      "id": 25,
      "start": 85.8,
      "end": 95.31,
      "rubyText": "水[みず]の中[なか]で暮[く]らす",
      "romaji": "mizu no naka de kurasu",
      "translation": "물 속에서 살아"
    },
    {
      "id": 26,
      "start": 95.31,
      "end": 99.32,
      "rubyText": "ねえ　飲[の]みきれないサイダー",
      "romaji": "nee nomikirenai saidaa",
      "translation": "저기, 아직 다 못 마신 사이다"
    },
    {
      "id": 27,
      "start": 99.32,
      "end": 104.79,
      "rubyText": "炭酸[たんさん]抜[ぬ]けちゃったけど誰[だれ]かいる？",
      "romaji": "tansan nukechatta kedo dareka iru?",
      "translation": "탄산 빠졌는데 누구 필요한 사람?"
    },
    {
      "id": 28,
      "start": 104.79,
      "end": 106.49,
      "rubyText": "ウサギをモフらんと",
      "romaji": "usagi o mofuran to",
      "translation": "복실복실 토끼를 만져야 해"
    },
    {
      "id": 29,
      "start": 106.49,
      "end": 109.43,
      "rubyText": "「然[しか]り」と並[なら]んだよ一行[いっこう]",
      "romaji": "shikari to naranda yo ikkou",
      "translation": "'그건 맞아'라며 줄을 섰어, 다들"
    },
    {
      "id": 30,
      "start": 109.43,
      "end": 111.73,
      "rubyText": "ハシビロコウ見[み]てたよ",
      "romaji": "hashibirokou miteta yo",
      "translation": "넓적부리황새를 보고 있었어"
    },
    {
      "id": 31,
      "start": 111.73,
      "end": 114.36,
      "rubyText": "2時間[にじかん]ぐらい",
      "romaji": "nijikan gurai",
      "translation": "2시간 정도"
    },
    {
      "id": 32,
      "start": 114.36,
      "end": 116.8,
      "rubyText": "近[ちか]い近[ちか]い近[ちか]い近[ちか]い近[ちか]い近[ちか]い近[ちか]い",
      "romaji": "chikai chikai chikai chikai chikai chikai chikai",
      "translation": "가까워 가까워 가까워 가까워 가까워 가까워 가까워"
    },
    {
      "id": 33,
      "start": 116.8,
      "end": 119.27,
      "rubyText": "コモドドラゴンが何故[なぜ]ここに",
      "romaji": "komodo doragon ga naze koko ni",
      "translation": "코모도왕도마뱀이 왜 여기 있어"
    },
    {
      "id": 34,
      "start": 119.27,
      "end": 122.24,
      "rubyText": "可愛[かわい]いでちゅね　触[さわ]りたい",
      "romaji": "kawaii dechune sawaritai",
      "translation": "기여어, 만지고 싶어"
    },
    {
      "id": 35,
      "start": 122.24,
      "end": 123.27,
      "rubyText": "カワウソ",
      "romaji": "kawauso",
      "translation": "수달을"
    },
    {
      "id": 36,
      "start": 126.2,
      "end": 126.7,
      "rubyText": "れいじゃっ！",
      "romaji": "reija!",
      "translation": "레젓!"
    },
    {
      "id": 37,
      "start": 131.45,
      "end": 132.72,
      "rubyText": "さながらガラガラヘビ　見[み]んな",
      "romaji": "sanagara garagarahebi minna",
      "translation": "마치 방울뱀 같아, 보지 마"
    },
    {
      "id": 38,
      "start": 132.72,
      "end": 134.45,
      "rubyText": "半[なか]ば　ヤマアラシのジレンマ",
      "romaji": "nakaba yamaarashi no jirenma",
      "translation": "한복판, 고슴도치의 딜레마"
    },
    {
      "id": 39,
      "start": 136.19,
      "end": 138.69,
      "rubyText": "行間感[ぎょうかんかん]　行間感[ぎょうかんかん]　ウォーアイニー",
      "romaji": "gyoukankan gyoukankan uo ai nii",
      "translation": "행간 간 행간 간 워 아이 니"
    },
    {
      "id": 40,
      "start": 138.69,
      "end": 140.79,
      "rubyText": "まだまだだ何[なに]も",
      "romaji": "madamadada nanimo",
      "translation": "아직, 아직이야 아무것도"
    },
    {
      "id": 41,
      "start": 140.79,
      "end": 143.46,
      "rubyText": "コテコテ肯定[こうてい]　ローファイ　ビービー",
      "romaji": "kotekote koutei roofai biibii",
      "translation": "덕지덕지 긍정 로파이 비 비"
    },
    {
      "id": 42,
      "start": 143.46,
      "end": 145.8,
      "rubyText": "明日[あした]ってどう？どう？どう？",
      "romaji": "ashita tte dou? dou? dou?",
      "translation": "내일은 어때? 어때? 어때?"
    },
    {
      "id": 43,
      "start": 145.8,
      "end": 148.13,
      "rubyText": "馬鹿[ばか]ばっかでポカポカフェイス",
      "romaji": "baka bakka de pokapoka feisu",
      "translation": "바보밖에 없어서 포커 포커 페이스"
    },
    {
      "id": 44,
      "start": 148.13,
      "end": 150.33,
      "rubyText": "クシャクシャ　べちべちで",
      "romaji": "kushakusha bechibechi de",
      "translation": "꾸깃꾸깃 찰팍찰팍해서"
    },
    {
      "id": 45,
      "start": 150.33,
      "end": 152.87,
      "rubyText": "想定外[そうていがい]　装丁[そうてい]　イガイガヒント",
      "romaji": "souteigai soutei igaiga hinto",
      "translation": "예상 밖 장정 이외이외 힌트"
    },
    {
      "id": 46,
      "start": 152.87,
      "end": 155.41,
      "rubyText": "また街[まち]遊[あそ]びいこう",
      "romaji": "mata machiasobi ikou",
      "translation": "또 거리 나들이 가자"
    },
    {
      "id": 47,
      "start": 155.41,
      "end": 157.47,
      "rubyText": "温泉[おんせん]かなんか了解[りょうかい]",
      "romaji": "onsen ka nanka ryoukai",
      "translation": "온천이든 어디든 확인"
    },
    {
      "id": 48,
      "start": 157.47,
      "end": 159.64,
      "rubyText": "なら明日[あした]ってどう？",
      "romaji": "nara ashita tte dou?",
      "translation": "그럼 내일은 어때?"
    }
  ],
