  "lyrics": [
    {
      "id": 1,
      "start": 7.708,
      "end": 11.666,
      "rubyText": "Hah ラッタッタ忙[いそが]しい 人混[ひとご]み躱[かわ]し",
      "translation": "Hah 랏탓타 바쁘게 인파를 피해가며"
    },
    {
      "id": 2,
      "start": 11.833,
      "end": 15.125,
      "rubyText": "後[うし]ろ指[ゆび]？はいこっち ゴジユーニ",
      "translation": "뒤에서 손가락질? 네, 이쪽은 마음대로 하시길"
    },
    {
      "id": 3,
      "start": 15.458,
      "end": 19.083,
      "rubyText": "ジャッジ待[ま]ちの列[れつ]に 悪[わる]いがお先[さき]に",
      "translation": "심사를 기다리는 줄에 미안하지만 난 먼저 갈게"
    },
    {
      "id": 4,
      "start": 19.291,
      "end": 22.458,
      "rubyText": "桁[けた]違[ちが]いの変差値[へんさち] 生[う]まれつき",
      "translation": "차원이 다른 변차값(편차치), 날 때부터 타고났지"
    },
    {
      "id": 5,
      "start": 23.083,
      "end": 26.458,
      "rubyText": "笑[わら]え 試[ため]せ 真似[まね]していいぜ",
      "translation": "웃어봐, 시험해 봐, 얼마든 흉내 내도 돼"
    },
    {
      "id": 6,
      "start": 26.541,
      "end": 29.875,
      "rubyText": "嵌[は]め殺[ごろ]しなんてnot my way",
      "translation": "퇴로를 막고 몰아넣는 것 따윈 not my way"
    },
    {
      "id": 7,
      "start": 30.5,
      "end": 31.958,
      "rubyText": "キテレツLifestyle",
      "translation": "엉뚱하고 기괴한 Lifestyle"
    },
    {
      "id": 8,
      "start": 32.25,
      "end": 33.708,
      "rubyText": "居心地[いごこち]最高[さいこう]",
      "translation": "지내는 기분은 최고"
    },
    {
      "id": 9,
      "start": 34.208,
      "end": 35.333,
      "rubyText": "ありがちはOh Noooo!",
      "translation": "흔해 빠진 방식은 Oh Noooo!"
    },
    {
      "id": 10,
      "start": 35.541,
      "end": 37.166,
      "rubyText": "奇抜[きばつ]上等[じょうとう]！",
      "translation": "기발함 대환영!"
    },
    {
      "id": 11,
      "start": 37.375,
      "end": 40.833,
      "rubyText": "だらだらだら文句[もんく]は言[い]わないで",
      "translation": "주절주절 주절 불평은 늘어놓지 마"
    },
    {
      "id": 12,
      "start": 40.958,
      "end": 45.083,
      "rubyText": "ゲラゲラゲラ不器用[ぶきよう]に生[い]きようぜ",
      "translation": "낄낄낄 서툴게라도 멋대로 살아가자고"
    },
    {
      "id": 13,
      "start": 45.25,
      "end": 48.5,
      "rubyText": "愛想笑[あいそわら]い貼[は]り付[つ]けるが正解[せいかい]?",
      "translation": "억지웃음을 붙여놓고 사는 게 정답이야?"
    },
    {
      "id": 14,
      "start": 48.791,
      "end": 51.625,
      "rubyText": "比類[ひるい]なき 天性[てんせい]鬼才[きさい]",
      "translation": "비할 데 없는 천부적인 귀재"
    },
    {
      "id": 15,
      "start": 55.041,
      "end": 57.208,
      "rubyText": "Stop! Stop! Stop! (聞[き]き飽[あ]きたって)",
      "translation": "Stop! Stop! Stop! (듣는 것도 질렸다고)"
    },
    {
      "id": 16,
      "start": 57.25,
      "end": 59.041,
      "rubyText": "Out! Out! Out! (お呼[よ]びじゃないって)",
      "translation": "Out! Out! Out! (부른 적 없다고)"
    },
    {
      "id": 17,
      "start": 59.083,
      "end": 59.708,
      "rubyText": "Off! Off! Off!",
      "translation": "Off! Off! Off!"
    },
    {
      "id": 18,
      "start": 59.708,
      "end": 62.75,
