{
  "id": "chinozo_damatte_chan",
  "title": "だまってちゃん",
  "artist": "Chinozo feat. 重音テト",
  "youtubeId": "uOeOZQ5eCZ0",
  "duration": 141,
  "lyrics": [
    {
      "id": 1,
      "start": 1.91,
      "end": 5.11,
      "rubyText": "ねぇ　安心[あんしん]しておくれ",
      "romaji": "nee anshin shite okure",
      "translation": "부디 안심해 주길 바라"
    },
    {
      "id": 2,
      "start": 5.16,
      "end": 8.81,
      "rubyText": "分[わ]かる　貴方[あなた]は賢[かしこ]く強[つよ]くて美[うつく]しい",
      "romaji": "wakaru anata wa kashikoku tsuyokute utsukushii",
      "translation": "알아 당신은 현명하고 강하고 아름다워"
    },
    {
      "id": 3,
      "start": 8.81,
      "end": 10.19,
      "rubyText": "他意[たい]はねぇ",
      "romaji": "tai wa nee",
      "translation": "다른 뜻은 없어"
    },
    {
      "id": 4,
      "start": 10.28,
      "end": 13.13,
      "rubyText": "\"運[うん]が良[よ]かっただけじゃない？笑[わら]\"",
      "romaji": "\"un ga yokatta dake janai? wara\"",
      "translation": "\"운이 좋았을 뿐 아니야? 웃음\""
    },
    {
      "id": 5,
      "start": 13.16,
      "end": 16.5,
      "rubyText": "なんて思[おも]っちゃいけないね",
      "romaji": "nante omoccha ikenai ne",
      "translation": "라고 생각하면 안 되겠지?"
    },
    {
      "id": 6,
      "start": 16.5,
      "end": 17.37,
      "rubyText": "メ　メ　メ",
      "romaji": "me me me",
      "translation": "메 메 메"
    },
    {
      "id": 7,
      "start": 17.37,
      "end": 19.71,
      "rubyText": "迷[めい]　侘[わ]び寂[さ]び",
      "romaji": "mei wabisabi",
      "translation": "방황 한적함"
    },
    {
      "id": 8,
      "start": 19.98,
      "end": 21.85,
      "rubyText": "果実[かじつ]は捨[す]て Tap",
      "romaji": "kajitsu wa sute Tap",
      "translation": "과실은 버리고 Tap"
    },
    {
      "id": 9,
      "start": 21.85,
      "end": 23.84,
      "rubyText": "錆[さ]びた威[い]",
      "romaji": "sabita i",
      "translation": "녹슨 위엄"
    },
    {
      "id": 10,
      "start": 23.86,
      "end": 25.88,
      "rubyText": "微[かす]かにラッタッタ",
      "romaji": "kasuka ni rattatta",
      "translation": "초라하게 랏탓타"
    },
    {
      "id": 11,
      "start": 25.93,
      "end": 27.55,
      "rubyText": "侘[わ]び寂[さ]び",
      "romaji": "wabisabi",
      "translation": "한적함"
    },
    {
      "id": 12,
      "start": 27.58,
      "end": 29.62,
      "rubyText": "無実[むじつ]を祟[たた]った",
      "romaji": "mujitsu o tatatta",
      "translation": "억울함을 입어"
    },
    {
      "id": 13,
      "start": 29.66,
      "end": 32.13,
      "rubyText": "恥[はじ]　恥[はじ]",
      "romaji": "haji haji",
      "translation": "창피 수치"
    },
    {
      "id": 14,
      "start": 32.31,
      "end": 36.19,
      "rubyText": "足音[あしおと]は鳴[な]らさないデ！",
      "romaji": "ashioto wa narasanai de!",
      "translation": "발소리는 내지 말아줘!"
    },
    {
      "id": 15,
      "start": 36.26,
      "end": 39.93,
      "rubyText": "貴方[あなた]がいなきゃ僕[ぼく]は勇[いさま]しい",
      "romaji": "anata ga inakya boku wa isamashii",
      "translation": "당신이 없으면 나는 대담해져"
    },
    {
      "id": 16,
      "start": 40.02,
      "end": 44.13,
      "rubyText": "足跡[あしあと]だけ残[のこ]してくネ！",
      "romaji": "ashiato dake nokoshiteku ne!",
      "translation": "발자국만 남겨둘게!"
    },
    {
      "id": 17,
      "start": 44.19,
      "end": 48.25,
      "rubyText": "貴方[あなた]には言[い]えないが大嫌[だいきら]いだ　ヤハハ",
      "romaji": "anata ni wa ienai ga daikirai da yahaha",
      "translation": "당신에게는 말 못하지만 정말 싫어해 야하하"
    },
    {
      "id": 18,
      "start": 48.3,
      "end": 50.33,
      "rubyText": "おい シシシ　黙[だま]ってちゃん（はッ）",
      "romaji": "oi shishishi damatte chan (ha)",
      "translation": "어이 쉿쉿쉿 잠자코쨩(핫)"
    },
    {
      "id": 19,
      "start": 50.36,
      "end": 52.26,
      "rubyText": "あらやだやだ　いまどきサイレンス",
      "romaji": "ara yada yada imadoki sairensu",
      "translation": "어머 싫어라 요즘의 Silence"
    },
    {
      "id": 20,
      "start": 52.27,
      "end": 54.17,
      "rubyText": "シシシ　黙[だま]ってちゃん（はッ）",
      "romaji": "shishishi damatte chan (ha)",
      "translation": "쉿쉿쉿 잠자코쨩(핫)"
    },
    {
      "id": 21,
      "start": 54.19,
      "end": 56.02,
      "rubyText": "傷付[きずつ]きたくないないNight Night",
      "romaji": "kizutsukitaku nai nai Night Night",
      "translation": "상처 입고 싶지 않아 않아 Night Night"
    },
    {
      "id": 22,
      "start": 56.06,
      "end": 59.29,
      "rubyText": "ねぇ　安心[あんしん]しておくれ",
      "romaji": "nee anshin shite okure",
      "translation": "부디 안심해 주길 바라"
    },
    {
      "id": 23,
      "start": 59.29,
      "end": 63.0,
      "rubyText": "分[わ]かる　貴方[あなた]は儚[はかな]く弱[よわ]くて美[うつく]しい",
      "romaji": "wakaru anata wa hakanaku yowakute utsukushii",
      "translation": "알아 당신은 덧없고 연약하며 아름다워"
    },
    {
      "id": 24,
      "start": 63.0,
      "end": 65.47,
      "rubyText": "流石[さすが]お嬢[じょう]さん！流石[さすが]お嬢[じょう]さん！",
      "romaji": "sasuga ojousan! sasuga ojousan!",
      "translation": "역시 아가씨! 역시 아가씨!"
    },
    {
      "id": 25,
      "start": 65.47,
      "end": 67.47,
      "rubyText": "僕[ぼく]の冴[さ]えない人生[じんせい]とは違[ちが]いますなお嬢[じょう]さん！",
      "romaji": "boku no saenai jinsei to wa chigaimasu na ojousan!",
      "translation": "저의 별 볼 일 없는 인생과는 다르네요 아가씨!"
    },
    {
      "id": 26,
      "start": 67.48,
      "end": 71.81,
      "rubyText": "明日[あした]もいっしょにあそぼ",
      "romaji": "ashita mo issho ni asobo",
      "translation": "내일도 같이 놀자"
    },
    {
      "id": 27,
      "start": 72.56,
      "end": 75.08,
      "rubyText": "訂[てい]　闇[やみ]Love it",
      "romaji": "tei yami Love it",
      "translation": "정정 어둠 Love it"
    },
    {
      "id": 28,
      "start": 75.08,
      "end": 77.09,
      "rubyText": "罵詈[ばり]はしまった Tap",
      "romaji": "bari wa shimatta Tap",
      "translation": "폭언은 멈췄어 Tap"
    },
    {
