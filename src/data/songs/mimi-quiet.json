  "releaseDate": "2026-07-31",
  "lyrics": [
    {
      "id": 1,
      "startTime": 22.906,
      "endTime": 24.5,
      "text": "ただ時間[じかん]過[す]ぎ去[さ]るのを待[ま]って",
      "translation": "그저 시간이 지나가기를 기다리며",
      "start": 22.906,
      "end": 24.5,
      "rubyText": "ただ時間[じかん]過[す]ぎ去[さ]るのを待[ま]って"
    },
    {
      "id": 2,
      "startTime": 24.608,
      "endTime": 25.8,
      "text": "今日[きょう]が過去[かこ]になって",
      "translation": "오늘이 과거가 되고",
      "start": 24.608,
      "end": 25.8,
      "rubyText": "今日[きょう]が過去[かこ]になって"
    },
    {
      "id": 3,
      "startTime": 25.909,
      "endTime": 27.5,
      "text": "少[すこ]し悲[かな]しくなって",
      "translation": "조금 슬퍼지고",
      "start": 25.909,
      "end": 27.5,
      "rubyText": "少[すこ]し悲[かな]しくなって"
    },
    {
      "id": 4,
      "startTime": 28.5,
      "endTime": 30.1,
      "text": "文字[もじ]で心[こころ]満[み]たせなくて",
      "translation": "글자로는 마음을 채울 수 없어",
      "start": 28.5,
      "end": 30.1,
      "rubyText": "文字[もじ]で心[こころ]満[み]たせなくて"
    },
    {
      "id": 5,
      "startTime": 30.18,
      "endTime": 31.35,
      "text": "辛[つら]くなって",
      "translation": "괴로워져서",
      "start": 30.18,
      "end": 31.35,
      "rubyText": "辛[つら]くなって"
    },
    {
      "id": 6,
      "startTime": 31.415,
      "endTime": 34.0,
      "text": "星[ほし]を眺[なが]めている",
      "translation": "별을 바라보고 있어",
      "start": 31.415,
      "end": 34.0,
      "rubyText": "星[ほし]を眺[なが]めている"
    },
    {
      "id": 7,
      "startTime": 40.057,
      "endTime": 42.4,
      "text": "明日[あした]どんなこんな世界[せかい]の中[なか]でさ",
      "translation": "내일도 어떻든 이런 세상 속에서",
      "start": 40.057,
      "end": 42.4,
      "rubyText": "明日[あした]どんなこんな世界[せかい]の中[なか]でさ"
    },
    {
      "id": 8,
      "startTime": 42.493,
      "endTime": 45.0,
      "text": "息[いき]をしなきゃいけなくってさ",
      "translation": "숨을 쉬어야만 하니까",
      "start": 42.493,
      "end": 45.0,
      "rubyText": "息[いき]をしなきゃいけなくってさ"
    },
    {
      "id": 9,
      "startTime": 45.462,
      "endTime": 47.731,
      "text": "夜[よる]に溶[と]けた氷[こおり]の寂[さび]しさの果[は]て",
      "translation": "밤에 녹아든 얼음의 그 외로움의 끝에서",
      "start": 45.462,
      "end": 47.731,
      "rubyText": "夜[よる]に溶[と]けた氷[こおり]の寂[さび]しさの果[は]て"
    },
    {
      "id": 10,
      "startTime": 48.132,
      "endTime": 50.467,
      "text": "幸[しあわ]せって見[み]つけられるの？",
      "translation": "행복이란 걸 찾을 수 있을까?",
      "start": 48.132,
      "end": 50.467,
      "rubyText": "幸[しあわ]せって見[み]つけられるの？"
    },
    {
      "id": 11,
      "startTime": 50.868,
      "endTime": 53.237,
      "text": "ただ君[きみ]とどうかきっといつか笑[わら]えたらさ",
      "translation": "너와 부디 언젠가 문득 웃을 수 있다면 말야",
      "start": 50.868,
      "end": 53.237,
      "rubyText": "ただ君[きみ]とどうかきっといつか笑[わら]えたらさ"
    },
    {
      "id": 12,
      "startTime": 53.637,
      "endTime": 55.939,
      "text": "遠[とお]い遠[とお]い星[ほし]の瞬[またた]き",
      "translation": "멀고 먼 별의 반짝임",
      "start": 53.637,
      "end": 55.939,
      "rubyText": "遠[とお]い遠[とお]い星[ほし]の瞬[またた]き"
    },
    {
      "id": 13,
      "startTime": 56.407,
      "endTime": 59.176,
      "text": "そして僕[ぼく]ら忘[わす]れないよ今日[きょう]の日[ひ]を",
      "translation": "그리고 우린 잊지 않을 거야, 오늘 이 날을",
      "start": 56.407,
      "end": 59.176,
      "rubyText": "そして僕[ぼく]ら忘[わす]れないよ今日[きょう]の日[ひ]を"
    },
    {
      "id": 14,
      "startTime": 59.243,
      "endTime": 62.0,
      "text": "無音[むおん]の先[さき]の歌[うた]を",
      "translation": "무음 너머의 노래를",
      "start": 59.243,
      "end": 62.0,
      "rubyText": "無音[むおん]の先[さき]の歌[うた]を"
    },
    {
      "id": 15,
      "startTime": 73.39,
      "endTime": 75.926,
      "text": "何[なに]も出来[でき]なくって僕[ぼく]はずっと待[ま]ってる 嗚呼[ああ]",
      "translation": "나는, 아무것도 하지 못하고 계속 기다리고 있어 아",
      "start": 73.39,
      "end": 75.926,
      "rubyText": "何[なに]も出来[でき]なくって僕[ぼく]はずっと待[ま]ってる 嗚呼[ああ]"
    },
    {
      "id": 16,
      "startTime": 75.926,
      "endTime": 78.062,
      "text": "ずっと覚[おぼ]えている",
      "translation": "계속 기억하고 있어",
      "start": 75.926,
      "end": 78.062,
      "rubyText": "ずっと覚[おぼ]えている"
    },
    {
      "id": 17,
      "startTime": 78.796,
      "endTime": 80.097,
      "text": "こんな今日[きょう]も綺麗[きれい]だって",
      "translation": "이런 오늘도 아름답다고",
      "start": 78.796,
      "end": 80.097,
      "rubyText": "こんな今日[きょう]も綺麗[きれい]だって"
    },
    {
      "id": 18,
      "startTime": 80.197,
      "endTime": 81.365,
      "text": "教[おし]えてくれた",
      "translation": "알려주었던",
      "start": 80.197,
      "end": 81.365,
      "rubyText": "教[おし]えてくれた"
    },
    {
      "id": 19,
      "startTime": 81.665,
      "endTime": 83.667,
      "text": "君[きみ]の香[かお]りがそっと",
      "translation": "너의 향기가 살며시",
      "start": 81.665,
      "end": 83.667,
      "rubyText": "君[きみ]の香[かお]りがそっと"
    },
    {
      "id": 20,
      "startTime": 84.735,
      "endTime": 89.206,
      "text": "空[から]っぽな僕[ぼく]が歩[ある]いたら",
      "translation": "텅 빈 내가 걸어가면",
      "start": 84.735,
      "end": 89.206,
      "rubyText": "空[から]っぽな僕[ぼく]が歩[ある]いたら"
    },
    {
      "id": 21,
      "startTime": 89.273,
      "endTime": 91.208,
      "text": "また今夜[こんや]くらい 今夜[こんや]くらい",
      "translation": "또 오늘 밤만은 오늘 밤만은",
      "start": 89.273,
      "end": 91.208,
      "rubyText": "また今夜[こんや]くらい 今夜[こんや]くらい"
    },
    {
      "id": 22,
      "startTime": 91.275,
      "endTime": 92.576,
      "text": "歌[うた]おうよって",
      "translation": "노래하자고 하는",
      "start": 91.275,
      "end": 92.576,
      "rubyText": "歌[うた]おうよって"
    },
    {
      "id": 23,
      "startTime": 92.743,
      "endTime": 95.0,
      "text": "君[きみ]の声[こえ]",
      "translation": "너의 목소리",
      "start": 92.743,
      "end": 95.0,
      "rubyText": "君[きみ]の声[こえ]"
    },
    {
      "id": 24,
      "startTime": 101.285,
      "endTime": 103.687,
      "text": "明日[あした]どんなこんな世界[せかい]の中[なか]でさ",
      "translation": "내일도 어떻든 이런 세상 속에서",
      "start": 101.285,
