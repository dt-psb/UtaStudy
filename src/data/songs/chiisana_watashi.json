{
  "id": "masarada-chiisana-watashi",
  "title": "ちっちゃな私 (Chiisana Watashi)",
  "artist": "マサラダ feat. 重音テトSV",
  "youtubeId": "4aFC2oC-wHA",
  "thumbnail": "https://img.youtube.com/vi/4aFC2oC-wHA/hqdefault.jpg",
  "duration": 232,
  "lyrics": [
    {
      "id": 1,
      "start": 16.75,
      "end": 20.08,
      "rubyText": "ずっと前[まえ]の気持[きも]ち",
      "translation": "오래 전의 감정을"
    },
    {
      "id": 2,
      "start": 20.08,
      "end": 23.48,
      "rubyText": "捨[す]て切[き]れなくて",
      "translation": "버릴 수가 없어서"
    },
    {
      "id": 3,
      "start": 23.48,
      "end": 26.45,
      "rubyText": "心[こころ]が足[た]りない",
      "translation": "마음이 부족해"
    },
    {
      "id": 4,
      "start": 26.45,
      "end": 29.78,
      "rubyText": "いくつになってもね",
      "translation": "몇 살이 되어도 말이야"
    },
    {
      "id": 5,
      "start": 29.78,
      "end": 33.08,
      "rubyText": "ほら見[み]てごらん",
      "translation": "자 한 번 봐봐"
    },
    {
      "id": 6,
      "start": 33.08,
      "end": 36.48,
      "rubyText": "でかい空[そら]",
      "translation": "커다란 하늘"
    },
    {
      "id": 7,
      "start": 36.48,
      "end": 39.41,
      "rubyText": "もう落[お]ちてきちゃいそうで",
      "translation": "이제 떨어질 것 같아서"
    },
    {
      "id": 8,
      "start": 39.41,
      "end": 43.01,
      "rubyText": "もう もう 落[お]ちてきちゃいそうで！",
      "translation": "이젠 정말 떨어질 것 같아서!"
    },
    {
      "id": 9,
      "start": 43.58,
      "end": 49.28,
      "rubyText": "ちっちゃな私[わたし]がさ　あーあ　あーあ　あー繰[く]り返[かえ]す",
      "translation": "자그마한 내가 아―아 되풀이해가"
    },
    {
      "id": 10,
      "start": 49.28,
      "end": 56.75,
      "rubyText": "ちっちゃな私[わたし]はさ　また　また　あー繰[く]り返[かえ]す",
      "translation": "자그마한 나는 다시 또 되풀이해가"
    },
    {
      "id": 11,
      "start": 70.48,
      "end": 73.65,
      "rubyText": "見[み]ないフリしても",
      "translation": "못 본 척을 해봐도"
    },
    {
      "id": 12,
      "start": 73.65,
      "end": 77.21,
      "rubyText": "忘[わす]れようとしても",
      "translation": "잊어버리려고 해봐도"
    },
    {
      "id": 13,
      "start": 77.21,
      "end": 80.18,
      "rubyText": "とんがった痛[いた]みが",
      "translation": "날카로운 괴로움이"
    },
    {
      "id": 14,
      "start": 80.18,
      "end": 83.51,
      "rubyText": "いつまでもついてまわる",
      "translation": "언제까지고 붙어서 따라와"
    },
    {
      "id": 15,
      "start": 83.51,
      "end": 86.85,
      "rubyText": "そんな　こんな　小[ちい]ささでは",
      "translation": "그런 이런 작음으로는"
    },
    {
      "id": 16,
      "start": 86.85,
      "end": 90.28,
      "rubyText": "風[かぜ]で飛[と]んでってしまうよなー",
      "translation": "바람에 날아가버리겠지"
    },
    {
      "id": 17,
      "start": 90.28,
      "end": 97.31,
      "rubyText": "飛[と]んで　飛[と]んで　飛[と]んでったらよかったのにな",
      "translation": "날아가 날아가 날아가 버렸다면 좋았을 텐데 말야"
    },
    {
      "id": 18,
      "start": 97.31,
      "end": 103.61,
      "rubyText": "ちっちゃな私[わたし]がさ　あーあ　あーあ　あー気[き]にしてる",
      "translation": "자그마한 내가 아―아 신경쓰고 있어"
    },
    {
      "id": 19,
      "start": 104.01,
      "end": 109.85,
      "rubyText": "ちっちゃな私[わたし]はさ　今日[きょう]も　今日[きょう]も　あー気[き]にしてる",
      "translation": "자그마한 나는 오늘도 오늘도 아― 신경쓰고 있어"
    },
    {
      "id": 20,
      "start": 139.35,
      "end": 145.41,
      "rubyText": "悲[かな]しくなった？　悲[かな]しくなった",
      "translation": "슬퍼졌어? 슬퍼졌어"
    },
    {
      "id": 21,
      "start": 146.08,
      "end": 152.45,
      "rubyText": "恥[は]ずかしかった？　恥[は]ずかしかった",
      "translation": "부끄러웠어? 부끄러웠어"
    },
    {
      "id": 22,
      "start": 152.78,
      "end": 156.08,
      "rubyText": "やめたい？　やめたい",
      "translation": "그만두고 싶어? 그만두고 싶어"
    },
    {
      "id": 23,
      "start": 156.08,
      "end": 159.48,
      "rubyText": "消[き]えたい？　消[き]えたい",
      "translation": "사라지고 싶어? 사라지고 싶어"
    },
    {
      "id": 24,
      "start": 159.48,
      "end": 163.08,
      "rubyText": "泣[な]きたい？　泣[な]きたい",
      "translation": "울고 싶어? 울고 싶어"
    },
    {
      "id": 25,
      "start": 164.01,
      "end": 167.31,
      "rubyText": "そっか　そうなのよ",
      "translation": "그렇구나 그런 거야"
    },
    {
      "id": 26,
      "start": 171.18,
      "end": 177.01,
      "rubyText": "ちっちゃな私[わたし]がさ　ずっと　ずっと　あーここにいる",
      "translation": "자그마한 내가 계속 계속 아― 여기에 있어"
    },
    {
      "id": 27,
      "start": 177.91,
      "end": 183.35,
      "rubyText": "ちっちゃな私[わたし]がさ　ずっと　ずっと　胸[むね]の中[なか]にいる",
      "translation": "자그마한 내가 계속 계속 가슴 속에 있어"
    },
    {
      "id": 28,
      "start": 183.35,
      "end": 184.61,
      "rubyText": "あー",
      "translation": "아―"
    },
    {
      "id": 29,
      "start": 184.61,
      "end": 190.41,
      "rubyText": "ちっちゃな私[わたし]には　全部[ぜんぶ]　全部[ぜんぶ]　大[おお]きすぎて",
      "translation": "자그마한 나에게는 전부 전부 너무나 커다래서"
    },
    {
      "id": 30,
      "start": 191.35,
      "end": 197.61,
      "rubyText": "ちっちゃな私[わたし]はさ　今日[きょう]も　今日[きょう]を　あー繰[く]り返[かえ]す",
      "translation": "자그마한 나는 오늘도 오늘을 아― 되풀이해가"
    }
  ],
