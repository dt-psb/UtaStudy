      "romaji": "wasuretai kako ga attemo kujikenai kono sutairu"
    },
    {
      "id": 28,
      "start": 64.98,
      "end": 67.32,
      "rubyText": "だけど無理[むり]しちゃ ダメダメよ",
      "translation": "하지만 너무 무리하면 안 돼",
      "romaji": "dakedo muri shicha dame dame yo"
    },
    {
      "id": 29,
      "start": 67.32,
      "end": 70.85,
      "rubyText": "泣[な]きたい時[とき]があったら ここにおいでね（Yay!）",
      "translation": "울고 싶을 때가 있다면 여기로 와 (Yay!)",
      "romaji": "nakitai toki ga attara koko ni oide ne (Yay!)"
    },
    {
      "id": 30,
      "start": 70.85,
      "end": 73.22,
      "rubyText": "思[おも]い出[だ]してね",
      "translation": "기억해 줘",
      "romaji": "omoidashite ne"
    },
    {
      "id": 31,
      "start": 73.72,
      "end": 76.36,
      "rubyText": "葛藤[かっとう] 悩[なや]み朽[く]ちて",
      "translation": "갈등, 고민하며 썩어가고",
      "romaji": "kattou nayami kuchite"
    },
    {
      "id": 32,
      "start": 76.36,
      "end": 79.4,
      "rubyText": "絶望[ぜつぼう] 冴[さ]えない過[あやま]ちで",
      "translation": "절망, 보잘것없는 실수들로",
      "romaji": "zetsubou saenai ayamachi de"
    },
    {
      "id": 33,
      "start": 79.4,
      "end": 82.4,
      "rubyText": "感傷[かんしょう] 思[おも]い耽[ふけ]て",
      "translation": "감상, 생각에 잠겨",
      "romaji": "kanshou omoifukete"
    },
    {
      "id": 34,
      "start": 82.4,
      "end": 85.27,
      "rubyText": "だけど諦[あきら]めない諦[あきら]めるまで",
      "translation": "하지만 포기하지 않아, 포기할 때까지는",
      "romaji": "dakedo akiramenai akirameru made"
    },
    {
      "id": 35,
      "start": 85.27,
      "end": 86.74,
