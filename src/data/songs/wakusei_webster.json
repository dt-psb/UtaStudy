  "duration": 165,
  "lyrics": [
    {
      "id": 1,
      "start": 12.9,
      "end": 14.37,
      "rubyText": "あの子[こ]また バズったって",
      "translation": "그 애가 또 떴다며",
      "romaji": "ano ko mata bazuttatte"
    },
    {
      "id": 2,
      "start": 14.37,
      "end": 15.87,
      "rubyText": "それに嫉妬[しっと] しちゃったって",
      "translation": "거기에 질투해 버렸다며",
      "romaji": "sore ni shitto shichattatte"
    },
    {
      "id": 3,
      "start": 15.87,
      "end": 17.07,
      "rubyText": "「恥[は]ずかしくないの?」",
      "translation": "「부끄럽지도 않아?」",
      "romaji": "\"hazukashiku nai no?\""
    },
    {
      "id": 4,
      "start": 17.07,
      "end": 18.6,
      "rubyText": "「君[きみ]いくつになるの?」",
      "translation": "「너 대체 몇 살이니?」",
      "romaji": "\"kimi ikutsu ni naru no?\""
    },
    {
      "id": 5,
      "start": 18.6,
      "end": 20.1,
      "rubyText": "仮[かり]にそう思[おも]ったって",
      "translation": "설령 그렇게 생각했다 해도",
      "romaji": "kari ni sou omottatte"
    },
    {
      "id": 6,
      "start": 20.1,
      "end": 21.47,
      "rubyText": "言葉[ことば]にしちゃ一緒[いっしょ]だよね",
      "translation": "말로 뱉어버리면 마찬가지잖아",
      "romaji": "kotoba ni shicha issho da yo ne"
    },
    {
      "id": 7,
      "start": 21.47,
      "end": 23.74,
      "rubyText": "根拠[こんきょ]はないけど",
      "translation": "근거는 없지만",
      "romaji": "konkyo wa nai kedo"
    },
    {
      "id": 8,
      "start": 23.74,
      "end": 24.61,
      "rubyText": "暴[あば]れたい",
      "translation": "날뛰고 싶어",
      "romaji": "abaretai"
    },
    {
      "id": 9,
      "start": 24.61,
      "end": 25.98,
      "rubyText": "雷雨[らいう] でも気分[きぶん]は（上々[じょうじょう]!）",
      "translation": "천둥번개 쳐도 기분은 (최고!)",
      "romaji": "raiu demo kibun wa (joujou!)"
    },
    {
      "id": 10,
      "start": 25.98,
      "end": 27.34,
      "rubyText": "算数[さんすう] できなくても（上等[じょうとう]!）",
      "translation": "산수 못 해도 (상관없어!)",
      "romaji": "sansuu dekinakutemo (joutou!)"
    },
    {
      "id": 11,
      "start": 27.34,
      "end": 28.75,
      "rubyText": "こんなんじゃﾑﾘﾑﾘだって…?",
      "translation": "이래서는 무리무리라고...?",
      "romaji": "konnan ja muri muri datte...?"
    },
    {
      "id": 12,
      "start": 28.75,
      "end": 30.35,
      "rubyText": "気[き]にせず行[い]こーぜっ!",
      "translation": "신경 쓰지 말고 가보자고!",
      "romaji": "ki ni sezu ikoozee!"
    },
    {
      "id": 13,
      "start": 30.35,
      "end": 31.82,
      "rubyText": "時代遅[じだいおく]れじゃん（Okay?）",
      "translation": "시대에 뒤처졌잖아 (Okay?)",
      "romaji": "jidaiokure jan (Okay?)"
    },
    {
      "id": 14,
      "start": 31.82,
      "end": 33.32,
      "rubyText": "乗[の]り遅[おく]れちゃう（No way!）",
      "translation": "흐름을 놓쳐버려 (No way!)",
      "romaji": "noriokurechau (No way!)"
    },
    {
      "id": 15,
      "start": 33.32,
      "end": 35.82,
      "rubyText": "ありのままが一番[いちばん]だにょ",
      "translation": "있는 그대로가 제일이라냥",
      "romaji": "ari no mama ga ichiban da nyo"
    },
    {
      "id": 16,
      "start": 36.19,
      "end": 38.22,
      "rubyText": "10年[ねん]経[た]ったって忘[わす]れない",
      "translation": "10년이 지나도 잊지 못할",
      "romaji": "juunen tattatte wasurenai"
    },
    {
      "id": 17,
      "start": 38.22,
      "end": 41.09,
      "rubyText": "そんな強烈[きょうれつ]なメモリー",
      "translation": "그런 강렬한 메모리",
      "romaji": "sonna kyouretsu na memorii"
    },
    {
      "id": 18,
      "start": 41.09,
      "end": 44.7,
      "rubyText": "いつかまたね なんて叶[かな]わないけれど",
      "translation": "언젠가 다시 만나자 같은 건 이뤄지지 않겠지만",
      "romaji": "itsuka mata ne nante kanawanai keredo"
    },
    {
      "id": 19,
      "start": 44.7,
      "end": 47.5,
      "rubyText": "最高[さいこう]じゃん いつだって最高[さいこう]じゃん",
      "translation": "최고잖아 언제라도 최고잖아",
      "romaji": "saikou jan itsu datte saikou jan"
    },
    {
      "id": 20,
      "start": 47.5,
      "end": 49.1,
      "rubyText": "でもぐるぐるぐるぐるもう",
      "translation": "하지만 빙글빙글빙글 이제는",
      "romaji": "demo guruguruguruguru mou"
    },
    {
      "id": 21,
      "start": 49.43,
      "end": 50.43,
      "rubyText": "ぷっちーん",
      "translation": "푸칭-",
      "romaji": "putchiin"
    },
    {
      "id": 22,
      "start": 50.43,
      "end": 50.73,
      "rubyText": "（Yeah!）",
      "translation": "(Yeah!)",
      "romaji": "(Yeah!)"
    },
    {
      "id": 23,
      "start": 50.73,
      "end": 53.44,
      "rubyText": "朝[あさ]になっても 眠[ねむ]れないこのフェイズ",
      "translation": "아침이 되어도 잠들지 못하는 이 페이즈",
      "romaji": "asa ni nattemo nemurenai kono feizu"
    },
    {
      "id": 24,
      "start": 53.44,
      "end": 55.71,
      "rubyText": "明日[あした]も明後日[あさって]も クラクラよ",
      "translation": "내일도 모레도 어질어질해",
      "romaji": "ashita mo asatte mo kurakura yo"
    },
    {
      "id": 25,
      "start": 55.71,
      "end": 59.34,
      "rubyText": "覚[さ]めない悪夢[あくむ]なんてもう 忘[わす]れちゃうこのスケール",
      "translation": "깨지 않는 악몽 따위는 이제 잊어버릴 이 스케일",
      "romaji": "samenai akumu nante mou wasurechau kono sukeeru"
    },
    {
      "id": 26,
      "start": 59.34,
      "end": 61.35,
      "rubyText": "憧[あこが]れちゃうね",
      "translation": "동경하게 되네",
      "romaji": "akogarechau ne"
    },
    {
      "id": 27,
      "start": 61.35,
      "end": 64.98,
      "rubyText": "忘[わす]れたい過去[かこ]があっても 挫[くじ]けないこのスタイル",
