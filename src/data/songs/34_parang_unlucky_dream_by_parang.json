  "lyrics": [
    {
      "id": 1,
      "start": 0.6,
      "end": 2.35,
      "rubyText": "突然[とつぜん]始[はじ]まる",
      "translation": "갑자기 시작해",
      "romaji": "totsuzen hajima ru"
    },
    {
      "id": 2,
      "start": 2.35,
      "end": 3.14,
      "rubyText": "Bad!",
      "translation": "Bad!",
      "romaji": "Bad !"
    },
    {
      "id": 3,
      "start": 3.14,
      "end": 5.33,
      "rubyText": "僕[ぼく]、どこかにいっちゃう途中[とちゅう]",
      "translation": "나, 어딘가로 가는 도중",
      "romaji": "boku , dokokaniitchau tochuu"
    },
    {
      "id": 4,
      "start": 5.33,
      "end": 6.19,
      "rubyText": "ぐぐぐぐっと",
      "translation": "부부부불쑥",
      "romaji": "gugugugutto"
    },
    {
      "id": 5,
      "start": 6.19,
      "end": 7.96,
      "rubyText": "おやすみの世界[せかい]",
      "translation": "꿈결같은 세상",
      "romaji": "oyasumino sekai"
    },
    {
      "id": 6,
      "start": 7.96,
      "end": 8.58,
      "rubyText": "すー",
      "translation": "코~",
      "romaji": "suu"
    },
    {
      "id": 7,
      "start": 8.58,
      "end": 9.92,
      "rubyText": "ちょっと 頭[あたま]いたッ 頭[あたま]いたッ",
      "translation": "조금 머리가 아파 머리가 아파",
      "romaji": "chotto   atama ita tsu   atama ita tsu"
    },
    {
      "id": 8,
      "start": 9.92,
      "end": 10.64,
      "rubyText": "虹[にじ]吐[は]きそう",
      "translation": "무지개를 토할 것 같아",
      "romaji": "niji haki sou"
    },
    {
      "id": 9,
      "start": 10.64,
      "end": 11.77,
      "rubyText": "La・La・La",
      "translation": "La・La・La",
      "romaji": "La ・ La ・ La"
    },
    {
      "id": 10,
      "start": 11.77,
      "end": 13.45,
      "rubyText": "何[なに]か落[お]ちている",
      "translation": "무언가 떨어져있어",
      "romaji": "nanika ochi teiru"
    },
    {
      "id": 11,
      "start": 13.45,
      "end": 14.48,
      "rubyText": "Bell Bell Bell",
      "translation": "Bell Bell Bell",
      "romaji": "Bell Bell Bell"
    },
    {
      "id": 12,
      "start": 14.48,
      "end": 17.29,
      "rubyText": "無意識[むいしき]に習[なら]う これ楽[たの]しい",
      "translation": "무의식 중에 울려, 이거 재미있네!",
      "romaji": "muishiki ni narau   kore tanoshii"
    },
    {
      "id": 13,
      "start": 17.29,
      "end": 19.84,
      "rubyText": "誰[だれ]かついてくるるるる",
      "translation": "누군가 따라오고있 어 어 어 어",
      "romaji": "dareka tsuitekururururu"
    },
    {
      "id": 14,
      "start": 19.84,
      "end": 21.09,
      "rubyText": "待[ま]って 息[いき]できない 息[いき]できない",
      "translation": "잠깐, 숨안쉬어져 숨안쉬어져",
      "romaji": "matsu te   iki dekinai   iki dekinai"
    },
    {
      "id": 15,
      "start": 21.09,
      "end": 21.88,
      "rubyText": "ちょっぴりきつい",
      "translation": "조금 괴롭네",
      "romaji": "choppirikitsui"
    },
    {
      "id": 16,
      "start": 21.88,
      "end": 22.88,
      "rubyText": "助[たす]けて",
      "translation": "구해줘",
      "romaji": "tasuke te"
    },
    {
      "id": 17,
      "start": 22.88,
      "end": 25.78,
      "rubyText": "想像[そうぞう]の動物[どうぶつ] 知[し]っている顔[かお]",
      "translation": "상상 속 동물도 알고있는 얼굴도",
      "romaji": "souzou no doubutsu   shitte iru kao"
    },
    {
      "id": 18,
      "start": 25.78,
      "end": 27.16,
      "rubyText": "全[ぜん]〜部[ぶ]〜",
      "translation": "전~부~",
      "romaji": "zen ~ bu ~"
    },
    {
      "id": 19,
      "start": 29.29,
      "end": 30.69,
      "rubyText": "バタバタ走[はし]ってる",
      "translation": "허둥지둥 달려가!",
      "romaji": "batabata hashitsu teru"
    },
    {
      "id": 20,
      "start": 30.69,
      "end": 32.0,
      "rubyText": "終[お]わらせない",
      "translation": "끝낼 수가 없어",
      "romaji": "owa rasenai"
    },
    {
      "id": 21,
      "start": 32.0,
      "end": 33.56,
      "rubyText": "真夜中[まよなか]の悪夢[あくむ]",
      "translation": "한밤 중의 악몽",
      "romaji": "mayonaka no akumu"
    },
    {
      "id": 22,
      "start": 33.56,
      "end": 34.84,
      "rubyText": "起[お]きない 覚[さ]めない",
      "translation": "깨지 않아 깨지 않아",
      "romaji": "oki nai   same nai"
    },
    {
      "id": 23,
      "start": 34.84,
      "end": 37.36,
      "rubyText": "君[きみ]のこと全[すべ]て 分[わ]からない",
      "translation": "너의 모든 것, 알 수가 없어",
      "romaji": "kimi nokoto subete   waka ranai"
    },
    {
      "id": 24,
      "start": 37.36,
      "end": 39.36,
      "rubyText": "そのウィスパー 耳[みみ]に刺[さ]さる",
      "translation": "그 속삭임, 귀에 꽂혀",
      "romaji": "sono uisupaa   mimi ni sasa ru"
    },
    {
      "id": 25,
      "start": 39.36,
      "end": 40.5,
      "rubyText": "きらり",
      "translation": "반짝 하고",
      "romaji": "kirari"
    },
    {
      "id": 26,
      "start": 40.5,
      "end": 42.0,
      "rubyText": "ドタバタ飛[と]んで行[い]け",
      "translation": "우당탕탕 날아가라!",
      "romaji": "dotabata ton de ike"
    },
    {
      "id": 27,
      "start": 42.0,
      "end": 43.33,
      "rubyText": "鳥[とり]のように",
      "translation": "저 하늘의 새처럼",
      "romaji": "tori noyouni"
    },
    {
      "id": 28,
      "start": 43.33,
      "end": 44.76,
      "rubyText": "真昼[まひる]でのねぼけ",
      "translation": "한낮 중의 선잠",
      "romaji": "mahiru denoneboke"
    },
    {
      "id": 29,
      "start": 44.76,
      "end": 46.14,
      "rubyText": "起[お]きない 覚[さ]めない",
      "translation": "깨지 않아 깨지 않아",
      "romaji": "oki nai   same nai"
    },
    {
      "id": 30,
      "start": 46.14,
      "end": 47.43,
      "rubyText": "なんでこんなにすごく",
      "translation": "왜 이렇게 엄청나게",
      "romaji": "nandekonnanisugoku"
    },
    {
      "id": 31,
      "start": 47.43,
      "end": 48.51,
      "rubyText": "Melancholic?",
      "translation": "Melancholic?",
      "romaji": "Melancholic?"
    },
    {
      "id": 32,
      "start": 48.52,
      "end": 50.58,
      "rubyText": "不思議[ふしぎ]な魔法[まほう]みたい",
      "translation": "신기한 마법 같아",
      "romaji": "fushigi na mahou mitai"
    },
    {
      "id": 33,
      "start": 50.59,
      "end": 51.76,
      "rubyText": "Unlucky Dream-",
      "translation": "Unlucky Dream-",
      "romaji": "Unlucky Dream-"
    },
    {
      "id": 34,
      "start": 51.76,
      "end": 53.59,
      "rubyText": "突然[とつぜん]終[お]わっちゃう",
      "translation": "갑자기 끝나버려",
      "romaji": "totsuzen owa tchau"
    },
    {
      "id": 35,
      "start": 53.6,
      "end": 54.44,
      "rubyText": "Back!",
      "translation": "Back!",
      "romaji": "Back !"
    },
    {
      "id": 36,
      "start": 54.44,
      "end": 56.39,
      "rubyText": "まだ君[きみ]は出[で]られない",
      "translation": "넌 아직 나갈 수 없어",
      "romaji": "mada kimi ha dera renai"
    },
    {
      "id": 37,
      "start": 56.39,
      "end": 57.26,
      "rubyText": "ケセラセラ",
      "translation": "케세라세라",
      "romaji": "keserasera"
    },
    {
      "id": 38,
      "start": 57.26,
      "end": 59.26,
      "rubyText": "紅茶[こうちゃ]を一口[ひとくち]",
      "translation": "홍차를 한 모금",
      "romaji": "koucha wo hitokuchi"
    },
    {
      "id": 39,
      "start": 59.26,
      "end": 60.0,
      "rubyText": "すー",
      "translation": "스~",
      "romaji": "suu"
    },
    {
      "id": 40,
      "start": 60.0,
      "end": 61.21,
      "rubyText": "これ毒[どく]だから 毒[どく]だから",
      "translation": "이거 독이니까 독이니까",
      "romaji": "kore doku dakara   doku dakara"
    },
    {
      "id": 41,
      "start": 61.21,
      "end": 61.92,
      "rubyText": "もしかして？",
      "translation": "설마설마?",
      "romaji": "moshikashite ？"
    },
    {
      "id": 42,
      "start": 61.92,
      "end": 62.89,
      "rubyText": "Bye Bye Bye?",
      "translation": "Bye Bye Bye?",
      "romaji": "Bye Bye Bye?"
    },
    {
      "id": 43,
      "start": 79.23,
      "end": 81.23,
      "rubyText": "突然[とつぜん]戻[もど]っちゃう",
      "translation": "갑자기 돌아와버려",
      "romaji": "totsuzen modotsu chau"
    },
    {
      "id": 44,
      "start": 81.23,
      "end": 82.23,
      "rubyText": "ごくごくごく",
      "translation": "꿀꺽꿀꺽꿀꺽",
      "romaji": "gokugokugoku"
    },
    {
      "id": 45,
      "start": 82.23,
      "end": 84.09,
      "rubyText": "お茶[ちゃ]は甘[あま]いね",
      "translation": "이 차, 달콤하네",
      "romaji": "o cha ha amai ne"
    },
    {
      "id": 46,
      "start": 84.09,
      "end": 85.25,
      "rubyText": "生[い]き返[かえ]る！",
      "translation": "되살아났어!",
      "romaji": "ikikaeru !"
    },
    {
      "id": 47,
      "start": 85.25,
      "end": 86.8,
      "rubyText": "道[みち]はくねくね",
      "translation": "길은 꾸불꾸불",
      "romaji": "michi hakunekune"
    },
    {
      "id": 48,
      "start": 87.94,
      "end": 89.91,
      "rubyText": "たぶん 山[やま]越[こ]えて 海[うみ]渡[わた]って 飛[と]び上[あ]がって",
      "translation": "아마, 산을 넘고 바다를 건너 날아올라서",
      "romaji": "tabun yama koete umi watatte tobiagatte"
    },
    {
      "id": 49,
      "start": 89.91,
      "end": 91.25,
      "rubyText": "宇宙[うちゅう]へ",
      "translation": "우주로",
      "romaji": "uchuu he"
    },
    {
      "id": 50,
      "start": 91.25,
      "end": 94.42,
      "rubyText": "銀色[ぎんいろ]の水[みず]が",
      "translation": "은빛의 물이",
      "romaji": "gin'iro no mizu ga"
    },
    {
      "id": 51,
      "start": 95.61,
      "end": 98.92,
      "rubyText": "僕[ぼく]を眠[ねむ]らせるんだね",
      "translation": "나를 잠재우려하네",
      "romaji": "boku wo nemura serundane"
    },
    {
      "id": 52,
      "start": 98.92,
      "end": 103.46,
      "rubyText": "とてもふかふかな雲[くも]に眠[ねむ]れ···",
      "translation": "무척이나 포근포근한 구름에 잠들어…",
      "romaji": "totemofukafukana kumo ni nemure . . ."
    },
    {
      "id": 53,
      "start": 103.46,
      "end": 104.99,
      "rubyText": "待[ま]っ〜て〜",
