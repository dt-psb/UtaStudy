{
  "id": "kiyou-kimi-no-kokoro-o-hacking",
  "title": "君のココロをハッキング (Kimi no Kokoro o Hacking)",
  "artist": "ki-you feat. りむる",
  "youtubeId": "-pIGv9GlhEU",
  "thumbnail": "https://img.youtube.com/vi/-pIGv9GlhEU/hqdefault.jpg",
  "duration": 151,
  "lyrics": [
    {
      "id": 1,
      "start": 1.52,
      "end": 3.65,
      "rubyText": "ガラス越[ご]し　はなればなれ",
      "translation": "유리창 너머 따로 떨어져",
      "romaji": "garasu goshi hanarebanare"
    },
    {
      "id": 2,
      "start": 3.65,
      "end": 7.04,
      "rubyText": "君[きみ]とふたり　死[し]ぬまで見[み]つめ合[あ]いたいの",
      "translation": "너와 둘이서 죽을 때까지 바라보고 싶어",
      "romaji": "kimi to futari shinu made mitsumeaitai no"
    },
    {
      "id": 3,
      "start": 7.04,
      "end": 9.28,
      "rubyText": "だけど埋[う]まらない　チグハグ",
      "translation": "하지만 채워지지 않아 뒤죽박죽",
      "romaji": "dakedo umaranai chiguhagu"
    },
    {
      "id": 4,
      "start": 9.28,
      "end": 12.28,
      "rubyText": "結露[けつろ]溢[あふ]れて　見[み]えなくなっていく",
      "translation": "결로 흘러넘쳐 보이지 않게 되어가",
      "romaji": "ketsuro afurete mienaku natte iku"
    },
    {
      "id": 5,
      "start": 12.78,
      "end": 14.95,
      "rubyText": "ガラス越[ご]し　はなればなれ",
      "translation": "유리창 너머 따로 떨어져",
      "romaji": "garasu goshi hanarebanare"
    },
    {
      "id": 6,
      "start": 14.95,
      "end": 18.35,
      "rubyText": "君[きみ]とふたり　言葉[ことば]を伝[つた]え合[あ]いたいの",
      "translation": "너와 둘이서 말을 전하고 싶어",
      "romaji": "kimi to futari kotoba o tsutaeaitai no"
    },
    {
      "id": 7,
      "start": 18.35,
      "end": 20.51,
      "rubyText": "だけど　あらま文字[もじ]反転[はんてん]",
      "translation": "하지만 어머 문자 반전",
      "romaji": "dakedo arama moji hanten"
    },
    {
      "id": 8,
      "start": 20.51,
      "end": 23.64,
      "rubyText": "もうラクガキ同然[どうぜん]　あいまみえない",
      "translation": "이젠 낙서 같아 틈이 보이지 않아",
      "romaji": "mou rakugaki douzen aimamienai"
    },
    {
      "id": 9,
      "start": 24.0,
      "end": 26.0,
      "rubyText": "まだ知[し]りたい　ただ知[し]りたい",
      "translation": "아직 알고 싶어 그저 알고 싶어",
      "romaji": "mada shiritai tada shiritai"
    },
    {
      "id": 10,
      "start": 26.0,
      "end": 27.14,
      "rubyText": "全[すべ]て知[し]りたい",
      "translation": "전부 알고 싶어",
      "romaji": "subete shiritai"
    },
    {
      "id": 11,
      "start": 27.14,
      "end": 29.6,
      "rubyText": "君[きみ]の　恥[は]ずかしいも全部[ぜんぶ]",
      "translation": "너의 부끄러운 걸 전부",
      "romaji": "kimi no hazukashii mo zenbu"
    },
    {
      "id": 12,
      "start": 29.6,
      "end": 31.6,
      "rubyText": "占[うらな]いたい　こじつけたい",
      "translation": "예언하고 싶어 꿰맞추고 싶어",
      "romaji": "uranaitai kojitsuketai"
    },
    {
      "id": 13,
      "start": 31.6,
      "end": 36.57,
      "rubyText": "だって君[きみ]は　どうしたって僕[ぼく]のモノ",
      "translation": "왜냐하면 너는 어떻게 해도 나의 것",
      "romaji": "datte kimi wa doushitatte boku no mono"
    },
    {
      "id": 14,
      "start": 36.81,
      "end": 40.58,
      "rubyText": "君[きみ]のココロをハッキング",
      "translation": "너의 마음을 해킹",
      "romaji": "kimi no kokoro o hakkingu"
    },
    {
      "id": 15,
      "start": 42.43,
      "end": 46.88,
      "rubyText": "君[きみ]のココロをハッキング",
      "translation": "너의 마음을 해킹",
      "romaji": "kimi no kokoro o hakkingu"
    },
    {
      "id": 16,
      "start": 48.2,
      "end": 52.56,
      "rubyText": "君[きみ]のココロをハッキング",
      "translation": "너의 마음을 해킹",
      "romaji": "kimi no kokoro o hakkingu"
    },
    {
      "id": 17,
      "start": 53.77,
      "end": 57.87,
      "rubyText": "君[きみ]のココロをハッキング",
      "translation": "너의 마음을 해킹",
      "romaji": "kimi no kokoro o hakkingu"
    },
    {
      "id": 18,
      "start": 57.87,
      "end": 60.68,
      "rubyText": "教[おし]えて　僕[ぼく]だけにラビリンス",
      "translation": "가르쳐 줘 나에게만 래버린스",
      "romaji": "oshiete boku dake ni rabirinsu"
    },
    {
      "id": 19,
      "start": 72.34,
      "end": 74.58,
      "rubyText": "ガラス越[ご]し　はなればなれ",
      "translation": "유리창 너머 따로 떨어져",
      "romaji": "garasu goshi hanarebanare"
    },
    {
      "id": 20,
      "start": 74.58,
      "end": 78.0,
      "rubyText": "君[きみ]とふたり　秘密[ひみつ]の花[はな]咲[さ]かせたいの",
      "translation": "너와 둘이서 비밀의 꽃을 피우고 싶어",
      "romaji": "kimi to futari himitsu no hana sakasetai no"
    },
    {
      "id": 21,
      "start": 78.0,
      "end": 80.21,
      "rubyText": "だけど遮[さえぎ]る　カーテン",
      "translation": "하지만 가로막는 커튼",
      "romaji": "dakedo saegiru kaaten"
    },
    {
      "id": 22,
      "start": 80.21,
      "end": 83.47,
      "rubyText": "光[ひかり]入[はい]らず　すべて枯[か]れていく",
      "translation": "빛이 들어오지 않아 전부 시들어가",
      "romaji": "hikari hairazu subete karete iku"
    },
    {
      "id": 23,
      "start": 83.76,
      "end": 85.95,
      "rubyText": "同[おな]じ星[ほし]　生[う]まれついた",
      "translation": "같은 별에서 태어났어",
      "romaji": "onaji hoshi umaretsuita"
    },
    {
      "id": 24,
      "start": 85.95,
      "end": 89.25,
      "rubyText": "奇跡[きせき]なんてものじゃ　諦[あきら]め切[き]れないの",
      "translation": "기적 같은 걸로는 포기할 수 없어",
      "romaji": "kiseki nante mono ja akiramekirenai no"
    },
    {
      "id": 25,
      "start": 89.25,
      "end": 91.59,
      "rubyText": "すべからく　相思相愛[そうしそうあい]",
      "translation": "모름지기 상사상애",
      "romaji": "subekaraku soushisouai"
    },
    {
      "id": 26,
      "start": 91.59,
      "end": 94.48,
      "rubyText": "めくるべく　愛証[あいしょう]　聖杯[せいはい]のⅡ",
      "translation": "넘기 위해 애증 성배의 Ⅱ",
      "romaji": "mekuru beku aishou seihai no tsuu"
    },
    {
