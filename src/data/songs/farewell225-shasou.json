  "lyrics": [
    {
      "id": 1,
      "startTime": 0.84,
      "endTime": 2.996,
      "text": "ちょっとずつ動[うご]き出[だ]す風景[ふうけい]が",
      "translation": "조금씩 움직이기 시작하는 풍경이",
      "start": 0.84,
      "end": 2.996,
      "rubyText": "ちょっとずつ動[うご]き出[だ]す風景[ふうけい]が"
    },
    {
      "id": 2,
      "startTime": 2.996,
      "endTime": 6.042,
      "text": "現在地[げんざいち]を教[おし]えてくれるの",
      "translation": "현재 위치를 알려준다면",
      "start": 2.996,
      "end": 6.042,
      "rubyText": "現在地[げんざいち]を教[おし]えてくれるの"
    },
    {
      "id": 3,
      "startTime": 6.042,
      "endTime": 7.658,
      "text": "なら",
      "translation": "그렇다면",
      "start": 6.042,
      "end": 7.658,
      "rubyText": "なら"
    },
    {
      "id": 4,
      "startTime": 7.658,
      "endTime": 10.365,
      "text": "今[いま]は寄[よ]りかかってりゃいいのかも",
      "translation": "지금은 기대고 있으면 되는 걸지도",
      "start": 7.658,
      "end": 10.365,
      "rubyText": "今[いま]は寄[よ]りかかってりゃいいのかも"
    },
    {
      "id": 5,
      "startTime": 10.365,
      "endTime": 12.952,
      "text": "なんとなく思[おも]い出[だ]す光景[こうけい]が",
      "translation": "왠지 떠오르는 광경이",
      "start": 10.365,
      "end": 12.952,
      "rubyText": "なんとなく思[おも]い出[だ]す光景[こうけい]が"
    },
    {
      "id": 6,
      "startTime": 12.952,
      "endTime": 16.0,
      "text": "どうしても楽[たの]しくないから",
      "translation": "아무래도 즐겁지 않으니까",
      "start": 12.952,
      "end": 16.0,
      "rubyText": "どうしても楽[たの]しくないから"
    },
    {
      "id": 7,
      "startTime": 16.0,
      "endTime": 18.253,
      "text": "まだ",
      "translation": "아직",
      "start": 16.0,
      "end": 18.253,
      "rubyText": "まだ"
    },
    {
      "id": 8,
      "startTime": 18.253,
      "endTime": 20.291,
      "text": "忘[わす]れきったフリをするよ",
      "translation": "완전히 잊은 척을 할게",
      "start": 18.253,
      "end": 20.291,
      "rubyText": "忘[わす]れきったフリをするよ"
    },
    {
      "id": 9,
      "startTime": 20.291,
      "endTime": 20.943,
      "text": "ねぇ",
      "translation": "있잖아",
      "start": 20.291,
      "end": 20.943,
      "rubyText": "ねぇ"
    },
    {
      "id": 10,
      "startTime": 20.943,
      "endTime": 22.448,
      "text": "頭[あたま]の中[なか]で聞[き]こえる",
      "translation": "머릿속에서 들리는",
      "start": 20.943,
      "end": 22.448,
      "rubyText": "頭[あたま]の中[なか]で聞[き]こえる"
    },
    {
      "id": 11,
      "startTime": 22.448,
      "endTime": 25.914,
      "text": "いつかの罵声[ばせい]は置[お]いてこうよ",
      "translation": "언젠가의 욕설은 두고 가자",
      "start": 22.448,
      "end": 25.914,
      "rubyText": "いつかの罵声[ばせい]は置[お]いてこうよ"
    },
    {
      "id": 12,
      "startTime": 25.914,
      "endTime": 27.357,
      "text": "めちゃくちゃになった後[あと]は",
      "translation": "엉망진창이 된 후에는",
      "start": 25.914,
      "end": 27.357,
      "rubyText": "めちゃくちゃになった後[あと]は"
    },
    {
      "id": 13,
      "startTime": 27.357,
      "endTime": 28.537,
      "text": "寂[さび]しくなって",
      "translation": "외로워져서",
      "start": 27.357,
      "end": 28.537,
      "rubyText": "寂[さび]しくなって"
    },
    {
      "id": 14,
      "startTime": 28.537,
      "endTime": 31.355,
      "text": "突[つ]っ立[た]ってるんだから",
      "translation": "우두커니 서 있게 되니까",
      "start": 28.537,
      "end": 31.355,
      "rubyText": "突[つ]っ立[た]ってるんだから"
    },
    {
      "id": 15,
      "startTime": 31.355,
      "endTime": 32.334,
      "text": "せめて今[いま]は",
      "translation": "적어도 지금은",
      "start": 31.355,
      "end": 32.334,
      "rubyText": "せめて今[いま]は"
    },
    {
      "id": 16,
      "startTime": 32.334,
      "endTime": 33.67,
      "text": "下手[へた]くそなりの",
      "translation": "서투른 나름의",
      "start": 32.334,
      "end": 33.67,
      "rubyText": "下手[へた]くそなりの"
    },
    {
      "id": 17,
      "startTime": 33.67,
      "endTime": 38.239,
      "text": "ステップを踏[ふ]まなきゃ",
      "translation": "스텝을 밟아야 해",
      "start": 33.67,
      "end": 38.239,
      "rubyText": "ステップを踏[ふ]まなきゃ"
    },
    {
      "id": 18,
      "startTime": 40.0,
      "endTime": 41.832,
      "text": "とにかく歩[ある]き続[つづ]ければ",
      "translation": "어쨌든 계속 걸어가면",
      "start": 40.0,
      "end": 41.832,
      "rubyText": "とにかく歩[ある]き続[つづ]ければ"
    },
    {
      "id": 19,
      "startTime": 41.832,
      "endTime": 44.482,
      "text": "どこかにたどり着[つ]ける気[き]がしてる",
      "translation": "어딘가에 다다를 수 있을 것 같아",
      "start": 41.832,
      "end": 44.482,
      "rubyText": "どこかにたどり着[つ]ける気[き]がしてる"
    },
    {
      "id": 20,
      "startTime": 44.482,
      "endTime": 45.942,
      "text": "いつか道間違[みちまちが]って",
      "translation": "언젠가 길을 잘못 들어",
      "start": 44.482,
      "end": 45.942,
      "rubyText": "いつか道間違[みちまちが]って"
    },
    {
      "id": 21,
      "startTime": 45.942,
      "endTime": 47.454,
      "text": "足[あし]が止[と]まって",
      "translation": "발이 멈추고",
      "start": 45.942,
      "end": 47.454,
      "rubyText": "足[あし]が止[と]まって"
    },
    {
      "id": 22,
      "startTime": 47.454,
      "endTime": 51.439,
      "text": "周[まわ]りから人[ひと]はいなくなってるかも",
      "translation": "주변에서 사람은 없어져 있을지도",
      "start": 47.454,
      "end": 51.439,
      "rubyText": "周[まわ]りから人[ひと]はいなくなってるかも"
    },
    {
      "id": 23,
      "startTime": 51.439,
      "endTime": 52.271,
      "text": "なんてね",
      "translation": "라니",
      "start": 51.439,
      "end": 52.271,
      "rubyText": "なんてね"
    },
    {
      "id": 24,
      "startTime": 52.271,
      "endTime": 54.664,
      "text": "また暗[くら]い事[こと]言[い]ってる",
      "translation": "또 어두운 말을 하고 있네",
      "start": 52.271,
      "end": 54.664,
      "rubyText": "また暗[くら]い事[こと]言[い]ってる"
    },
    {
      "id": 25,
      "startTime": 54.664,
      "endTime": 57.029,
      "text": "お財布[さいふ]に痛[いた]くならない程度[ていど]に",
      "translation": "지갑이 아프지 않을 정도로",
      "start": 54.664,
      "end": 57.029,
      "rubyText": "お財布[さいふ]に痛[いた]くならない程度[ていど]に"
    },
    {
      "id": 26,
      "startTime": 57.029,
      "endTime": 59.664,
      "text": "あったかいものを食[た]べに行[い]こうよ",
      "translation": "따뜻한 것을 먹으러 가자",
      "start": 57.029,
      "end": 59.664,
      "rubyText": "あったかいものを食[た]べに行[い]こうよ"
    },
    {
      "id": 27,
      "startTime": 59.664,
      "endTime": 61.122,
      "text": "まぁ",
      "translation": "뭐",
      "start": 59.664,
      "end": 61.122,
      "rubyText": "まぁ"
    },
    {
      "id": 28,
      "startTime": 61.123,
      "endTime": 63.556,
      "text": "別[べつ]に良[い]いけどさ",
      "translation": "딱히 괜찮긴 한데",
      "start": 61.123,
      "end": 63.556,
      "rubyText": "別[べつ]に良[い]いけどさ"
    },
    {
      "id": 29,
      "startTime": 63.556,
      "endTime": 65.881,
      "text": "気[き]にしないように",
      "translation": "신경 쓰지 않으려고",
      "start": 63.556,
      "end": 65.881,
      "rubyText": "気[き]にしないように"
    },
    {
      "id": 30,
      "startTime": 65.882,
      "endTime": 68.323,
      "text": "してるだけだから",
      "translation": "하고 있을 뿐이니까",
      "start": 65.882,
      "end": 68.323,
      "rubyText": "してるだけだから"
    },
    {
      "id": 31,
      "startTime": 68.323,
      "endTime": 70.943,
      "text": "きっと良[よ]くないの",
      "translation": "분명 좋지 않은 거야",
      "start": 68.323,
      "end": 70.943,
      "rubyText": "きっと良[よ]くないの"
    },
    {
      "id": 32,
      "startTime": 70.943,
      "endTime": 72.0,
      "text": "いつのまにか",
      "translation": "어느새",
      "start": 70.943,
      "end": 72.0,
      "rubyText": "いつのまにか"
    },
    {
      "id": 33,
      "startTime": 72.0,
      "endTime": 74.449,
      "text": "どっか飛[と]んでった終末論[しゅうまつろん]や",
      "translation": "어딘가 날아가 버린 종말론과",
      "start": 72.0,
      "end": 74.449,
      "rubyText": "どっか飛[と]んでった終末論[しゅうまつろん]や"
    },
    {
      "id": 34,
      "startTime": 74.449,
      "endTime": 76.907,
      "text": "書[か]いて消[け]すを繰[く]り返[かえ]した日々[ひび]が",
      "translation": "쓰고 지우기를 반복했던 날들이",
      "start": 74.449,
      "end": 76.907,
      "rubyText": "書[か]いて消[け]すを繰[く]り返[かえ]した日々[ひび]が"
    },
    {
      "id": 35,
      "startTime": 76.907,
      "endTime": 78.025,
      "text": "なんか全部[ぜんぶ]",
      "translation": "왠지 전부",
      "start": 76.907,
      "end": 78.025,
      "rubyText": "なんか全部[ぜんぶ]"
    },
    {
      "id": 36,
      "startTime": 78.026,
      "endTime": 79.893,
      "text": "意味[いみ]ないように見[み]えてさ",
      "translation": "의미 없는 것처럼 보여서",
      "start": 78.026,
      "end": 79.893,
      "rubyText": "意味[いみ]ないように見[み]えてさ"
    },
    {
      "id": 37,
      "startTime": 79.893,
      "endTime": 82.203,
      "text": "どんどんと遠[とお]くなる風景[ふうけい]が",
      "translation": "점점 멀어지는 풍경이",
      "start": 79.893,
      "end": 82.203,
      "rubyText": "どんどんと遠[とお]くなる風景[ふうけい]が"
    },
    {
      "id": 38,
      "startTime": 82.203,
      "endTime": 85.327,
      "text": "現在地[げんざいち]を更新[こうしん]するたびに",
      "translation": "현재 위치를 갱신할 때마다",
      "start": 82.203,
      "end": 85.327,
      "rubyText": "現在地[げんざいち]を更新[こうしん]するたびに"
    },
    {
      "id": 39,
      "startTime": 85.327,
      "endTime": 86.777,
      "text": "また",
      "translation": "또",
      "start": 85.327,
      "end": 86.777,
      "rubyText": "また"
    },
    {
      "id": 40,
      "startTime": 86.777,
      "endTime": 89.554,
      "text": "何[なに]かを忘[わす]れちゃっていくのなら",
      "translation": "무언가를 잊어버리게 된다면",
      "start": 86.777,
      "end": 89.554,
      "rubyText": "何[なに]かを忘[わす]れちゃっていくのなら"
    },
    {
      "id": 41,
      "startTime": 89.554,
      "endTime": 92.116,
      "text": "なんとなく思[おも]い出[だ]す光景[こうけい]が",
      "translation": "왠지 떠오르는 광경이",
      "start": 89.554,
      "end": 92.116,
      "rubyText": "なんとなく思[おも]い出[だ]す光景[こうけい]が"
    },
    {
      "id": 42,
      "startTime": 92.116,
      "endTime": 95.234,
      "text": "ちょっとでも苦[くる]しくないように",
      "translation": "조금이라도 괴롭지 않도록",
      "start": 92.116,
      "end": 95.234,
      "rubyText": "ちょっとでも苦[くる]しくないように"
    },
    {
      "id": 43,
      "startTime": 95.234,
      "endTime": 97.322,
      "text": "ただ",
      "translation": "그저",
      "start": 95.234,
      "end": 97.322,
      "rubyText": "ただ"
    },
    {
      "id": 44,
      "startTime": 97.322,
      "endTime": 104.094,
      "text": "髪[かみ]を切[き]って前[まえ]を向[む]くの",
      "translation": "머리를 자르고 앞을 보는 거야",
      "start": 97.322,
      "end": 104.094,
      "rubyText": "髪[かみ]を切[き]って前[まえ]を向[む]くの"
