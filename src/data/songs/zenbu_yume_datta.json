{
  "id": "zenbu_yume_datta",
  "title": "全部夢だった！",
  "artist": "黒うさぎ feat.重音テトSV",
  "youtubeId": "z13hzDHruo8",
  "thumbnail": "https://i.ytimg.com/vi/z13hzDHruo8/maxresdefault.jpg",
  "lyrics": [
    {
      "id": 1,
      "start": 13.44,
      "end": 16.734,
      "rubyText": "限界[げんかい]です　限界[げんかい]です",
      "translation": "한계예요, 한계예요",
      "romaji": "genkai desu genkai desu"
    },
    {
      "id": 2,
      "start": 16.734,
      "end": 18.934,
      "rubyText": "そう言[い]ってもどうにかなって",
      "translation": "그렇게 말해도 어떻게든 흘러가고",
      "romaji": "sou itte mo dounika natte"
    },
    {
      "id": 3,
      "start": 19.3,
      "end": 22.934,
      "rubyText": "本当[ほんとう]に　本当[ほんとう]に　ダメなのは",
      "translation": "정말로, 정말로 안 되는 건",
      "romaji": "hontou ni hontou ni dame na no wa"
    },
    {
      "id": 4,
      "start": 23.3,
      "end": 24.367,
      "rubyText": "わたしだけ",
      "translation": "나뿐",
      "romaji": "watashi dake"
    },
    {
      "id": 5,
      "start": 24.734,
      "end": 28.0,
      "rubyText": "いや、消[け]したらくがきが いつか輝[かがや]くなにかになれたかも",
      "translation": "아니, 지워버린 낙서가 언젠가 반짝이는 무언가가 될 수 있었을지도",
      "romaji": "iya, keshita rakugaki ga itsuka kagayaku nanika ni nareta kamo"
    },
    {
      "id": 6,
      "start": 28.0,
      "end": 30.567,
      "rubyText": "あのときもっと、 ちゃんとまともなことが言[い]えたなら",
      "translation": "그때 좀 더, 제대로 된 말을 할 수 있었다면",
      "romaji": "ano toki motto, chanto matomo na koto ga ieta nara"
    },
    {
      "id": 7,
      "start": 30.934,
      "end": 33.467,
      "rubyText": "生活[せいかつ]にゃ鰾膠[にべ]もなく",
      "translation": "생활에는 여유조차 없고",
      "romaji": "seikatsu nya nibe mo naku"
    },
    {
      "id": 8,
      "start": 33.634,
      "end": 35.3,
      "rubyText": "考[かんが]えてばっかいて",
      "translation": "생각만 가득해서",
      "romaji": "kangaete bakka ite"
    },
    {
      "id": 9,
      "start": 36.367,
      "end": 40.0,
      "rubyText": "何[なに]も無[な]いんだ",
      "translation": "아무것도 없어",
      "romaji": "nani mo nai n da"
    },
    {
      "id": 10,
      "start": 40.0,
      "end": 41.467,
      "rubyText": "わたしって",
      "translation": "나란 애는",
      "romaji": "watashitte"
    },
    {
      "id": 11,
      "start": 41.467,
      "end": 42.2,
      "rubyText": "「間違[まちが]った」",
      "translation": "「잘못했어」",
      "romaji": "“machigatta”"
    },
    {
      "id": 12,
      "start": 42.934,
      "end": 44.367,
      "rubyText": "その罰[ばつ]がさ",
      "translation": "그 벌이 말이야",
      "romaji": "sono batsu ga sa"
    },
    {
      "id": 13,
      "start": 45.1,
      "end": 47.3,
      "rubyText": "今[いま]もわたしを締[し]め付[つ]ける",
      "translation": "지금도 나를 꽉 죄어와",
      "romaji": "ima mo watashi o shimetsukeru"
    },
    {
      "id": 14,
      "start": 48.0,
      "end": 50.934,
      "rubyText": "さかなになって くじらになって",
      "translation": "물고기가 돼서, 고래가 돼서",
      "romaji": "sakana ni natte kujira ni natte"
    },
    {
      "id": 15,
      "start": 50.934,
      "end": 53.467,
      "rubyText": "月夜[つきよ]に浮[う]かぶ星[ほし]になって",
      "translation": "달밤에 떠오르는 별이 돼서",
      "romaji": "tsukiyo ni ukabu hoshi ni natte"
    },
    {
      "id": 16,
      "start": 53.834,
      "end": 57.834,
      "rubyText": "夢[ゆめ]を見[み]るわたしを どうか許[ゆる]してほしいの",
      "translation": "꿈을 꾸는 나를 부디 용서해 줬으면 좋겠어",
      "romaji": "yume o miru watashi o douka yurushite hoshii no"
    },
    {
      "id": 17,
      "start": 58.2,
      "end": 59.667,
      "rubyText": "ずっと甘[あま]い",
      "translation": "계속 아득하게",
      "romaji": "zutto amai"
    },
    {
      "id": 18,
      "start": 59.667,
      "end": 62.2,
      "rubyText": "幽々[ゆうゆう]幽々[ゆうゆう]と",
      "translation": "유유히, 유유히",
      "romaji": "yuuyuu yuuyuu to"
    },
    {
      "id": 19,
      "start": 74.2,
      "end": 80.367,
      "rubyText": "べつに悩[なや]んでるとかそういうわけじゃないよ ただ、ただ漠然[ばくぜん]と",
      "translation": "딱히 고민이 있다거나 그런 건 아니야 그냥, 그저 막연하게",
      "romaji": "betsu ni nayanderu to ka sou iu wake ja nai yo tada, tada bakuzen to"
    },
    {
      "id": 20,
      "start": 80.734,
      "end": 84.967,
      "rubyText": "なんていうか、わたしってダメだなって",
      "translation": "뭐랄까, 나는 참 구제불능이구나 하고",
      "romaji": "nante iu ka, watashitte dame da na tte"
    },
    {
      "id": 21,
      "start": 84.967,
      "end": 86.2,
      "rubyText": "ごめんね",
      "translation": "미안해",
      "romaji": "gomen ne"
    },
    {
      "id": 22,
      "start": 86.4,
      "end": 95.867,
      "rubyText": "吐[は]きそうなくらい どんなにカスのような心持[こころも]ちでいても 勝手[かって]に明日[あした]がくるのです",
      "translation": "토할 것 같을 정도로 아무리 쓰레기 같은 마음가짐으로 있어도 제멋대로 내일은 찾아오는걸요",
      "romaji": "hakisou na kurai donna ni kasu no you na kokoromochi de ite mo katte ni ashita ga kuru no desu"
    },
    {
      "id": 23,
      "start": 97.467,
      "end": 101.1,
      "rubyText": "何[なに]も無[な]いんだ",
      "translation": "아무것도 없어",
      "romaji": "nani mo nai n da"
    },
    {
      "id": 24,
      "start": 101.1,
      "end": 102.934,
      "rubyText": "今更[いまさら]...",
      "translation": "이제 와서...",
      "romaji": "imasara..."
    },
    {
      "id": 25,
      "start": 103.3,
      "end": 108.734,
      "rubyText": "あなたにも　そうあなたにも ご迷惑[めいわく]をおかけしました",
      "translation": "당신에게도, 그래 당신에게도 민폐를 끼쳐버렸네요",
      "romaji": "anata ni mo sou anata ni mo gomeiwaku o okake shimashita"
    },
    {
      "id": 26,
      "start": 109.467,
      "end": 111.3,
      "rubyText": "だからわたし",
      "translation": "그러니까 나는",
      "romaji": "dakara watashi"
    },
    {
      "id": 27,
      "start": 111.5,
      "end": 114.0,
      "rubyText": "もう間違[まちが]わないように",
      "translation": "다시 실수하지 않도록",
      "romaji": "mou machigawanai you ni"
    },
    {
      "id": 28,
      "start": 114.934,
      "end": 119.3,
      "rubyText": "今[いま]までのこと全部[ぜんぶ] 夢[ゆめ]ってことにしたんだ",
      "translation": "지금까지의 일 전부 꿈이었다는 걸로 해두기로 했어",
      "romaji": "ima made no koto zenbu yumette koto ni shita n da"
    },
    {
      "id": 29,
      "start": 119.834,
      "end": 125.1,
      "rubyText": "...あー、目覚[めざ]めたら 次[つぎ]は　うまくできたらいいな",
      "translation": "...아-, 눈을 뜨면 다음에는 잘해낼 수 있으면 좋겠네",
      "romaji": "...aa, mezametara tsugi wa umaku dekitara ii na"
    },
    {
      "id": 30,
      "start": 125.467,
      "end": 126.567,
      "rubyText": "深[ふか]く",
      "translation": "깊이",
      "romaji": "fukaku"
    },
    {
      "id": 31,
      "start": 126.567,
      "end": 129.1,
      "rubyText": "およぐ　およぐ　今[いま]",
      "translation": "헤엄쳐, 헤엄쳐 지금",
      "romaji": "oyogu oyogu ima"
    },
    {
      "id": 32,
      "start": 129.467,
      "end": 133.1,
      "rubyText": "溶[と]けてゆくのでした！",
      "translation": "스르륵 녹아내려 가는 것이었습니다!",
      "romaji": "toketeyuku no deshita!"
    }
  ],
