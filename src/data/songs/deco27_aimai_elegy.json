{
  "id": "deco27_aimai_elegy",
  "title": "愛迷エレジー (Reloaded)",
  "artist": "DECO*27 feat. 初音ミク",
  "youtubeId": "ZTlH8A79xFg",
  "thumbnail": "https://i.ytimg.com/vi/ZTlH8A79xFg/maxresdefault.jpg",
  "duration": 169,
  "lyrics": [
    {
      "id": 1,
      "start": 25.505,
      "end": 30.05,
      "rubyText": "「どうやら泣[な]きすぎたみたい」ときみは笑[わら]う",
      "translation": "「아무래도 너무 오래 운 것 같아」라며 너는 웃어"
    },
    {
      "id": 2,
      "start": 30.05,
      "end": 34.596,
      "rubyText": "どうにも笑[わら]えない こうにも笑[わら]えないよ",
      "translation": "아무래도 웃지 못하겠어 도저히 웃지 못하겠어"
    },
    {
      "id": 3,
      "start": 34.596,
      "end": 39.953,
      "rubyText": "たぶん、裏[うら]たぶん あたしのとある言葉[ことば]のせい",
      "translation": "아마도, 아마도 내가 했던 어떤 말 때문"
    },
    {
      "id": 4,
      "start": 39.953,
      "end": 46.296,
      "rubyText": "いや、気[き]のせい？ 脳[のう]の味噌[みそ]も呆[あき]れてます",
      "translation": "아니, 기분 탓? 뇌수도 어이없어 하고 있어요"
    },
    {
      "id": 5,
      "start": 52.891,
      "end": 57.542,
      "rubyText": "そろそろ助[たす]けようか 恐怖[きょうふ]も引[ひ]き連[つ]れてさ",
      "translation": "슬슬 도와줄까 공포감도 데리고서"
    },
    {
      "id": 6,
      "start": 57.542,
      "end": 62.129,
      "rubyText": "雑巾[ぞうきん]絞[しぼ]るように 勇気[ゆうき]もアレしちゃおう",
      "translation": "걸레를 짜듯이 용기도 그렇게 해버리자"
    },
    {
      "id": 7,
      "start": 62.129,
      "end": 66.695,
      "rubyText": "だけどさ怖[こわ]いんだよ ガタがアシアシだよ",
      "translation": "하지만 무서워 부들이 다리다리거려"
    },
    {
      "id": 8,
      "start": 66.695,
      "end": 70.822,
      "rubyText": "フラフラで そのまま堕[お]ちる",
      "translation": "흔들거리며 그대로 떨어져"
    },
    {
      "id": 9,
      "start": 70.822,
      "end": 75.444,
      "rubyText": "溺[おぼ]れるのが怖[こわ]かったの エラ呼吸[こきゅう]など出来[でき]ないから",
      "translation": "빠져버리는게 무서웠어 아가미호흡 같은건 못하니까"
    },
    {
      "id": 10,
      "start": 75.444,
      "end": 82.24,
      "rubyText": "きみが立[た]てる その波紋[はもん]に 揺[ゆ]られ酔[よ]って 逃[に]げようと足掻[あが]いてた",
      "translation": "네가 일으킨 그 파문에 흔들려서 멀미하며 도망가려고 발버둥쳤어"
    },
    {
      "id": 11,
      "start": 99.889,
      "end": 104.538,
      "rubyText": "何度[なんど]も迷[まよ]うんだろう 何度[なんど]でも溺[おぼ]れるだろう",
      "translation": "몇 번이고 헤매겠지 몇 번이라도 빠져들겠지"
    },
    {
      "id": 12,
      "start": 104.538,
      "end": 109.123,
      "rubyText": "カイコする弱虫[よわむし]なの 痛[いた]いくらい抗[あらが]うのよ",
      "translation": "회고하는 겁쟁이인걸 아픈 만큼 저항하는 거야"
    },
    {
      "id": 13,
      "start": 109.123,
      "end": 113.655,
      "rubyText": "一歩[いっぽ]、また一歩[いっぽ]と 夢[ゆめ]から離[はな]れるたび",
      "translation": "한 걸음, 또 한 걸음 꿈으로부터 멀어질 때마다"
    },
    {
      "id": 14,
      "start": 113.655,
      "end": 118.332,
      "rubyText": "泡[あわ]のように浮[う]かぶ 二人[ふたり]の淡[あわ]い笑顔[えがお]",
      "translation": "거품처럼 떠오르는 두 사람의 아련한 미소"
    },
    {
      "id": 15,
      "start": 118.332,
      "end": 122.939,
      "rubyText": "やっぱ助[たす]けるよ 逃[に]げないから あたしの息[いき]あげる",
      "translation": "역시 도와주자 도망치지 않을테니까 내 숨을 줄게"
    },
    {
      "id": 16,
      "start": 122.939,
      "end": 127.52,
      "rubyText": "そう、相舞[あいまい]のチュー 愛迷[あいまい]です 二[ふた]つの息[いき]でWalking",
      "translation": "그래, 함께 춤추는 츄 사랑 미혹이에요 두개의 숨으로 Walking"
    },
    {
      "id": 17,
      "start": 127.52,
      "end": 132.053,
      "rubyText": "さて飛[と]び込[こ]むよ んで飲[の]み込[こ]むよ その悲[かな]しみ全[すべ]て",
      "translation": "그럼 뛰어들게 그리고 삼킬게 그 슬픔 전부를"
    },
    {
      "id": 18,
      "start": 132.053,
      "end": 136.02,
      "rubyText": "さあ位置[いち]について いつかの二人[ふたり]のこと求[もと]めて",
      "translation": "자 위치에 서서 언젠가의 우리 두 사람을 찾아서"
    },
    {
      "id": 19,
      "start": 136.02,
      "end": 140.868,
      "rubyText": "溢[あふ]れるなら 零[こぼ]れるなら このあたしが その涙[なみだ]を",
      "translation": "넘쳐버린다면 흘러내린다면 이 내가 그 눈물을"
    },
    {
      "id": 20,
      "start": 140.868,
      "end": 145.372,
      "rubyText": "飲[の]み干[ほ]そうか そうしようか 水太[みずぶと]りは 気[き]にしないけど",
      "translation": "다 마셔버릴까 그래버릴까 물배 채우는 건 신경쓰지 않지만"
    },
    {
      "id": 21,
      "start": 145.372,
      "end": 150.0,
      "rubyText": "塩辛[しおから]いのは ちと辛[つら]いな だってあたし 甘党[あまとう]だし",
      "translation": "짠 건 좀 괴로워 왜냐면 난 단 걸 좋아하니까"
    },
    {
      "id": 22,
      "start": 150.0,
      "end": 156.163,
      "rubyText": "だからきみの 甘[あま]い愛[あい]が また欲[ほ]しいから 目[め]を覚[さ]ましてほしいな",
      "translation": "그러니 네 달콤한 사랑을 다시 원하니까 눈을 떠줬으면 좋겠어"
    },
    {
      "id": 23,
      "start": 156.163,
      "end": 160.537,
      "rubyText": "泳[およ]ぐエレジー",
      "translation": "헤엄치는 엘레지"
    }
  ],
