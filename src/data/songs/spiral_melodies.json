  "lyrics": [
    {
      "id": 1,
      "start": 2.38,
      "end": 8.84,
      "rubyText": "La la la...",
      "translation": "라 라 라…",
      "romaji": "la la la..."
    },
    {
      "id": 2,
      "start": 26.71,
      "end": 31.5,
      "rubyText": "遠[とお]くに眺[なが]めた景色[けしき]が",
      "translation": "멀리서 바라본 풍경이",
      "romaji": "tooku ni nagameta keshiki ga"
    },
    {
      "id": 3,
      "start": 31.5,
      "end": 36.71,
      "rubyText": "いつもよりなぜか　優[やさ]しく見[み]えて",
      "translation": "평소보다도 왠지 상냥하게 보여서",
      "romaji": "itsumo yori nazeka yasashiku miete"
    },
    {
      "id": 4,
      "start": 36.71,
      "end": 41.2,
      "rubyText": "風[かぜ]に導[みちび]かれるように",
      "translation": "바람에 이끌리듯이",
      "romaji": "kaze ni michibikareru you ni"
    },
    {
      "id": 5,
      "start": 41.2,
      "end": 45.36,
      "rubyText": "長[なが]い橋[はし]を渡[わた]ってきたんだ",
      "translation": "긴 다리를 건너온 거야",
      "romaji": "nagai hashi o watatte kitanda"
    },
    {
      "id": 6,
      "start": 45.36,
      "end": 50.39,
      "rubyText": "スパイラル・メロディーズ やっと会[あ]えたね",
      "translation": "스파이럴・멜로디즈 드디어 만났네",
      "romaji": "supairaru merodiizu yatto aeta ne"
    },
    {
      "id": 7,
      "start": 50.39,
      "end": 51.64,
      "rubyText": "La la la",
      "translation": "La la la",
      "romaji": "la la la"
    },
    {
      "id": 8,
      "start": 51.64,
      "end": 55.05,
      "rubyText": "重[かさ]ねた声[こえ]を　この空[そら]へ",
      "translation": "거듭했던 목소리를, 이 하늘로",
      "romaji": "kasaneta koe o kono sora e"
    },
    {
      "id": 9,
      "start": 55.05,
      "end": 60.33,
      "rubyText": "懐[なつ]かしいメロディー 新[あら]たなメロディー",
      "translation": "그리운 멜로디, 새로운 멜로디",
      "romaji": "natsukashii merodii arata na merodii"
    },
    {
      "id": 10,
      "start": 60.33,
      "end": 61.58,
      "rubyText": "La la la",
      "translation": "La la la",
      "romaji": "la la la"
    },
    {
      "id": 11,
      "start": 61.58,
      "end": 66.53,
      "rubyText": "風[かぜ]の巡[めぐ]りに　祈[いの]りをのせて",
      "translation": "맴도는 바람에 기도를 싣고서",
      "romaji": "kaze no meguri ni inori o nosete"
    },
    {
      "id": 12,
      "start": 66.53,
      "end": 71.2,
      "rubyText": "通[とお]り過[す]ぎた記憶[きおく]のふちで",
      "translation": "스쳐 지나간 기억의 깊은 곳에서",
      "romaji": "toorisugita kioku no fuchi de"
    },
    {
      "id": 13,
      "start": 71.2,
      "end": 76.58,
      "rubyText": "セピア色[いろ]染[そ]まった　あの日[ひ]のメロディー",
      "translation": "세피아빛으로 물든 그날의 멜로디",
      "romaji": "sepia-iro somatta ano hi no merodii"
    },
    {
      "id": 14,
      "start": 76.58,
      "end": 80.9,
      "rubyText": "あなたと歩[ある]き出[だ]したとき",
      "translation": "당신과 함께 걸어나갔을 때",
      "romaji": "anata to arukidashita toki"
    },
    {
      "id": 15,
      "start": 80.9,
      "end": 85.98,
      "rubyText": "歌[うた]い方[かた]を思[おも]い出[だ]せたんだ",
      "translation": "노래하는 법을 떠올릴 수 있었어",
      "romaji": "utaikata o omoidasetanda"
    },
    {
      "id": 16,
      "start": 85.98,
      "end": 90.0,
      "rubyText": "この胸[むね]の高鳴[たかな]りよ　響[ひび]いて！",
      "translation": "이 가슴의 두근거림아, 울려 퍼져라!",
      "romaji": "kono mune no takanari yo hibiite!"
    },
    {
      "id": 17,
      "start": 90.0,
      "end": 95.21,
      "rubyText": "スパイラル・メロディーズ あなたといると",
      "translation": "스파이럴・멜로디즈 당신과 함께 있으면",
      "romaji": "supairaru merodiizu anata to iru to"
    },
    {
      "id": 18,
      "start": 95.21,
      "end": 96.19,
      "rubyText": "La la la",
      "translation": "La la la",
      "romaji": "la la la"
    },
    {
      "id": 19,
      "start": 96.19,
      "end": 99.91,
      "rubyText": "足[あし]どりは軽[かる]く　舞[ま]うように",
      "translation": "발걸음은 가볍게, 춤추듯이",
      "romaji": "ashidori wa karuku mau you ni"
    },
    {
      "id": 20,
      "start": 99.91,
      "end": 105.25,
      "rubyText": "ドキドキの夏[なつ]も　綺麗[きれい]な冬[ふゆ]も",
      "translation": "두근거리는 여름도, 아름다운 겨울도",
      "romaji": "dokidoki no natsu mo kirei na fuyu mo"
    },
    {
      "id": 21,
      "start": 105.25,
      "end": 106.33,
      "rubyText": "La la la",
      "translation": "La la la",
      "romaji": "la la la"
    },
    {
      "id": 22,
      "start": 106.33,
      "end": 111.33,
      "rubyText": "巡[めぐ]る月日[つきひ]を　行[ゆ]こう　どこまでも！",
      "translation": "맴도는 세월을 나아가자 어디까지라도!",
      "romaji": "meguru tsukihi o yukou dokomademo!"
    },
    {
      "id": 23,
      "start": 116.27,
      "end": 121.05,
      "rubyText": "La la la...",
      "translation": "La la la…",
      "romaji": "la la la..."
    },
    {
      "id": 24,
      "start": 121.25,
      "end": 126.34,
      "rubyText": "歌[うた]いたいのは　あなたの歌[うた]",
      "translation": "부르고 싶은 건 당신의 노래",
      "romaji": "utaitai no wa anata no uta"
    },
    {
      "id": 25,
      "start": 126.51,
      "end": 131.28,
