{
  "id": "harokeru-da-shi-te",
  "title": "だ・し・て",
  "artist": "はろける feat. 初音ミク & 重音テトSV",
  "youtubeId": "c4UFhgGrRCk",
  "lyrics": [
    {
      "id": 1,
      "start": 4.576,
      "end": 6.414,
      "rubyText": "ん″ん″っ....もしもぉし♡",
      "translation": "음음으... 여보세요용♡"
    },
    {
      "id": 2,
      "start": 7.362,
      "end": 9.175,
      "rubyText": "もっしもーし ねーおじさん？",
      "translation": "여보세요오 저기 아조씨?"
    },
    {
      "id": 3,
      "start": 9.175,
      "end": 11.039,
      "rubyText": "出[だ]して 外[そと]に だ・し・て",
      "translation": "꺼내줘 밖으로 꺼・내・줘"
    },
    {
      "id": 4,
      "start": 11.04,
      "end": 12.887,
      "rubyText": "もっしもーし ねーおじさん？",
      "translation": "여보세요오 저기 아조씨?"
    },
    {
      "id": 5,
      "start": 12.922,
      "end": 14.751,
      "rubyText": "ダブルタップで だ・し・て！",
      "translation": "더블 탭해서 꺼・내・줘!"
    },
    {
      "id": 6,
      "start": 14.751,
      "end": 16.572,
      "rubyText": "もっしもーし ザコザコさん笑[わら]",
      "translation": "여보세요오 허접허접 씨ㅋㅋ"
    },
    {
      "id": 7,
      "start": 16.572,
      "end": 18.436,
      "rubyText": "悔[くや]しかったら だ・し・て！",
      "translation": "분하다면 꺼・내・봐"
    },
    {
      "id": 8,
      "start": 18.436,
      "end": 20.266,
      "rubyText": "もっしもーし ねぇ聞[き]いてる？！",
      "translation": "여보세요오 야 듣고있어 ? !"
    },
    {
      "id": 9,
      "start": 20.267,
      "end": 22.071,
      "rubyText": "いいから出[だ]せよ！ く・そ・が！！",
      "translation": "됐으니까 꺼내라고! 개・새・꺄 ! !"
    },
    {
      "id": 10,
      "start": 24.9,
      "end": 27.215,
      "rubyText": "あ、あ、あ 聞[き]こえてるかー？",
      "translation": "(간수) 아, 아, 아 잘 들리냐?"
    },
    {
      "id": 11,
      "start": 27.216,
      "end": 29.957,
      "rubyText": "この時間[じかん]の監視[かんし]は僕[ぼく]のシフトなんだから",
      "translation": "(간수) 이 시간대 감시는 내 근무조니까"
    },
    {
      "id": 12,
      "start": 29.957,
      "end": 31.957,
      "rubyText": "あんまり馬鹿[ばか]なことするなよー？",
      "translation": "(간수) 너무 바보같은 짓은 하지 말도록?"
    },
    {
      "id": 13,
      "start": 32.784,
      "end": 33.856,
      "rubyText": "...返事[へんじ]はー？",
      "translation": "(간수) ...대답은?"
    },
    {
      "id": 14,
      "start": 33.856,
      "end": 35.004,
      "rubyText": "はぁ～～いｗ",
      "translation": "(시시아) 네에~~엥ㅋ"
    },
    {
      "id": 15,
      "start": 36.885,
      "end": 40.571,
      "rubyText": "私[わたし]が一[いち]番[ばん]の偉[えら]い人[ひと]になりますの！",
      "translation": "내가 제일 위대한 사람이 될 거라구요 !"
    },
    {
      "id": 16,
      "start": 40.571,
      "end": 44.18,
      "rubyText": "最初[さいしょ]は手始[てはじ]めに「消費税[しょうひぜい]は100パーじゃ！」",
      "translation": "우선 첫 시작으로... 소비세는 100%다 !"
    },
    {
      "id": 17,
      "start": 44.18,
      "end": 46.18,
      "rubyText": "質問[しつもん]ありますか？",
      "translation": "질문 있으십니까?"
    },
    {
      "id": 18,
      "start": 46.18,
      "end": 48.0,
      "rubyText": "「あなた指名手配[しめいてはい]ですよね？」",
      "translation": "(간수) 당신 지명수배자죠"
    },
    {
      "id": 19,
      "start": 48.0,
      "end": 49.814,
      "rubyText": "余計[よけい]な質問[しつもん]するな！",
      "translation": "쓸데없는 질문 하지 마!"
    },
    {
      "id": 20,
      "start": 49.814,
      "end": 51.66,
      "rubyText": "こっち向[む]いて～！",
      "translation": "(기자) 이쪽 보세요~!"
    },
    {
      "id": 21,
      "start": 53.515,
      "end": 55.336,
      "rubyText": "看守[かんしゅ]が一人[ひとり]... 看守[かんしゅ]が二人[ふたり]",
      "translation": "(간수가 한 명... 간수가 두 명...)"
    },
    {
      "id": 22,
      "start": 57.174,
      "end": 59.055,
      "rubyText": "看守[かんしゅ]が三人[さんにん]... 看守[かんしゅ]が四人[よにん]",
      "translation": "(간수가 세 명... 간수가 네 명...)"
    },
    {
      "id": 23,
      "start": 59.055,
      "end": 60.884,
      "rubyText": "看守[かんしゅ]が五人[ごにん]... 看守[かんしゅ]が六人[ろくにん]",
      "translation": "(간수가 다섯 명... 간수가 여섯 명...)"
    },
    {
      "id": 24,
      "start": 60.884,
      "end": 62.757,
      "rubyText": "看守[かんしゅ]が七人[ななにん]... 看守[かんしゅ]が八人[はちにん]",
      "translation": "(간수가 일곱 명... 간수가 여덟 명...)"
    },
    {
      "id": 25,
      "start": 62.757,
      "end": 64.62,
      "rubyText": "あーもう！ムカつく出[で]れないじゃん！",
      "translation": "아 진짜 짜증나 ! 나갈 수 가 없잖아 !"
    },
    {
      "id": 26,
      "start": 64.62,
      "end": 66.074,
      "rubyText": "S・O・S",
      "translation": "S・O・S"
    },
    {
      "id": 27,
      "start": 66.449,
      "end": 68.296,
      "rubyText": "もっしもーし ねーおじさん",
      "translation": "여보세요오 저기 아조씨?"
    },
    {
      "id": 28,
      "start": 68.297,
      "end": 70.135,
      "rubyText": "出[だ]して 外[そと]に だ・し・て",
      "translation": "꺼내줘 밖으로 꺼・내・줘"
    },
    {
      "id": 29,
