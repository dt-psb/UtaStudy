      "rubyText": "悔[くや]しかったら だ・し・て！",
      "translation": "분하다면 꺼・내・봐"
    },
    {
      "id": 33,
      "start": 77.515,
      "end": 79.379,
      "rubyText": "もっしもーし ねぇ聞[き]いてる？！",
      "translation": "여보세요오 야 듣고있어?!"
    },
    {
      "id": 34,
      "start": 79.38,
      "end": 81.21,
      "rubyText": "いいから出[だ]せよ！ く・そ・が！！",
      "translation": "됐으니까 꺼내라고! 개・새・꺄 ! !"
    },
    {
      "id": 35,
      "start": 82.561,
      "end": 84.45,
      "rubyText": "脱走後[だっそうご]は何[なに]しよう",
      "translation": "탈옥하면 뭘 할까나"
    },
    {
      "id": 36,
      "start": 84.45,
      "end": 88.144,
      "rubyText": "ネコのあたまハゲさせてそのまま逃走中[とうそうちゅう]",
      "translation": "고양이 머리 대머리 만들고 그대로 도주 중"
    },
    {
      "id": 37,
      "start": 88.144,
      "end": 89.923,
      "rubyText": "「なんにも盗[ぬす]みはしてないの！」",
      "translation": "「아무것도 훔치진 않았어 ! 」"
    },
    {
      "id": 38,
      "start": 90.113,
      "end": 91.355,
      "rubyText": "...もう捕[つか]まった！？",
      "translation": "...벌써 잡혀버렸다 ! ?"
    },
    {
      "id": 39,
      "start": 94.742,
      "end": 99.549,
      "rubyText": "えぇーーーーーこんなもの刑務所[けいむしょ]に持[も]ち込[こ]んでどうするのちょっと～～～～？？？",
      "translation": "(간수) 에에ーーーーー 이런 걸 교도소에 반입해서 뭘 하려고 (시시아) 잠깐～～～～？？？"
    },
    {
      "id": 40,
      "start": 99.549,
      "end": 101.338,
      "rubyText": "あーしのコレクション（食料[しょくりょう]）にケチつけんの？",
      "translation": "(시시아) 내 먹을 거에 딴지 거는 거야?"
    },
    {
      "id": 41,
      "start": 101.338,
      "end": 103.526,
      "rubyText": "いやー、許可[きょか]はするよ",
      "translation": "(간수) ...아니ㅡ, 허가는 해줄게..."
    },
    {
      "id": 42,
      "start": 103.526,
      "end": 104.683,
      "rubyText": "けどなんで卵[たまご]なんだ",
      "translation": "...근데 왜 계란인 거냐..."
    },
    {
      "id": 43,
      "start": 106.564,
      "end": 108.428,
      "rubyText": "ホントバカすぎじゃん笑[わら]",
      "translation": "진짜 너무 바보잖아 ㅋㅋ"
    },
    {
      "id": 44,
      "start": 108.428,
      "end": 110.283,
      "rubyText": "マジくそチョロすぎじゃん笑[わら]",
      "translation": "진짜 개 쉽잖아 ㅋㅋ"
    },
    {
      "id": 45,
      "start": 110.283,
      "end": 115.264,
      "rubyText": "このままおさらばじゃん！",
      "translation": "이대로 작별인 거잖아 !"
    },
    {
      "id": 46,
      "start": 117.764,
      "end": 119.611,
      "rubyText": "もっしもーし ねーお嬢[じょう]さん？",
      "translation": "여보세요오 저기 아가씨?"
    },
    {
      "id": 47,
      "start": 119.671,
      "end": 121.355,
      "rubyText": "だして 外[そと]に だ・し・て",
      "translation": "꺼내줘 밖으로 꺼・내・줘"
    },
    {
      "id": 48,
      "start": 121.526,
      "end": 123.228,
      "rubyText": "もっしもーし ねーお嬢[じょう]さん？",
      "translation": "여보세요오 저기 아가씨?"
    },
    {
      "id": 49,
      "start": 123.369,
      "end": 125.054,
      "rubyText": "お願[ねが]い 早[はや]く だ・し・て",
      "translation": "부탁이야 얼른 좀 꺼내줘"
    },
    {
      "id": 50,
      "start": 125.166,
      "end": 126.885,
      "rubyText": "もっしもーし ザコザコさん笑[わら]",
      "translation": "여보세요 허접허접 씨💢"
    },
    {
      "id": 51,
      "start": 127.052,
      "end": 128.737,
      "rubyText": "聞[き]こえてたら だ・し・て",
      "translation": "듣고 있다면은 꺼・내・줘"
    },
    {
      "id": 52,
      "start": 128.887,
      "end": 130.589,
      "rubyText": "もっしもーし どうしてほしい？",
      "translation": "여보세요오 뭘 해주길 원하실까?"
    },
    {
      "id": 53,
      "start": 130.642,
      "end": 135.568,
      "rubyText": "いいから出[だ]して！ く・そ・が ああああああああああ！！",
      "translation": "됐으니까 꺼내 달라고 ! 개・새・꺄아아아아아아아아아 ! !"
    },
    {
      "id": 54,
      "start": 136.111,
      "end": 138.0,
      "rubyText": "もっしもーし ねえお嬢[じょう]さん？",
      "translation": "여보세요오 저기 아가씨?"
    },
    {
      "id": 55,
      "start": 138.0,
      "end": 139.83,
      "rubyText": "あーしは冤罪[えんざい] む・ざ・い！",
      "translation": "나는 억울하다고 무・죄・야!"
    },
    {
      "id": 56,
      "start": 143.488,
      "end": 145.42,
      "rubyText": "もっしもーし 反省[はんせい]しよ？",
      "translation": "여보세요오 반성 좀 할까?"
    },
    {
      "id": 57,
      "start": 145.42,
      "end": 147.207,
      "rubyText": "信[しん]じて出[だ]して！ く・そ・が！！",
      "translation": "믿고 꺼내달라고 ! 개・새・꺄 !"
    }
