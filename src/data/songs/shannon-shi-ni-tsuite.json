      "endTime": 75.7,
      "text": "生[う]まれて 歩[ある]いて",
      "translation": "태어나고 걸어가며",
      "start": 72.94,
      "end": 75.7,
      "rubyText": "生[う]まれて 歩[ある]いて"
    },
