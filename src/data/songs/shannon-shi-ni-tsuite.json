  "lyrics": [
    {
      "id": 1,
      "startTime": 1.98,
      "endTime": 4.54,
      "text": "生[う]まれて 歩[ある]いて",
      "translation": "태어나고 걸어가며",
      "start": 1.98,
      "end": 4.54,
      "rubyText": "生[う]まれて 歩[ある]いて"
    },
    {
      "id": 2,
      "startTime": 4.74,
      "endTime": 6.86,
      "text": "誰[だれ]かの死[し]と向[む]き合[あ]って",
      "translation": "누군가의 죽음을 맞이하고",
      "start": 4.74,
      "end": 6.86,
      "rubyText": "誰[だれ]かの死[し]と向[む]き合[あ]って"
    },
    {
      "id": 3,
      "startTime": 7.24,
      "endTime": 12.04,
      "text": "人[ひと]は世界[せかい]について考[かんが]えるの",
      "translation": "사람은 세계에 대해 생각해",
      "start": 7.24,
      "end": 12.04,
      "rubyText": "人[ひと]は世界[せかい]について考[かんが]えるの"
    },
    {
      "id": 4,
      "startTime": 34.92,
      "endTime": 39.04,
      "text": "選[えら]ばれた世界[せかい]にいるようで",
      "translation": "선택받은 세계에 있는 듯해서",
      "start": 34.92,
      "end": 39.04,
      "rubyText": "選[えら]ばれた世界[せかい]にいるようで"
    },
    {
      "id": 5,
      "startTime": 40.26,
      "endTime": 43.22,
      "text": "攫[さら]われそうになった朝[あさ]",
      "translation": "납치당한 것만 같은 아침",
      "start": 40.26,
      "end": 43.22,
      "rubyText": "攫[さら]われそうになった朝[あさ]"
    },
    {
      "id": 6,
      "startTime": 45.14,
      "endTime": 47.3,
      "text": "どうしてこれでいいの",
      "translation": "어째서 이걸로 괜찮은 거야",
      "start": 45.14,
      "end": 47.3,
      "rubyText": "どうしてこれでいいの"
    },
    {
      "id": 7,
      "startTime": 47.88,
      "endTime": 49.8,
      "text": "どうしてこれがいいの",
      "translation": "어째서 이게 괜찮은 거야",
      "start": 47.88,
      "end": 49.8,
      "rubyText": "どうしてこれがいいの"
    },
    {
      "id": 8,
      "startTime": 50.48,
      "endTime": 53.28,
      "text": "なんて そうやって考[かんが]えて",
      "translation": "라고 그렇게 생각하며",
      "start": 50.48,
      "end": 53.28,
      "rubyText": "なんて そうやって考[かんが]えて"
    },
    {
      "id": 9,
      "startTime": 53.78,
      "endTime": 55.6,
      "text": "雨[あめ]が降[ふ]っていた",
      "translation": "비가 내렸어",
      "start": 53.78,
      "end": 55.6,
      "rubyText": "雨[あめ]が降[ふ]っていた"
    },
    {
      "id": 10,
      "startTime": 56.94,
      "endTime": 60.96,
      "text": "今年[ことし]も夏[なつ]が来[き]た",
      "translation": "올해도 여름이 왔어",
      "start": 56.94,
      "end": 60.96,
      "rubyText": "今年[ことし]も夏[なつ]が来[き]た"
    },
    {
      "id": 11,
      "startTime": 61.76,
      "endTime": 65.1,
      "text": "もしも永生[えいせい]の様[よう]な存在[そんざい]が",
      "translation": "만약 거의 영생을 사는 존재가",
      "start": 61.76,
      "end": 65.1,
      "rubyText": "もしも永生[えいせい]の様[よう]な存在[そんざい]が"
    },
    {
      "id": 12,
      "startTime": 65.1,
      "endTime": 67.24,
      "text": "この星[ほし]にあったなら",
      "translation": "이 별에 있었다면",
      "start": 65.1,
      "end": 67.24,
      "rubyText": "この星[ほし]にあったなら"
    },
    {
      "id": 13,
      "startTime": 67.64,
      "endTime": 72.06,
      "text": "一体[いったい]どんな世界[せかい]を描[えが]き出[だ]すんだろう",
