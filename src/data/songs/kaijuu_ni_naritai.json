  "lyrics": [
    {
      "id": 1,
      "start": 4.222,
      "end": 6.462,
      "rubyText": "怪[かい]獣[じゅう]になりたい",
      "romaji": "kaijuu ni naritai",
      "translation": "괴수가 되고 싶어"
    },
    {
      "id": 2,
      "start": 6.462,
      "end": 8.729,
      "rubyText": "怪[かい]獣[じゅう]になりたい",
      "romaji": "kaijuu ni naritai",
      "translation": "괴수가 되고 싶어"
    },
    {
      "id": 3,
      "start": 8.729,
      "end": 13.134,
      "rubyText": "全[すべ]て倒[たお]して 全[すべ]て壊[こわ]すの",
      "romaji": "subete taoshite subete kowasu no",
      "translation": "전부 쓰러뜨리고 전부 부수겠어"
    },
    {
      "id": 4,
      "start": 26.869,
      "end": 29.124,
      "rubyText": "夢[ゆめ]は夢[ゆめ]さ",
      "romaji": "yume wa yume sa",
      "translation": "꿈은 꿈이야"
    },
    {
      "id": 5,
      "start": 29.124,
      "end": 31.254,
      "rubyText": "かつては見[み]ていた",
      "romaji": "katsute wa mite ita",
      "translation": "한때는 보고 있었어"
    },
    {
      "id": 6,
      "start": 31.254,
      "end": 33.495,
      "rubyText": "時[とき]と友[とも]を",
      "romaji": "toki to tomo o",
      "translation": "세월과 친구를"
    },
    {
      "id": 7,
      "start": 33.495,
      "end": 35.625,
      "rubyText": "闇[やみ]雲[くも]に失[うしな]った",
      "romaji": "yamikumo ni ushinatta",
      "translation": "무작정 잃었어"
    },
    {
      "id": 8,
      "start": 35.625,
      "end": 37.599,
      "rubyText": "今[いま]は骨[ほね]を",
      "romaji": "ima wa hone o",
      "translation": "지금은 뼈를"
    },
    {
      "id": 9,
      "start": 37.599,
      "end": 39.425,
      "rubyText": "埋[う]める場[ば]所[しょ]を",
      "romaji": "umeru basho o",
      "translation": "묻을 곳을"
    },
    {
      "id": 10,
      "start": 39.425,
      "end": 42.727,
      "rubyText": "探[さが]し歩[ある]き行[い]くだけ",
      "romaji": "sagashiaruki iku dake",
      "translation": "찾아 걸어다닐 뿐"
    },
    {
      "id": 11,
      "start": 43.452,
      "end": 44.18,
      "rubyText": "只[ただ]、",
      "romaji": "tada,",
      "translation": "그저,"
    },
    {
      "id": 12,
      "start": 44.18,
      "end": 45.405,
      "rubyText": "忘[ぼう]却[きゃく]の",
      "romaji": "boukyaku no",
      "translation": "망각의"
    },
    {
      "id": 13,
      "start": 46.287,
      "end": 48.0,
      "rubyText": "彼方[かなた]に攫[さら]われて",
      "romaji": "kanata ni sarawarete",
      "translation": "저 너머로 끌려가"
    },
    {
      "id": 14,
      "start": 48.577,
      "end": 49.535,
      "rubyText": "それでも",
      "romaji": "soredemo",
      "translation": "그래도"
    },
    {
      "id": 15,
      "start": 49.535,
      "end": 52.428,
      "rubyText": "役[やく]立[だ]つ何[なに]かにはなりたい",
      "romaji": "yakudatsu nanika ni wa naritai",
      "translation": "쓸모 있는 무언가가 되고 싶어"
    },
    {
      "id": 16,
      "start": 53.1,
      "end": 55.311,
      "rubyText": "いずれ最[さい]期[ご]は死[し]ぬのなら",
      "romaji": "izure saigo wa shinu no nara",
      "translation": "결국 최후는 죽음이라면"
    },
    {
      "id": 17,
      "start": 55.311,
      "end": 58.775,
      "rubyText": "爪[つめ]痕[あと]をせめて刻[きざ]めるなら",
      "romaji": "tsumeato o semete kizameru nara",
      "translation": "최소한 흔적이라도 새길 수 있다면"
    },
    {
      "id": 18,
      "start": 59.956,
      "end": 62.267,
      "rubyText": "怪[かい]獣[じゅう]になりたい",
      "romaji": "kaijuu ni naritai",
      "translation": "괴수가 되고 싶어"
    },
    {
      "id": 19,
      "start": 62.267,
      "end": 64.231,
      "rubyText": "怪[かい]獣[じゅう]になりたい",
      "romaji": "kaijuu ni naritai",
      "translation": "괴수가 되고 싶어"
    },
    {
      "id": 20,
      "start": 64.231,
      "end": 66.427,
      "rubyText": "全[すべ]て倒[たお]して",
      "romaji": "subete taoshite",
      "translation": "전부 쓰러뜨리고"
    },
    {
      "id": 21,
      "start": 66.427,
      "end": 69.442,
      "rubyText": "全[すべ]て壊[こわ]すの",
      "romaji": "subete kowasu no",
      "translation": "전부 부수겠어"
    },
    {
      "id": 22,
      "start": 69.442,
      "end": 71.641,
      "rubyText": "どんな敵[てき]も",
      "romaji": "donna teki mo",
      "translation": "어떤 적이라도"
    },
    {
      "id": 23,
      "start": 71.641,
      "end": 73.826,
      "rubyText": "どれだけの壁[かべ]も",
      "romaji": "doredake no kabe mo",
      "translation": "아무리 큰 벽이라도"
    },
    {
      "id": 24,
      "start": 73.826,
      "end": 79.558,
      "rubyText": "いずれ粉々[こなごな]の塵々[ちりぢり]にしてやる",
      "romaji": "izure konagona no chirijiri ni shite yaru",
      "translation": "결국은 산산히 조각조각 내주겠어"
    },
    {
      "id": 25,
      "start": 98.148,
      "end": 99.479,
      "rubyText": "来[らい]世[せ]は",
      "romaji": "raise wa",
      "translation": "다음 생은"
    },
    {
      "id": 26,
      "start": 99.479,
      "end": 101.693,
      "rubyText": "美[うつく]しく生[い]きたい",
      "romaji": "utsukushiku ikitai",
      "translation": "아름답게 살고 싶어"
    },
    {
      "id": 27,
      "start": 102.174,
      "end": 103.907,
      "rubyText": "次[つぎ]があるなら",
      "romaji": "tsugi ga aru nara",
      "translation": "다음이 있다면"
    },
    {
      "id": 28,
      "start": 103.907,
      "end": 106.308,
      "rubyText": "可愛[かわい]く生[い]きたい",
      "romaji": "kawaiku ikitai",
      "translation": "예쁘게 살고 싶어"
    },
    {
      "id": 29,
      "start": 110.049,
      "end": 112.179,
      "rubyText": "怪[かい]獣[じゅう]になりたい",
      "romaji": "kaijuu ni naritai",
      "translation": "괴수가 되고 싶어"
    },
