{
  "id": "aktari_summer_festa",
  "title": "サマフェスタ",
  "artist": "あくたり (Aktari) feat. 初音ミク",
  "youtubeId": "FBecwwAOojs",
  "thumbnail": "https://i.ytimg.com/vi/FBecwwAOojs/maxresdefault.jpg",
  "duration": 188,
  "lyrics": [
    {
      "id": 1,
      "start": 1.398,
      "end": 6.0,
      "rubyText": "青[あお]い世界[せかい]もこの夏[なつ]も変[か]わらないで欲[ほ]しいけど",
      "translation": "푸른 세상도 이 여름도 변하지 않았으면 좋겠지만"
    },
    {
      "id": 2,
      "start": 6.0,
      "end": 11.716,
      "rubyText": "いつか終[お]わりがあって続[つづ]かないことも分[わ]かってるんだよ",
      "translation": "언젠가 끝이 있고 계속되지 않는다는 것도 알고 있어"
    },
    {
      "id": 3,
      "start": 11.716,
      "end": 16.425,
      "rubyText": "隣[とな]り合[あ]っていた君[きみ]もいつかいなくなってしまうのなら",
      "translation": "곁에 머물던 너도 언젠가 사라져 버린다면"
    },
    {
      "id": 4,
      "start": 16.425,
      "end": 21.841,
      "rubyText": "僕[ぼく]だけが残[のこ]って思[おも]い出[で]すらも消[き]えてしまうのかな",
      "translation": "나 홀로 남아 추억마저도 사라져 버리는 걸까"
    },
    {
      "id": 5,
      "start": 42.079,
      "end": 46.86,
      "rubyText": "Ah 巡[めぐ]り巡[めぐ]って僕達[ぼくたち]は出会[であ]えたんだ、運命[うんめい]さ！",
      "translation": "Ah 돌고 돌아 우리들은 만난 거야, 운명인걸!"
    },
    {
      "id": 6,
      "start": 46.86,
      "end": 50.795,
      "rubyText": "きっと例外[れいがい]なしの\"いつか\"さえ忘[わす]れさせてよ",
      "translation": "분명 예외 없는 \"언젠가\"마저도 잊게 해줘"
    },
    {
      "id": 7,
      "start": 50.795,
      "end": 52.584,
      "rubyText": "さあ、声[こえ]を聞[き]かせてよ！",
      "translation": "자, 목소리를 들려줘!"
    },
    {
      "id": 8,
      "start": 52.584,
      "end": 55.462,
      "rubyText": "Wow!!　君[きみ]と僕[ぼく]で",
      "translation": "Wow!! 너와 내가"
    },
    {
      "id": 9,
      "start": 55.462,
      "end": 59.787,
      "rubyText": "Wow!!　二人[ふたり]ずっと歌[うた]っていようねいつまでも",
      "translation": "Wow!! 둘이서 언제까지나 계속 노래하자"
    },
    {
      "id": 10,
      "start": 59.787,
      "end": 62.761,
      "rubyText": "夏[なつ]は、明[あ]けたばかりさ。",
      "translation": "여름은, 이제 막 밝았을 뿐이야."
    },
    {
      "id": 11,
      "start": 62.761,
      "end": 67.293,
      "rubyText": "ああ、不幸[ふこう]あっての幸[こう]　傷[きず]だって愛[いと]おしいよ",
      "translation": "아아, 불행이 있기에 행복이 있는 법 상처조차 사랑스러워"
    },
    {
      "id": 12,
      "start": 67.293,
      "end": 73.006,
      "rubyText": "例[たと]えいつか消[き]えると分[わ]かっててもずっと愛[あい]していたいのさ",
      "translation": "설령 언젠가 사라질 걸 안다 해도 영원히 사랑하고 싶어"
    },
    {
      "id": 13,
      "start": 73.006,
      "end": 80.373,
      "rubyText": "「この歌[うた]と愛[あい]は永久[とわ]に消[き]えないからね」って君[きみ]はそう言[い]った",
      "translation": "「이 노래와 사랑은 영원히 사라지지 않으니까」라며 너는 그렇게 말했어"
    },
    {
      "id": 14,
      "start": 80.373,
      "end": 85.115,
      "rubyText": "Ah 廻[めぐ]り廻[めぐ]って僕達[ぼくたち]の絆[きずな]だって運命[うんめい]さ！",
      "translation": "Ah 돌고 도는 우리들의 인연 또한 운명인걸!"
    },
    {
      "id": 15,
      "start": 85.115,
      "end": 89.094,
      "rubyText": "ずっと曖昧[あいまい]だった\"いつか\"さえ忘[わす]れたいんだよ",
      "translation": "내내 모호하기만 하던 \"언젠가\"마저 잊고 싶은걸"
    },
    {
      "id": 16,
      "start": 89.094,
      "end": 91.189,
      "rubyText": "ねえ、声[こえ]で搔[か]き消[け]して！",
      "translation": "있잖아, 목소리로 깨끗이 지워줘!"
    },
    {
      "id": 17,
      "start": 91.189,
      "end": 93.761,
      "rubyText": "Wow!!　君[きみ]と僕[ぼく]で",
      "translation": "Wow!! 너와 내가"
    },
    {
      "id": 18,
      "start": 93.761,
      "end": 98.08,
      "rubyText": "Wow!!　二人[ふたり]ずっと歌[うた]っていようねいつまでも",
      "translation": "Wow!! 둘이서 언제까지나 계속 노래하자"
    },
    {
      "id": 19,
      "start": 98.08,
      "end": 100.936,
      "rubyText": "夏[なつ]が、少[すこ]し落[お]ちていく。",
      "translation": "여름이, 조금씩 저물어가."
    },
    {
      "id": 20,
      "start": 100.936,
      "end": 105.263,
      "rubyText": "この夏[なつ]もいつか終[お]わりがあって輝[かがや]くように",
      "translation": "이 여름도 언젠가 끝이 있기에 눈부시게 빛나듯이"
    },
    {
      "id": 21,
      "start": 105.263,
      "end": 109.98,
      "rubyText": "そうさ、終[お]わんない今日[きょう]なんて僕達[ぼくたち]はいらないさ！",
      "translation": "그래, 끝나지 않는 오늘 따윈 우리에겐 필요 없어!"
    },
    {
      "id": 22,
      "start": 109.98,
      "end": 116.049,
      "rubyText": "あの花[はな]もいつか枯[か]れてしまうって分[わ]かってるんだけどさ",
      "translation": "저 꽃도 언젠간 시들어 버린다는 걸 알고는 있지만"
    },
    {
      "id": 23,
      "start": 116.049,
