  "lyrics": [
    {
      "id": 1,
      "start": 0.451,
      "end": 3.554,
      "rubyText": "この何[なん]でもない手[て]のひらのカードでさ",
      "translation": "이 아무것도 아닌 손바닥 위의 카드로 말야"
    },
    {
      "id": 2,
      "start": 3.554,
      "end": 6.79,
      "rubyText": "1度[ど]だけの秘[ひ]密[みつ]のイリュージョン",
      "translation": "단 한 번뿐인 비밀의 일루전"
    },
    {
      "id": 3,
      "start": 6.79,
      "end": 9.96,
      "rubyText": "揺[ゆ]らめくハートそっと消[き]える",
      "translation": "일렁이는 하트, 살며시 사라져"
    },
    {
      "id": 4,
      "start": 9.96,
      "end": 13.497,
      "rubyText": "今[こん]夜[や]も星[ほし]のような開[かい]幕[まく]で",
      "translation": "오늘 밤도 별 같은 개막으로"
    },
    {
      "id": 5,
      "start": 13.497,
      "end": 16.333,
      "rubyText": "種[たね]も仕[し]掛[かけ]も無[な]い世[せ]界[かい]を",
      "translation": "속임수도 장치도 없는 세상을"
    },
    {
      "id": 6,
      "start": 16.333,
      "end": 18.569,
      "rubyText": "今日[きょう]は愛[あい]せるのかな",
      "translation": "오늘은 사랑할 수 있을까"
    },
    {
      "id": 7,
      "start": 19.703,
      "end": 22.806,
      "rubyText": "抱[だ]きしめる嘘[うそ]みたいなホントの時[じ]間[かん]",
      "translation": "끌어안아, 거짓말 같은 진짜 시간"
    },
    {
      "id": 8,
      "start": 23.007,
      "end": 25.943,
      "rubyText": "言[こと]葉[ば]だけじゃつらいは言[い]えないから",
      "translation": "말만으로는 괴로움을 말할 수 없으니까"
    },
    {
      "id": 9,
      "start": 26.243,
      "end": 29.446,
      "rubyText": "このカードだけ何[なに]も無[な]い夜[よる]だけど",
      "translation": "이 카드뿐 아무것도 없는 밤이지만"
    },
    {
      "id": 10,
      "start": 29.446,
      "end": 32.649,
      "rubyText": "オマジナイみたいな手[て]品[じな]ひとつ",
      "translation": "주문 같은 마술 하나"
    },
    {
      "id": 11,
      "start": 32.983,
      "end": 35.619,
      "rubyText": "ちょっぴり寂[さび]しくて涙[なみだ] 零[こぼ]れる終[しゅう]末[まつ]感[かん]",
      "translation": "조금 쓸쓸해서 눈물 흐르는 종말감"
    },
    {
      "id": 12,
      "start": 35.619,
      "end": 38.789,
      "rubyText": "君[きみ]はカードの魔[ま]法[ほう]で微[ほほ]笑[え]んだ",
      "translation": "너는 카드의 마법으로 미소 지었어"
    },
    {
      "id": 13,
      "start": 39.056,
      "end": 42.393,
      "rubyText": "種[たね]も仕[し]掛[かけ]もないはずの心[こころ]の欠[かけ]片[ら]を",
      "translation": "속임수도 장치도 없을 터인 마음의 조각을"
    },
    {
      "id": 14,
      "start": 42.393,
      "end": 45.262,
      "rubyText": "探[さが]す旅[たび]に出[で]るハートのA",
      "translation": "찾으러 떠나는 여행, 하트의 A"
    },
    {
      "id": 15,
      "start": 58.609,
      "end": 61.178,
      "rubyText": "ちっぽけな感[かん]情[じょう]のキャパシティ",
      "translation": "보잘것없는 감정의 그릇"
    },
    {
      "id": 16,
      "start": 61.178,
      "end": 64.181,
      "rubyText": "失[しっ]敗[ぱい]ばかりしてきたそれでも",
      "translation": "실패만 해왔어, 그래도"
    },
    {
      "id": 17,
      "start": 64.281,
      "end": 68.218,
      "rubyText": "明日[あした]の最[さい]後[ご]笑[わら]えるまでは",
      "translation": "내일의 마지막 웃을 수 있을 때까지는"
    },
    {
      "id": 18,
      "start": 68.218,
      "end": 71.121,
      "rubyText": "この種[たね]を明[あ]かしちゃいけない",
      "translation": "이 비밀을 밝혀선 안 돼"
    },
    {
      "id": 19,
      "start": 71.121,
      "end": 73.824,
      "rubyText": "少[すこ]しの痛[いた]みが灯[とも]っても",
      "translation": "약간의 아픔이 피어나더라도"
    },
    {
      "id": 20,
      "start": 73.957,
      "end": 76.06,
      "rubyText": "君[きみ]と抱[だ]きしめてる",
      "translation": "너와 끌어안고 있어"
    },
    {
      "id": 21,
      "start": 77.661,
      "end": 80.597,
      "rubyText": "解[と]けてくようにすり抜[ぬ]けてくように",
      "translation": "풀려가듯이 빠져나가듯이"
    },
    {
      "id": 22,
      "start": 80.597,
      "end": 83.6,
      "rubyText": "つまらない未[み]来[らい]はこの手[て]品[じな]で",
      "translation": "시시한 미래는 이 마술로"
    },
    {
      "id": 23,
      "start": 83.834,
      "end": 86.67,
      "rubyText": "変[か]えちゃうからどうか君[きみ]が笑[わら]えるように",
      "translation": "바꿔버릴 테니까 부디 네가 웃을 수 있도록"
    },
    {
      "id": 24,
      "start": 86.67,
      "end": 89.64,
      "rubyText": "鮮[あざ]やかな記[き]憶[おく]で幕[まく]を閉[と]じたい",
      "translation": "선명한 기억으로 막을 내리고 싶어"
    },
    {
      "id": 25,
      "start": 90.374,
      "end": 91.575,
      "rubyText": "しっかりしんどくて",
      "translation": "꽤나 힘들어서"
    },
    {
      "id": 26,
      "start": 91.675,
      "end": 93.177,
      "rubyText": "俯[うつむ]いてきた過[か]去[こ]も",
      "translation": "고개 숙여왔던 과거도"
    },
    {
      "id": 27,
      "start": 93.243,
      "end": 96.48,
      "rubyText": "嘘[うそ]じゃないままギュッて赦[ゆる]せるように",
      "translation": "거짓이 아닌 채로 꽉 용서할 수 있도록"
    },
    {
      "id": 28,
      "start": 96.647,
      "end": 100.184,
      "rubyText": "種[たね]も仕[し]掛[かけ]もないはずの心[こころ]の欠[かけ]片[ら]",
      "translation": "속임수도 장치도 없을 터인 마음의 조각"
    },
    {
      "id": 29,
      "start": 100.184,
      "end": 102.953,
      "rubyText": "探[さが]す旅[たび]に出[で]るハートのJ",
      "translation": "찾으러 떠나는 여행 하트의 J"
    },
    {
      "id": 30,
      "start": 116.2,
      "end": 121.839,
      "rubyText": "ゆっくり過[す]ぎてく日[にち]常[じょう]にほどける",
      "translation": "천천히 지나가는 일상에 스며들어"
    },
    {
      "id": 31,
      "start": 122.506,
      "end": 125.075,
      "rubyText": "最[さい]後[ご]は笑[わら]えるような種[たね]を明[あ]かして",
      "translation": "마지막은 웃을수 있는 비밀을 밝히고"
    },
    {
      "id": 32,
