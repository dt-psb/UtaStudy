{
  "id": "kisara-fuyubare-step",
  "title": "冬晴れステップ (Fuyubare Step)",
  "artist": "きさら feat. 初音ミク",
  "youtubeId": "BupJ_OLUBMw",
  "thumbnail": "https://img.youtube.com/vi/BupJ_OLUBMw/hqdefault.jpg",
  "duration": 164,
  "lyrics": [
    {
      "id": 1,
      "start": 0.83,
      "end": 3.43,
      "rubyText": "ほら、やっぱ今日[きょう]だよ",
      "translation": "봐, 역시 오늘이야",
      "romaji": "hora, yappa kyou da yo"
    },
    {
      "id": 2,
      "start": 3.43,
      "end": 7.07,
      "rubyText": "今[いま]すぐ飛[と]び出[だ]して 支度[したく]しなきゃ",
      "translation": "지금 당장 뛰쳐나가 준비해야 해",
      "romaji": "ima sugu tobidashite shitaku shinakya"
    },
    {
      "id": 3,
      "start": 7.07,
      "end": 9.27,
      "rubyText": "お日様[ひさま]は待[ま]ってくれない",
      "translation": "햇님은 기다려주지 않아",
      "romaji": "ohisama wa matte kurenai"
    },
    {
      "id": 4,
      "start": 9.27,
      "end": 12.34,
      "rubyText": "すべてのクラウドを払[はら]い飛[と]ばして",
      "translation": "모든 구름(클라우드)을 털어 날려 보내고",
      "romaji": "subete no kuraudo o haraitobashite"
    },
    {
      "id": 5,
      "start": 12.34,
      "end": 17.12,
      "rubyText": "冬空[ふゆぞら]の天使[てんし]たちも 今[いま]は羽[はね]を休[やす]めてる",
      "translation": "겨울 하늘의 천사들도 지금은 날개를 쉬게 하고 있어",
      "romaji": "fuyuzora no tenshitachi mo ima wa hane o yasumeteru"
    },
    {
      "id": 6,
      "start": 17.12,
      "end": 22.09,
      "rubyText": "そうだ 凪[な]いだこのカーテンの向[む]こう側[がわ]",
      "translation": "그래, 잠잠해진 이 커튼 너머에서",
      "romaji": "sou da naida kono kaaten no mukougawa"
    },
    {
      "id": 7,
      "start": 22.09,
      "end": 28.94,
      "rubyText": "光[ひかり]に呼[よ]ばれる",
      "translation": "빛이 나를 부르고 있어",
      "romaji": "hikari ni yobareru"
    },
    {
      "id": 8,
      "start": 31.35,
      "end": 34.39,
      "rubyText": "待[ま]ちわびた青[あお]に きらめくスノータウン",
      "translation": "애타게 기다리던 푸르름에 반짝이는 스노우 타운",
      "romaji": "machiwabita ao ni kirameku sunootaun"
    },
    {
      "id": 9,
      "start": 34.39,
      "end": 39.08,
      "rubyText": "何[なに]かがきっと待[ま]ってるような",
      "translation": "무언가가 분명 기다리고 있을 것만 같은",
      "romaji": "nanika ga kitto matte iru you na"
    },
    {
      "id": 10,
      "start": 39.08,
      "end": 42.0,
      "rubyText": "ときめきが心[こころ]をほどいて",
      "translation": "설렘이 마음을 풀어주며",
      "romaji": "tokimeki ga kokoro o hodoite"
    },
    {
      "id": 11,
      "start": 42.0,
      "end": 44.85,
      "rubyText": "寒[さむ]くてもね 平気[へいき]だよ",
      "translation": "춥더라도 괜찮아",
      "romaji": "samukutemo ne heiki da yo"
    },
    {
      "id": 12,
      "start": 44.85,
      "end": 47.63,
      "rubyText": "今日[きょう]だけは特別[とくべつ]",
      "translation": "오늘만큼은 특별하니까",
      "romaji": "kyou dake wa tokubetsu"
    },
    {
      "id": 13,
      "start": 47.63,
      "end": 52.52,
      "rubyText": "だってこんなに声[こえ]が高[たか]く響[ひび]くから",
      "translation": "이렇게나 노랫소리가 높게 울려 퍼지니까",
      "romaji": "datte konna ni koe ga takaku hibiku kara"
    },
    {
      "id": 14,
      "start": 53.56,
      "end": 57.61,
      "rubyText": "カラフルな街[まち] 縁取[ふちど]った白[しろ]まぶしくて",
      "translation": "알록달록한 거리를 테두리 두른 하얀빛이 눈부셔서",
      "romaji": "karafuru na machi fuchidotta shiro mabushikute"
    },
    {
      "id": 15,
      "start": 57.61,
      "end": 60.0,
      "rubyText": "心[こころ]はずむメロディー",
      "translation": "가슴 뛰는 멜로디",
      "romaji": "kokoro hazumu merodii"
    },
    {
      "id": 16,
      "start": 60.0,
      "end": 63.86,
      "rubyText": "はなうたも景色[けしき]に咲[さ]くみたい",
      "translation": "콧노래도 풍경 속에 피어나는 것 같아",
      "romaji": "hanauta mo keshiki ni saku mitai"
    },
    {
      "id": 17,
      "start": 64.61,
      "end": 67.79,
      "rubyText": "飛[と]び込[こ]んでくる彩[いろど]られたパッケージ",
      "translation": "눈앞에 뛰어드는 다채롭게 물든 패키지",
      "romaji": "tobikonde kuru irodorareta pakkeeji"
    },
    {
      "id": 18,
      "start": 67.79,
      "end": 70.33,
      "rubyText": "今[いま]ならば見[み]つけられる",
      "translation": "지금이라면 찾아낼 수 있어",
      "romaji": "ima naraba mitsukerareru"
    },
    {
      "id": 19,
      "start": 70.33,
      "end": 73.28,
      "rubyText": "照[て]らし出[だ]された世界[せかい]のたからもの",
      "translation": "환하게 비춰진 세상의 보물들을",
      "romaji": "terashidasareta sekai no takaramono"
    },
    {
      "id": 20,
      "start": 96.05,
      "end": 101.56,
      "rubyText": "アマテラスも今日[きょう]はご機嫌[きげん]みたいね",
      "translation": "아마테라스(태양신)도 오늘은 기분이 좋은가 봐",
      "romaji": "amaterasu mo kyou wa gokigen mitai ne"
    },
    {
      "id": 21,
      "start": 101.56,
      "end": 106.19,
      "rubyText": "吸[す]い込[こ]んだ冬[ふゆ]が私[わたし]を満[み]たすの",
      "translation": "들이마신 겨울이 나를 가득 채워",
      "romaji": "suikonda fuyu ga watashi o mitasu no"
    },
    {
      "id": 22,
      "start": 106.19,
      "end": 109.28,
      "rubyText": "青一色[あおいっしょく] 一面[いちめん]のキャンバス",
      "translation": "온통 푸른 한 빛깔, 눈앞 가득한 캔버스",
      "romaji": "aoisshoku ichimen no kyanbasu"
    },
    {
      "id": 23,
      "start": 109.28,
      "end": 112.31,
      "rubyText": "取[と]り付[つ]ける飾[かざ]りはひとつだけ",
      "translation": "달아놓을 장식은 단 하나뿐",
      "romaji": "toritsukeru kazari wa hitotsu dake"
    },
    {
      "id": 24,
      "start": 112.31,
      "end": 117.53,
      "rubyText": "きらっと照[て]らしたら これでおしまい！",
      "translation": "반짝하고 비추어주면 이걸로 완성!",
      "romaji": "kiratto terashitara kore de oshimai!"
    },
    {
      "id": 25,
      "start": 118.17,
      "end": 120.9,
      "rubyText": "透[す]き通[とお]る青[あお]に きらめくスノータウン",
      "translation": "투명하게 갠 푸르름에 반짝이는 스노우 타운",
      "romaji": "sukitooru ao ni kirameku sunootaun"
    },
    {
      "id": 26,
      "start": 120.9,
      "end": 125.68,
      "rubyText": "いつかの思[おも]い出[で]だって動[うご]き出[だ]すような",
      "translation": "언젠가의 추억마저 다시 움직이기 시작할 것 같은",
      "romaji": "itsuka no omoide datte ugokidasu you na"
    },
    {
      "id": 27,
      "start": 125.68,
      "end": 128.45,
      "rubyText": "ときめきが心[こころ]をほどいて",
      "translation": "설렘이 마음을 풀어주며",
      "romaji": "tokimeki ga kokoro o hodoite"
    },
    {
      "id": 28,
      "start": 128.45,
      "end": 131.34,
      "rubyText": "寒[さむ]くてもね 平気[へいき]だよ",
      "translation": "춥더라도 괜찮아",
      "romaji": "samukutemo ne heiki da yo"
    },
    {
      "id": 29,
      "start": 131.34,
      "end": 134.09,
      "rubyText": "今日[きょう]だけは特別[とくべつ]",
      "translation": "오늘만큼은 특별하니까",
      "romaji": "kyou dake wa tokubetsu"
    },
    {
      "id": 30,
      "start": 134.09,
      "end": 137.53,
      "rubyText": "だって見上[みあ]げるたびに歌[うた]いたくなって",
      "translation": "올려다볼 때마다 노래하고 싶어지는걸",
      "romaji": "datte miageru tabi ni utaitaku natte"
    },
    {
      "id": 31,
      "start": 137.53,
      "end": 140.4,
      "rubyText": "麗[うら]らか晴天[せいてん] 寒凪日和[かんなぎびより]",
      "translation": "화창한 맑은 하늘, 잔잔하고 따스한 겨울날",
      "romaji": "uraraka seiten kannagibiyori"
    },
    {
      "id": 32,
      "start": 140.4,
      "end": 144.5,
      "rubyText": "どこまでだって高[たか]く響[ひび]くから",
      "translation": "어디까지나 높게 울려 퍼질 테니까",
      "romaji": "doko made datte takaku hibiku kara"
    }
  ],
