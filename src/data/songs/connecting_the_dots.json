{
  "id": "souten-connecting-the-dots",
  "title": "connecting the dots",
  "artist": "蒼天のラピスラズリ feat. 初音ミク, IA",
  "youtubeId": "Kz9hfvwfFXk",
  "thumbnail": "https://img.youtube.com/vi/Kz9hfvwfFXk/hqdefault.jpg",
  "duration": 222,
  "lyrics": [
    {
      "id": 1,
      "start": 28.73,
      "end": 30.98,
      "rubyText": "あぁ思[おも]い出[で]は",
      "translation": "아아 추억은",
      "romaji": "aa omoide wa"
    },
    {
      "id": 2,
      "start": 31.08,
      "end": 34.3,
      "rubyText": "心[こころ]の奥[おく]深[ふか]くに追[お]いやって",
      "translation": "마음속 깊은 곳으로 몰아넣고",
      "romaji": "kokoro no okufukaku ni oiyatte"
    },
    {
      "id": 3,
      "start": 34.54,
      "end": 37.95,
      "rubyText": "誰[だれ]しもが取[と]り出[だ]さないように",
      "translation": "누구라도 꺼내지 않도록",
      "romaji": "dareshimo ga toridasanai you ni"
    },
    {
      "id": 4,
      "start": 37.98,
      "end": 40.58,
      "rubyText": "今[いま]を生[い]きているなんて",
      "translation": "지금을 살아가고 있다니",
      "romaji": "ima wo ikite iru nante"
    },
    {
      "id": 5,
      "start": 41.67,
      "end": 43.87,
      "rubyText": "幻[げん]想[そう]だろう？",
      "translation": "환상이잖아?",
      "romaji": "gensou darou?"
    },
    {
      "id": 6,
      "start": 43.87,
      "end": 48.0,
      "rubyText": "強[つよ]いフリをしているだけで",
      "translation": "강한 척을 하고 있을 뿐이면서",
      "romaji": "tsuyoi furi wo shite iru dake de"
    },
    {
      "id": 7,
      "start": 48.1,
      "end": 50.19,
      "rubyText": "そうだろう？",
      "translation": "그렇잖아?",
      "romaji": "sou darou?"
    },
    {
      "id": 8,
      "start": 50.25,
      "end": 54.0,
      "rubyText": "時[とき]に振[ふ]り返[かえ]ったっていいだろう…？",
      "translation": "때로는 뒤돌아본대도 괜찮잖아…?",
      "romaji": "toki ni furikaettatte ii darou...?"
    },
    {
      "id": 9,
      "start": 54.43,
      "end": 59.56,
      "rubyText": "もう一度[いちど]あの夏[なつ]を呼[よ]び覚[さ]ませ",
      "translation": "다시 한번 그 여름을 일깨워줘",
      "romaji": "mou ichido ano natsu wo yobisamase"
    },
    {
      "id": 10,
      "start": 59.77,
      "end": 66.99,
      "rubyText": "過去[かこ]は今[いま]、君[きみ]と未来[みらい]繋[つな]いでる道[みち]の兆[きざ]し",
      "translation": "과거는 지금, 너와 미래를 잇는 길의 전조",
      "romaji": "kako wa ima, kimi to mirai tsunaideru michi no kizashi"
    },
    {
      "id": 11,
      "start": 66.99,
      "end": 69.34,
      "rubyText": "I ain't say goodbye.",
      "translation": "작별은 말하지 않을 거야",
      "romaji": "I ain't say goodbye."
    },
    {
      "id": 12,
      "start": 69.4,
      "end": 72.51,
      "rubyText": "思[おも]い出[で]も抱[だ]きしめて",
      "translation": "추억마저 끌어안고",
      "romaji": "omoide mo dakishimete"
    },
    {
      "id": 13,
      "start": 72.56,
      "end": 75.67,
      "rubyText": "刹那[せつな]的[てき]日々[ひび]の",
      "translation": "찰나와 같은 나날의",
      "romaji": "setsunateki hibi no"
    },
    {
      "id": 14,
      "start": 75.67,
      "end": 76.89,
      "rubyText": "意味[いみ]を噛[か]み締[し]めて",
      "translation": "의미를 되새기며",
      "romaji": "imi wo kamishimete"
    },
    {
      "id": 15,
      "start": 76.89,
      "end": 79.42,
      "rubyText": "生[い]きてゆくから",
      "translation": "살아갈 테니까",
      "romaji": "ikite yuku kara"
    },
    {
      "id": 16,
      "start": 80.07,
      "end": 86.43,
      "rubyText": "I'm gonna do it. I mean it.",
      "translation": "난 해낼 거야, 진심이야",
      "romaji": "I'm gonna do it. I mean it."
    },
    {
      "id": 17,
      "start": 86.43,
      "end": 92.64,
      "rubyText": "I ain't gonna live forever.",
      "translation": "난 영원히 살 수는 없으니까",
      "romaji": "I ain't gonna live forever."
    },
    {
      "id": 18,
      "start": 92.9,
      "end": 105.19,
      "rubyText": "I just want to live while I'm alive.",
      "translation": "그저 살아 숨 쉬는 동안 온전히 살아가고 싶을 뿐이야",
      "romaji": "I just want to live while I'm alive."
    },
    {
      "id": 19,
