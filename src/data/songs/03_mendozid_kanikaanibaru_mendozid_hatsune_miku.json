  "lyrics": [
    {
      "id": 1,
      "start": 2.06,
      "end": 4.37,
      "rubyText": "楽[たの]しみましょうか海[うみ]のカーニバル",
      "translation": "즐겨봅시다 바다의 카니발",
      "romaji": "tanoshimimashoukaumino kaanibaru"
    },
    {
      "id": 2,
      "start": 4.53,
      "end": 15.01,
      "rubyText": "カニカーニバル",
      "translation": "카니카니발",
      "romaji": "kanikaanibaru"
    },
    {
      "id": 3,
      "start": 15.34,
      "end": 18.0,
      "rubyText": "深[ふか]い海[うみ]の中[なか]",
      "translation": "깊은 바닷속에서",
      "romaji": "fukaiuminonaka"
    },
    {
      "id": 4,
      "start": 18.0,
      "end": 20.66,
      "rubyText": "歩[ある]いていたカニ一匹[いっぴき]",
      "translation": "걷고 있던 게 한 마리",
      "romaji": "aruiteita kani ippiki"
    },
    {
      "id": 5,
      "start": 20.66,
      "end": 23.34,
      "rubyText": "貝殻[かいがら]の中[なか]で",
      "translation": "조개껍데기 속에서",
      "romaji": "kaigaranonakade"
    },
    {
      "id": 6,
      "start": 23.34,
      "end": 26.0,
      "rubyText": "友達[ともだち]に出会[であ]えました",
      "translation": "친구를 만났습니다",
      "romaji": "tomodachinideaemashita"
    },
    {
      "id": 7,
      "start": 26.0,
      "end": 28.64,
      "rubyText": "仲間[なかま]を探[さが]して",
      "translation": "동료를 찾아서",
      "romaji": "nakamawosagashite"
    },
    {
      "id": 8,
      "start": 28.64,
      "end": 31.34,
      "rubyText": "歩[ある]いていたカニ二匹[にひき]",
      "translation": "걷고 있던 게 두 마리",
      "romaji": "aruiteita kani nihiki"
    },
    {
      "id": 9,
      "start": 31.34,
      "end": 34.0,
      "rubyText": "海藻[かいそう]の中[なか]でも",
      "translation": "해초 안에서도",
      "romaji": "kaisounonakademo"
    },
    {
      "id": 10,
      "start": 34.0,
      "end": 36.66,
      "rubyText": "友達[ともだち]ができました",
      "translation": "친구가 생겼습니다",
      "romaji": "tomodachigadekimashita"
    },
    {
      "id": 11,
      "start": 36.66,
      "end": 39.04,
      "rubyText": "くるくる回[まわ]って踊[おど]ろうカニ",
      "translation": "빙글빙글 돌면서 춤추는 게",
      "romaji": "kurukurumawatteodorou kani"
    },
    {
      "id": 12,
      "start": 39.04,
      "end": 41.77,
      "rubyText": "ゆらゆら揺[ゆ]らいで踊[おど]ろうカニ",
      "translation": "흔들흔들 흔들리며 춤추는 게",
      "romaji": "yurayurayuraideodorou kani"
    },
    {
      "id": 13,
      "start": 41.77,
      "end": 44.99,
      "rubyText": "ふわふわ浮[う]かんで優雅[ゆうが]に踊[おど]ろうカニ",
      "translation": "둥실둥실 떠다니며 우아하게 춤추는 게",
      "romaji": "fuwafuwaukandeyuuganiodorou kani"
    },
    {
      "id": 14,
      "start": 45.9,
      "end": 47.19,
      "rubyText": "始[はじ]めましょう!",
      "translation": "시작해보자!",
      "romaji": "hajimemashou!"
    },
    {
      "id": 15,
      "start": 47.19,
      "end": 49.64,
      "rubyText": "カニカーニバル カニカーニバル",
      "translation": "카니카니발 카니카니발",
      "romaji": "kanikaanibaru kanikaanibaru"
    },
    {
      "id": 16,
      "start": 49.96,
      "end": 52.48,
      "rubyText": "タコさんもエビさんも一緒[いっしょ]に踊[おど]ろう",
      "translation": "문어 씨도 새우 씨도 같이 춤추자",
      "romaji": "tako sanmo ebi sanmoisshoniodorou"
    },
    {
      "id": 17,
      "start": 52.48,
      "end": 55.32,
      "rubyText": "つまらない日々[ひび]もぎこちない日々[ひび]も",
      "translation": "시시한 날들도 서툰 날들도",
      "romaji": "tsumaranaihibimogikochinaihibimo"
    },
    {
      "id": 18,
      "start": 55.32,
      "end": 57.94,
      "rubyText": "全[すべ]て忘[わす]れてこの指[ゆび]止[と]まれ",
      "translation": "전부 잊어버리고 여기여기 모여라",
      "romaji": "subetewasuretekonoyubitomare"
    },
    {
      "id": 19,
      "start": 57.94,
      "end": 60.32,
      "rubyText": "カニカーニバル カニカーニバル",
      "translation": "카니카니발 카니카니발",
      "romaji": "kanikaanibaru kanikaanibaru"
    },
    {
      "id": 20,
      "start": 60.65,
      "end": 63.17,
      "rubyText": "ウニさんもクラゲさんも一緒[いっしょ]に歌[うた]おう",
      "translation": "성게 씨도 해파리 씨도 함께 노래하자",
      "romaji": "uni sanmo kurage sanmoisshoniutaou"
    },
    {
      "id": 21,
      "start": 63.17,
      "end": 65.9,
      "rubyText": "今日[きょう]も明日[あした]もみんなで楽[たの]しく",
      "translation": "오늘도 내일도 다같이 즐겁게",
      "romaji": "kyoumoashitamominnadetanoshiku"
    },
    {
      "id": 22,
      "start": 65.9,
      "end": 68.34,
      "rubyText": "踊[おど]りましょうカニカーニバル",
      "translation": "춤춰봅시다 카니카니발",
      "romaji": "odorimashou kanikaanibaru"
    },
    {
      "id": 23,
      "start": 68.66,
      "end": 79.0,
      "rubyText": "カニカーニバル",
      "translation": "카니카니발",
      "romaji": "kanikaanibaru"
    },
    {
      "id": 24,
      "start": 79.0,
      "end": 81.92,
      "rubyText": "広[ひろ]い海[うみ]の中[なか]",
      "translation": "드넓은 바닷속에서",
      "romaji": "hiroiuminonaka"
    },
    {
      "id": 25,
      "start": 81.92,
      "end": 84.64,
      "rubyText": "泳[およ]いでいたカニ三匹[さんびき]",
      "translation": "헤엄치고 있던 게 세 마리",
      "romaji": "oyoideita kani sanbiki"
    },
    {
      "id": 26,
      "start": 84.64,
      "end": 87.31,
      "rubyText": "海[うみ]のみんなと",
      "translation": "바다의 모두와",
      "romaji": "uminominnato"
    },
    {
      "id": 27,
      "start": 87.31,
      "end": 89.92,
      "rubyText": "友達[ともだち]になれました",
      "translation": "친구가 되었습니다",
      "romaji": "tomodachininaremashita"
    },
    {
      "id": 28,
      "start": 89.92,
      "end": 92.65,
      "rubyText": "暖[あたた]かい海辺[うみべ]で",
      "translation": "따스한 해변에서",
      "romaji": "atatakaiumibede"
    },
    {
      "id": 29,
      "start": 92.65,
      "end": 95.32,
      "rubyText": "遊[あそ]んでいたカニさんたち",
      "translation": "놀고 있던 게 씨들",
      "romaji": "asondeita kani santachi"
    },
    {
      "id": 30,
      "start": 95.32,
      "end": 97.95,
      "rubyText": "海[うみ]の外[そと]でも",
      "translation": "바다 밖에서도",
      "romaji": "uminosotodemo"
    },
    {
      "id": 31,
      "start": 97.95,
      "end": 100.63,
      "rubyText": "アイドルになれました",
      "translation": "아이돌이 되었습니다",
      "romaji": "aidoru ninaremashita"
    },
    {
      "id": 32,
      "start": 100.63,
      "end": 102.94,
      "rubyText": "にこにこ笑[わら]って歌[うた]おうカニ",
      "translation": "싱글벙글 웃으며 노래하는 게",
      "romaji": "nikonikowaratteutaou kani"
    },
    {
      "id": 33,
      "start": 102.94,
      "end": 105.7,
      "rubyText": "わくわく楽[たの]しく歌[うた]おうカニ",
      "translation": "두근두근 즐겁게 노래하는 게",
      "romaji": "wakuwakutanoshikuutaou kani"
    },
    {
      "id": 34,
      "start": 105.7,
      "end": 109.0,
      "rubyText": "きらきらきらめいて共[とも]に歌[うた]おうカニ",
      "translation": "반짝반짝 반짝이며 함께 노래하는 게",
      "romaji": "kirakirakirameitetomoniutaou kani"
    },
    {
      "id": 35,
      "start": 109.93,
      "end": 111.33,
      "rubyText": "始[はじ]めましょう！",
      "translation": "시작해보자!",
      "romaji": "hajimemashou!"
    },
    {
      "id": 36,
      "start": 111.33,
      "end": 114.09,
      "rubyText": "カニカーニバル カニカーニバル",
      "translation": "카니카니발 카니카니발",
      "romaji": "kanikaanibaru kanikaanibaru"
    },
    {
      "id": 37,
      "start": 114.09,
      "end": 116.9,
      "rubyText": "海[うみ]でも空[そら]でも歌[うた]いたい",
      "translation": "바다에서도 하늘에서도 노래하고 싶어",
      "romaji": "umidemosorademoutaitai"
    },
    {
      "id": 38,
      "start": 116.9,
      "end": 119.35,
      "rubyText": "胸[むね]に輝[かがや]く宝物[たからもの]たちは",
      "translation": "가슴에 반짝이는 보물들은",
      "romaji": "munenikagayakutakaramonotachiha"
    },
    {
      "id": 39,
      "start": 119.35,
      "end": 121.95,
      "rubyText": "夢[ゆめ]への道[みち]しるべだから",
      "translation": "꿈으로 향하는 이정표니까",
      "romaji": "yumehenomichishirubedakara"
    },
    {
      "id": 40,
      "start": 121.95,
      "end": 124.68,
      "rubyText": "カニカーニバル カニカーニバル",
      "translation": "카니카니발 카니카니발",
      "romaji": "kanikaanibaru kanikaanibaru"
    },
    {
      "id": 41,
      "start": 124.68,
      "end": 127.49,
      "rubyText": "海[うみ]の向[む]こうでも踊[おど]りたい",
      "translation": "바다 건너에서도 춤추고 싶어",
      "romaji": "uminomukoudemoodoritai"
    },
    {
      "id": 42,
      "start": 127.49,
      "end": 129.8,
      "rubyText": "夢[ゆめ]の向[む]こう憧[あこが]れの先[さき]へ",
      "translation": "꿈의 건너편 동경의 너머로",
      "romaji": "yumenomukouakogarenosakihe"
    },
    {
      "id": 43,
      "start": 129.8,
      "end": 132.49,
      "rubyText": "精一杯[せいいっぱい]走[はし]り抜[ぬ]けよう!",
      "translation": "있는 힘껏 달려나가자!",
      "romaji": "seiippaihashirinukeyou!"
    },
    {
      "id": 44,
      "start": 132.51,
      "end": 135.29,
      "rubyText": "カニカーニバル カニカーニバル",
      "translation": "카니카니발 카니카니발",
      "romaji": "kanikaanibaru kanikaanibaru"
    },
    {
      "id": 45,
      "start": 135.29,
      "end": 137.91,
      "rubyText": "クジラさんもイルカさんも一緒[いっしょ]に踊[おど]ろう",
      "translation": "고래 씨도 돌고래 씨도 같이 춤추자",
      "romaji": "kujira sanmo iruka sanmoisshoniodorou"
    },
    {
      "id": 46,
      "start": 137.91,
      "end": 140.66,
      "rubyText": "油断[ゆだん]したら波[なみ]にゆらゆらゆら",
      "translation": "방심한다면 파도에 둥실둥실둥실",
      "romaji": "yudanshitaranaminiyurayurayura"
    },
    {
      "id": 47,
      "start": 140.66,
      "end": 143.32,
      "rubyText": "流[なが]されるかもね もう一度[いちど]行[い]くね",
      "translation": "떠내려가면 어떡해 한번 더 간다",
      "romaji": "nagasarerukamone mouichidoikune"
    },
    {
      "id": 48,
      "start": 143.32,
      "end": 145.72,
      "rubyText": "カニカーニバル カニカーニバル",
      "translation": "카니카니발 카니카니발",
      "romaji": "kanikaanibaru kanikaanibaru"
    },
    {
      "id": 49,
