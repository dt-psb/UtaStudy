{
  "id": "usushioshisuu-boku-wa-sore-de-iinkai",
  "title": "ぼくはそれで委員会!",
  "artist": "薄塩指数 ft. 重音テトSV",
  "youtubeId": "fReNcRnVnS8",
  "lyrics": [
    {
      "id": 1,
      "start": 9.512,
      "end": 13.604,
      "rubyText": "全然[ぜんぜん] 期待[きたい]した通[とお]りにゃいかないもんだな",
      "translation": "전혀 기대한 대로 되진 않네"
    },
    {
      "id": 2,
      "start": 13.604,
      "end": 15.747,
      "rubyText": "せっかく稼[かせ]いだマネーも",
      "translation": "겨우 번 돈도"
    },
    {
      "id": 3,
      "start": 15.747,
      "end": 19.568,
      "rubyText": "物価[ぶっか]が高[たか]けーし 円[えん]安[やす]やべーしさ",
      "translation": "물가는 비싸고 엔화는 약세고"
    },
    {
      "id": 4,
      "start": 20.069,
      "end": 22.48,
      "rubyText": "せいぜいもっとモテるって思[おも]っていたんだが",
      "translation": "좀 더 인기가 많을 줄 알았는데"
    },
    {
      "id": 5,
      "start": 22.48,
      "end": 25.466,
      "rubyText": "んなこたねえ",
      "translation": "그런 건 없었지"
    },
    {
      "id": 6,
      "start": 25.466,
      "end": 29.702,
      "rubyText": "そういう問題[もんだい]じゃないって教[おし]えといてくれ！",
      "translation": "그런 문제가 아니라고 알려줘!"
    },
    {
      "id": 7,
      "start": 29.702,
      "end": 32.937,
      "rubyText": "結論[けつろん] 今日[きょう]生[い]きてりゃ楽[たの]しい（楽[たの]しい）",
      "translation": "결론은 오늘 살아 있으면 즐거워(즐거워)"
    },
    {
      "id": 8,
      "start": 32.937,
      "end": 35.696,
      "rubyText": "明日[あした]死[し]ぬと悲[かな]しい（悲[かな]しい）",
      "translation": "내일 죽으면 슬퍼(슬퍼)"
    },
    {
      "id": 9,
      "start": 35.696,
      "end": 37.89,
      "rubyText": "100年[ねん]後[ご]にはいない（いない）",
      "translation": "년 후엔 없을 테니(없을 테니)"
    },
    {
      "id": 10,
      "start": 37.89,
      "end": 41.155,
      "rubyText": "ぼくはそれでいいんかい！？",
      "translation": "내가 그걸로 괜찮은 걸까!?"
    },
    {
      "id": 11,
      "start": 46.368,
      "end": 50.679,
      "rubyText": "一生[いっしょう] 大業[たいぎょう]を成[な]せる予定[よてい]もないから",
      "translation": "평생 큰일을 이룰 예정도 없으니"
    },
    {
      "id": 12,
      "start": 50.679,
      "end": 54.055,
      "rubyText": "明日[あした]あたり駅[えき]前[まえ]で野垂[のた]れ死[じ]んだって",
      "translation": "내일쯤 역 앞에서 쓰러져 죽어도"
    },
    {
      "id": 13,
      "start": 54.055,
      "end": 56.89,
      "rubyText": "そんなには悔[く]いはない",
      "translation": "그렇게 후회는 없을 거야"
    },
    {
      "id": 14,
      "start": 57.066,
      "end": 59.288,
      "rubyText": "せいぜいもっとやれるって思[おも]っていたんだが",
      "translation": "좀 더 잘할 줄 알았는데"
    },
    {
      "id": 15,
      "start": 59.288,
      "end": 62.319,
      "rubyText": "そうでもねえ",
      "translation": "그렇지도 않네"
    },
    {
      "id": 16,
      "start": 62.319,
      "end": 66.14,
      "rubyText": "「勉強[べんきょう]して働[はたら]け」って言[い]い聞[き]かしてくれ！",
      "translation": "\"공부하고 일해라\"라고 말해줘!"
    },
    {
      "id": 17,
      "start": 66.523,
      "end": 69.997,
      "rubyText": "結論[けつろん] 今日[きょう]笑[わら]えてればいい（いい）",
      "translation": "결론은 오늘 웃을 수 있으면 돼(돼)"
    },
    {
      "id": 18,
      "start": 69.997,
      "end": 72.592,
      "rubyText": "明日[あした]泣[な]いててもいい（いい）",
      "translation": "내일 울어도 괜찮아(괜찮아)"
    },
    {
      "id": 19,
      "start": 72.592,
      "end": 74.725,
      "rubyText": "10年[ねん]後[ご] 何[なに]もない（ない）",
      "translation": "년 후엔 아무것도 없으니(없으니)"
    },
    {
      "id": 20,
      "start": 74.725,
      "end": 77.888,
      "rubyText": "ぼくはそれでいいんかい！？",
      "translation": "내가 그걸로 괜찮은 걸까!?"
    },
    {
      "id": 21,
      "start": 77.888,
      "end": 80.4,
      "rubyText": "僕[ぼく]が笑[わら]えればいい（いい）",
      "translation": "내가 웃을 수 있으면 돼(돼)"
    },
    {
      "id": 22,
      "start": 80.4,
      "end": 83.148,
      "rubyText": "誰[だれ]を泣[な]かせてもいい（いい）",
      "translation": "누군가를 울려도 괜찮아(괜찮아)"
    },
    {
      "id": 23,
      "start": 83.148,
      "end": 85.441,
      "rubyText": "どうせ死[し]ぬときはひとり（ひとり）",
      "translation": "어차피 죽을 땐 혼자(혼자)"
    },
    {
      "id": 24,
      "start": 85.441,
      "end": 88.648,
      "rubyText": "ほんとうにそう思[おも]うかい！？",
      "translation": "정말로 그렇게 생각해!?"
    },
    {
      "id": 25,
      "start": 88.648,
      "end": 91.35,
      "rubyText": "幸福[こうふく]でさえも疑[うたが]ってかからなきゃ",
      "translation": "행복조차도 의심하고"
    },
    {
      "id": 26,
      "start": 91.35,
      "end": 93.955,
      "rubyText": "自分[じぶん]じゃねえ、って",
      "translation": "그러지 않으면 내 자신이 아냐, 라고"
    },
    {
      "id": 27,
      "start": 93.955,
      "end": 97.775,
      "rubyText": "ほんとうにそう望[のぞ]んでるかい！？",
      "translation": "정말로 그렇게 바라니!?"
    },
    {
