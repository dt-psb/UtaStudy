  "lyrics": [
    {
      "id": 1,
      "start": 0.0,
      "end": 5.799,
      "rubyText": "僕[ぼく]らの最後[さいご]は死別[しべつ]にしよう",
      "translation": "우리의 마지막은 사별인 걸로 하자"
    },
    {
      "id": 2,
      "start": 5.954,
      "end": 11.106,
      "rubyText": "嫌[きら]いになりそうな日差[ひざ]しの中[なか]",
      "translation": "싫어질 것만 같은 햇살 속"
    },
    {
      "id": 3,
      "start": 11.261,
      "end": 16.208,
      "rubyText": "どれほど固[かた]く耳[みみ]を塞[ふさ]ごう",
      "translation": "아무리 단단히 귀를 막아도"
    },
    {
      "id": 4,
      "start": 16.324,
      "end": 21.825,
      "rubyText": "他人事[ひとごと]みたいね蝉[せみ]は時雨[しぐれ]",
      "translation": "남 일 같네 매미는 울어대"
    },
    {
      "id": 5,
      "start": 23.143,
      "end": 28.509,
      "rubyText": "君[きみ]が早[はや]く死[し]んでよかったな",
      "translation": "네가 빨리 죽어서 다행이야"
    },
    {
      "id": 6,
      "start": 28.509,
      "end": 33.875,
      "rubyText": "君[きみ]が早[はや]く死[し]んでよかったな",
      "translation": "네가 빨리 죽어서 다행이야"
    },
    {
      "id": 7,
      "start": 33.991,
      "end": 38.348,
      "rubyText": "君[きみ]と見[み]た蝉[せみ]たちや",
      "translation": "너와 함께 본 매미들이나"
    },
    {
      "id": 8,
      "start": 38.484,
      "end": 44.023,
      "rubyText": "君[きみ]と過[す]ごした夏[なつ]が",
      "translation": "너와 함께 보낸 여름이"
    },
    {
      "id": 9,
      "start": 45.25,
      "end": 50.089,
      "rubyText": "腐[くさ]り落[お]ちてしまう前[まえ]にさ",
      "translation": "썩어 떨어져 버리기 전에 말이야"
    },
    {
      "id": 10,
      "start": 50.089,
      "end": 55.59,
      "rubyText": "さよなら夏[なつ]、君[きみ]との思[おも]い出[で]",
      "translation": "안녕 여름, 너와의 추억"
    },
    {
      "id": 11,
      "start": 62.25,
      "end": 67.125,
      "rubyText": "僕[ぼく]らの最後[さいご]は死別[しべつ]にしよう",
      "translation": "우리의 마지막은 사별인 걸로 하자"
    },
    {
      "id": 12,
      "start": 67.125,
      "end": 72.102,
      "rubyText": "嫌[きら]いになるなら尚更[なおさら]だね",
      "translation": "싫어진다면 더더욱 그래야지"
    },
    {
      "id": 13,
      "start": 72.102,
      "end": 77.378,
      "rubyText": "どれほど終[お]わりを待[ま]ち望[のぞ]もう",
      "translation": "아무리 마지막을 진심으로 바래도"
    },
    {
      "id": 14,
      "start": 77.514,
      "end": 82.693,
      "rubyText": "抜[ぬ]け殻[がら]みたいな夏[なつ]は長[なが]く",
      "translation": "빈껍데기 같은 여름은 길게"
    },
    {
      "id": 15,
      "start": 82.828,
      "end": 87.728,
      "rubyText": "果[は]てしなく長[なが]く",
      "translation": "끝없이 길게"
    },
    {
      "id": 16,
      "start": 89.821,
      "end": 95.098,
      "rubyText": "君[きみ]が早[はや]く死[し]んでよかったな",
