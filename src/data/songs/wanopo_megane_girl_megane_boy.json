{
  "id": "wanopo_megane_girl_megane_boy",
  "title": "MEGANE GIRL MEGANE BOY",
  "artist": "WONDERFUL★OPPORTUNITY! feat. 鏡音リン・鏡音レン",
  "youtubeId": "la6_f-oUFHE",
  "duration": 155,
  "lyrics": [
    {
      "id": 1,
      "start": 1.22,
      "end": 3.12,
      "rubyText": "おニューのメガネだね?",
      "romaji": "onyuu no megane da ne?",
      "translation": "새 안경이네?"
    },
    {
      "id": 2,
      "start": 3.9,
      "end": 6.17,
      "rubyText": "アタシは漫画[まんが]できてる",
      "romaji": "atashi wa manga de kiteru",
      "translation": "난 만화로 이루어져 있어"
    },
    {
      "id": 3,
      "start": 6.17,
      "end": 8.88,
      "rubyText": "いいすぎじゃない　過言[かごん]ではない",
      "romaji": "iisugi janai kagon dewa nai",
      "translation": "과언이 아냐, 지나친 말이 아니야"
    },
    {
      "id": 4,
      "start": 8.88,
      "end": 11.78,
      "rubyText": "朝[あさ]から晩[ばん]までにらめっこです",
      "romaji": "asa kara ban made niramekko desu",
      "translation": "아침부터 밤까지 눈싸움이에요"
    },
    {
      "id": 5,
      "start": 11.78,
      "end": 14.65,
      "rubyText": "むちゅむちゅ夢中[むちゅう]　ごりむちゅ夢中[むちゅう]",
      "romaji": "muchu muchu muchuu gori muchu muchuu",
      "translation": "푹 빠져서 무아지경, 오리무중 열중"
    },
    {
      "id": 6,
      "start": 14.65,
      "end": 17.35,
      "rubyText": "マジ　待[ま]って　あっちいけ　ばか",
      "romaji": "maji matte acchi ike baka",
      "translation": "진짜 잠깐 저리 가 바보야"
    },
    {
      "id": 7,
      "start": 17.35,
      "end": 20.28,
      "rubyText": "クソエイム　よっしゃ　おつですわ",
      "romaji": "kuso eimu yossha otsu desu wa",
      "translation": "똥에임, 나이스 수고하셨어요"
    },
    {
      "id": 8,
      "start": 20.28,
      "end": 22.28,
      "rubyText": "ラグいって　うっそ　しんだ〜",
      "romaji": "ragui tte usso shinda~",
      "translation": "렉 걸렸다고, 거짓말 나 죽었어~"
    },
    {
      "id": 9,
      "start": 22.28,
      "end": 25.12,
      "rubyText": "むちゅむちゅ夢中[むちゅう]　ごりむちゅ夢中[むちゅう]",
      "romaji": "muchu muchu muchuu gori muchu muchuu",
      "translation": "푹 빠져서 무아지경, 오리무중 열중"
    },
    {
      "id": 10,
      "start": 25.12,
      "end": 27.75,
      "rubyText": "勉強[べんきょう]も恋愛[れんあい]もそっちのけ",
      "romaji": "benkyou mo ren'ai mo socchinoke",
      "translation": "공부도 연애도 뒷전"
    },
    {
      "id": 11,
      "start": 27.75,
      "end": 30.62,
      "rubyText": "先生[せんせい]　アタシは落[お]ちこぼれですか?",
      "romaji": "sensei atashi wa ochikobore desu ka?",
      "translation": "선생님 전 낙오자인가요?"
    },
    {
      "id": 12,
      "start": 30.62,
      "end": 33.28,
      "rubyText": "まんがのせいとか…関係[かんけい]ぬぁぁい！",
      "romaji": "manga no sei toka... kankei nwaaai!",
      "translation": "만화 탓이라니… 상관없으으으으음!"
    },
    {
      "id": 13,
      "start": 33.28,
      "end": 35.82,
      "rubyText": "MEGANE GIRL MEGANE BOY",
      "romaji": "MEGANE GIRL MEGANE BOY",
      "translation": "MEGANE GIRL MEGANE BOY"
    },
    {
      "id": 14,
      "start": 35.82,
      "end": 37.32,
      "rubyText": "なにか問題[もんだい]でも?",
      "romaji": "nanika mondai demo?",
      "translation": "무슨 문제라도?"
    },
    {
      "id": 15,
      "start": 37.32,
      "end": 38.52,
      "rubyText": "ない！ない！ない！",
      "romaji": "nai! nai! nai!",
      "translation": "없어! 없어! 없어!"
    },
    {
      "id": 16,
      "start": 38.52,
      "end": 41.25,
      "rubyText": "両目[りょうめ]酷使[こくし]　現代社会[げんだいしゃかい]",
      "romaji": "ryoume kokushi gendai shakai",
      "translation": "양 눈을 혹사하는 현대 사회"
    },
    {
      "id": 17,
      "start": 41.25,
      "end": 43.28,
      "rubyText": "コンタクトはオレ無理[むり]ですあたし",
      "romaji": "kontakuto wa ore muri desu atashi",
      "translation": "렌즈는 난 무리예요 나도"
    },
    {
      "id": 18,
      "start": 43.28,
      "end": 46.42,
      "rubyText": "漫画[まんが]のとりこ",
      "romaji": "manga no toriko",
      "translation": "만화의 포로"
    },
    {
      "id": 19,
      "start": 46.42,
      "end": 48.95,
      "rubyText": "インドアの申[もう]し子[ご]",
      "romaji": "indoa no moushigo",
      "translation": "집돌이 집순이의 표상"
    },
    {
      "id": 20,
      "start": 48.95,
      "end": 51.78,
      "rubyText": "おやつはポテチ　気分[きぶん]は上々[じょうじょう]",
      "romaji": "oyatsu wa potechi kibun wa joujou",
      "translation": "간식은 포테이토칩 기분은 최고조"
    },
    {
      "id": 21,
      "start": 51.78,
      "end": 54.78,
      "rubyText": "宿題[しゅくだい]なんてものはなかったのだ！",
      "romaji": "shukudai nante mono wa nakatta no da!",
      "translation": "숙제 같은 건 없었던 거야!"
    },
    {
      "id": 22,
      "start": 54.78,
      "end": 58.58,
      "rubyText": "自分[じぶん]を信[しん]じぬくクエストが",
      "romaji": "jibun o shinjinuku kuesto ga",
      "translation": "나 자신을 끝까지 믿는 퀘스트가"
    },
    {
      "id": 23,
      "start": 58.58,
      "end": 59.92,
      "rubyText": "進行中[しんこうちゅう]ぅ〜",
      "romaji": "shinkouchuuu~",
      "translation": "진행 중우우~"
    },
    {
      "id": 24,
      "start": 59.92,
      "end": 62.38,
      "rubyText": "上[あ]がるハピネス",
      "romaji": "agaru hapinesu",
      "translation": "올라가는 행복도"
    },
    {
      "id": 25,
      "start": 62.38,
      "end": 65.08,
      "rubyText": "下[さ]がる視力[しりょく]",
      "romaji": "sagaru shiryoku",
      "translation": "떨어지는 시력"
    },
    {
      "id": 26,
      "start": 65.08,
      "end": 67.68,
      "rubyText": "おニューのメガネだね",
      "romaji": "onyuu no megane da ne",
      "translation": "새 안경이네"
    },
    {
      "id": 27,
      "start": 67.68,
      "end": 70.48,
      "rubyText": "それなかなかよき　なかなかよき",
      "romaji": "sore nakanaka yoki nakanaka yoki",
      "translation": "그거 제법 괜찮네, 꽤 좋네"
    },
    {
      "id": 28,
      "start": 71.75,
      "end": 75.87,
      "rubyText": "オレはゲームを愛[あい]しとる　いいすぎじゃない",
      "romaji": "ore wa geemu o aishitoru iisugi janai",
      "translation": "난 게임을 사랑해, 과한 말이 아냐"
    },
    {
      "id": 29,
      "start": 75.87,
      "end": 79.67,
      "rubyText": "むしろゲームがオレのこと愛[あい]しとるのかもな〜",
      "romaji": "mushiro geemu ga ore no koto aishitoru no kamo naa~",
      "translation": "오히려 게임이 날 사랑하고 있는 걸지도 몰라~"
    },
    {
      "id": 30,
      "start": 79.67,
      "end": 81.99,
      "rubyText": "ってってあほちゃうかな〜　あほちゃう?",
      "romaji": "tte tte aho chau ka naa~ aho chau?",
      "translation": "라니 바보 아닐까나~ 바보 아냐?"
    },
    {
      "id": 31,
      "start": 81.99,
      "end": 82.55,
      "rubyText": "手厳[てきび]し",
      "romaji": "tekibishi",
      "translation": "인정사정없네"
    },
    {
      "id": 32,
      "start": 82.55,
      "end": 85.43,
      "rubyText": "新刊[しんかん]? あれ? これ持[も]ってた?",
      "romaji": "shinkan? are? kore motteta?",
      "translation": "신간? 어라? 이거 갖고 있었나?"
    },
    {
      "id": 33,
      "start": 85.43,
      "end": 87.28,
      "rubyText": "やっちまった　二冊目[にさつめ]?",
      "romaji": "yacchimatta nisatsume?",
      "translation": "저질러버렸다, 두 권째?"
    },
    {
      "id": 34,
      "start": 87.28,
      "end": 88.05,
      "rubyText": "またかよ〜",
      "romaji": "mata ka yo~",
      "translation": "또냐고~"
    },
    {
      "id": 35,
      "start": 88.05,
      "end": 92.35,
      "rubyText": "本屋[ほんや]さんの漫画[まんが]ゾーンに永住希望[えいじゅうきぼう]！　永住希望[えいじゅうきぼう]！",
      "romaji": "hon'ya-san no manga zoon ni eijuu kibou! eijuu kibou!",
      "translation": "서점의 만화 코너에 영주 희망! 영주 희망!"
    },
    {
      "id": 36,
      "start": 92.35,
      "end": 93.28,
      "rubyText": "どぞ〜",
      "romaji": "dozo~",
      "translation": "어서 오세요~"
    },
    {
      "id": 37,
      "start": 93.28,
      "end": 95.82,
      "rubyText": "教科書[きょうかしょ]どおりじゃ頭打[あたまう]ち?",
      "romaji": "kyoukasho doori ja atamauchi?",
      "translation": "교과서대로는 한계에 부딪혔나?"
    },
    {
      "id": 38,
      "start": 95.82,
      "end": 98.62,
      "rubyText": "先生[せんせい]　オレってできそこないですか?",
      "romaji": "sensei ore tte dekisokonai desu ka?",
      "translation": "선생님 저 못난이인가요?"
    },
    {
      "id": 39,
      "start": 98.62,
      "end": 101.35,
      "rubyText": "ゲームのせいとか…関係[かんけい]ぬぁぁい！",
      "romaji": "geemu no sei toka... kankei nwaaai!",
      "translation": "게임 탓이라니… 상관없으으으으음!"
    },
    {
      "id": 40,
      "start": 101.35,
      "end": 103.88,
      "rubyText": "MEGANE GIRL MEGANE BOY",
      "romaji": "MEGANE GIRL MEGANE BOY",
      "translation": "MEGANE GIRL MEGANE BOY"
    },
    {
      "id": 41,
      "start": 103.88,
      "end": 105.44,
      "rubyText": "なにか問題[もんだい]でも?",
      "romaji": "nanika mondai demo?",
      "translation": "무슨 문제라도?"
    },
    {
      "id": 42,
      "start": 105.44,
      "end": 106.67,
      "rubyText": "ない！ない！ない！",
      "romaji": "nai! nai! nai!",
      "translation": "없어! 없어! 없어!"
    },
    {
      "id": 43,
      "start": 106.67,
      "end": 109.32,
      "rubyText": "両目[りょうめ]酷使[こくし]　現代社会[げんだいしゃかい]",
      "romaji": "ryoume kokushi gendai shakai",
      "translation": "양 눈을 혹사하는 현대 사회"
    },
    {
      "id": 44,
      "start": 109.32,
      "end": 111.38,
      "rubyText": "メスはいれないルールですっ",
      "romaji": "mesu wa irenai ruuru desu'",
      "translation": "수술칼은 대지 않는 게 규칙이에요!"
    },
    {
      "id": 45,
      "start": 111.38,
      "end": 114.38,
      "rubyText": "オレはゲームの虜[とりこ]",
      "romaji": "ore wa geemu no toriko",
      "translation": "난 게임의 포로"
    },
    {
      "id": 46,
      "start": 114.38,
      "end": 117.16,
      "rubyText": "インドアの申[もう]し子[ご]",
      "romaji": "indoa no moushigo",
      "translation": "집돌이 집순이의 표상"
    },
    {
      "id": 47,
      "start": 117.16,
      "end": 119.83,
      "rubyText": "炭酸[たんさん]がぶ飲[の]み　燃料満[ねんりょうまん]タン",
      "romaji": "tansan gabunomi nenryou mantan",
      "translation": "탄산 벌컥벌컥 들이켜고 연료 가득 충전"
    },
    {
      "id": 48,
      "start": 119.83,
      "end": 122.88,
      "rubyText": "めんどいから彼女[かのじょ]なんてつくらねえし",
      "romaji": "mendoi kara kanojo nante tsukuranee shi",
      "translation": "귀찮으니까 여자친구 따윈 안 사귈 거고"
    },
    {
      "id": 49,
      "start": 122.88,
      "end": 126.55,
      "rubyText": "我[わ]が道[みち]をゆくキャラたちが",
      "romaji": "waga michi o yuku kyara-tachi ga",
      "translation": "마이웨이를 가는 캐릭터들이"
    },
    {
      "id": 50,
      "start": 126.55,
      "end": 127.92,
      "rubyText": "降臨中[こうりんちゅう]ぅ〜",
      "romaji": "kourinchuuu~",
      "translation": "강림 중우우~"
    },
    {
      "id": 51,
      "start": 127.92,
      "end": 130.35,
      "rubyText": "上[あ]がるハピネス",
      "romaji": "agaru hapinesu",
      "translation": "올라가는 행복도"
    },
    {
      "id": 52,
      "start": 130.35,
      "end": 133.02,
      "rubyText": "下[さ]がる視力[しりょく]",
      "romaji": "sagaru shiryoku",
      "translation": "떨어지는 시력"
    },
    {
      "id": 53,
      "start": 133.02,
      "end": 135.65,
      "rubyText": "おニューのメガネだね",
      "romaji": "onyuu no megane da ne",
      "translation": "새 안경이네"
    },
    {
      "id": 54,
      "start": 135.65,
      "end": 138.38,
      "rubyText": "それなかなかよき　なかなかよき",
      "romaji": "sore nakanaka yoki nakanaka yoki",
      "translation": "그거 제법 괜찮네, 꽤 좋네"
    },
    {
      "id": 55,
      "start": 138.38,
      "end": 141.25,
      "rubyText": "さぁ！好[す]きな武器[えもの]手[て]にとり",
      "romaji": "saa! suki na emono te ni tori",
      "translation": "자! 좋아하는 무기를 손에 쥐고"
    },
    {
      "id": 56,
      "start": 141.25,
      "end": 143.95,
      "rubyText": "サバイブせよ　エンジョイしまくって",
      "romaji": "sabaibu seyo enjoi shimakutte",
      "translation": "살아남아라, 마음껏 즐기면서"
    },
    {
      "id": 57,
      "start": 143.95,
      "end": 146.45,
      "rubyText": "おニューのメガネだね",
      "romaji": "onyuu no megane da ne",
      "translation": "새 안경이네"
    },
    {
      "id": 58,
      "start": 146.45,
      "end": 149.69,
      "rubyText": "それなかなかよき　なかなかよき",
      "romaji": "sore nakanaka yoki nakanaka yoki",
      "translation": "그거 제법 괜찮네, 꽤 좋네"
    }
  ],
