  "lyrics": [
    {
      "id": 1,
      "startTime": 12.062,
      "endTime": 15.399,
      "text": "月[つき]の裏側[うらがわ] お餅[もち]ついてる",
      "translation": "달의 뒷면에서 떡방아를 찧고 있어",
      "start": 12.062,
      "end": 15.399,
      "rubyText": "月[つき]の裏側[うらがわ] お餅[もち]ついてる"
    },
    {
      "id": 2,
      "startTime": 15.399,
      "endTime": 19.47,
      "text": "まだ眠[ねむ]いままの うさぎは待[ま]っている",
      "translation": "아직 꾸벅꾸벅 졸면서 토끼는 기다리고 있어",
      "start": 15.399,
      "end": 19.47,
      "rubyText": "まだ眠[ねむ]いままの うさぎは待[ま]っている"
    },
    {
      "id": 3,
      "startTime": 19.47,
      "endTime": 22.84,
      "text": "夜[よる]にぴょんぴょんの時[とき]が やってくるのを",
      "translation": "밤에 깡총깡총 뛸 시간이 오기를",
      "start": 19.47,
      "end": 22.84,
      "rubyText": "夜[よる]にぴょんぴょんの時[とき]が やってくるのを"
    },
    {
      "id": 4,
      "startTime": 22.84,
      "endTime": 26.31,
      "text": "夢[ゆめ]の向[む]こうで 星[ほし]が昇[のぼ]って",
      "translation": "꿈의 저편에서 별이 떠오르고",
      "start": 22.84,
      "end": 26.31,
      "rubyText": "夢[ゆめ]の向[む]こうで 星[ほし]が昇[のぼ]って"
    },
    {
      "id": 5,
      "startTime": 26.31,
      "endTime": 28.512,
      "text": "まだ淡[あわ]いままの 心[こころ]が跳[は]ねたら",
      "translation": "아직 수줍은 마음이 깡총 뛴다면",
      "start": 26.31,
      "end": 28.512,
      "rubyText": "まだ淡[あわ]いままの 心[こころ]が跳[は]ねたら"
    },
    {
      "id": 6,
      "startTime": 28.512,
      "endTime": 33.65,
      "text": "今日[きょう]のぴょんぴょんの舞[まい]を 覚[おぼ]えていてね",
      "translation": "오늘의 깡총깡총 춤을 기억해 줘",
      "start": 28.512,
      "end": 33.65,
      "rubyText": "今日[きょう]のぴょんぴょんの舞[まい]を 覚[おぼ]えていてね"
    },
    {
      "id": 7,
      "startTime": 34.218,
      "endTime": 36.353,
      "text": "ぽつん落[お]ちる 言葉[ことば]みたい",
      "translation": "뚝 떨어지는 말 같아",
      "start": 34.218,
      "end": 36.353,
      "rubyText": "ぽつん落[お]ちる 言葉[ことば]みたい"
    },
    {
      "id": 8,
      "startTime": 36.353,
      "endTime": 38.255,
      "text": "そしていま踊[おど]るからね",
      "translation": "그리고 지금 춤출 테니까",
      "start": 36.353,
      "end": 38.255,
      "rubyText": "そしていま踊[おど]るからね"
    },
    {
      "id": 9,
      "startTime": 38.255,
      "endTime": 38.922,
      "text": "せーのっ",
      "translation": "하나, 둘",
      "start": 38.255,
      "end": 38.922,
      "rubyText": "せーのっ"
    },
    {
      "id": 10,
      "startTime": 38.922,
      "endTime": 40.824,
