  "youtubeId": "kRTcFyjvUtE",
  "lyrics": [
    {
      "id": 1,
      "start": 0.866,
      "end": 2.533,
      "rubyText": "いつもちょっとだけ背伸[せの]びして",
      "translation": "항상 조금만 발돋움하며"
    },
    {
      "id": 2,
      "start": 2.533,
      "end": 4.533,
      "rubyText": "いつかは空[そら]に届[とど]くかもって",
      "translation": "언젠가는 하늘에 닿을지도 모른다고 생각했어"
    },
    {
      "id": 3,
      "start": 4.533,
      "end": 6.2,
      "rubyText": "夢見[ゆめみ]てたトキメキは",
      "translation": "꿈에 그리던 설렘은"
    },
    {
      "id": 4,
      "start": 6.2,
      "end": 8.166,
      "rubyText": "ただの理想[りそう]でしかなくて",
      "translation": "그저 이상일 뿐이었어"
    },
    {
      "id": 5,
      "start": 8.166,
      "end": 10.1,
      "rubyText": "人生[じんせい]はキャンディじゃない",
      "translation": "인생은 사탕이 아니야"
    },
    {
      "id": 6,
      "start": 10.1,
      "end": 12.066,
      "rubyText": "愛情[あいじょう]は無料[むりょう]じゃない",
      "translation": "애정은 공짜가 아니야"
    },
    {
      "id": 7,
      "start": 12.066,
      "end": 13.933,
      "rubyText": "「苦[にが]いお薬[くすり]ほど良[い]いんだ」って",
      "translation": "「쓴 약일수록 좋다」는 말은"
    },
    {
      "id": 8,
      "start": 13.933,
      "end": 15.333,
      "rubyText": "ホントなの？",
      "translation": "정말인 거야?"
    },
    {
      "id": 9,
      "start": 15.333,
      "end": 15.866,
      "rubyText": "ねえ",
      "translation": "저기"
    },
    {
      "id": 10,
      "start": 15.866,
      "end": 17.166,
      "rubyText": "甘[あま]いだけのポップじゃ",
      "translation": "달콤하기만 한 팝으로는"
    },
    {
      "id": 11,
      "start": 17.166,
      "end": 19.1,
      "rubyText": "もう信[しん]じられないわ",
      "translation": "이제 믿을 수 없어"
    },
    {
      "id": 12,
      "start": 19.1,
      "end": 21.233,
      "rubyText": "綺麗事[きれいごと]並[なら]べたケーキは",
      "translation": "예쁜 것만 늘어놓은 케이크는"
    },
    {
      "id": 13,
      "start": 21.233,
      "end": 23.133,
      "rubyText": "怪[あや]しくて買[か]えないわ",
      "translation": "수상해서 살 수 없어"
    },
    {
      "id": 14,
      "start": 23.133,
      "end": 24.966,
      "rubyText": "だって 素直[すなお]なだけの言葉[ことば]じゃ",
      "translation": "하지만 솔직하기만 한 말로는"
    },
    {
      "id": 15,
      "start": 24.966,
      "end": 26.733,
      "rubyText": "振[ふ]り向[む]いてあげないわ",
      "translation": "돌아봐 주지 않아"
    },
    {
      "id": 16,
      "start": 26.733,
      "end": 28.666,
      "rubyText": "貴方[あなた]の目[め]に映[うつ]るのは",
      "translation": "당신의 눈에 비치는 것은"
    },
    {
      "id": 17,
      "start": 28.666,
      "end": 30.833,
      "rubyText": "私[わたし]であってほしいのよ",
      "translation": "나였으면 좋겠는걸"
    },
    {
      "id": 18,
      "start": 45.766,
      "end": 47.433,
      "rubyText": "「好[す]き」って言葉[ことば]のモノサシが",
      "translation": "「좋아해」라는 말의 기준이"
    },
    {
      "id": 19,
      "start": 47.433,
      "end": 49.433,
      "rubyText": "「好[す]き」って想[おも]いのベクトルが",
      "translation": "「좋아해」라는 마음의 방향이"
    },
    {
      "id": 20,
      "start": 49.433,
      "end": 50.966,
      "rubyText": "私[わたし]と貴方[あなた]じゃ違[ちが]うもの",
      "translation": "나와 당신은 달라"
    },
    {
      "id": 21,
      "start": 50.966,
      "end": 53.333,
      "rubyText": "もっとオトナな恋[こい]がしたいんだもん",
      "translation": "좀 더 어른스러운 사랑을 하고 싶은 걸"
    },
    {
      "id": 22,
      "start": 53.333,
      "end": 55.1,
      "rubyText": "牛乳[ぎゅうにゅう]だけじゃ背[せ]は伸[の]びないし",
      "translation": "우유만으로는 키가 자라지 않고"
    },
    {
      "id": 23,
      "start": 55.1,
      "end": 57.1,
      "rubyText": "わたあめだけじゃ空[そら]は飛[と]べないし",
      "translation": "솜사탕만으로는 하늘을 날 수 없고"
    },
    {
      "id": 24,
      "start": 57.1,
      "end": 58.966,
      "rubyText": "甘[あま]えてるだけじゃ飽[あ]きられちゃうの",
      "translation": "응석만 부리면 싫증 나버릴 거야"
    },
    {
      "id": 25,
      "start": 58.966,
      "end": 60.4,
      "rubyText": "分[わ]かってるけど……",
      "translation": "알고 있지만……"
    },
    {
      "id": 26,
      "start": 60.4,
      "end": 60.833,
      "rubyText": "だって",
      "translation": "그치만"
    },
    {
      "id": 27,
      "start": 60.833,
      "end": 62.5,
      "rubyText": "ワガママばっかり言[い]っても",
      "translation": "제멋대로 굴어도"
    },
    {
      "id": 28,
      "start": 62.5,
      "end": 64.5,
      "rubyText": "笑[わら]って聞[き]いてくれるでしょ",
      "translation": "웃으며 들어주잖아"
    },
    {
      "id": 29,
      "start": 64.5,
      "end": 66.033,
      "rubyText": "気[き]を引[ひ]きたいだけポーズも",
      "translation": "관심 끌고 싶어서 취하는 행동도"
    },
    {
      "id": 30,
      "start": 66.033,
