      "romaji": "nante yatteraren na"
    },
    {
      "id": 3,
      "start": 12.62,
      "end": 15.68,
      "rubyText": "Hey Normie　Hey Normie",
      "translation": "Hey Normie　Hey Normie",
      "romaji": "Hey Normie Hey Normie"
    },
    {
      "id": 4,
      "start": 15.85,
      "end": 17.35,
      "rubyText": "大言[たいげん]吐[は]いていたって",
