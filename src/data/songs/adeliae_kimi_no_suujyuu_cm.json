{
  "id": "adeliae_kimi_no_suujyuu_cm",
  "title": "君の数十センチ下の世界",
  "artist": "Adeliae feat. 可不",
  "youtubeId": "fFuj6p2tcIs",
  "lyrics": [
    {
      "id": 1,
      "start": 2.39,
      "end": 6.15,
      "rubyText": "ただ横[よこ]になるつもりが",
      "translation": "그저 누울 생각이었는데"
    },
    {
      "id": 2,
      "start": 6.15,
      "end": 9.15,
      "rubyText": "眠[ねむ]り込[こ]んだようだ",
      "translation": "잠들어 버린 것 같아"
    },
    {
      "id": 3,
      "start": 9.15,
      "end": 11.95,
      "rubyText": "覚[おぼ]えのない毛布[もうふ]と",
      "translation": "기억에 없는 담요와"
    },
    {
      "id": 4,
      "start": 11.95,
      "end": 14.78,
      "rubyText": "魚[さかな]を焼[や]く匂[にお]い",
      "translation": "생선을 굽는 냄새"
    },
    {
      "id": 5,
      "start": 14.78,
      "end": 18.1,
      "rubyText": "オレンジがかる風景[ふうけい]",
      "translation": "주황빛으로 물드는 풍경"
    },
    {
      "id": 6,
      "start": 18.1,
      "end": 21.06,
      "rubyText": "ちょっとしょげこめば",
      "translation": "조금 기가 죽어 있으면"
    },
    {
      "id": 7,
      "start": 21.06,
      "end": 24.23,
      "rubyText": "「また明日[あした]もあるから」ってさ",
      "translation": "「내일도 또 있으니까」라며"
    },
    {
      "id": 8,
      "start": 29.93,
      "end": 36.15,
      "rubyText": "大長編[だいちょうへん]の映画[えいが] まるで見[み]てたようだ",
      "translation": "대장편 영화를 마치 보고 있었던 것 같아"
    },
    {
      "id": 9,
      "start": 36.15,
      "end": 42.16,
      "rubyText": "瞳[ひとみ]を真[ま]ん丸[まる]にして 覗[のぞ]き込[こ]む君[きみ]",
      "translation": "눈동자를 동그랗게 뜨고 들여다보는 너"
    },
    {
      "id": 10,
      "start": 42.16,
      "end": 45.16,
      "rubyText": "欠伸[あくび]で誤魔化[ごまか]して",
      "translation": "하품으로 얼버무리고"
    },
    {
      "id": 11,
      "start": 45.16,
      "end": 48.17,
      "rubyText": "そっぽ向[む]き笑[わら]った",
      "translation": "딴청 피우며 웃었어"
    },
    {
      "id": 12,
      "start": 48.17,
      "end": 53.92,
      "rubyText": "何[なん]でもない夜[よる]がまた今日[きょう]も更[ふ]けてく",
      "translation": "아무것도 아닌 밤이 또 오늘도 깊어가"
    },
    {
      "id": 13,
      "start": 53.92,
      "end": 56.69,
      "rubyText": "Ah Ah",
      "translation": "Ah Ah"
    },
    {
      "id": 14,
      "start": 56.69,
      "end": 61.05,
      "rubyText": "見返[みかえ]りないものだけ、ばっか",
      "translation": "바라는 것 없는 것들만, 가득"
    },
    {
      "id": 15,
      "start": 61.05,
      "end": 65.31,
      "rubyText": "だからこそちゃんと返[かえ]せてるかな",
      "translation": "그렇기에 제대로 보답하고 있는 걸까"
    },
    {
      "id": 16,
      "start": 65.31,
      "end": 68.83,
      "rubyText": "僕[ぼく]はさ ちゃんと覚[おぼ]えてる",
      "translation": "난 말이야 제대로 기억하고 있어"
    },
    {
      "id": 17,
      "start": 68.83,
      "end": 71.15,
      "rubyText": "もらった分[ぶん]だけ",
      "translation": "받은 만큼 전부"
    },
    {
      "id": 18,
      "start": 71.15,
      "end": 72.72,
      "rubyText": "でも無力[むりょく]でさ",
      "translation": "하지만 무력해서 말야"
    },
    {
      "id": 19,
      "start": 72.72,
      "end": 77.43,
      "rubyText": "それが枯[か]れぬよう 願[ねが]っているだけ",
      "translation": "그것이 시들지 않기를 바라고 있을 뿐이야"
    },
    {
      "id": 20,
      "start": 77.43,
      "end": 84.13,
      "rubyText": "だけども 言葉[ことば]に出[だ]すとさ こそばゆいから",
      "translation": "그렇지만 입 밖으로 내어 말하면 쑥스러우니까"
    },
    {
      "id": 21,
      "start": 84.13,
      "end": 86.76,
      "rubyText": "せめて忘[わす]れないように",
      "translation": "적어도 잊지 않도록"
    },
    {
      "id": 22,
      "start": 86.76,
      "end": 91.0,
      "rubyText": "今日[きょう]も生[い]きてる",
      "translation": "오늘도 살아가고 있어"
    },
    {
      "id": 23,
      "start": 100.78,
      "end": 107.13,
      "rubyText": "今[いま]も夢[ゆめ]で襲[おそ]い来[く]るんだ",
      "translation": "지금도 꿈속에서 덮쳐오는 거야"
    },
    {
      "id": 24,
      "start": 107.13,
      "end": 113.0,
      "rubyText": "一人[ひとり] 雨[あめ]に濡[ぬ]れる夜[よる]が",
      "translation": "홀로 비에 젖던 밤이"
    },
    {
      "id": 25,
      "start": 113.0,
      "end": 117.88,
      "rubyText": "震[ふる]える肩[かた] 抱[だ]き上[あ]げてくれて",
      "translation": "떨리는 어깨를 안아 올려주고"
    },
    {
      "id": 26,
      "start": 117.88,
      "end": 124.61,
      "rubyText": "そして今日[きょう]も いつもありがとう",
      "translation": "그리고 오늘도 언제나 고마워"
    },
    {
      "id": 27,
      "start": 124.97,
      "end": 130.91,
      "rubyText": "おはよう 今朝[けさ]は僕[ぼく]が先[さき]に起[お]きたようだ",
      "translation": "안녕 좋은 아침, 오늘 아침은 내가 먼저 일어난 것 같네"
    },
    {
      "id": 28,
      "start": 130.91,
      "end": 137.21,
      "rubyText": "澄[す]み切[き]った空気[くうき]と ミントのような匂[にお]い",
      "translation": "맑게 갠 공기와 민트 같은 냄새"
    },
    {
      "id": 29,
      "start": 137.21,
      "end": 139.89,
      "rubyText": "話[はな]せなくはないが",
      "translation": "말하지 못할 건 없지만"
    },
    {
      "id": 30,
      "start": 139.89,
      "end": 143.12,
      "rubyText": "やっぱり言[い]わずいようか",
      "translation": "역시 말하지 않고 있을까"
    },
    {
      "id": 31,
      "start": 143.12,
      "end": 148.58,
      "rubyText": "そのうち 遠[とお]い場所[ばしょ]へまた旅[たび]に出[で]ること",
      "translation": "머지않아 머나먼 곳으로 다시 여행을 떠난다는 걸"
    },
    {
      "id": 32,
      "start": 148.58,
      "end": 151.44,
      "rubyText": "Ah Ah",
      "translation": "Ah Ah"
    },
    {
      "id": 33,
      "start": 151.44,
      "end": 156.1,
      "rubyText": "また 出会[であ]えるのなら",
      "translation": "다시 만날 수 있다면"
    },
    {
      "id": 34,
      "start": 156.1,
      "end": 160.1,
      "rubyText": "やっぱ君[きみ]のちょっと下[した]で笑[わら]ってたいかな",
      "translation": "역시 너의 조금 아래에서 웃고 있고 싶으려나"
    },
    {
      "id": 35,
      "start": 160.1,
      "end": 163.7,
      "rubyText": "僕[ぼく]はさ ちゃんと見[み]えている",
      "translation": "난 말야 똑똑히 보이고 있어"
    },
    {
      "id": 36,
      "start": 163.7,
      "end": 166.13,
      "rubyText": "何処[どこ]へ行[い]っても",
      "translation": "어디로 가든"
    },
    {
      "id": 37,
      "start": 166.13,
      "end": 172.43,
      "rubyText": "君[きみ]が歩[ある]く少[すこ]しだけ先[さき]を歩[ある]いていくだけ",
      "translation": "네가 걸어가는 조금 앞을 걸어가고 있을 뿐이야"
    },
    {
      "id": 38,
      "start": 172.43,
      "end": 179.08,
      "rubyText": "「それ」がさ 明日[あした]であっても そうじゃなくても",
      "translation": "「그 날」이 내일이든 그렇지 않든 간에"
    },
    {
      "id": 39,
      "start": 179.08,
      "end": 181.9,
      "rubyText": "せめて忘[わす]れないように",
      "translation": "적어도 잊지 않도록"
    },
    {
      "id": 40,
      "start": 181.9,
      "end": 185.11,
      "rubyText": "一[ひと]つも失[な]くさないように",
      "translation": "하나도 잃어버리지 않도록"
    },
    {
      "id": 41,
      "start": 185.11,
      "end": 187.66,
      "rubyText": "僕[ぼく]が僕[ぼく]であるように",
      "translation": "내가 나일 수 있도록"
    },
    {
      "id": 42,
      "start": 187.66,
      "end": 193.9,
      "rubyText": "今日[きょう]を生[い]きてる",
      "translation": "오늘을 살아가고 있어"
    }
  ],
