{
  "id": "mimi-yawaraku-hodoite",
  "title": "『 柔く、ほどいて 』",
  "artist": "MIMI feat. 初音ミク＆重音テトSV",
  "romaji": "Yawaraku, Hodoite",
  "englishTitle": "Yawaraku, Hodoite",
  "youtubeId": "-2FCAZLhh-Y",
  "category": "VOCALOID",
  "language": "ja",
  "releaseDate": "2026-02-10",
  "lyrics": [
    {
      "id": 1,
      "startTime": 14.4,
      "endTime": 16.7,
      "text": "風船[ふうせん]みたいな",
      "translation": "풍선 같은",
      "start": 14.4,
      "end": 16.7,
      "rubyText": "風船[ふうせん]みたいな"
    },
    {
      "id": 2,
      "startTime": 17.366,
      "endTime": 19.833,
      "text": "心[こころ]は今夜[こんや]もゆらゆらり",
      "translation": "마음은 오늘 밤도 흔들흔들",
      "start": 17.366,
      "end": 19.833,
      "rubyText": "心[こころ]は今夜[こんや]もゆらゆらり"
    },
    {
      "id": 3,
      "startTime": 20.766,
      "endTime": 24.533,
      "text": "誰[だれ]にも触[ふ]れられないままのつぼみ達[たち]",
      "translation": "누구에게도 닿지 못한 꽃봉오리들처럼",
      "start": 20.766,
      "end": 24.533,
      "rubyText": "誰[だれ]にも触[ふ]れられないままのつぼみ達[たち]"
    },
    {
      "id": 4,
      "startTime": 24.666,
      "endTime": 26.9,
      "text": "私[わたし]はひとりぼっち",
      "translation": "나는 외톨이",
      "start": 24.666,
      "end": 26.9,
      "rubyText": "私[わたし]はひとりぼっち"
    },
    {
      "id": 5,
      "startTime": 28.433,
      "endTime": 29.933,
      "text": "溶[と]けかけの",
      "translation": "녹아가는",
      "start": 28.433,
      "end": 29.933,
      "rubyText": "溶[と]けかけの"
    },
    {
      "id": 6,
      "startTime": 30.166,
      "endTime": 31.866,
      "text": "口付[くちづ]けで誰[だれ]か",
      "translation": "입맞춤으로 누군가",
      "start": 30.166,
      "end": 31.866,
      "rubyText": "口付[くちづ]けで誰[だれ]か"
    },
    {
      "id": 7,
      "startTime": 31.866,
      "endTime": 33.9,
      "text": "目[め]を 覚[さ]まして",
      "translation": "눈을 뜨게 해줘",
      "start": 31.866,
      "end": 33.9,
      "rubyText": "目[め]を 覚[さ]まして"
    },
    {
      "id": 8,
      "startTime": 34.933,
      "endTime": 36.8,
      "text": "ドアの向[む]こうに置[お]いた想[おも]い",
      "translation": "문 저편에 두고 온 마음",
      "start": 34.933,
      "end": 36.8,
      "rubyText": "ドアの向[む]こうに置[お]いた想[おも]い"
    },
    {
      "id": 9,
      "startTime": 36.8,
      "endTime": 38.633,
      "text": "指先[ゆびさき]が震[ふる]えてる",
      "translation": "손끝이 떨리고 있어",
      "start": 36.8,
      "end": 38.633,
      "rubyText": "指先[ゆびさき]が震[ふる]えてる"
    },
    {
      "id": 10,
      "startTime": 38.633,
      "endTime": 40.633,
      "text": "言葉[ことば]じゃ解[ほど]けない",
      "translation": "말로는 풀리지 않아",
      "start": 38.633,
      "end": 40.633,
      "rubyText": "言葉[ことば]じゃ解[ほど]けない"
    },
    {
      "id": 11,
      "startTime": 41.3,
      "endTime": 45.2,
      "text": "瞬[まばた]きの理由[りゆう]さえも薬[くすり]の果[は]て",
      "translation": "눈 깜빡이는 이유조차 약의 끝",
      "start": 41.3,
      "end": 45.2,
      "rubyText": "瞬[まばた]きの理由[りゆう]さえも薬[くすり]の果[は]て"
    },
    {
      "id": 12,
      "startTime": 45.2,
      "endTime": 47.4,
      "text": "嘘[うそ]つきな朝[あさ]の前[まえ]",
      "translation": "거짓말 같은 아침 앞에서",
      "start": 45.2,
      "end": 47.4,
      "rubyText": "嘘[うそ]つきな朝[あさ]の前[まえ]"
    },
    {
      "id": 13,
      "startTime": 48.866,
      "endTime": 50.5,
      "text": "握[にぎ]った手[て]の中[なか]の孤独[こどく]",
      "translation": "꽉 쥔 손 안의 고독",
      "start": 48.866,
      "end": 50.5,
      "rubyText": "握[にぎ]った手[て]の中[なか]の孤独[こどく]"
    },
    {
      "id": 14,
      "startTime": 50.5,
      "endTime": 52.3,
      "text": "月明[つきあ]かりの冷[つめ]たい願[ねが]い",
      "translation": "달빛의 차가운 소원",
      "start": 50.5,
      "end": 52.3,
      "rubyText": "月明[つきあ]かりの冷[つめ]たい願[ねが]い"
    },
    {
      "id": 15,
      "startTime": 52.3,
      "endTime": 54.3,
      "text": "ふわふわな寂[さび]しさ",
      "translation": "둥실거리는 외로움",
      "start": 52.3,
      "end": 54.3,
      "rubyText": "ふわふわな寂[さび]しさ"
    },
    {
      "id": 16,
      "startTime": 55.033,
      "endTime": 58.8,
      "text": "優[やさ]しい光[ひかり]に眠[ねむ]れぬシンデレラ",
      "translation": "상냥한 빛에 잠들지 못하는 신데렐라",
      "start": 55.033,
      "end": 58.8,
      "rubyText": "優[やさ]しい光[ひかり]に眠[ねむ]れぬシンデレラ"
    },
    {
      "id": 17,
      "startTime": 58.866,
      "endTime": 61.4,
      "text": "ただ柔[やわ]く解[ほど]いてよ",
      "translation": "그저 부드럽게 풀어줘",
      "start": 58.866,
      "end": 61.4,
      "rubyText": "ただ柔[やわ]く解[ほど]いてよ"
    },
    {
      "id": 18,
      "startTime": 89.733,
      "endTime": 92.266,
      "text": "感情[かんじょう]のウィスパー",
      "translation": "감정의 속삭임이",
      "start": 89.733,
      "end": 92.266,
      "rubyText": "感情[かんじょう]のウィスパー"
    },
    {
      "id": 19,
      "startTime": 92.733,
      "endTime": 93.7,
      "text": "ボイスが",
      "translation": "독일까 라며",
      "start": 92.733,
      "end": 93.7,
      "rubyText": "ボイスが"
    },
    {
      "id": 20,
      "startTime": 93.7,
      "endTime": 95.2,
      "text": "ザワザワ靡[なび]いている",
      "translation": "독일까 라며, 웅성웅성 흔들리고 있어",
      "start": 93.7,
      "end": 95.2,
      "rubyText": "ザワザワ靡[なび]いている"
    },
    {
      "id": 21,
      "startTime": 96.233,
      "endTime": 98.666,
      "text": "大人[おとな]になれない綻[ほころ]びも",
      "translation": "어른이 되지 못한 허물마저",
      "start": 96.233,
      "end": 98.666,
      "rubyText": "大人[おとな]になれない綻[ほころ]びも"
    },
    {
      "id": 22,
      "startTime": 98.666,
      "endTime": 100.066,
      "text": "ほろ苦[にが]い",
      "translation": "씁쓸해",
      "start": 98.666,
      "end": 100.066,
      "rubyText": "ほろ苦[にが]い"
    },
    {
      "id": 23,
      "startTime": 100.066,
      "endTime": 102.366,
      "text": "そしたら2人[ふたり]ぼっち",
      "translation": "그러면 둘만 남은 외톨이",
      "start": 100.066,
      "end": 102.366,
      "rubyText": "そしたら2人[ふたり]ぼっち"
    },
    {
      "id": 24,
      "startTime": 103.866,
      "endTime": 105.3,
      "text": "夢[ゆめ]の続[つづ]き",
      "translation": "꿈의 이어짐,",
      "start": 103.866,
      "end": 105.3,
      "rubyText": "夢[ゆめ]の続[つづ]き"
    },
    {
      "id": 25,
      "startTime": 105.633,
      "endTime": 109.366,
      "text": "信[しん]じる淡[あわ]い心模様[こころもよう]",
      "translation": "믿고 있는 희미한 마음의 무늬",
      "start": 105.633,
      "end": 109.366,
      "rubyText": "信[しん]じる淡[あわ]い心模様[こころもよう]"
    },
    {
      "id": 26,
      "startTime": 110.533,
      "endTime": 112.166,
      "text": "褒[ほ]められた日[ひ]は眠[ねむ]れない",
      "translation": "칭찬받은 날은 잠들 수 없어",
      "start": 110.533,
      "end": 112.166,
      "rubyText": "褒[ほ]められた日[ひ]は眠[ねむ]れない"
    },
    {
      "id": 27,
      "startTime": 112.166,
      "endTime": 114.0,
      "text": "期待[きたい]されるのが怖[こわ]くて",
      "translation": "기대받는 게 두려워서",
      "start": 112.166,
      "end": 114.0,
      "rubyText": "期待[きたい]されるのが怖[こわ]くて"
    },
    {
      "id": 28,
      "startTime": 114.0,
      "endTime": 116.0,
      "text": "数字[すうじ]じゃ解[ほど]けない",
      "translation": "숫자로는 풀 수 없어",
      "start": 114.0,
      "end": 116.0,
      "rubyText": "数字[すうじ]じゃ解[ほど]けない"
    },
    {
      "id": 29,
      "startTime": 116.766,
      "endTime": 120.566,
      "text": "息[いき]を吸[す]う時間[じかん]2つも薬瓶[くすりびん]",
      "translation": "숨 쉬는 시간조차 약병",
      "start": 116.766,
      "end": 120.566,
      "rubyText": "息[いき]を吸[す]う時間[じかん]2つも薬瓶[くすりびん]"
    },
    {
      "id": 30,
      "startTime": 120.6,
      "endTime": 122.966,
      "text": "それでも信[しん]じたくて",
      "translation": "그래도 믿고 싶어서",
      "start": 120.6,
      "end": 122.966,
      "rubyText": "それでも信[しん]じたくて"
    },
    {
      "id": 31,
      "startTime": 124.3,
      "endTime": 125.866,
      "text": "ねぇ 愛[あい]ってホントはなんなの",
      "translation": "있지, 사랑이란 건 대체 뭘까",
      "start": 124.3,
      "end": 125.866,
      "rubyText": "ねぇ 愛[あい]ってホントはなんなの"
    },
    {
      "id": 32,
      "startTime": 125.866,
      "endTime": 127.566,
      "text": "ねぇ 愛[あい]ってホントはなんなの",
      "translation": "응, 사랑이란 건 대체 뭘까?",
      "start": 125.866,
      "end": 127.566,
      "rubyText": "ねぇ 愛[あい]ってホントはなんなの"
    },
    {
      "id": 33,
      "startTime": 127.566,
      "endTime": 129.833,
      "text": "優[やさ]しい夜[よる]に問[と]うよ",
      "translation": "상냥한 밤에게 물어봐",
      "start": 127.566,
      "end": 129.833,
      "rubyText": "優[やさ]しい夜[よる]に問[と]うよ"
    },
    {
      "id": 34,
      "startTime": 130.4,
      "endTime": 134.466,
      "text": "震[ふる]えた心[こころ]に舞[ま]ったのおまじない",
      "translation": "떨리는 마음에 내려앉은 주문",
      "start": 130.4,
      "end": 134.466,
      "rubyText": "震[ふる]えた心[こころ]に舞[ま]ったのおまじない"
    },
    {
      "id": 35,
      "startTime": 134.466,
      "endTime": 136.933,
      "text": "ただ、柔[やわ]く解[ほど]けるの",
      "translation": "그저, 부드럽게 풀리는 걸",
      "start": 134.466,
      "end": 136.933,
      "rubyText": "ただ、柔[やわ]く解[ほど]けるの"
    },
    {
      "id": 36,
      "startTime": 137.5,
      "endTime": 139.666,
      "text": "誰[だれ]にも見[み]つからない温度[おんど]に",
      "translation": "누구에게도 들키지 않을 온도로",
      "start": 137.5,
      "end": 139.666,
      "rubyText": "誰[だれ]にも見[み]つからない温度[おんど]に"
    },
    {
      "id": 37,
      "startTime": 139.666,
      "endTime": 141.466,
      "text": "嗚呼[ああ] ノートに零[こぼ]れたキラメキ",
      "translation": "아아 노트에 쏟아진 반짝임",
      "start": 139.666,
      "end": 141.466,
      "rubyText": "嗚呼[ああ] ノートに零[こぼ]れたキラメキ"
    },
    {
      "id": 38,
      "startTime": 141.466,
      "endTime": 143.3,
      "text": "今[いま]、包帯[ほうたい]替[が]わりの大好[だいす]きって",
      "translation": "지금, 붕대 대신 '정말 좋아'라고",
      "start": 141.466,
      "end": 143.3,
      "rubyText": "今[いま]、包帯[ほうたい]替[が]わりの大好[だいす]きって"
    },
    {
      "id": 39,
      "startTime": 143.3,
      "endTime": 144.166,
      "text": "囁[ささや]く",
      "translation": "속삭여",
      "start": 143.3,
      "end": 144.166,
      "rubyText": "囁[ささや]く"
    },
    {
      "id": 40,
      "startTime": 144.166,
      "endTime": 148.0,
      "text": "優[やさ]しい光[ひかり]に眠[ねむ]れぬシンデレラ",
      "translation": "상냥한 빛에 잠들지 못하는 신데렐라",
      "start": 144.166,
      "end": 148.0,
      "rubyText": "優[やさ]しい光[ひかり]に眠[ねむ]れぬシンデレラ"
    },
    {
      "id": 41,
      "startTime": 148.0,
      "endTime": 150.4,
      "text": "ただ、柔[やわ]く解[ほど]けるの",
      "translation": "그저 부드럽게 풀어줘",
      "start": 148.0,
      "end": 150.4,
      "rubyText": "ただ、柔[やわ]く解[ほど]けるの"
    }
  ],
