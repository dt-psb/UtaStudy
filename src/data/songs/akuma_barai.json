{
  "id": "uchinobokaro-akuma-barai",
  "title": "アクマバライ (Akumabarai / Exorcist)",
  "artist": "うちのボカロは様子がおかしい feat. 雨衣, Gemini, 初音ミク",
  "youtubeId": "TzH5BsJj81Y",
  "thumbnail": "https://img.youtube.com/vi/TzH5BsJj81Y/hqdefault.jpg",
