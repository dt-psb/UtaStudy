  "lyrics": [
    {
      "id": 1,
      "startTime": 20.998,
      "endTime": 23.769,
      "text": "そんじょそこらの優[やさ]しさで",
      "translation": "흔해 빠진 친절함 정도로",
      "start": 20.998,
      "end": 23.769,
      "rubyText": "そんじょそこらの優[やさ]しさで"
    },
    {
      "id": 2,
      "startTime": 23.769,
      "endTime": 27.636,
      "text": "僕[ぼく]の心[こころ] 癒[いや]せるのかい？",
      "translation": "내 이런 마음을 정말 치유할 수 있을까?",
      "start": 23.769,
      "end": 27.636,
      "rubyText": "僕[ぼく]の心[こころ] 癒[いや]せるのかい？"
    },
    {
      "id": 3,
      "startTime": 29.21,
      "endTime": 32.179,
      "text": "あぁ 嫌[きら]われた 僕[ぼく]のせい？",
      "translation": "아, 미움받아 버렸어. 내 탓인 걸까?",
      "start": 29.21,
      "end": 32.179,
      "rubyText": "あぁ 嫌[きら]われた 僕[ぼく]のせい？"
    },
    {
      "id": 4,
      "startTime": 32.179,
      "endTime": 35.09,
      "text": "ついに誰[だれ]も見[み]てないや",
      "translation": "드디어 아무도 보지 않게 됐어.",
      "start": 32.179,
      "end": 35.09,
      "rubyText": "ついに誰[だれ]も見[み]てないや"
    },
    {
      "id": 5,
      "startTime": 36.189,
      "endTime": 39.02,
      "text": "明日[あした]からやるって本当[ほんとう]だ！",
      "translation": "진심이야, 내일부터 시작할게!",
      "start": 36.189,
      "end": 39.02,
      "rubyText": "明日[あした]からやるって本当[ほんとう]だ！"
    },
    {
      "id": 6,
      "startTime": 39.02,
      "endTime": 43.74,
      "text": "天然物[てんねんもの]のナマケモノだよ",
      "translation": "결국 난 타고난 게으름뱅이니까.",
      "start": 39.02,
      "end": 43.74,
      "rubyText": "天然物[てんねんもの]のナマケモノだよ"
    },
    {
      "id": 7,
      "startTime": 45.128,
      "endTime": 47.555,
      "text": "来世[らいせ]に期待[きたい]だ！",
      "translation": "다음 생에 기대를 걸어볼래!",
      "start": 45.128,
      "end": 47.555,
      "rubyText": "来世[らいせ]に期待[きたい]だ！"
    },
    {
      "id": 8,
      "startTime": 48.159,
      "endTime": 51.649,
      "text": "そう思[おも]ってる日々[ひび]は楽[らく]かもね",
      "translation": "그런 마음으로 사는 게 편할지도 몰라",
      "start": 48.159,
      "end": 51.649,
      "rubyText": "そう思[おも]ってる日々[ひび]は楽[らく]かもね"
    },
    {
      "id": 9,
      "startTime": 51.649,
      "endTime": 59.88,
      "text": "だけどずっとこのままじゃ 登場[とうじょう]シーンすらないかもね",
      "translation": "하지만 계속 이대로라면 등장하는 장면조차 없을지 몰라.",
      "start": 51.649,
      "end": 59.88,
      "rubyText": "だけどずっとこのままじゃ 登場[とうじょう]シーンすらないかもね"
    },
    {
      "id": 10,
      "startTime": 60.32,
      "endTime": 64.14,
      "text": "あの子[こ]みたいにと願[ねが]えば僕[ぼく]の",
      "translation": "그 애처럼 되고 싶다고 바랄수록",
      "start": 60.32,
      "end": 64.14,
      "rubyText": "あの子[こ]みたいにと願[ねが]えば僕[ぼく]の"
    },
    {
      "id": 11,
      "startTime": 64.14,
      "endTime": 66.879,
      "text": "足[た]りなさが分[わ]かってく",
      "translation": "내가 얼마나 부족한지 깨닫게 돼.",
      "start": 64.14,
      "end": 66.879,
      "rubyText": "足[た]りなさが分[わ]かってく"
    },
    {
      "id": 12,
      "startTime": 74.48,
      "endTime": 77.819,
      "text": "そんじょそこらの教育[きょういく]で",
      "translation": "흔해 빠진 교육 정도로",
      "start": 74.48,
      "end": 77.819,
      "rubyText": "そんじょそこらの教育[きょういく]で"
    },
    {
      "id": 13,
      "startTime": 77.819,
      "endTime": 82.0,
      "text": "僕[ぼく]の心[こころ] 直[なお]せるのかい？",
      "translation": "내 이런 마음을 정말 고칠 수 있을까?",
      "start": 77.819,
      "end": 82.0,
      "rubyText": "僕[ぼく]の心[こころ] 直[なお]せるのかい？"
    },
    {
      "id": 14,
      "startTime": 83.084,
      "endTime": 86.7,
      "text": "あぁもがけばもがくほどに",
      "translation": "아, 발버둥 치며 괴로워할수록",
      "start": 83.084,
      "end": 86.7,
      "rubyText": "あぁもがけばもがくほどに"
    },
    {
      "id": 15,
      "startTime": 86.7,
      "endTime": 89.56,
      "text": "馴[な]れ合[あ]いが心地[ここち]いいや",
      "translation": "공허한 위로가 딱 맞아떨어지는 기분이야.",
      "start": 86.7,
      "end": 89.56,
      "rubyText": "馴[な]れ合[あ]いが心地[ここち]いいや"
    },
    {
      "id": 16,
      "startTime": 90.0,
      "endTime": 94.459,
      "text": "来月[らいげつ]までにって本当[ほんとう]だ！",
      "translation": "정말이야, 내달에는 꼭!",
      "start": 90.0,
      "end": 94.459,
      "rubyText": "来月[らいげつ]までにって本当[ほんとう]だ！"
    },
    {
      "id": 17,
      "startTime": 94.459,
      "endTime": 99.814,
      "text": "大言壮語[たいげんそうご] まだ今[いま]も引[ひ]きずる",
      "translation": "큰소리만 떵떵 치고, 아직도 질질 끌고 있어.",
      "start": 94.459,
      "end": 99.814,
      "rubyText": "大言壮語[たいげんそうご] まだ今[いま]も引[ひ]きずる"
    },
    {
      "id": 18,
      "startTime": 100.909,
      "endTime": 103.607,
      "text": "誰[だれ]かに期待[きたい]だ！",
      "translation": "다른 사람에게 기대를 걸어볼래!",
      "start": 100.909,
      "end": 103.607,
      "rubyText": "誰[だれ]かに期待[きたい]だ！"
    },
    {
      "id": 19,
      "startTime": 103.9,
      "endTime": 108.75,
      "text": "そこに立[た]つのは僕[ぼく]じゃないかもね",
      "translation": "그곳에 서 있는 건 내가 아닐지도 모르지만",
      "start": 103.9,
      "end": 108.75,
      "rubyText": "そこに立[た]つのは僕[ぼく]じゃないかもね"
    },
    {
      "id": 20,
      "startTime": 108.75,
      "endTime": 115.75,
      "text": "だけどずっとこのままじゃ 続[つづ]くだけの日々[ひび]になるかもね",
      "translation": "하지만 계속 이대로라면 이런 날들이 그저 반복될 뿐이야.",
      "start": 108.75,
      "end": 115.75,
      "rubyText": "だけどずっとこのままじゃ 続[つづ]くだけの日々[ひび]になるかもね"
    },
    {
      "id": 21,
      "startTime": 116.24,
      "endTime": 121.37,
      "text": "がむしゃらに叫[さけ]んで声[こえ]だけデカいままだ",
      "translation": "그저 목소리만 높여서, 무작정 소리칠 뿐.",
      "start": 116.24,
      "end": 121.37,
      "rubyText": "がむしゃらに叫[さけ]んで声[こえ]だけデカいままだ"
    },
    {
      "id": 22,
      "startTime": 125.174,
      "endTime": 127.916,
      "text": "あの子[こ]になれたら",
      "translation": "\"그 애처럼 될 수 있다면\"",
      "start": 125.174,
      "end": 127.916,
      "rubyText": "あの子[こ]になれたら"
    },
    {
      "id": 23,
      "startTime": 127.916,
      "endTime": 131.96,
      "text": "そう願[ねが]ってる日々[ひび]に幸[さち]あれ",
      "translation": "그렇게 바라기만 하던 날들에 행운을.",
      "start": 127.916,
      "end": 131.96,
      "rubyText": "そう願[ねが]ってる日々[ひび]に幸[さち]あれ"
    },
    {
      "id": 24,
      "startTime": 131.96,
      "endTime": 140.15,
      "text": "だけどきっとこのままじゃ 登場[とうじょう]シーンすらないかもね",
      "translation": "하지만 분명 이대로라면 등장하는 장면조차 없을지 몰라.",
      "start": 131.96,
      "end": 140.15,
      "rubyText": "だけどきっとこのままじゃ 登場[とうじょう]シーンすらないかもね"
    },
    {
      "id": 25,
      "startTime": 140.15,
      "endTime": 144.46,
      "text": "あの子[こ]みたいにと願[ねが]う心[こころ]の",
      "translation": "그 애처럼 되고 싶다고 바랄 때",
      "start": 140.15,
      "end": 144.46,
      "rubyText": "あの子[こ]みたいにと願[ねが]う心[こころ]の"
    },
    {
      "id": 26,
      "startTime": 144.46,
      "endTime": 147.24,
      "text": "足[た]りなさがわかってく",
      "translation": "내 동경이 얼마나 나약한지 보게 돼.",
      "start": 144.46,
      "end": 147.24,
      "rubyText": "足[た]りなさがわかってく"
    },
    {
      "id": 27,
      "startTime": 148.156,
      "endTime": 151.43,
      "text": "あの子[こ]みたいになんなきゃ！",
      "translation": "그 애처럼 되어야만 해!",
      "start": 148.156,
      "end": 151.43,
      "rubyText": "あの子[こ]みたいになんなきゃ！"
    }
