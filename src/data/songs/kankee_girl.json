{
  "id": "masarada-kankee-girl",
  "title": "カンケーガール (Kankee Girl)",
  "artist": "マサラダ feat. 重音テト",
  "youtubeId": "5lK9z88taP8",
  "thumbnail": "https://img.youtube.com/vi/5lK9z88taP8/hqdefault.jpg",
  "duration": 254,
  "lyrics": [
    {
      "id": 1,
      "start": 24.82,
      "end": 25.99,
      "rubyText": "ハッ　キリッ",
      "translation": "딱 잘라",
      "romaji": "ha' kiri'"
    },
    {
      "id": 2,
      "start": 25.99,
      "end": 26.93,
      "rubyText": "言[い]えないよ",
      "translation": "말할 수 없어",
      "romaji": "ienai yo"
    },
    {
      "id": 3,
      "start": 26.93,
      "end": 29.76,
      "rubyText": "カンタンなことばかりじゃないのに",
      "translation": "간단한 일만 있는 게 아닌데",
      "romaji": "kantan na koto bakari ja nai noni"
    },
    {
      "id": 4,
      "start": 30.06,
      "end": 32.47,
      "rubyText": "ずっとね　複雑怪奇[ふくざつかいき]な",
      "translation": "끝없이 복잡괴기한",
      "romaji": "zutto ne fukuzatsukaiki na"
    },
    {
      "id": 5,
      "start": 32.47,
      "end": 34.58,
      "rubyText": "たこ足[あし] クモ網[あみ] 矢印[やじるし]！",
      "translation": "문어발 거미줄 화살표!",
      "romaji": "takoashi kumoami yajirushi!"
    },
    {
      "id": 6,
      "start": 35.13,
      "end": 37.57,
      "rubyText": "いつもあちらこちらに",
      "translation": "언제나 여기저기에",
      "romaji": "itsumo achira kochira ni"
    },
    {
      "id": 7,
      "start": 37.57,
      "end": 39.97,
      "rubyText": "キラメキ行[ゆ]き交[か]うが交差点[こうさてん]",
      "translation": "반짝임이 오가는 교차점",
      "romaji": "kirameki yukikau ga kousaten"
    },
    {
      "id": 8,
      "start": 39.97,
      "end": 42.44,
      "rubyText": "あっ そういえば元気[げんき]かに？ って",
      "translation": "아, 그러고 보니 잘 지내려나? 하고",
      "romaji": "a' sou ieba genki ka ni? tte"
    },
    {
      "id": 9,
      "start": 42.44,
      "end": 44.45,
      "rubyText": "思[おも]い出[だ]すのは何故[なぜ]？",
      "translation": "떠올리는 건 어째서?",
      "romaji": "omoidasu no wa naze?"
    },
    {
      "id": 10,
      "start": 45.61,
      "end": 50.28,
      "rubyText": "隣[となり]の隣[となり]の隣[となり]で聞[き]いた",
      "translation": "옆친구의 옆친구의 옆친구한테 들었던",
      "romaji": "tonari no tonari no tonari de kiita"
    },
    {
      "id": 11,
      "start": 50.48,
      "end": 55.23,
      "rubyText": "言葉[ことば]繰[く]り返[かえ]してる",
      "translation": "말을 되풀이하고 있어",
      "romaji": "kotoba kurikaeshiteru"
    },
    {
      "id": 12,
      "start": 55.99,
      "end": 57.92,
      "rubyText": "間違[まちが]っていても壊[こわ]れない！",
      "translation": "실수하더라도 망가지지 않아!",
      "romaji": "machigatte ite mo kowarenai!"
    },
    {
      "id": 13,
      "start": 58.69,
      "end": 60.63,
      "rubyText": "丸[まる]ごと　何[なに]よりも",
      "translation": "있는 그대로 무엇보다도",
      "romaji": "marugoto nani yori mo"
    },
    {
      "id": 14,
      "start": 60.83,
      "end": 63.3,
      "rubyText": "大切[たいせつ]って聞[き]きたいその声[こえ]で",
      "translation": "소중하다고 듣고 싶어 그 목소리로",
      "romaji": "taisetsu tte kikitai sono koe de"
    },
    {
      "id": 15,
      "start": 63.76,
      "end": 67.6,
      "rubyText": "黙[だま]るほど　今[いま]重[かさ]なるほどに苦[くる]しくなるのよ",
      "translation": "침묵할수록 지금 겹쳐질수록 괴로워지는 거야",
      "romaji": "damaru hodo ima kasanaru hodo ni kurushiku naru no yo"
    },
    {
      "id": 16,
      "start": 68.87,
      "end": 70.8,
      "rubyText": "カンケーガール　カンケーガール",
      "translation": "관계 걸 관계 걸",
      "romaji": "kankee gaaru kankee gaaru"
    },
    {
      "id": 17,
      "start": 71.1,
      "end": 73.44,
      "rubyText": "だってあなたのことだもの",
      "translation": "그야 너에 대한 거니까",
      "romaji": "datte anata no koto da mono"
    },
    {
      "id": 18,
      "start": 74.14,
      "end": 76.08,
      "rubyText": "カンケーガール　カンケーガール",
      "translation": "관계 걸 관계 걸",
      "romaji": "kankee gaaru kankee gaaru"
    },
    {
      "id": 19,
      "start": 89.72,
      "end": 91.69,
      "rubyText": "幽霊[ゆうれい]を見[み]ました",
      "translation": "유령을 봤습니다",
      "romaji": "yuurei o mimashita"
    },
    {
      "id": 20,
      "start": 91.69,
      "end": 94.63,
      "rubyText": "呪[のろ]いにも祈[いの]りにも恋[こい]にも",
      "translation": "저주에도 기도에도 사랑에도",
      "romaji": "noroi ni mo inori ni mo koi ni mo"
    },
    {
      "id": 21,
      "start": 94.83,
      "end": 97.46,
      "rubyText": "形[かたち]はないのに　触[ふ]れる",
      "translation": "형태가 없는데도 닿을 수 있어",
      "romaji": "katachi wa nai noni fureru"
    },
    {
      "id": 22,
      "start": 97.46,
      "end": 99.93,
      "rubyText": "思念[しねん] 琴線[きんせん] コンプレックス",
      "translation": "사념 심금 콤플렉스",
      "romaji": "shinen kinsen kompurekkusu"
    },
    {
      "id": 23,
      "start": 100.07,
      "end": 102.1,
      "rubyText": "勘違[かんちが]いじゃないのに！",
      "translation": "착각한 게 아닌데!",
      "romaji": "kanchigai ja nai noni!"
    },
    {
      "id": 24,
      "start": 102.23,
      "end": 105.24,
      "rubyText": "うわ 玉[たま]に瑕[きず]だねおばかだね　フｗ",
      "translation": "우와 옥에 티네 바보 같네 ㅋ",
      "romaji": "uwa tama ni kizu da ne obaka da ne fuw"
    },
    {
      "id": 25,
      "start": 105.67,
      "end": 109.88,
      "rubyText": "嘲笑[あざわら]う人[ひと]を嘲笑[あざわら]う僕[ぼく]を誰[だれ]かが指差[ゆびさ]し嘲笑[あざわら]う",
      "translation": "비웃는 사람을 비웃는 나를 누군가가 손가락질하며 비웃어",
      "romaji": "azawarau hito o azawarau boku o dareka ga yubisashi azawarau"
    },
    {
      "id": 26,
      "start": 109.94,
      "end": 115.01,
      "rubyText": "だけど好[す]き好[この]む人[ひと]を好[す]き好[この]む僕[ぼく]を誰[だれ]かが目[め]で見[み]て好[す]き好[この]む",
      "translation": "하지만 좋아하는 사람을 좋아하는 나를 누군가는 보고서 좋아해 줘",
      "romaji": "dakedo sukikonomu hito o sukikonomu boku o dareka ga me de mite sukikonomu"
    },
    {
      "id": 27,
      "start": 115.18,
      "end": 118.12,
      "rubyText": "たかがままごと　くだらないよなんて",
      "translation": "고작 소꿉놀이 시시하다며",
      "romaji": "takaga mamagoto kudaranai yo nante"
    },
    {
      "id": 28,
      "start": 118.22,
      "end": 120.39,
      "rubyText": "誰[だれ]かが言[い]うんだ吐[は]き捨[す]てて",
      "translation": "누군가는 내뱉으며 말하지만",
      "romaji": "dareka ga iu nda hakisutete"
    },
    {
      "id": 29,
      "start": 120.75,
      "end": 123.36,
      "rubyText": "されども　僕[ぼく]には何[なに]より",
      "translation": "그렇다 해도 나에게는 무엇보다",
      "romaji": "saredomo boku ni wa nani yori"
    },
    {
      "id": 30,
      "start": 123.36,
      "end": 125.09,
      "rubyText": "光[ひか]って見[み]えたのよ",
      "translation": "빛나 보였던 거야",
      "romaji": "hikatte mieta no yo"
    },
    {
      "id": 31,
      "start": 126.03,
      "end": 127.96,
      "rubyText": "カンケーガール　カンケーガール",
      "translation": "관계 걸 관계 걸",
      "romaji": "kankee gaaru kankee gaaru"
    },
    {
      "id": 32,
      "start": 128.16,
      "end": 130.83,
      "rubyText": "きっとあなたのことだから",
      "translation": "분명 너에 대한 거니까",
      "romaji": "kitto anata no koto dakara"
    },
    {
      "id": 33,
      "start": 131.2,
      "end": 133.2,
      "rubyText": "カンケーガール　カンケーガール",
      "translation": "관계 걸 관계 걸",
      "romaji": "kankee gaaru kankee gaaru"
    },
    {
      "id": 34,
      "start": 136.44,
      "end": 138.54,
      "rubyText": "小[ちい]さくなっても変[か]わらない！",
      "translation": "작아지더라도 변하지 않아!",
      "romaji": "chiisaku natte mo kawaranai!"
    },
    {
      "id": 35,
      "start": 159.96,
      "end": 164.5,
      "rubyText": "ありもしないこと怖[こわ]がるたび",
      "translation": "있지도 않은 일을 두려워할 때마다",
      "romaji": "ari mo shinai koto kowagaru tabi"
    },
    {
      "id": 36,
      "start": 165.13,
      "end": 169.32,
      "rubyText": "あることだけをずっと確[たし]かめてる",
      "translation": "있는 것만을 계속 확인하고 있어",
      "romaji": "aru koto dake o zutto tashikameteru"
    },
    {
      "id": 37,
      "start": 169.64,
      "end": 172.47,
      "rubyText": "いつもあちらこちらに",
      "translation": "언제나 여기저기에",
      "romaji": "itsumo achira kochira ni"
    },
    {
      "id": 38,
      "start": 172.47,
      "end": 174.81,
      "rubyText": "キラメキ宿[やど]すのは面影[おもかげ]",
      "translation": "반짝임을 머금는 건 그리운 모습",
      "romaji": "kirameki yadosu no wa omokage"
    },
    {
      "id": 39,
      "start": 175.18,
      "end": 178.08,
      "rubyText": "そういえば元気[げんき]かに",
      "translation": "그러고 보니 잘 지내려나",
      "romaji": "sou ieba genki ka ni"
    },
    {
      "id": 40,
      "start": 180.41,
      "end": 182.28,
      "rubyText": "誰[だれ]かと重[かさ]なる時[とき]",
      "translation": "누군가와 겹쳐질 때",
      "romaji": "dareka to kasanaru toki"
    },
    {
      "id": 41,
      "start": 182.28,
      "end": 185.38,
      "rubyText": "痛快[つうかい]な音[おと]が鳴[な]ることがある",
      "translation": "통쾌한 소리가 울릴 때가 있어",
      "romaji": "tsuukai na oto ga naru koto ga aru"
    },
    {
      "id": 42,
      "start": 185.49,
      "end": 190.16,
      "rubyText": "僕[ぼく]はそのために生[い]きてきたんだって言[い]い切[き]れる",
      "translation": "나는 그걸 위해 살아왔다고 단언할 수 있어",
      "romaji": "boku wa sono tame ni ikite kita ndatte iikireru"
    },
    {
      "id": 43,
      "start": 190.92,
      "end": 192.89,
      "rubyText": "カンケーガール　カンケーガール",
      "translation": "관계 걸 관계 걸",
      "romaji": "kankee gaaru kankee gaaru"
    },
    {
      "id": 44,
      "start": 194.79,
      "end": 196.76,
      "rubyText": "丸[まる]ごと　何[なに]よりも",
      "translation": "있는 그대로 무엇보다도",
      "romaji": "marugoto nani yori mo"
    },
    {
      "id": 45,
      "start": 196.93,
      "end": 199.59,
      "rubyText": "大切[たいせつ]って聞[き]きたいその声[こえ]で",
      "translation": "소중하다고 듣고 싶어 그 목소리로",
      "romaji": "taisetsu tte kikitai sono koe de"
    },
    {
      "id": 46,
      "start": 199.72,
      "end": 204.5,
      "rubyText": "混[ま]ざるほど　今[いま]重[かさ]なるほどに嬉[うれ]しくなるのよ",
      "translation": "섞일수록 지금 겹쳐질수록 기뻐지는 거야",
      "romaji": "mazaru hodo ima kasanaru hodo ni ureshiku naru no yo"
    },
    {
      "id": 47,
      "start": 204.87,
      "end": 207.21,
      "rubyText": "聞[き]かせたいよ　見[み]せたいよ",
      "translation": "들려주고 싶어 보여주고 싶어",
      "romaji": "kikasetai yo misetai yo"
    },
    {
      "id": 48,
      "start": 207.31,
      "end": 209.98,
      "rubyText": "もうしないよって謝[あやま]りたいよ",
      "translation": "다신 안 그럴게 하고 사과하고 싶어",
      "romaji": "mou shinai yo tte ayamaritai yo"
    },
    {
      "id": 49,
      "start": 210.11,
      "end": 214.48,
      "rubyText": "混[ま]ざるほど　今[いま]重[かさ]なるほどに生[い]きていたいのよ",
      "translation": "섞일수록 지금 겹쳐질수록 살아있고 싶은 거야",
      "romaji": "mazaru hodo ima kasanaru hodo ni ikite itai no yo"
    },
