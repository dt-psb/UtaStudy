{
  "id": "wanopo-tenshi-ka-akuma-ka",
  "title": "てんしかあくまか (Tenshi ka Akuma ka)",
  "artist": "WONDERFUL★OPPORTUNITY! feat. 雨衣",
  "youtubeId": "YC6DLCKhlkY",
  "thumbnail": "https://img.youtube.com/vi/YC6DLCKhlkY/hqdefault.jpg",
  "duration": 173,
  "lyrics": [
    {
      "id": 1,
      "start": 6.04,
      "end": 7.69,
      "rubyText": "てんしかあくまか",
      "translation": "천사인가 악마인가",
      "romaji": "tenshi ka akuma ka"
    },
    {
      "id": 2,
      "start": 19.83,
      "end": 20.81,
      "rubyText": "だ　だ　だ　だ　だ",
      "translation": "누　누　누　누　누",
      "romaji": "da da da da da"
    },
    {
      "id": 3,
      "start": 20.81,
      "end": 21.31,
      "rubyText": "だれ？",
      "translation": "누구?",
      "romaji": "dare?"
    },
    {
      "id": 4,
      "start": 21.31,
      "end": 22.06,
      "rubyText": "アイドンノー？　え？",
      "translation": "아이 돈 노? 에?",
      "romaji": "ai don noo? e?"
    },
    {
      "id": 5,
      "start": 22.06,
      "end": 23.97,
      "rubyText": "これは知[し]らない子[こ]ですねぇ",
      "translation": "이건 모르는 아이네요",
      "romaji": "kore wa shiranai ko desu nee"
    },
    {
      "id": 6,
      "start": 23.97,
      "end": 25.65,
      "rubyText": "なんて言[い]わないで　待[ま]って",
      "translation": "라고 하지 말아줘 잠깐만",
      "romaji": "nante iwanaide matte"
    },
    {
      "id": 7,
      "start": 25.65,
      "end": 27.01,
      "rubyText": "お騒[さわ]がしております",
      "translation": "저 때문에 좀 소란스럽죠",
      "romaji": "osawagase shite orimasu"
    },
    {
      "id": 8,
      "start": 27.01,
      "end": 28.16,
      "rubyText": "ビジュはこんなかんじ",
      "translation": "비주얼은 이런 느낌",
      "romaji": "biju wa konna kanji"
    },
    {
      "id": 9,
      "start": 28.16,
      "end": 30.4,
      "rubyText": "悪[わる]くないでしょ？むしろ好[す]き？",
      "translation": "나쁘지 않죠? 오히려 아끼고",
      "romaji": "warukunai desho? mushiro suki?"
    },
    {
      "id": 10,
      "start": 30.4,
      "end": 31.9,
      "rubyText": "まであるんじゃない？",
      "translation": "싶어지지 않아?",
      "romaji": "made arun ja nai?"
    },
    {
      "id": 11,
      "start": 31.9,
      "end": 33.21,
      "rubyText": "はい　じゃあ　これが利用[りよう]規約[きやく]",
      "translation": "네 그럼 이건 이용약관",
      "romaji": "hai jaa kore ga riyou kiyaku"
    },
    {
      "id": 12,
      "start": 33.21,
      "end": 34.8,
      "rubyText": "最後[さいご]までちゃーんとよく読[よ]んで？",
      "translation": "끝까지 제대로 읽으렴?",
      "romaji": "saigo made chaanto yoku yonde?"
    },
    {
      "id": 13,
      "start": 34.8,
      "end": 37.85,
      "rubyText": "同意[どうい]　同意[どうい]　同意[どうい]　しよ？",
      "translation": "동의 동의 동의 하자?",
      "romaji": "doui doui doui shiyo?"
    },
    {
      "id": 14,
      "start": 37.85,
      "end": 39.2,
      "rubyText": "まって　熟読[じゅくどく]？助[たす]かる～",
      "translation": "잠깐 정독할거야? 그럼 좋지~",
      "romaji": "matte jukudoku? tasukaru~"
    },
    {
      "id": 15,
      "start": 39.2,
      "end": 40.92,
      "rubyText": "てか大丈夫[だいじょうぶ]そ？じれったいな～",
      "translation": "근데 괜찮을 것 같아? 감질나네~",
      "romaji": "teka daijoubu so? jirettai naa~"
    },
    {
      "id": 16,
      "start": 40.92,
      "end": 42.36,
      "rubyText": "きみにとっては",
      "translation": "너에게 있어서",
      "romaji": "kimi ni totte wa"
    },
    {
      "id": 17,
      "start": 42.36,
      "end": 45.51,
      "rubyText": "てんしかあくまか　どっちでしょうね",
      "translation": "천사인가 악마인가　어느쪽일까",
      "romaji": "tenshi ka akuma ka docchi deshou ne"
    },
    {
      "id": 18,
      "start": 45.51,
      "end": 48.59,
      "rubyText": "ピンチかチャンスか　ねぇどんな気持[きも]ち？",
      "translation": "위기일까 찬스일까　어떤 기분이야?",
      "romaji": "pinchi ka chansu ka nee donna kimochi?"
    },
    {
      "id": 19,
      "start": 48.59,
      "end": 51.56,
      "rubyText": "善[ぜん]は急[いそ]げ　きらいになっても",
      "translation": "쇠뿔도 달았는데　싫어하게 되어도",
      "romaji": "zen wa isoge kirai ni nattemo"
    },
    {
      "id": 20,
      "start": 51.56,
      "end": 52.78,
      "rubyText": "いいの？　いいの？",
      "translation": "괜찮아?　괜찮아?",
      "romaji": "ii no? ii no?"
    },
    {
      "id": 21,
      "start": 52.78,
      "end": 54.54,
      "rubyText": "ってきいていますか？",
      "translation": "랄까 듣고 있나요?",
      "romaji": "tte kiite imasu ka?"
    },
    {
      "id": 22,
      "start": 54.54,
      "end": 57.57,
      "rubyText": "あっちもこっちもライバルだらけじゃんか",
      "translation": "이쪽도 저쪽도 라이벌이 가득하잖아",
      "romaji": "acchi mo kocchi mo raibaru darake jan ka"
    },
    {
      "id": 23,
      "start": 57.57,
      "end": 60.72,
      "rubyText": "ねぇ何[なに]ためらってんの？受[う]け入[い]れないと",
      "translation": "왜 망설이는거야? 받아주지 않으면",
      "romaji": "nee nani tameratten no? ukeirenai to"
    },
    {
      "id": 24,
      "start": 60.72,
      "end": 63.73,
      "rubyText": "泣[な]いちゃうぞ？ここでないちゃうぞ？いいの？",
      "translation": "울어버릴꺼야? 여기서 울어버릴거야? 알았어?",
      "romaji": "naichau zo? koko de naichau zo? ii no?"
    },
    {
      "id": 25,
      "start": 63.73,
      "end": 66.85,
      "rubyText": "だってだって推[お]して欲[ほ]しいの！",
      "translation": "왜냐면 왜냐면 애정해줬으면 하는걸!",
      "romaji": "datte datte oshite hoshii no!"
    },
    {
      "id": 26,
      "start": 66.85,
      "end": 69.23,
      "rubyText": "T・E・N・S・H・I",
      "translation": "ㅊ・ㅓ・ㄴ・ㅅ・ㅏ",
      "romaji": "T E N S H I"
    },
    {
      "id": 27,
      "start": 69.23,
      "end": 70.9,
      "rubyText": "ちょちょMIDIみせて？",
      "translation": "MIDI 조금만 보여줄래?",
      "romaji": "chocho MIDI misete?"
    },
    {
      "id": 28,
      "start": 70.9,
      "end": 72.98,
      "rubyText": "え～　ケチ　バカ！　もうしらない！",
      "translation": "에~ 쩨쩨해 바보! 알아서 해!",
      "romaji": "ee~ kechi baka! mou shiranai!"
    },
    {
      "id": 29,
      "start": 72.98,
      "end": 75.22,
      "rubyText": "A・K・U・M・A",
      "translation": "ㅇ・ㅏ・ㄱ・ㅁ・ㅏ",
      "romaji": "A K U M A"
    },
    {
      "id": 30,
      "start": 75.22,
      "end": 77.46,
      "rubyText": "お騒[さわ]がしております",
      "translation": "저 때문에 좀 소란스럽죠",
      "romaji": "osawagase shite orimasu"
    },
    {
      "id": 31,
      "start": 77.46,
      "end": 79.47,
      "rubyText": "ごめんあそばせっ",
      "translation": "실례하겠습니다",
      "romaji": "gomen asobase"
    },
    {
      "id": 32,
      "start": 82.32,
      "end": 85.27,
      "rubyText": "ねぇ、ちょっとまだ本気[ほんき]じゃないでしょ？",
      "translation": "있잖아, 아직 진심은 아니지?",
      "romaji": "nee, chotto mada honki ja nai desho?"
    },
    {
      "id": 33,
      "start": 85.27,
      "end": 88.11,
      "rubyText": "へぇ、なんかけっこうかっこいいこというじゃん？",
      "translation": "헤, 뭔가 꽤 멋진말도 하잖아?",
      "romaji": "hee, nanka kekkou kakkoii koto iu jan?"
    },
    {
      "id": 34,
      "start": 88.11,
      "end": 90.5,
      "rubyText": "慌[あわ]てないで？焦[あせ]んないで？",
      "translation": "당황하지마? 초조해하지마?",
      "romaji": "awatenaide? asennaide?"
    },
    {
      "id": 35,
      "start": 90.5,
      "end": 92.55,
      "rubyText": "やぶからぼうにアイウォンチュー？",
      "translation": "그런데 뜬금없이 아이 원 츄?",
      "romaji": "yabukarabou ni ai won chuu?"
    },
    {
      "id": 36,
      "start": 92.55,
      "end": 94.08,
      "rubyText": "き…きらいじゃないが",
      "translation": "시…싫은건 아닌데",
      "romaji": "ki... kirai ja nai ga"
    },
    {
      "id": 37,
      "start": 94.08,
      "end": 95.62,
      "rubyText": "はい　じゃあ　これが契約書[けいやくしょ]",
      "translation": "네　그럼　이게 계약서",
      "romaji": "hai jaa kore ga keiyakusho"
    },
    {
      "id": 38,
      "start": 95.62,
      "end": 97.15,
      "rubyText": "甲乙[こうおつ]苦手[にがて]？知[し]りませ〜ん",
      "translation": "잘 모르겠어? 알까보냐~",
      "romaji": "kouotsu nigate? shrimase~n"
    },
    {
      "id": 39,
      "start": 97.15,
      "end": 100.19,
      "rubyText": "勉強[べんきょう]　勉強[べんきょう]　勉強[べんきょう]　だな？",
      "translation": "공부　공부　공부　해야겠지?",
      "romaji": "benkyou benkyou benkyou da na?"
    },
    {
      "id": 40,
      "start": 100.19,
      "end": 101.8,
      "rubyText": "まって　怒[おこ]った？ごめんって～",
      "translation": "잠깐　화났어? 미안하다니까~",
      "romaji": "matte okotta? gomentte~"
    },
    {
      "id": 41,
      "start": 101.8,
      "end": 103.25,
      "rubyText": "もういいよ　いやよくないか",
      "translation": "이제 됐어　아니 이래선 안되지",
      "romaji": "mou ii yo iya yokunai ka"
    },
    {
      "id": 42,
      "start": 103.25,
      "end": 104.85,
      "rubyText": "きみにとっては",
      "translation": "너에게 있어서",
      "romaji": "kimi ni totte wa"
    },
    {
      "id": 43,
      "start": 104.85,
      "end": 106.2,
      "rubyText": "きみにとっては（2回[かい]目[め]）",
      "translation": "너에게 있어서",
      "romaji": "kimi ni totte wa (nikaime)"
    },
    {
      "id": 44,
      "start": 106.2,
      "end": 109.23,
      "rubyText": "てんしかあくまか　お分[わ]かりですね",
      "translation": "천사인가 악마인가　알고 있겠지요",
      "romaji": "tenshi ka akuma ka owakari desu ne"
    },
    {
      "id": 45,
      "start": 109.23,
      "end": 112.41,
      "rubyText": "ピンチかチャンスか　明白[めいはく]ですよね",
      "translation": "위기인가 찬스인가　명백하지요",
      "romaji": "pinchi ka chansu ka meihaku desu yo ne"
    },
    {
      "id": 46,
      "start": 112.41,
      "end": 116.58,
      "rubyText": "出発[しゅっぱつ]進行[しんこう]　雨[あめ]降[ふ]って地[じ]固[かた]まったねって",
      "translation": "출발진행　비온뒤에 땅이 굳었다며",
      "romaji": "shuppatsu shinkou ame futte ji katamatta nette"
    },
    {
      "id": 47,
      "start": 116.58,
      "end": 118.45,
      "rubyText": "きいていますか？",
      "translation": "듣고 있어요?",
      "romaji": "kiite imasu ka?"
    },
    {
      "id": 48,
      "start": 118.45,
      "end": 121.34,
      "rubyText": "にっちもさっちもかわいいだらけじゃんね",
      "translation": "머리부터 발끝까지 귀엽지 않나요",
      "romaji": "nicchi mo sacchi mo kawaii darake jan ne"
    },
    {
      "id": 49,
      "start": 121.34,
      "end": 124.47,
      "rubyText": "お察[さっ]しの通[とお]り　でっかいラブくれないと",
      "translation": "짐작하셨듯　큰 러브를 주지않으면",
      "romaji": "osasshi no toori dekkai rabu kurenai to"
    },
    {
      "id": 50,
      "start": 124.47,
      "end": 127.47,
      "rubyText": "拗[す]ねちゃうぞ？ガチで拗[す]ねちゃうぞ？いいの？",
      "translation": "삐져버릴거야? 진짜로 삐질거에요? 알았지?",
      "romaji": "sunechau zo? gachi de sunechau zo? ii no?"
    },
    {
      "id": 51,
      "start": 127.47,
      "end": 130.55,
      "rubyText": "だってだって推[お]してほしいの！",
      "translation": "왜냐면 왜냐면 애정해줬으면 하는걸!",
      "romaji": "datte datte oshite hoshii no!"
    },
    {
      "id": 52,
      "start": 130.55,
      "end": 132.94,
      "rubyText": "T・E・N・S・H・I",
      "translation": "ㅊ・ㅓ・ㄴ・ㅅ・ㅏ",
      "romaji": "T E N S H I"
    },
    {
      "id": 53,
      "start": 132.94,
      "end": 134.63,
      "rubyText": "ちょちょリリックみせて？",
      "translation": "가사 조금만 보여줄래?",
      "romaji": "chocho ririkku misete?"
    },
    {
      "id": 54,
      "start": 134.63,
      "end": 136.92,
      "rubyText": "え～　ケチ　バカ！　もうしらない！",
      "translation": "에~ 쩨쩨해 바보! 알아서 해!",
      "romaji": "ee~ kechi baka! mou shiranai!"
    },
    {
      "id": 55,
      "start": 136.92,
      "end": 139.04,
      "rubyText": "A・K・U・M・A",
      "translation": "ㅇ・ㅏ・ㄱ・ㅁ・ㅏ",
      "romaji": "A K U M A"
    },
    {
      "id": 56,
      "start": 139.04,
      "end": 141.29,
      "rubyText": "お騒[さわ]がしております",
      "translation": "저 때문에 좀 소란스럽죠",
      "romaji": "osawagase shite orimasu"
    },
    {
      "id": 57,
      "start": 141.29,
      "end": 142.84,
      "rubyText": "ってきいてます〜？",
      "translation": "랄까 듣고 계신가요~?",
      "romaji": "tte kiitemasu~?"
    },
    {
      "id": 58,
      "start": 142.84,
      "end": 145.14,
      "rubyText": "T・E・N・S・H・I",
      "translation": "ㅊ・ㅓ・ㄴ・ㅅ・ㅏ",
      "romaji": "T E N S H I"
    },
    {
      "id": 59,
      "start": 145.14,
      "end": 148.76,
      "rubyText": "なななー",
      "translation": "나나나-",
      "romaji": "nananaa"
    },
    {
      "id": 60,
      "start": 148.76,
      "end": 151.21,
      "rubyText": "A・K・U・M・A",
      "translation": "ㅇ・ㅏ・ㄱ・ㅁ・ㅏ",
      "romaji": "A K U M A"
    },
    {
      "id": 61,
      "start": 151.21,
      "end": 153.42,
      "rubyText": "ああだこうだ言[い]いましたが",
      "translation": "이러쿵 저러쿵 말했지만은",
      "romaji": "aada kouda iimashita ga"
    },
    {
      "id": 62,
      "start": 153.42,
      "end": 156.37,
      "rubyText": "全部[ぜんぶ]ウソだから",
      "translation": "전부 거짓말이니까",
      "romaji": "zenbu uso dakara"
    },
    {
      "id": 63,
      "start": 156.37,
      "end": 157.9,
      "rubyText": "ごめんあそばせっ",
      "translation": "실례하겠습니다",
      "romaji": "gomen asobase"
    },
    {
      "id": 64,
