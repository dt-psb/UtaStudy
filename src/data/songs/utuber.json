  "lyrics": [
    {
      "id": 1,
      "start": 2.776,
      "end": 3.9,
      "rubyText": "Who are you?",
      "translation": "Who are you?",
      "romaji": "Who are you?"
    },
    {
      "id": 2,
      "start": 3.9,
      "end": 5.399,
      "rubyText": "はい ユーチューバー",
      "translation": "네 유튜버",
      "romaji": "hai yuuchuubaa"
    },
    {
      "id": 3,
      "start": 5.908,
      "end": 8.532,
      "rubyText": "「ユーチューバー」",
      "translation": "「유튜버」",
      "romaji": "\"yuuchuubaa\""
    },
    {
      "id": 4,
      "start": 11.865,
      "end": 14.364,
      "rubyText": "ガッデム 盛[も]り上[あ]がってる",
      "translation": "God damn 분위기 고조되고 있어",
      "romaji": "gaddemu moriagatteru"
    },
    {
      "id": 5,
      "start": 14.369,
      "end": 17.464,
      "rubyText": "でっかい数字[すうじ]を見[み]て 頭[あたま]が沸[わ]いてる",
      "translation": "엄청 큰 숫자를 보고 머리가 끓고 있어",
      "romaji": "dekkai suujio mite atamaga waiteru"
    },
    {
      "id": 6,
      "start": 17.464,
      "end": 20.33,
      "rubyText": "「まだ流行[はや]ってる？」 評判[ひょうばん]聞[き]いて捨[す]てる",
      "translation": "「아직 유행이야?」 평판 듣고 버려",
      "romaji": "\"mada hayatteru?\" hyouban kiite suteru"
    },
    {
      "id": 7,
      "start": 20.33,
      "end": 23.229,
      "rubyText": "ゴミの山[やま]にもお花[はな]が咲[さ]いてる",
      "translation": "쓰레기 더미에도 꽃이 피어나",
      "romaji": "gomino yamani mo ohana ga saiteru"
    },
    {
      "id": 8,
      "start": 24.101,
      "end": 25.395,
      "rubyText": "悪鬼[あっき]羅刹[らせつ]が寄[よ]ってきて",
      "translation": "악귀나찰이 접근해 와서",
      "romaji": "akkirasetsu ga yotte kite"
    },
    {
      "id": 9,
      "start": 25.395,
      "end": 26.795,
      "rubyText": "よっ あんたが大統領[だいとうりょう]",
      "translation": "좋아 당신이 대통령",
      "romaji": "yo' anta ga daitouryou"
    },
    {
      "id": 10,
      "start": 27.235,
      "end": 28.495,
      "rubyText": "満身[まんしん]創痍[そうい]で愛想[あいそ]笑[わら]い",
      "translation": "만신창이로 아양 떠는 웃음",
      "romaji": "manshinsouide aisowarai"
    },
    {
      "id": 11,
      "start": 28.495,
      "end": 29.795,
      "rubyText": "はい あげちゃうバンソーコー",
      "translation": "그래 붙여 버려 반창고",
      "romaji": "hai agechau bansoukou"
    },
    {
      "id": 12,
      "start": 30.261,
      "end": 31.561,
      "rubyText": "自分[じぶん]に酔[よ]ってみたいが",
      "translation": "자신에게 취해 보고 싶지만",
      "romaji": "jibunni yottemitaiga"
    },
    {
      "id": 13,
      "start": 31.561,
      "end": 33.227,
      "rubyText": "醒[さ]めちゃう×（ばってん）ばっか",
      "translation": "깨어 버려 × 가위표만이",
      "romaji": "samechau batten bakka"
    },
    {
      "id": 14,
      "start": 33.227,
      "end": 34.66,
      "rubyText": "そんなこんなで",
      "translation": "이러쿵저러쿵",
      "romaji": "sonna konnade"
    },
    {
      "id": 15,
      "start": 34.66,
      "end": 36.098,
      "rubyText": "Time goes by",
      "translation": "Time goes by",
      "romaji": "Time goes by"
    },
    {
      "id": 16,
      "start": 36.211,
      "end": 38.859,
      "rubyText": "おじいちゃんはね 昔[むかし]",
      "translation": "할아버지는 말이야 예전에",
      "romaji": "ojiichanwa ne mukashi"
    },
    {
      "id": 17,
      "start": 38.859,
      "end": 41.726,
      "rubyText": "ユーチューバーだったんだよ",
      "translation": "유튜버였단다",
      "romaji": "yuuchuubaa dattandayo"
    },
    {
      "id": 18,
      "start": 41.726,
      "end": 42.325,
      "rubyText": "（へえ）",
      "translation": "(헤에)",
      "romaji": "(hee)"
    },
    {
      "id": 19,
      "start": 42.325,
      "end": 44.992,
      "rubyText": "おじいちゃんはね 素晴[すば]らしい",
      "translation": "할아버지는 말이야 굉장한",
      "romaji": "ojiichanwa ne subarashii"
    },
    {
      "id": 20,
      "start": 44.992,
      "end": 48.524,
      "rubyText": "ユーチューバーだったんだよ ハロー",
      "translation": "유튜버였단다 헬로",
      "romaji": "yuuchuubaa dattandayo harou"
    },
    {
      "id": 21,
      "start": 51.524,
      "end": 53.99,
      "rubyText": "健全[けんぜん]な方[ほう]のユーチューバー",
      "translation": "건전한 쪽의 유튜버",
      "romaji": "kenzenna houno yuuchuubaa"
    },
    {
      "id": 22,
      "start": 54.223,
      "end": 56.856,
      "rubyText": "わかってる みんな わかってる",
      "translation": "알고 있어 모두들 알고 있어",
      "romaji": "wakatteru minna wakatteru"
    },
    {
      "id": 23,
      "start": 56.856,
      "end": 59.889,
      "rubyText": "きっと寛容[かんよう]な感[かん]じで 笑[わら]ってくれる",
      "translation": "분명 너그러운 느낌으로 웃어주고 있어",
      "romaji": "kitto kanyouna kanjide waratte kureru"
    },
    {
      "id": 24,
      "start": 59.891,
      "end": 63.621,
      "rubyText": "みんな愛[あい]してる みんな愛[あい]してる",
      "translation": "모두들 사랑해 모두들 사랑해",
      "romaji": "minna aishiteru minna aishiteru"
    },
    {
      "id": 25,
      "start": 63.621,
      "end": 65.121,
      "rubyText": "「絶対[ぜったい]許[ゆる]さん」",
      "translation": "「절대 용서 못 해」",
      "romaji": "\"zettai yurusan\""
    },
    {
      "id": 26,
      "start": 65.121,
      "end": 66.321,
      "rubyText": "Love is dead",
      "translation": "Love is dead",
      "romaji": "Love is dead"
    },
    {
