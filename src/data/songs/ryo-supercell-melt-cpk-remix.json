  "lyrics": [
    {
      "id": 1,
      "startTime": 2.018,
      "endTime": 6.495,
      "text": "メルト 溶[と]けてしまいそう",
      "translation": "멜트 녹아내릴 것만 같아",
      "start": 2.018,
      "end": 6.495,
      "rubyText": "メルト 溶[と]けてしまいそう"
    },
    {
      "id": 2,
      "startTime": 27.547,
      "endTime": 29.939,
      "text": "朝[あさ] 目[め]が覚[さ]めて",
      "translation": "아침에 눈을 뜨면",
      "start": 27.547,
      "end": 29.939,
      "rubyText": "朝[あさ] 目[め]が覚[さ]めて"
    },
    {
      "id": 3,
      "startTime": 29.939,
      "endTime": 37.12,
      "text": "真[ま]っ先[さき]に思[おも]い浮[う]かぶ 君[きみ]のこと",
      "translation": "제일 먼저 떠오르는 건 바로 너의 모습",
      "start": 29.939,
      "end": 37.12,
      "rubyText": "真[ま]っ先[さき]に思[おも]い浮[う]かぶ 君[きみ]のこと"
    },
    {
      "id": 4,
      "startTime": 38.133,
      "endTime": 42.342,
      "text": "思[おも]いきって前髪[まえがみ]を切[き]った",
      "translation": "큰맘을 먹고 앞머리를 잘랐어",
      "start": 38.133,
      "end": 42.342,
      "rubyText": "思[おも]いきって前髪[まえがみ]を切[き]った"
    },
    {
      "id": 5,
      "startTime": 42.342,
      "endTime": 48.07,
      "text": "「どうしたの？」って聞[き]かれたくて",
      "translation": "무슨 일 있어? 하고 물어봤으면 해서",
      "start": 42.342,
      "end": 48.07,
      "rubyText": "「どうしたの？」って聞[き]かれたくて"
    },
    {
      "id": 6,
      "startTime": 48.07,
      "endTime": 53.289,
      "text": "ピンクのスカート お花[はな]の髪飾[かみかざ]り",
      "translation": "핑크색 스커트 귀여운 꽃모양 머리핀",
      "start": 48.07,
      "end": 53.289,
      "rubyText": "ピンクのスカート お花[はな]の髪飾[かみかざ]り"
    },
    {
      "id": 7,
      "startTime": 53.289,
      "endTime": 56.004,
      "text": "さして 出[で]かけるの",
      "translation": "살며시 꽂고 나갈게",
      "start": 53.289,
      "end": 56.004,
      "rubyText": "さして 出[で]かけるの"
    },
    {
      "id": 8,
      "startTime": 56.004,
      "endTime": 62.465,
      "text": "今日[きょう]の私[わたし]は かわいいのよ！",
      "translation": "오늘의 나는 엄청 귀여운 것 같아!",
      "start": 56.004,
      "end": 62.465,
      "rubyText": "今日[きょう]の私[わたし]は かわいいのよ！"
    },
    {
      "id": 9,
      "startTime": 69.0,
      "endTime": 73.456,
      "text": "メルト 溶[と]けてしまいそう",
      "translation": "멜트 녹아내릴 것만 같아",
      "start": 69.0,
      "end": 73.456,
      "rubyText": "メルト 溶[と]けてしまいそう"
    },
    {
      "id": 10,
      "startTime": 73.456,
      "endTime": 78.535,
      "text": "好[す]きだなんて 絶対[ぜったい]にいえない…",
      "translation": "좋아한다는 말 절대절대 못 하는걸",
      "start": 73.456,
      "end": 78.535,
      "rubyText": "好[す]きだなんて 絶対[ぜったい]にいえない…"
    },
    {
      "id": 11,
      "startTime": 78.535,
      "endTime": 83.791,
      "text": "だけど メルト 目[め]も合[あ]わせられない",
      "translation": "하지만 멜트 눈도 마주치지 못해",
      "start": 78.535,
      "end": 83.791,
      "rubyText": "だけど メルト 目[め]も合[あ]わせられない"
    },
    {
      "id": 12,
      "startTime": 83.791,
      "endTime": 89.564,
      "text": "恋[こい]に恋[こい]なんてしないわ わたし",
      "translation": "사랑은 사양할래 안 할 거야 난 말야",
      "start": 83.791,
      "end": 89.564,
      "rubyText": "恋[こい]に恋[こい]なんてしないわ わたし"
    },
    {
      "id": 13,
      "startTime": 89.564,
      "endTime": 96.065,
      "text": "だって 君[きみ]のことが …好[す]きなの",
      "translation": "그치만 너라는 사람을 좋아해요",
      "start": 89.564,
      "end": 96.065,
      "rubyText": "だって 君[きみ]のことが …好[す]きなの"
    },
    {
      "id": 14,
      "startTime": 105.937,
      "endTime": 109.326,
      "text": "天気[てんき]予報[よほう]が ウソをついた",
      "translation": "일기예보가 거짓말을 했어",
      "start": 105.937,
      "end": 109.326,
      "rubyText": "天気[てんき]予報[よほう]が ウソをついた"
    },
    {
      "id": 15,
      "startTime": 109.326,
      "endTime": 116.125,
      "text": "土砂降[どしゃぶ]りの雨[あめ]が降[ふ]る",
      "translation": "하염없이 비가 내리잖아",
      "start": 109.326,
      "end": 116.125,
      "rubyText": "土砂降[どしゃぶ]りの雨[あめ]が降[ふ]る"
    },
    {
      "id": 16,
      "startTime": 116.125,
      "endTime": 118.245,
      "text": "カバンに入[い]れてた",
      "translation": "가방 속에 들어있었던",
      "start": 116.125,
      "end": 118.245,
      "rubyText": "カバンに入[い]れてた"
    },
    {
      "id": 17,
      "startTime": 118.245,
      "endTime": 121.652,
      "text": "折[お]りたたみ傘[がさ] うれしくない",
      "translation": "작은 접이식 우산 기쁘지 않은걸",
      "start": 118.245,
      "end": 121.652,
      "rubyText": "折[お]りたたみ傘[がさ] うれしくない"
    },
    {
      "id": 18,
      "startTime": 121.652,
      "endTime": 125.875,
      "text": "ため息[いき]をついた そんなとき",
      "translation": "살짝 한숨을 쉬었어, 바로 그 순간",
      "start": 121.652,
      "end": 125.875,
      "rubyText": "ため息[いき]をついた そんなとき"
    },
    {
      "id": 19,
      "startTime": 125.875,
      "endTime": 131.33,
      "text": "「しょうがないから入[はい]ってやる」なんて",
      "translation": "\"어쩔 수 없잖아- 같이 쓰자 들어갈게?\" 라니",
      "start": 125.875,
      "end": 131.33,
      "rubyText": "「しょうがないから入[はい]ってやる」なんて"
    },
    {
      "id": 20,
      "startTime": 131.33,
      "endTime": 135.29,
      "text": "隣[となり]にいるきみが笑[わら]う",
      "translation": "옆에 있는 네가 환하게 웃는걸",
      "start": 131.33,
      "end": 135.29,
      "rubyText": "隣[となり]にいるきみが笑[わら]う"
    },
    {
      "id": 21,
      "startTime": 135.29,
      "endTime": 141.942,
      "text": "恋[こい]に落[お]ちる音[おと]がした",
      "translation": "사랑에 빠지는 소리가 났어",
      "start": 135.29,
      "end": 141.942,
      "rubyText": "恋[こい]に落[お]ちる音[おと]がした"
    },
    {
      "id": 22,
      "startTime": 147.183,
      "endTime": 151.661,
      "text": "メルト 息[いき]がつまりそう",
      "translation": "멜트 숨이 멎을 것만 같아",
      "start": 147.183,
      "end": 151.661,
      "rubyText": "メルト 息[いき]がつまりそう"
    },
    {
      "id": 23,
      "startTime": 151.661,
      "endTime": 156.667,
      "text": "君[きみ]に触[ふ]れてる右手[みぎて]が 震[ふる]える",
      "translation": "너에게 닿아있는 오른손이 떨리는 걸",
      "start": 151.661,
      "end": 156.667,
      "rubyText": "君[きみ]に触[ふ]れてる右手[みぎて]が 震[ふる]える"
    },
    {
      "id": 24,
      "startTime": 156.667,
      "endTime": 161.824,
      "text": "高鳴[たかな]る胸[むね] はんぶんこの傘[かさ]",
      "translation": "두근대는 가슴 나눠 쓰고 있는 우산",
      "start": 156.667,
      "end": 161.824,
      "rubyText": "高鳴[たかな]る胸[むね] はんぶんこの傘[かさ]"
    },
    {
      "id": 25,
      "startTime": 161.824,
      "endTime": 167.705,
      "text": "手[て]を伸[の]ばせば届[とど]く距離[きょり] どうしよう…！",
      "translation": "손을 쭉 뻗으면 닿을 거리 어떡해",
      "start": 161.824,
      "end": 167.705,
      "rubyText": "手[て]を伸[の]ばせば届[とど]く距離[きょり] どうしよう…！"
    },
    {
      "id": 26,
      "startTime": 167.705,
      "endTime": 172.687,
      "text": "想[おも]いよ届[とど]け 君[きみ]に",
      "translation": "이 떨림이 너에게 전해지기를",
      "start": 167.705,
      "end": 172.687,
      "rubyText": "想[おも]いよ届[とど]け 君[きみ]に"
    },
    {
      "id": 27,
      "startTime": 172.687,
      "endTime": 177.698,
      "text": "お願[ねが]い 時間[じかん]をとめて 泣[な]きそうなの",
      "translation": "부탁이야 이 시간을 멈춰줘 울 것만 같아",
      "start": 172.687,
      "end": 177.698,
      "rubyText": "お願[ねが]い 時間[じかん]をとめて 泣[な]きそうなの"
    },
    {
      "id": 28,
      "startTime": 177.698,
      "endTime": 183.998,
      "text": "でも嬉[うれ]しくて 死[し]んでしまうわ！",
      "translation": "그래 행복해져서 죽을 것 같아",
      "start": 177.698,
      "end": 183.998,
      "rubyText": "でも嬉[うれ]しくて 死[し]んでしまうわ！"
    },
    {
      "id": 29,
      "startTime": 224.573,
      "endTime": 229.184,
      "text": "メルト 駅[えき]についてしまう…",
      "translation": "멜트 이제 곧 정류장이야",
      "start": 224.573,
      "end": 229.184,
      "rubyText": "メルト 駅[えき]についてしまう…"
    },
    {
      "id": 30,
      "startTime": 229.184,
      "endTime": 235.457,
      "text": "もう会[あ]えない 近[ちか]くて 遠[とお]いよ だから",
      "translation": "이젠 못 볼 거야, 가까워도 참 멀잖아. 그래서",
      "start": 229.184,
      "end": 235.457,
      "rubyText": "もう会[あ]えない 近[ちか]くて 遠[とお]いよ だから"
    },
    {
      "id": 31,
      "startTime": 235.457,
      "endTime": 239.639,
      "text": "メルト 手[て]をつないで 歩[ある]きたい！",
      "translation": "멜트 손을 잡고 걷고 싶어",
      "start": 235.457,
      "end": 239.639,
      "rubyText": "メルト 手[て]をつないで 歩[ある]きたい！"
    },
    {
      "id": 32,
      "startTime": 239.639,
      "endTime": 245.493,
      "text": "もうバイバイしなくちゃいけないの？",
      "translation": "이대로 안녕이란 작별 인사를 해야 해",
      "start": 239.639,
      "end": 245.493,
      "rubyText": "もうバイバイしなくちゃいけないの？"
    },
    {
      "id": 33,
      "startTime": 245.493,
      "endTime": 250.138,
      "text": "今[いま]すぐ わたしを 抱[だ]きしめて！",
      "translation": "지금 당장 나를 꼭 안아 줄래",
      "start": 245.493,
      "end": 250.138,
      "rubyText": "今[いま]すぐ わたしを 抱[だ]きしめて！"
    },
    {
      "id": 34,
      "startTime": 250.138,
      "endTime": 251.871,
      "text": "…なんてね",
      "translation": "랄까나",
      "start": 250.138,
      "end": 251.871,
      "rubyText": "…なんてね"
    }
  ],
