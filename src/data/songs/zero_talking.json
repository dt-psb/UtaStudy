  "duration": 227,
  "lyrics": [
    {
      "id": 1,
      "start": 16.54,
      "end": 17.79,
      "rubyText": "もう、着[つ]いたのね",
      "translation": "벌써, 도착했구나"
    },
    {
      "id": 2,
      "start": 17.92,
      "end": 19.38,
      "rubyText": "正面[しょうめん]あたりで待[ま]ってるわ",
      "translation": "정면 즈음에서 기다리고 있어"
    },
    {
      "id": 3,
      "start": 20.17,
      "end": 21.42,
      "rubyText": "ええ、楽[たの]しみよ",
      "translation": "그럼, 기대되지"
    },
    {
      "id": 4,
      "start": 21.54,
      "end": 23.17,
      "rubyText": "あなたの声[こえ]が聞[き]けるなんて",
      "translation": "네 목소리를 들을 수 있다니"
    },
    {
      "id": 5,
      "start": 30.58,
      "end": 31.88,
      "rubyText": "背[せ]、伸[の]びてるね",
      "translation": "키가 자랐구나"
    },
    {
      "id": 6,
      "start": 31.92,
      "end": 34.25,
      "rubyText": "知[し]らないリングがお似合[にあ]いね",
      "translation": "본 적 없는 반지가 잘 어울려"
    },
    {
      "id": 7,
      "start": 34.29,
      "end": 36.0,
      "rubyText": "ええ、感情論者[かんじょうろんしゃ]の",
      "translation": "응, 감정론자가 하는"
    },
    {
      "id": 8,
      "start": 36.04,
      "end": 37.71,
      "rubyText": "言葉[ことば]はすっかり意味[いみ]ないもんね",
      "translation": "말은 전혀 의미가 없지"
    },
    {
      "id": 9,
      "start": 37.75,
      "end": 39.42,
      "rubyText": "あの頃[ころ]",
      "translation": "그 시절"
    },
    {
      "id": 10,
      "start": 39.75,
      "end": 41.29,
      "rubyText": "私[わたし]たちは",
      "translation": "우리들은"
    },
    {
      "id": 11,
      "start": 41.33,
      "end": 43.0,
      "rubyText": "喧嘩[けんか]も",
      "translation": "싸움도"
    },
    {
      "id": 12,
      "start": 43.33,
      "end": 45.04,
      "rubyText": "よくしたけど",
      "translation": "꽤 자주 했었지만"
    },
    {
      "id": 13,
      "start": 45.08,
      "end": 46.79,
      "rubyText": "海[うみ]の見[み]える街[まち]　展望台[てんぼうだい]",
      "translation": "바다가 보이는 마을의 전망대"
    },
    {
      "id": 14,
      "start": 46.92,
      "end": 48.63,
      "rubyText": "マリィゴールドガ咲[さ]いている",
      "translation": "메리골드가 피어 있어"
    },
    {
      "id": 15,
      "start": 48.67,
      "end": 50.42,
      "rubyText": "私[わたし]たちの見[み]た夕焼[ゆうや]けは",
      "translation": "우리가 봤던 노을은"
    },
    {
      "id": 16,
      "start": 50.5,
      "end": 52.29,
      "rubyText": "やり直[なお]せないよシスター",
      "translation": "다시 볼 수 없어, 시스터"
    },
    {
      "id": 17,
      "start": 52.33,
      "end": 53.96,
      "rubyText": "大[おお]きくなって",
      "translation": "어른이 되어가고"
    },
    {
      "id": 18,
      "start": 54.08,
      "end": 55.54,
      "rubyText": "話[はなし]も減[へ]って",
      "translation": "대화도 줄어들고"
    },
    {
      "id": 19,
      "start": 55.58,
      "end": 57.54,
      "rubyText": "Zero Talking Talking Talking",
      "translation": "Zero Talking Talking Talking"
    },
    {
      "id": 20,
      "start": 57.58,
      "end": 59.29,
      "rubyText": "まだ諦[あきら]めてないよ",
      "translation": "아직 포기하지 않았어"
    },
    {
      "id": 21,
      "start": 59.33,
      "end": 61.04,
      "rubyText": "一回[いっかい]だけ",
      "translation": "단 한 번만이라도"
    },
    {
      "id": 22,
      "start": 61.17,
      "end": 62.79,
      "rubyText": "私[わたし]を見[み]て",
      "translation": "나를 바라봐 줘"
    },
    {
      "id": 23,
      "start": 62.83,
      "end": 64.71,
      "rubyText": "Zero Talking Talking Talking",
      "translation": "Zero Talking Talking Talking"
    },
    {
      "id": 24,
      "start": 64.75,
      "end": 66.21,
      "rubyText": "せめて話[はな]してよ！",
      "translation": "말이라도 좀 해줘!"
    },
    {
      "id": 25,
      "start": 81.17,
      "end": 82.75,
      "rubyText": "そう、嫌[いや]なのね",
      "translation": "그래, 싫다는 거구나"
    },
    {
      "id": 26,
      "start": 82.79,
      "end": 84.46,
      "rubyText": "言葉[ことば]はどっかに行[い]ったのね",
      "translation": "할 말은 없다는 거지"
    },
    {
      "id": 27,
      "start": 85.04,
      "end": 86.42,
      "rubyText": "もう好[す]きにして",
      "translation": "이젠 좋을대로 해"
    },
    {
      "id": 28,
      "start": 86.46,
      "end": 87.79,
      "rubyText": "“…一旦[いったん]お茶[ちゃ]でも振[ふ]る舞[ま]います”",
      "translation": "\"...일단 차라도 내어오겠습니다\""
    },
    {
      "id": 29,
      "start": 88.33,
      "end": 90.08,
      "rubyText": "熱湯[ねっとう]正論[せいろん] Suger & Milk",
      "translation": "뜨거운 물, 정론, Sugar & Milk"
    },
    {
      "id": 30,
      "start": 90.13,
      "end": 91.79,
      "rubyText": "機嫌[きげん]を治[なお]して Q・E・Tea",
      "translation": "기분을 추스르고 Q·E·Tea"
    },
    {
      "id": 31,
      "start": 91.83,
      "end": 93.71,
      "rubyText": "メタルの葉[は]っぱを絞[しぼ]ったシルバー",
      "translation": "금속의 잎에서 짜낸 은을"
    },
    {
      "id": 32,
      "start": 93.75,
      "end": 95.5,
      "rubyText": "剣[つるぎ]に鍛[きた]えてさしあげます",
      "translation": "검으로 벼려 바치겠습니다"
    },
    {
      "id": 33,
      "start": 95.54,
      "end": 97.08,
      "rubyText": "今[いま]でも",
      "translation": "지금도"
    },
    {
      "id": 34,
      "start": 97.5,
      "end": 99.13,
      "rubyText": "夢[ゆめ]に見[み]るわ",
      "translation": "꿈꾸고 있어"
    },
    {
      "id": 35,
      "start": 99.17,
      "end": 100.71,
      "rubyText": "あなたが",
      "translation": "당신의"
    },
    {
      "id": 36,
      "start": 101.08,
      "end": 102.79,
      "rubyText": "笑[わら]う顔[かお]を",
      "translation": "웃는 얼굴을"
    },
    {
      "id": 37,
      "start": 102.83,
      "end": 104.42,
      "rubyText": "四[よ]つ葉[ば]の見[み]つかる昼下[ひるさ]がり",
      "translation": "네잎클로버를 찾은 정오 무렵"
    },
    {
      "id": 38,
      "start": 104.54,
      "end": 106.21,
      "rubyText": "二人[ふたり]で半分[はんぶん]レーズンパン",
      "translation": "둘이서 반으로 나눈 건포도 빵"
    },
    {
      "id": 39,
      "start": 106.33,
      "end": 108.17,
      "rubyText": "私[わたし]たちはまだそこにいる",
      "translation": "우리는 아직 그곳에 있어"
    },
    {
      "id": 40,
      "start": 108.21,
      "end": 109.92,
      "rubyText": "どうにか気[き]づいてシスター",
      "translation": "어떻게든 알아차려줘, 시스터"
    },
    {
      "id": 41,
      "start": 109.96,
      "end": 111.54,
      "rubyText": "お腹[なか]が減[へ]って",
      "translation": "배가 고파서"
    },
    {
      "id": 42,
      "start": 111.71,
      "end": 113.13,
      "rubyText": "話[はなし]も減[へ]って",
      "translation": "대화도 고파서"
    },
    {
      "id": 43,
      "start": 113.17,
      "end": 115.29,
      "rubyText": "Zero Talking Talking Talking",
      "translation": "Zero Talking Talking Talking"
    },
    {
      "id": 44,
      "start": 115.33,
      "end": 117.04,
      "rubyText": "背中[せなか]向[む]けてないで",
      "translation": "등을 돌리지 말아줘"
    },
    {
      "id": 45,
      "start": 117.08,
      "end": 118.92,
      "rubyText": "一回[いっかい]だけ",
      "translation": "단 한 번만이라도"
    },
    {
      "id": 46,
      "start": 118.96,
      "end": 120.67,
      "rubyText": "赦[ゆる]してみて",
      "translation": "용서해 줘"
    },
    {
      "id": 47,
      "start": 120.71,
      "end": 122.67,
      "rubyText": "Zero Talking Talking Talking",
      "translation": "Zero Talking Talking Talking"
    },
    {
      "id": 48,
      "start": 122.71,
      "end": 124.33,
      "rubyText": "なにか話[はな]してよ！",
      "translation": "뭐라고 말 좀 해봐!"
    },
    {
      "id": 49,
      "start": 128.33,
      "end": 150.17,
      "rubyText": "一言[ひとこと]でも",
      "translation": "한마디라도"
    },
    {
      "id": 50,
      "start": 153.63,
      "end": 154.92,
      "rubyText": "もう帰[かえ]るのね",
      "translation": "벌써 돌아가는구나"
    },
    {
      "id": 51,
      "start": 155.08,
      "end": 156.54,
      "rubyText": "まるで彦星[ひこぼし]と織姫[おりひめ]ね",
      "translation": "마치 견우와 직녀 같아"
    },
    {
      "id": 52,
      "start": 157.25,
      "end": 158.71,
      "rubyText": "まあ、私[わたし]たち",
      "translation": "뭐, 우리들"
    },
    {
      "id": 53,
      "start": 158.75,
      "end": 160.54,
      "rubyText": "奇[く]しくも人間[にんげん]ですからね",
      "translation": "이상하게도 인간이니까요"
    },
    {
      "id": 54,
      "start": 183.96,
      "end": 185.54,
      "rubyText": "さよならなんて",
      "translation": "작별 따위에는"
    },
    {
      "id": 55,
      "start": 185.71,
      "end": 187.29,
      "rubyText": "習[なら]わなかった",
      "translation": "익숙해지지 않았어"
    },
    {
      "id": 56,
      "start": 187.33,
      "end": 189.29,
      "rubyText": "Zero Talking Talking Talking",
      "translation": "Zero Talking Talking Talking"
    },
    {
      "id": 57,
      "start": 189.33,
      "end": 191.04,
      "rubyText": "もう何[なに]も話[はな]すな！",
      "translation": "더 이상 아무 말도 하지 마!"
    },
    {
      "id": 58,
      "start": 191.08,
      "end": 192.79,
      "rubyText": "一回[いっかい]だけ",
      "translation": "단 한 번이지만"
    },
    {
      "id": 59,
      "start": 192.83,
      "end": 194.58,
      "rubyText": "蓋[ふた]してみた",
      "translation": "너의 입을 덮어 보았어"
    },
    {
      "id": 60,
      "start": 194.63,
      "end": 196.54,
      "rubyText": "Zero Talking Talking Talking",
      "translation": "Zero Talking Talking Talking"
    },
    {
      "id": 61,
      "start": 196.58,
      "end": 202.04,
      "rubyText": "全[すべ]て忘[わす]れろよ",
      "translation": "전부 잊어버리도록 해"
