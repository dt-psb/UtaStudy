  "duration": 191,
  "lyrics": [
    {
      "id": 1,
      "start": 8.66,
      "end": 11.2,
      "rubyText": "魂[たましい]　どこにあるの",
      "translation": "영혼은 어디 있나요",
      "romaji": "tamashii doko ni aru no"
    },
    {
      "id": 2,
      "start": 11.2,
      "end": 12.33,
      "rubyText": "先生[せんせい]",
      "translation": "선생님",
      "romaji": "sensei"
    },
    {
      "id": 3,
      "start": 12.33,
      "end": 14.9,
      "rubyText": "わたしは　どこにいるの",
      "translation": "저는 어디에 있나요",
      "romaji": "watashi wa doko ni iru no"
    },
    {
      "id": 4,
      "start": 14.9,
      "end": 16.23,
      "rubyText": "先生[せんせい]",
      "translation": "선생님",
      "romaji": "sensei"
    },
    {
      "id": 5,
      "start": 16.23,
      "end": 19.3,
      "rubyText": "神様[かみさま]って薄情[はくじょう]ね",
      "translation": "신님은 참 무정하시네요",
      "romaji": "kamisama tte hakujou ne"
    },
    {
      "id": 6,
      "start": 19.3,
      "end": 21.5,
      "rubyText": "増[ふ]えすぎたクランケ",
      "translation": "환자가 너무 많아져 버렸어요",
      "romaji": "fuesugita kuranke"
    },
    {
      "id": 7,
      "start": 26.08,
      "end": 30.21,
      "rubyText": "水[みず]たまりの空[そら]を飛[と]ぼうとした",
      "translation": "물웅덩이에 비친 하늘을 날려고 했던",
      "romaji": "mizutamari no sora o tobou to shita"
    },
    {
      "id": 8,
      "start": 30.21,
      "end": 33.78,
      "rubyText": "堕天使[だてんし]は地底[ちてい]にラピュタを作[つく]る",
      "translation": "타락천사는 땅속에 라퓨타를 만드는",
      "romaji": "datenshi wa chitei ni rapyuta o tsukuru"
    },
    {
      "id": 9,
      "start": 33.78,
      "end": 37.85,
      "rubyText": "計画[けいかく]を1年[ねん]温[あたた]めている",
      "translation": "계획을 1년 동안 간직하고 있었대요",
      "romaji": "keikaku o ichinen atatamete iru"
    },
    {
      "id": 10,
      "start": 37.85,
      "end": 41.66,
      "rubyText": "って先生[せんせい]話[はなし]聞[き]いてる？",
      "translation": "…선생님, 제 얘기 듣고 계세요?",
      "romaji": "tte sensei hanashi kiiteru?"
    },
    {
      "id": 11,
      "start": 41.66,
      "end": 44.49,
      "rubyText": "アタマモミ",
      "translation": "아타마모미(머리 마사지)",
      "romaji": "atamamomi"
    },
    {
      "id": 12,
      "start": 44.49,
      "end": 46.96,
      "rubyText": "はやくアタマモミ",
      "translation": "빨리 아타마모미(머리 마사지)",
      "romaji": "hayaku atamamomi"
    },
    {
      "id": 13,
      "start": 46.96,
      "end": 48.27,
      "rubyText": "して",
      "translation": "해줘",
      "romaji": "shite"
    },
    {
      "id": 14,
      "start": 48.27,
      "end": 51.07,
      "rubyText": "だからアタマモミ",
      "translation": "그러니 아타마모미(머리 마사지)",
      "romaji": "dakara atamamomi"
    },
    {
      "id": 15,
      "start": 52.0,
      "end": 54.3,
      "rubyText": "はやくアタマモミ",
      "translation": "어서 아타마모미(머리 마사지)",
      "romaji": "hayaku atamamomi"
    },
    {
      "id": 16,
      "start": 54.3,
      "end": 55.67,
      "rubyText": "して",
      "translation": "해줘",
      "romaji": "shite"
    },
    {
      "id": 17,
      "start": 55.67,
      "end": 59.24,
      "rubyText": "わたしアタマの固[かた]い女[おんな]の子[こ]",
      "translation": "나는야 머리가 딱딱한 소녀",
      "romaji": "watashi atama no katai onna no ko"
    },
    {
      "id": 18,
      "start": 59.24,
      "end": 63.65,
      "rubyText": "来[き]たらすぐに施[ほどこ]してアタマモミ",
      "translation": "오면 바로 시술해줘 아타마모미(머리 마사지)",
      "romaji": "kitara sugu ni hodokoshite atamamomi"
    },
    {
      "id": 19,
      "start": 63.65,
      "end": 66.55,
      "rubyText": "アタマとココロがバラバラ",
      "translation": "머리와 마음이 따로따로",
      "romaji": "atama to kokoro ga barabara"
    },
    {
      "id": 20,
      "start": 66.55,
      "end": 70.92,
      "rubyText": "この世界[せかい]に理解者[りかいしゃ]はアナタノミ",
      "translation": "이 세상에서 이해자는 오직 당신뿐",
      "romaji": "kono sekai ni rikaisha wa anatanomi"
    },
    {
      "id": 21,
      "start": 70.92,
      "end": 73.92,
      "rubyText": "アナタノミ",
      "translation": "당신뿐",
      "romaji": "anatanomi"
    },
    {
      "id": 22,
      "start": 73.92,
      "end": 76.83,
      "rubyText": "だからアナタノミ",
      "translation": "그러니 당신뿐",
      "romaji": "dakara anatanomi"
    },
    {
      "id": 23,
      "start": 78.36,
      "end": 80.86,
      "rubyText": "魂[たましい]　どこにあるの",
      "translation": "\"영혼은 어디에 있나요\"",
      "romaji": "tamashii doko ni aru no"
    },
    {
      "id": 24,
      "start": 80.86,
      "end": 82.0,
      "rubyText": "先生[せんせい]",
      "translation": "\"선생님\"",
      "romaji": "sensei"
    },
    {
      "id": 25,
      "start": 82.0,
      "end": 84.57,
      "rubyText": "あしたは　どこにいくの",
      "translation": "\"내일은 어디로 가나요\"",
      "romaji": "ashita wa doko ni iku no"
    },
    {
      "id": 26,
      "start": 84.57,
      "end": 85.7,
      "rubyText": "先生[せんせい]",
      "translation": "\"선생님\"",
      "romaji": "sensei"
    },
    {
      "id": 27,
      "start": 85.7,
      "end": 88.67,
      "rubyText": "まるで子[こ]どものように",
      "translation": "마치 어린아이처럼",
      "romaji": "marude kodomo no you ni"
    },
    {
      "id": 28,
      "start": 88.67,
      "end": 91.08,
      "rubyText": "繰[く]り返[かえ]すクランケ",
      "translation": "되뇌이는 환자",
      "romaji": "kurikaesu kuranke"
    },
    {
      "id": 29,
      "start": 96.21,
      "end": 99.62,
      "rubyText": "口[くち]寂[さび]しさだけに処方[しょほう]をして",
      "translation": "외로움을 달래기 위해 처방해 주니",
      "romaji": "kuchisabishisa dake ni shohou o shite"
    },
    {
      "id": 30,
      "start": 99.62,
      "end": 103.09,
      "rubyText": "彼女[かのじょ]たちは皆[みな]人形[にんぎょう]に戻[もど]る",
      "translation": "그녀들은 모두 인형으로 돌아가버리죠",
      "romaji": "kanojotachi wa mina ningyou ni modoru"
    },
    {
      "id": 31,
      "start": 103.09,
      "end": 105.66,
      "rubyText": "それから用法[ようほう]容量[ようりょう]守[まも]りな宰相[さいしょう]",
      "translation": "규칙도, 용량도 지키렴 재상",
      "romaji": "sorekara youhou youryou mamori na saishou"
    },
    {
      "id": 32,
      "start": 105.66,
      "end": 107.26,
      "rubyText": "集合[しゅうごう]解散[かいさん]海砂利水[かいじゃりすい]",
      "translation": "집합 해산 카이자리스이",
      "romaji": "shuugou kaisan kaijarisui"
    },
    {
      "id": 33,
      "start": 107.26,
      "end": 110.63,
      "rubyText": "って全然[ぜんぜん]話[はなし]聞[き]いてない",
      "translation": "…전혀 제 얘기를 듣고 있지 않네요",
      "romaji": "tte zenzen hanashi kiitenai"
    },
    {
      "id": 34,
      "start": 110.63,
      "end": 113.9,
      "rubyText": "だからアタマモミ",
      "translation": "그러니 아타마모미(머리 마사지)",
      "romaji": "dakara atamamomi"
    },
    {
      "id": 35,
      "start": 114.3,
      "end": 116.67,
      "rubyText": "はやくアタマモミ",
      "translation": "바로 아타마모미(머리 마사지)",
